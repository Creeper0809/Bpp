// IR Test: source-aware JSON ranges for control flow, calls, and expressions
import std.io;

func bump(v: i64) -> i64 {
    return v + 1;
}

func main() -> i64 {
    var current: i64 = 12;
    var p: i64 = 2;
    while (current > 1) {
        if ((current % p) == 0) {
            current = current / p;
        } else {
            p = bump(p);
        }
    }
    println("done");
    return current;
}
