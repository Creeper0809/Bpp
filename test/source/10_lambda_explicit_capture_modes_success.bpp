}

func lambda_closure_handle_copy_check() -> u64 {
    var x: u64 = 1;
    var a: u64 = func () -> u64 { x };
    var b: u64 = a;
    if (b() != 1) { return 9; }
    return 0;
}

struct TypedLambdaRecord { public a: u64; public b: u64; public c: u64; }
struct TypedLambdaBox { public callback: func (u64) -> u64; }

func typed_lambda_apply(callback: func (u64) -> u64, value: u64) -> u64 { return callback(value); }
func typed_lambda_factory(base: u64) -> func (u64) -> u64 {
    return func [base] (value: u64) -> u64 { base + value };
}
func typed_lambda_record_apply(callback: func (u64) -> TypedLambdaRecord, value: u64) -> TypedLambdaRecord {
    return callback(value);
}
func typed_lambda_slice_apply(callback: func (u64) -> []u64) -> []u64 { return callback(1); }
func typed_lambda_effect_apply(callback: func (u64), value: u64) { callback(value); }
func typed_lambda_effect_check(total: u64) -> u64 {
    var effect: func (u64) = func [&total] (amount: u64) { total = total + amount; return; };
    typed_lambda_effect_apply(effect, 42);
    return total;
}

func result_block_checks(total: u64) -> u64 {
    var empty: func () = func () {};
    empty();
    var effect: func () = func [&total] () { total = total + 1; };
    effect();
    if (total != 1) { return 20; }
    var nested: func (u64) -> u64 = func (value: u64) -> u64 { { value + 1 } };
    if (nested(41) != 42) { return 21; }
    var record: TypedLambdaRecord = match (total) -> TypedLambdaRecord {
        case 1: TypedLambdaRecord{total, 2, 3};
        default: TypedLambdaRecord{4, 5, 6};
    };
    if (record.a != 1 || record.c != 3) { return 22; }
    var item: u64 = 42;
    var values: []u64 = slice(&item, 1);
    var sequence: []u64 = match (total) -> []u64 {
        case 1: values;
        default: slice(0, 0);
    };
    if (sequence.len != 1 || sequence[0] != 42) { return 23; }
    var callback: func (u64) -> u64 = typed_lambda_factory(5);
    var selected: func (u64) -> u64 = match (total) -> func (u64) -> u64 {
        case 1: callback;
        default: callback;
    };
    if (selected(37) != 42) { return 24; }
    return 0;
}

func typed_lambda_gc_apply(callback: func (u64) -> u64) -> u64 {
    bpp_gc_collect();
    return callback(37);
}

func typed_lambda_gc_local() -> u64 {
    var callback: func (u64) -> u64 = typed_lambda_factory(5);
    bpp_gc_collect();
    if (callback(37) != 42) { return 16; }
    return 0;
}

func typed_lambda_gc_box_local() -> u64 {
    var box: TypedLambdaBox = TypedLambdaBox{typed_lambda_factory(5)};
    bpp_gc_collect();
    return box.callback(37);
}

func typed_lambda_gc_box_assign() -> u64 {
    var box: TypedLambdaBox;
    box.callback = typed_lambda_factory(5);
    bpp_gc_collect();
    if (box.callback(37) != 42) { return 0; }
    box = TypedLambdaBox{typed_lambda_factory(7)};
    bpp_gc_collect();
    return box.callback(35);
}

func typed_lambda_gc_box_param(box: TypedLambdaBox) -> u64 {
    bpp_gc_collect();
    return box.callback(37);
}

func typed_lambda_gc_early_return() -> u64 {
    var iteration: u64 = 0;
    while (iteration < 3) {
        if (iteration == 1) { return 42; }
        var later_callback: func (u64) -> u64 = typed_lambda_factory(5);
        if (later_callback(37) != 42) { return 0; }
        iteration = iteration + 1;
    }
    return 0;
}

func typed_lambda_gc_pressure() -> u64 {
    bpp_gc_collect();
    bpp_gc_compact();
    return 37;
}

func typed_lambda_gc_box_factory() -> TypedLambdaBox {
    return TypedLambdaBox{typed_lambda_factory(5)};
}

func typed_lambda_gc_box_with_arg(box: TypedLambdaBox, value: u64) -> u64 {
    return box.callback(value);
}

func typed_lambda_gc_callee() -> u64 {
    var callback: func (u64) -> u64 = typed_lambda_factory(5);
    return callback(typed_lambda_gc_pressure());
}

func typed_lambda_gc_raw_handle() -> u64 { return (u64)typed_lambda_factory(5); }
func typed_lambda_gc_cast_call() -> u64 {
    return ((func (u64) -> u64)typed_lambda_gc_raw_handle())(37);
}

struct TypedLambdaHeapBox { public inner: TypedLambdaBox; public value: u64; }
func typed_lambda_gc_heap() -> u64 {
    var box: *TypedLambdaHeapBox = new TypedLambdaHeapBox{TypedLambdaBox{typed_lambda_factory(5)}, typed_lambda_gc_pressure()};
    bpp_gc_collect();
    return box.inner.callback(box.value);
}

func typed_lambda_gc_loop_condition() -> u64 {
    var iteration: u64 = 0;
    while (typed_lambda_apply(typed_lambda_factory(1), iteration) < 5) {
        if (bpp_gc_temporary_root_count() != 0) { return 0; }
        iteration = iteration + 1;
        bpp_gc_collect();
    }
    return iteration;
}

func typed_lambda_gc_checks() -> u64 {
    bpp_gc_reset();
    bpp_gc_set_auto(0, 0);
    if (typed_lambda_gc_local() != 0) { return 16; }
    if (typed_lambda_gc_apply(typed_lambda_factory(5)) != 42) { return 17; }
    if (typed_lambda_gc_box_local() != 42) { return 25; }
    if (typed_lambda_gc_box_param(TypedLambdaBox{typed_lambda_factory(5)}) != 42) { return 26; }
    if (typed_lambda_gc_early_return() != 42) { return 27; }
    if (typed_lambda_gc_box_assign() != 42) { return 34; }
    if (typed_lambda_apply(typed_lambda_factory(5), typed_lambda_gc_pressure()) != 42) { return 35; }
    if (typed_lambda_gc_box_with_arg(typed_lambda_gc_box_factory(), typed_lambda_gc_pressure()) != 42) { return 36; }
    if (typed_lambda_gc_heap() != 42) { return 37; }
    if (typed_lambda_gc_callee() != 42) { return 40; }
    if (typed_lambda_gc_cast_call() != 42) { return 41; }
    if (typed_lambda_gc_loop_condition() != 4) { return 38; }
    bpp_gc_collect();
    if (bpp_gc_live_count() != 0 || bpp_gc_root_slot_count() != 0) { return 18; }
    if (bpp_gc_temporary_root_count() != 0 || bpp_gc_root_count() != 0) { return 39; }
    bpp_gc_reset();
    return 0;
}

func typed_lambda_contract_checks() -> u64 {
    var block_status: u64 = result_block_checks(0);
    if (block_status != 0) { return block_status; }
    var base: u64 = 5;
    var add: func (u64) -> u64 = func [base] (value: u64) -> u64 { base + value };
    if (add(37) != 42 || typed_lambda_apply(add, 37) != 42) { return 10; }
    if ((true && add(37) == 42) == false) { return 28; }
    if ((false || add(37) != 42) != false) { return 29; }
    if ((add(37) == 42 && false) != false) { return 30; }
    if ((add(37) != 42 || false) != false) { return 31; }
    if ((true ? add(37) + 1 : 99) != 43) { return 32; }
    if ((false ? 99 : add(37) + 2) != 44) { return 33; }
    var box: TypedLambdaBox = TypedLambdaBox{add};
    if (box.callback(37) != 42) { return 11; }
    var from_factory: func (u64) -> u64 = typed_lambda_factory(7);
    if (typed_lambda_apply(from_factory, 35) != 42) { return 12; }
    var record_fn: func (u64) -> TypedLambdaRecord = func [base] (value: u64) -> TypedLambdaRecord {
        TypedLambdaRecord{base, value, base + value}
    };
    var result: TypedLambdaRecord = typed_lambda_record_apply(record_fn, 37);
    if (result.a != 5 || result.b != 37 || result.c != 42) { return 13; }
    var value: u64 = 42;
    var values: []u64 = slice(&value, 1);
    var slice_fn: func (u64) -> []u64 = func [values] (unused: u64) -> []u64 { values };
    var returned: []u64 = typed_lambda_slice_apply(slice_fn);
    if (returned.len != 1 || returned[0] != 42) { return 14; }
    if (typed_lambda_effect_check(0) != 42) { return 15; }
    return 0;
}

func main() -> u64 {
    var c1: u64 = lambda_non_capture_checks();
    if (c1 != 0) { return c1; }

    var c2: u64 = lambda_capture_check();
    if (c2 != 0) { return c2; }

    var c3: u64 = lambda_explicit_capture_modes_check();
