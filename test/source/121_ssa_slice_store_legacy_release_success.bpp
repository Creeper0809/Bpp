// Releasing legacy slice-store metadata must free its real argument vector.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.datastruct;
import std.vec;
import std.mem;

func release_legacy_slice_store_payload() -> u64 {
    var args: *Vec<u64> = new Vec<u64>{heap_alloc(128 * sizeof(u64)), 0, 128};
    var info: *SSACallInfo = new SSACallInfo{};
    info.name = slice((u64)"target", 6);
    info.args_vec = args;
    info.nargs = 0;
    info.ret_type = 0;
    info.ret_ptr_depth = 0;
    ssa_aux_payload_release(SSA_AUX_CALL_SLICE_STORE, (u64)info);
    return 0;
}

func main() -> u64 {
    release_legacy_slice_store_payload();
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        release_legacy_slice_store_payload();
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
