// Covers: GC root-slot runtime reachability for pointer-only function parameters
// Expect exit code: 0
// Expect asm contains: std_mem__bpp_gc_root_slot_remove:

func pointer_param_is_non_null(value: *u64) -> u64 {
    if (value == 0) { return 0; }
    return 1;
}

func main() -> u64 {
    var value: u64 = 7;
    if (pointer_param_is_non_null(&value) == 0) { return 1; }
    return 0;
}
