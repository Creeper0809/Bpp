// Per-declaration emitter type scratch must not escape the declaration call.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import emitter.emitter;
import emitter.gen.stmt;
import ast;
import types;
import std.vec;
import std.mem;

func emit_one_decl(decl: *AstVarDecl, structs: *Vec<*AstStructDef>) -> u64 {
    init_state();
    emit_var_decl_stmt((u64)decl, symtab_current(), structs);
    return 0;
}

func main() -> u64 {
    compiler_ctx_current();
    var decl: *AstVarDecl = ast_var_decl(slice((u64)"value", 5), TYPE_U64, 0, 0);
    var structs: *Vec<*AstStructDef> = new Vec<*AstStructDef>{heap_alloc(8 * sizeof(*AstStructDef)), 0, 8};

    emit_one_decl(decl, structs);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 64; i++) {
        emit_one_decl(decl, structs);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    emitter_state_release();
    if (after > before + 64) { return 1; }
    return 0;
}
