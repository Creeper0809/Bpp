// SSA diagnostic/source-span transient state must be isolated per compiler context.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import ssa.core;

func main() -> u64 {
    var first: *CompilerCtx = compiler_ctx_new();
    var second: *CompilerCtx = compiler_ctx_new();

    compiler_ctx_activate(first);
    ssa_builder_diag_suppress_set(1);
    ssa_source_span_set_current_full(111, 11, 12, 13, 14, 15, 16, 17, 18);

    compiler_ctx_activate(second);
    var file_ptr: u64 = 0;
    var file_len: u64 = 0;
    var start_line: u64 = 0;
    var start_col: u64 = 0;
    var end_line: u64 = 0;
    var end_col: u64 = 0;
    var range_id: u64 = 0;
    var start_offset: u64 = 0;
    var end_offset: u64 = 0;
    if (ssa_builder_diag_suppressed() != 0) { return 1; }
    if (ssa_source_span_get_current_full(&file_ptr, &file_len, &start_line, &start_col, &end_line, &end_col, &range_id, &start_offset, &end_offset) != 0) { return 2; }

    ssa_source_span_set_current_full(222, 21, 22, 23, 24, 25, 26, 27, 28);
    compiler_ctx_activate(first);
    if (ssa_builder_diag_suppressed() != 1) { return 3; }
    if (ssa_source_span_get_current_full(&file_ptr, &file_len, &start_line, &start_col, &end_line, &end_col, &range_id, &start_offset, &end_offset) == 0) { return 4; }
    if (file_ptr != 111 || file_len != 11 || start_line != 12 || range_id != 16 || end_offset != 18) { return 5; }

    compiler_ctx_destroy(second);
    compiler_ctx_destroy(first);
    return 0;
}
