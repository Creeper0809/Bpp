// Covers: the retained legacy compatibility predicate must never infer type
// compatibility from byte width and must reject categories whose nominal or
// element identity is absent from its old scalar-only signature.
// Mode: ssa|nossa
// Opt: O0|O1
// Expect exit code: 0

import emitter.typeinfo;
import types;

func main() -> u64 {
    var no_layout: []u8 = slice(0, 0);
    if (check_type_compat(TYPE_U64, 0, 0, no_layout, TYPE_U64, 0, 0, no_layout) != 0) { return 1; }
    if (check_type_compat(TYPE_F64, 0, 0, no_layout, TYPE_U64, 0, 0, no_layout) == 0) { return 2; }
    if (check_type_compat(TYPE_U8, 1, 0, no_layout, TYPE_U64, 1, 0, no_layout) == 0) { return 3; }
    if (check_type_compat(TYPE_STRUCT, 0, 0, no_layout, TYPE_STRUCT, 0, 0, no_layout) == 0) { return 4; }
    if (check_type_compat(TYPE_FUNC, 0, 0, no_layout, TYPE_FUNC, 0, 0, no_layout) == 0) { return 5; }
    return 0;
}
