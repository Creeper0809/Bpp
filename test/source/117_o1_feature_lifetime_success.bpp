// O1 must release its per-function feature summary after every run.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.datastruct;
import run as optimize_o1 from ssa.opt_o1;
import std.mem;

func main() -> u64 {
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice((u64)"o1_feature_probe", 16));
    create_block(ctx, fn);

    optimize_o1(ctx);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        optimize_o1(ctx);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    ssa_context_release_aux(ctx);
    if (after > before + 64) { return 1; }
    return 0;
}
