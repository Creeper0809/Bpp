// Named-argument call-shape validation must release its assignment bitmap.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler.annotations;
import ast;
import types;
import std.vec;
import std.mem;

func main() -> u64 {
    var params: *Vec<*Param> = new Vec<*Param>{heap_alloc(sizeof(*Param)), 0, 1};
    var param: *Param = new Param{};
    param.name = slice((u64)"value", 5);
    params.push(param);

    var fn: *AstFunc = new AstFunc{};
    fn.params_vec = params;

    var arg_names: *Vec<*NameInfo> = new Vec<*NameInfo>{heap_alloc(sizeof(*NameInfo)), 0, 1};
    arg_names.push(new NameInfo{(u64)"value", 5});

    if (annotation_complexity_fn_accepts_call_shape(fn, 1, 0, arg_names) == 0) { return 2; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        if (annotation_complexity_fn_accepts_call_shape(fn, 1, 0, arg_names) == 0) { return 2; }
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
