// Per-function SSA builder reset must reuse scratch containers.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.builder;
import ssa.core;
import compiler;
import std.io;
import std.vec;
import std.mem;
import types;

func plan_and_release_one_param(builder: *BuilderCtx, params: *Vec<*Param>) -> u64 {
    var layouts: *Vec<*BuilderParamLayout> = new Vec<*BuilderParamLayout>{heap_alloc(sizeof(*BuilderParamLayout)), 0, 1};
    if (plan_param_layout(builder, params, 0, layouts) == 0) { return 0; }
    builder_param_layouts_release(layouts);
    return 1;
}

func main() -> u64 {
    compiler_ctx_current();
    var ssa_ctx: *SSAContext = create_context();
    if (ssa_ctx == 0) { return 10; }
    var builder: *BuilderCtx = ctx_new(ssa_ctx);
    if (builder == 0) { return 11; }
    reset_func(builder);
    var params: *Vec<*Param> = new Vec<*Param>{heap_alloc(sizeof(*Param)), 0, 1};
    var param: *Param = new Param{};
    param.name = slice((u64)"value", 5);
    param.type_kind = TYPE_U64;
    params.push(param);
    if (plan_and_release_one_param(builder, params) == 0) { return 12; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 64; i++) {
        reset_func(builder);
        if (plan_and_release_one_param(builder, params) == 0) { return 12; }
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
