// O2 transaction snapshots must be released on every completion path.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.opt_pipeline;
import std.mem;

func main() -> u64 {
    var ctx: *SSAContext = create_context();
    ssa_opt_pipeline_run_memoryssa2_transaction(ctx);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        ssa_opt_pipeline_run_memoryssa2_transaction(ctx);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }

    var fn: *SSAFunction = create_function(ctx, slice((u64)"o2_summary_probe", 16));
    create_block(ctx, fn);
    ssa_opt_pipeline_prepare_o2(ctx, 2);
    before = heap_profile_live_payload_byte_count();
    for (var j: u64 = 0; j < 32; j++) {
        ssa_opt_pipeline_prepare_o2(ctx, 2);
    }
    after = heap_profile_live_payload_byte_count();
    ssa_context_release_aux(ctx);
    if (after > before + 64) { return 2; }
    return 0;
}
