// Imported generic templates must be visible while pass 1 parses signatures.
// Mode: ssa|nossa
// Opt: O0|O1
// Expect exit code: 0

import Option from std.option;
import Result from std.result;

func keep_option(value: Option<u64>) -> Option<u64> {
    return value;
}

func keep_result(value: Result<u64, u64>) -> Result<u64, u64> {
    return value;
}

func main() -> u64 {
    var option_value: Option<u64>;
    option_value.is_some = 1;
    option_value.value = 17;
    var kept_option: Option<u64> = keep_option(option_value);
    if (kept_option.is_some != 1 || kept_option.value != 17) { return 1; }

    var result_value: Result<u64, u64>;
    result_value.is_ok = 1;
    result_value.ok = 29;
    result_value.err = 0;
    var kept_result: Result<u64, u64> = keep_result(result_value);
    if (kept_result.is_ok != 1 || kept_result.ok != 29) { return 2; }
    return 0;
}
