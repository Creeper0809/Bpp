// Operator-name lookup and released lexer pools must not leak or dangle.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import compiler.ast_lowering;
import emitter.gen.expr;
import ssa.builder;
import types;
import std.mem;
import lexer;

func probe_released_token_pool() -> u64 {
    var ctx: *LexCtx = lex_ctx_new();
    var old_tokens: *Vec<*Token> = lex_all_with_ctx(ctx, (u64)"<", 1);
    var tokens: *Vec<*Token> = lex_all_with_ctx(ctx, (u64)">>", 2);
    var active_pool: u64 = g_tok_pool_ptr;
    lex_release_tokens(old_tokens);
    if (g_tok_pool_ptr != active_pool) { return 10; }
    lex_release_tokens(tokens);
    if (g_tok_pool_ptr != 0 || g_tok_pool_len != 0 || g_tok_pool_cap != 0) { return 11; }
    var pending: *Token = tok_new(TOKEN_GT, (u64)">", 1, 1, 2);
    if (pending == 0 || pending.kind != TOKEN_GT || pending.col != 2) { return 12; }
    lex_ctx_capture(ctx);
    lex_ctx_release(ctx);
    return 0;
}

func resolve_operator_once() -> u64 {
    var name: NameInfo = compiler_operator_binary_name(TOKEN_PLUS);
    var number_name: NameInfo = builder_number_binary_call_name(TOKEN_PLUS);
    var convert_name: NameInfo = lower_number_to_integer_method_name(TYPE_I8);
    var canonical_name: NameInfo = emit_number_canonical_lower_call_name(slice((u64)"number_from_i8", 14));
    if (name.ptr == 0 || number_name.ptr == 0 || convert_name.ptr == 0 || canonical_name.ptr == 0) { return 0; }
    return 1;
}

func main() -> u64 {
    var pool_result: u64 = probe_released_token_pool();
    if (pool_result != 0) { return pool_result; }
    if (resolve_operator_once() != 1) { return 2; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        if (resolve_operator_once() != 1) { return 2; }
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
