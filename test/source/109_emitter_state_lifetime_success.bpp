// Reinitializing one context's emitter must release all emitter-owned state.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import emitter.emitter;
import emitter.typeinfo;
import emitter.symtab;
import std.io;
import std.vec;
import types;

func prepare_emitter_state(globals: *Vec<*GlobalInfo>, consts: *Vec<*AstConstDecl>) -> u64 {
    init_state();
    globals_set(globals);
    load_consts(consts);
    symtab_add(symtab_current(), slice("local", 5), TYPE_U64, 0, 8);
    string_get_label(slice("\"text\"", 6));
    float_get_label(slice("1.25", 4));
    closure_handle_set(slice("closure", 7), 1);

    var backend: *GlobalInfo = (*GlobalInfo)heap_alloc(sizeof(GlobalInfo));
    backend.name = slice("__probe_global", 14);
    backend.typeinfo_ptr = typeinfo_make(TYPE_U64, 0);
    add_backend_global(backend);
    return 0;
}

func main() -> u64 {
    compiler_ctx_current();
    var globals: *Vec<*GlobalInfo> = new Vec<*GlobalInfo>{heap_alloc(8 * sizeof(*GlobalInfo)), 0, 8};
    var consts: *Vec<*AstConstDecl> = new Vec<*AstConstDecl>{heap_alloc(8 * sizeof(*AstConstDecl)), 0, 8};
    prepare_emitter_state(globals, consts);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        prepare_emitter_state(globals, consts);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }

    emitter_state_release();
    var first: *CompilerCtx = compiler_ctx_new();
    var second: *CompilerCtx = compiler_ctx_new();
    compiler_ctx_activate(first);
    prepare_emitter_state(globals, consts);
    compiler_ctx_activate(second);
    prepare_emitter_state(globals, consts);
    var switch_before: u64 = heap_profile_live_payload_byte_count();
    for (var j: u64 = 0; j < 16; j++) {
        compiler_ctx_activate(first);
        prepare_emitter_state(globals, consts);
        compiler_ctx_activate(second);
        prepare_emitter_state(globals, consts);
    }
    var switch_after: u64 = heap_profile_live_payload_byte_count();
    if (switch_after > switch_before + 64) { return 2; }
    emitter_state_release();
    compiler_ctx_destroy(first);
    compiler_ctx_destroy(second);
    return 0;
}
