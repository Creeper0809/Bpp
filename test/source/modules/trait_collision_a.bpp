// Module-local trait deliberately shares its source spelling with module B.
trait ModuleTrait234 {
    func left(self: *Self, payload: *ModuleTraitPayload234) -> u64;
    func payload_left(self: *Self) -> *ModuleTraitPayload234;
    func default_left(self: *Self) -> u64 {
        var payload: ModuleTraitPayload234;
        payload.n = 3;
        return payload.n;
    }
}

struct ModuleTraitPayload234 {
    public n: u64;
}

struct ModuleTraitShape234 {
    public n: u64;
}

impl ModuleTrait234 for ModuleTraitShape234 {
    public func left(self: *ModuleTraitShape234, payload: *ModuleTraitPayload234) -> u64 {
        return self.n + payload.n;
    }

    public func payload_left(self: *ModuleTraitShape234) -> *ModuleTraitPayload234 {
        return null;
    }
}

func module_trait_a_call234() -> u64 {
    var value: ModuleTraitShape234;
    value.n = 4;
    var payload: ModuleTraitPayload234;
    payload.n = 1;
    if (value.left(&payload) != 5) { return 100; }
    return value.default_left();
}
