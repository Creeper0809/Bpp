// Same trait spelling, intentionally different contract from module A.
trait ModuleTrait234 {
    func right(self: *Self, payload: *ModuleTraitPayload234) -> u64;
    func payload_right(self: *Self) -> *ModuleTraitPayload234;
    func default_right(self: *Self) -> u64 {
        var payload: ModuleTraitPayload234;
        payload.n = 4;
        return payload.n;
    }
}

struct ModuleTraitPayload234 {
    public n: u64;
}

struct ModuleTraitShape234 {
    public n: u64;
}

impl ModuleTrait234 for ModuleTraitShape234 {
    public func right(self: *ModuleTraitShape234, payload: *ModuleTraitPayload234) -> u64 {
        return self.n + payload.n;
    }

    public func payload_right(self: *ModuleTraitShape234) -> *ModuleTraitPayload234 {
        return null;
    }
}

func module_trait_b_call234() -> u64 {
    var value: ModuleTraitShape234;
    value.n = 7;
    var payload: ModuleTraitPayload234;
    payload.n = 2;
    if (value.right(&payload) != 9) { return 100; }
    return value.default_right();
}
