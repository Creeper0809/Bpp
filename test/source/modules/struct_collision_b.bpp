// Module-local type with the same source spelling as struct_collision_a.
struct ModuleShape232 {
    public second: u64;
    public third: u64;
    public first: u64;
}

struct GenericModuleShape233<T> {
    public first: T;
    public second: T;
    public third: T;
}

func module_shape_b_size232() -> u64 {
    return sizeof(ModuleShape232);
}

func module_shape_b_read_first232(value: *ModuleShape232) -> u64 {
    return value.first;
}

func module_shape_b_field232() -> u64 {
    var value: ModuleShape232;
    value.first = 47;
    return module_shape_b_read_first232(&value);
