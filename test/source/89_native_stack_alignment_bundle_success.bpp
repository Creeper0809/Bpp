// Mode: ssa|nossa
// Opt: O0|O1
// Expect exit code: 0

func native_stack_pointer() -> u64 {
    var result: u64 = 0;
    asm {
        mov rax, rsp
        mov [rbp-8], rax
    }
    return result;
}

var deferred_stack_pointer: u64 = 0;

func return_with_deferred_call() -> u64 {
    defer deferred_stack_pointer = native_stack_pointer();
    return 7;
}

func main() -> i64 {
    var baseline: u64 = native_stack_pointer();
    var value: i64 = 0;
    match (99) {
        case 1:
            value = 1;
    }
    var after_unmatched: u64 = native_stack_pointer();
    if ((after_unmatched & 15) != (baseline & 15)) { return 1; }
    match (1) {
        case 1:
            break;
        case 2:
            value = 2;
    }
    var after_break: u64 = native_stack_pointer();
    if ((after_break & 15) != (baseline & 15)) { return 2; }
    for (var i: i64 = 0; i < 1; i = i + 1) {
        match (1) {
            case 1:
                continue;
            case 2:
                value = 3;
        }
    }
    var after_continue: u64 = native_stack_pointer();
    if ((after_continue & 15) != (baseline & 15)) { return 3; }
    if (value != 0) { return 4; }
    if (return_with_deferred_call() != 7) { return 5; }
    var return_baseline: u64 = native_stack_pointer();
    if ((deferred_stack_pointer & 15) != (return_baseline & 15)) { return 6; }
    return 0;
}
