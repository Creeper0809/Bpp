// Covers: SSA auxiliary metadata uses stable context-owned IDs rather than
// embedding process addresses in serializable operands.
// Mode: nossa
// Opt: O0
// Compiler output mode: -dump-ssa-json
// Expect deterministic compiler output: true
// Expect asm contains: helper99
// Compile only: true

func helper99(value: u64) -> u64 {
    return value + 1;
}

func main() -> u64 {
    return helper99(98);
}
