// Binary artifact record validation: exact identity, bounds, corruption and
// allocation-free repeated reads. CLI/dependency tests: test/run_cache_tests.ps1.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import compiler.artifact_cache;
import compiler.runtime_api;
import std.io;
import std.mem;

func main() -> u64 {
    if (compiler_target_parse((u64)"linux-x86_64", str_len("linux-x86_64")) != COMPILER_TARGET_LINUX_X86_64) { return 13; }
    if (compiler_target_parse((u64)"windows-x86_64", str_len("windows-x86_64")) != COMPILER_TARGET_WINDOWS_X86_64) { return 14; }
    var data: u64 = heap_alloc(128);
    var header: *u64 = (*u64)data;
    var identity: [3]u8;
    identity[0] = 107;
    identity[1] = 0;
    identity[2] = 121;
    header[0] = ARTIFACT_CACHE_MAGIC;
    header[1] = ARTIFACT_CACHE_FORMAT;
    header[2] = 3;
    memcopy(data + 24, (u64)&identity, 3);
    memcopy(data + 27, (u64)"ret\n", 4);
    var footer: *u64 = (*u64)(data + 31);
    footer[0] = 4;
    footer[1] = io_content_hash_extend(14695981039346656037, data + 27, 4);
    footer[2] = ARTIFACT_CACHE_END;
    var payload: u64 = 0;
    var payload_len: u64 = 0;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 1) { return 1; }
    if (payload != data + 27 || payload_len != 4) { return 2; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 1) { return 3; }
    }
    if (heap_profile_live_payload_byte_count() != before) { return 4; }
    for (var length: u64 = 0; length < 55; length++) {
        if (artifact_cache_record_matches(data, length, (u64)&identity, 3, &payload, &payload_len) != 0) { return 5; }
    }
    if (artifact_cache_record_matches(data, 56, (u64)&identity, 3, &payload, &payload_len) != 0) { return 6; }
    header[1] = ARTIFACT_CACHE_FORMAT + 1;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 7; }
    header[1] = ARTIFACT_CACHE_FORMAT;
    identity[2] = 122;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 8; }
    identity[2] = 121;
    header[2] = 0 - 1;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 9; }
    header[2] = 3;
    footer[0] = 0 - 1;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 10; }
    footer[0] = 4;
    footer[1] = footer[1] ^ 1;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 11; }
    footer[1] = footer[1] ^ 1;
    ((*u8)data)[27] = 120;
    if (artifact_cache_record_matches(data, 55, (u64)&identity, 3, &payload, &payload_len) != 0) { return 12; }
    heap_free(data);
    return 0;
}
