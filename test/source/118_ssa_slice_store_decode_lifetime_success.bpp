// Legacy slice-store call metadata decoding must use caller-owned scratch.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.datastruct;
import ssa.codegen;
import std.vec;
import std.mem;

func main() -> u64 {
    var args: *Vec<u64> = new Vec<u64>{heap_alloc(8), 0, 1};
    var info: *SSACallInfo = new SSACallInfo{};
    info.name = slice((u64)"target", 6);
    info.args_vec = args;
    info.nargs = 0;
    info.ret_type = 0;
    info.ret_ptr_depth = 0;

    call_slice_store_use_mask((u64)info);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        call_slice_store_use_mask((u64)info);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
