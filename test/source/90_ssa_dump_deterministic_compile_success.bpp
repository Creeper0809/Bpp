// Covers: serialized SSA uses stable symbols/registers instead of process pointers.
// Mode: ssa
// Opt: O0|O1
// Compiler output mode: -dump-ssa-json
// Expect deterministic compiler output: true
// Compile only: true

func stable_callee90(value: u64) -> u64 {
    return value + 1;
}

func main() -> u64 {
    var text: []u8 = "stable";
    var value: u64 = stable_callee90(text.len);
    asm {
        "nop"
    }
    if (value != 7) { return 1; }
    return 0;
}
