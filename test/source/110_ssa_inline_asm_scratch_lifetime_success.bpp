// SSA inline-asm token scratch and function-pointer metadata must be bounded.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import ssa.builder;
import ssa.codegen;
import ssa.core;
import std.io;
import std.vec;

func release_text(text: *Vec<u64>) -> u64 {
    if (text == 0) { return 0; }
    text.release_buffer();
    free((u64)text);
    return 0;
}

func exercise_scratch(builder: *BuilderCtx, text: *Vec<u64>) -> u64 {
    var mask: u64 = asm_text_reg_mask(text);
    if ((mask & SSA_LIVE_RAX) == 0 || (mask & SSA_LIVE_R10) == 0) { return 1; }
    var cloned: *Vec<u64> = ssa_asm_clone_with_current_aliases(text);
    release_text(cloned);
    set_func_ptr(builder, slice("fp", 2), slice("first", 5));
    set_func_ptr(builder, slice("fp", 2), slice("second", 6));
    reset_func(builder);
    return 0;
}

func main() -> u64 {
    compiler_ctx_current();
    var ssa_ctx: *SSAContext = create_context();
    var builder: *BuilderCtx = ctx_new(ssa_ctx);
    reset_func(builder);

    var text: *Vec<u64> = new Vec<u64>{heap_alloc(16 * sizeof(u64)), 0, 16};
    text.push(82);  // R
    text.push(65);  // A
    text.push(88);  // X
    text.push(32);
    text.push(114); // r
    text.push(49);  // 1
    text.push(48);  // 0
    text.push(32);
    text.push(114); // r
    text.push(49);  // 1
    text.push(53);  // 5 (nonvolatile, deliberately not in the live mask)

    if (exercise_scratch(builder, text) != 0) { return 2; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 64; i++) {
        if (exercise_scratch(builder, text) != 0) { return 3; }
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 4; }
    return 0;
}
