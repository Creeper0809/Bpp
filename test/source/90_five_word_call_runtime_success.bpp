// Expect exit code: 0
// Covers: fifth ABI word stays in its fixed stack slot when call alignment needs padding

func sum_five_words(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    return a + b + c + d + e;
}

func main() -> u64 {
    if (sum_five_words(1, 2, 3, 4, 5) != 15) { return 1; }
    return 0;
}
