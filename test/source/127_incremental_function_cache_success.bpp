// Function-fragment incremental cache smoke fixture.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

func incremental_keep_127(x: u64) -> u64 {
    return x + 1;
}

func incremental_change_127(x: u64, y: u64) -> u64 {
    return x + y;
}

func main() -> u64 {
    var value: u64 = incremental_keep_127(4) + incremental_change_127(5, 3);
    if (value != 13) { return 1; }
    return 0;
}
