// Covers: legacy stack reservation follows actual automatic storage instead
// of leaving large locals outside the reserved frame.
// Mode: nossa
// Opt: O0|O1
// Expect exit code: 0

func main() -> u64 {
    var scratch: [4096]u8;
    scratch[0] = 7;
    scratch[4095] = 9;
    if (scratch[0] != 7) { return 1; }
    if (scratch[4095] != 9) { return 2; }
    return 0;
}
