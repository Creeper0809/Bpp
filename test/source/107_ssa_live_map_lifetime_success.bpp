// SSA liveness analysis must release all per-build temporary containers.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import ssa.core;
import ssa.codegen;
import ssa.datastruct;
import ssa.regalloc;
import std.io;
import std.mem;
import std.vec;

func release_probe_map(map: *Vec<u64>) -> u64 {
    if (map == 0) { return 0; }
    map.release_buffer();
    free((u64)map);
    return 0;
}

func spill_probe_args() -> *Vec<u64> {
    var args: *Vec<u64> = new Vec<u64>{heap_alloc(3 * sizeof(u64)), 0, 3};
    args.push(1);
    args.push(2);
    args.push(1);
    return args;
}

func probe_spill_batch() -> u64 {
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice("spill_probe", 11));
    for (var reg: u64 = 1; reg <= 4; reg++) {
        append_inst(fn.entry, create_inst(ctx, SSA_OP_CONST, reg, operand_const(reg), 0));
    }
    var add: *SSAInstruction = create_inst(ctx, SSA_OP_ADD, 5, operand_reg(1), operand_reg(1));
    append_inst(fn.entry, add);
    var indirect: *SSACallPtrInfo = new SSACallPtrInfo{};
    indirect.callee_reg = 3;
    indirect.args_vec = spill_probe_args();
    indirect.nargs = 3;
    var call: *SSAInstruction = ssa_inst_set_aux(create_inst(ctx, SSA_OP_CALL_PTR, 6, 0, operand_reg(7)), SSA_AUX_CALL_PTR, (u64)indirect);
    append_inst(fn.entry, call);
    var direct: *SSACallInfo = new SSACallInfo{};
    direct.name = slice("target", 6);
    direct.args_vec = spill_probe_args();
    direct.nargs = 3;
    append_inst(fn.entry, ssa_inst_set_aux(create_inst(ctx, SSA_OP_CALL, 0, 0, 0), SSA_AUX_CALL, (u64)direct));
    var slice_info: *SSACallSliceStoreInfo = new SSACallSliceStoreInfo{};
    slice_info.is_ptr = 1;
    slice_info.callee_reg = 3;
    slice_info.args_vec = spill_probe_args();
    slice_info.nargs = 3;
    var slice_call: *SSAInstruction = ssa_inst_set_aux(create_inst(ctx, SSA_OP_CALL_SLICE_STORE, 0, 0, operand_reg(4)), SSA_AUX_CALL_SLICE_STORE, (u64)slice_info);
    append_inst(fn.entry, slice_call);
    var legacy: *SSACallInfo = new SSACallInfo{};
    legacy.name = slice("target", 6);
    legacy.args_vec = spill_probe_args();
    legacy.nargs = 3;
    var legacy_call: *SSAInstruction = ssa_inst_set_aux(create_inst(ctx, SSA_OP_CALL_SLICE_STORE, 0, 0, operand_reg(4)), SSA_AUX_CALL_SLICE_STORE, (u64)legacy);
    append_inst(fn.entry, legacy_call);
    var ret: *SSAInstruction = create_inst(ctx, SSA_OP_RET_SLICE_HEAP, 0, operand_reg(6), operand_reg(7));
    ret_slice_heap_set_ex((u64)ret, 8, 6, 7, 1, 1);
    append_inst(fn.entry, ret);

    var arena: BppScratchArena;
    bpp_scratch_arena_init(&arena, 0);
    var colors: *Vec<u64> = vec_new_scratch<u64>(&arena, 8);
    for (var i: u64 = 0; i < 8; i++) { colors.push_scratch(0, &arena); }
    var next_slot: u64 = 200;
    var count: u64 = regalloc_spill_uncolored_batch(ctx, fn, colors, 7, &arena, &next_slot);
    bpp_scratch_arena_reset(&arena);
    if (count != 7 || next_slot != 207) { return 10; }
    if (add.src1 != add.src2 || operand_value(add.src1) <= 7) { return 11; }
    if (call.dest <= 7 || operand_value(call.src2) <= 7 || call.dest == operand_value(call.src2)) { return 12; }
    if (indirect.callee_reg <= 7 || slice_info.callee_reg <= 7) { return 13; }
    if (indirect.args_vec.get(0) != (SSA_CALL_ARG_SLOT_FLAG | 200)) { return 14; }
    if (indirect.args_vec.get(1) != (SSA_CALL_ARG_SLOT_FLAG | 201)) { return 15; }
    if (indirect.args_vec.get(2) != indirect.args_vec.get(0)) { return 16; }
    if (direct.args_vec.get(0) != indirect.args_vec.get(0)) { return 17; }
    if (slice_info.args_vec.get(1) != indirect.args_vec.get(1)) { return 18; }
    if (legacy.args_vec.get(1) != indirect.args_vec.get(1)) { return 19; }
    if (operand_value(slice_call.src2) <= 7 || operand_value(legacy_call.src2) <= 7) { return 20; }
    if (ret.ret_slice_heap_ptr_val != operand_value(ret.src1) || ret.ret_slice_heap_len_val != operand_value(ret.src2)) { return 21; }
    var stores: u64 = 0;
    var inst: *SSAInstruction = fn.entry.inst_head;
    while (inst != 0) {
        for (var r: u64 = 1; r <= 7; r++) {
            if (regalloc_inst_sources_use_reg(inst, r) != 0) { return 22; }
        }
        if (op_of(inst) == SSA_OP_STORE) { stores = stores + 1; }
        else if (inst.dest != 0 && inst.dest <= 7) { return 23; }
        inst = inst.next;
    }
    if (stores != 7) { return 24; }
    if (fn.entry.inst_tail != ret) { return 25; }
    return 0;
}

func probe_frame_layout_epoch() -> u64 {
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice("frame_probe", 11));
    var other: *SSAFunction = create_function(ctx, slice("other_frame", 11));
    var bias: u64 = 4611686018427387904;
    var local: *SSAInstruction = create_inst(ctx, SSA_OP_LEA_LOCAL, SSA_PHYS_R12, operand_const(bias - 24), 0);
    append_inst(fn.entry, local);
    append_inst(fn.entry, create_inst(ctx, SSA_OP_LOAD, SSA_PHYS_RAX, operand_const(3), 0));
    var expected: u64 = compute_frame_size(fn);
    var other_expected: u64 = compute_frame_size(other);
    ssa_frame_layout_begin(fn);
    for (var i: u64 = 0; i < 100; i++) {
        if (compute_local_object_need(fn) != 24 || max_pseudo_var_id(fn) != 3) { return 30; }
        if (ssa_fn_uses_callee_saved(fn) != 1 || compute_frame_size(fn) != expected) { return 31; }
        if (compute_frame_size(other) != other_expected) { return 32; }
    }
    ssa_frame_layout_end();
    if (g_ssa_frame_layout_fn != 0) { return 33; }
    local.src1 = operand_const(bias - 4096);
    if (compute_local_object_need(fn) != 4096 || compute_frame_size(fn) <= expected) { return 34; }
    var changed: u64 = compute_frame_size(fn);
    ssa_frame_layout_begin(fn);
    if (compute_local_object_need(fn) != 4096 || compute_frame_size(fn) != changed) { return 35; }
    ssa_frame_layout_begin(other);
    if (compute_local_object_need(other) != 0 || compute_frame_size(other) != other_expected) { return 36; }
    ssa_frame_layout_end();
    return 0;
}

func main() -> u64 {
    compiler_ctx_current();
    var frame_result: u64 = probe_frame_layout_epoch();
    if (frame_result != 0) { return frame_result; }
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice("probe", 5));
    var inst: *SSAInstruction = create_inst(ctx, SSA_OP_RET, 0, 0, 0);
    append_inst(fn.entry, inst);

    release_probe_map(build_live_map(fn));
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        release_probe_map(build_live_map(fn));
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return probe_spill_batch();
}
