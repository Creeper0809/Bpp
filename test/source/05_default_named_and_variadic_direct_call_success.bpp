func variadic_bundle() -> u64 {
    var code: u64 = 0;
    code = variadic_scalar_bundle();
    if (code != 0) { return code; }
    code = variadic_pointer_bundle();
    if (code != 0) { return code; }
    code = variadic_record_bundle();
    if (code != 0) { return code; }
    code = variadic_generic_bundle();
    if (code != 0) { return code; }
    code = variadic_method_bundle();
    if (code != 0) { return code; }
    code = variadic_order_bundle();
    if (code != 0) { return code; }
    code = variadic_array_bundle();
    if (code != 0) { return code; }
    code = variadic_callable_bundle();
    if (code != 0) { return code; }
    code = variadic_gc_bundle();
    if (code != 0) { return code; }
    return 0;
}

struct VariadicGcNode { public value: u64; }
struct VariadicGcHolder { public item: *VariadicGcNode; }

func variadic_gc_make(value: u64) -> *VariadicGcNode {
    bpp_gc_collect();
    var node: *VariadicGcNode = new VariadicGcNode{value};
    return node;
}

func variadic_gc_make_expression(value: u64) -> *VariadicGcNode {
    bpp_gc_collect();
    return new VariadicGcNode{value};
}

func variadic_gc_sum(...values: *VariadicGcNode) -> u64 {
    bpp_gc_collect();
    var sum: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { sum = sum + values[i].value; }
    return sum;
}

func variadic_gc_holder(value: u64) -> VariadicGcHolder {
    return VariadicGcHolder{variadic_gc_make(value)};
}

func variadic_gc_holders(...values: VariadicGcHolder) -> u64 {
    bpp_gc_collect();
    var sum: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { sum = sum + values[i].item.value; }
    return sum;
}

func variadic_gc_bundle() -> u64 {
    bpp_gc_reset();
    bpp_gc_set_auto(0, 0);
    if (variadic_gc_sum(variadic_gc_make(11), variadic_gc_make(22), variadic_gc_make(33)) != 66) { return 90; }
    if (bpp_gc_root_slot_count() != 0) { return 91; }
    var sum_fn: func (...*VariadicGcNode) -> u64 = variadic_gc_sum;
    if (sum_fn(variadic_gc_make(44), variadic_gc_make(55)) != 99) { return 92; }
    if (bpp_gc_root_slot_count() != 0) { return 93; }
    if (variadic_gc_holders(variadic_gc_holder(66), variadic_gc_holder(77)) != 143) { return 94; }
    if (bpp_gc_root_slot_count() != 0) { return 95; }
    if (variadic_gc_sum(variadic_gc_make_expression(11), variadic_gc_make_expression(22), variadic_gc_make_expression(33)) != 66) { return 97; }
    bpp_gc_collect();
    if (bpp_gc_live_count() != 0) { return 96; }
    if (bpp_gc_root_count() != 0 || bpp_gc_temporary_root_count() != 0) { return 98; }
    bpp_gc_reset();
    return 0;
}

struct PointEx109 {
    public x: u64;
    public y: u64;
}

impl PointEx109 {
    public constructor(x: u64, y: u64 = 5) {
        self.x = x;
        self.y = y;
    }
}

struct CalcEx109 {
}

impl CalcEx109 {
    public static func add(a: u64, b: u64 = 40) -> u64 {
        return a + b;
    }
}

struct NamedArgsBox109 {
    public v: u64;
}

impl NamedArgsBox109 {
    public func set(self: *NamedArgsBox109, a: u64, b: u64 = 10, c: u64 = 1) -> u64 {
        self.v = a + b + c;
        return self.v;
    }
}

func main() -> u64 {
    var a: u64 = add3(1);
    var b: u64 = add3(1, c: 100, b: 10);
    var c: u64 = add3(a: 5, c: 1);

    if (a != 19) { return 10; }
    if (b != 111) { return 11; }
    if (c != 13) { return 12; }

    var v0: u64 = variadic_head_sum(9);
    var v1: u64 = variadic_head_sum(9, 4);
    var v2: u64 = variadic_head_sum(9, 4, 88, 99);

    if (v0 != 9) { return 20; }
    if (v1 != 13) { return 21; }
    if (v2 != 200) { return 22; }
    if (variadic_head_sum(1, 2, 3, 4, 5, 6, 7, 8, 9) != 45) { return 23; }

    var p0: PointEx109 = PointEx109(2);
    var p1: PointEx109 = PointEx109(y: 9, x: 3);
    if (p0.x != 2 || p0.y != 5) { return 30; }
    if (p1.x != 3 || p1.y != 9) { return 31; }

    var sv0: u64 = CalcEx109.add(2);
    var sv1: u64 = CalcEx109.add(b: 39, a: 3);
    if (sv0 != 42) { return 40; }
    if (sv1 != 42) { return 41; }

    var box: NamedArgsBox109 = NamedArgsBox109 { 0 };
    var r0: u64 = box.set(1, 10, 1);
    var r1: u64 = box.set(c: 2, a: 3, b: 4);
    var r2: u64 = box.set(a: 5, c: 6);
    if (r0 != 12) { return 50; }
    if (r1 != 9) { return 51; }
    if (r2 != 21) { return 52; }

    return variadic_bundle();
}
