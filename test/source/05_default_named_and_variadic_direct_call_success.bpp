    if (variadic_trace != 12) { return 106; }
    variadic_trace = 0;
    if (call_order_mixed(CallOrderMixed{(u8)variadic_mark(3)}) != 3) { return 107; }
    if (variadic_trace != 3 || call_order_mixed(CallOrderMixed{}) != 0) { return 108; }
    return 0;
}

func variadic_array_bundle() -> u64 {
    var pair: [2]u64;
    pair[0] = 2;
