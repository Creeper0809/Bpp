// LLVM Build: true

func add3(a: u64, b: u64 = 7, c: u64 = 11) -> u64 {
    return a + b + c;
}

func variadic_head_sum(head: u64, ...rest: u64) -> u64 {
    var total: u64 = head;
    for (var i: u64 = 0; i < rest.len; i++) { total = total + rest[i]; }
    return total;
}

var variadic_trace: u64 = 0;
func variadic_mark(value: u64) -> u64 {
    variadic_trace = variadic_trace * 10 + value;
    return value;
}

func variadic_mark_pointer(value: *u64) -> *u64 {
    variadic_mark(1);
    return value;
}

func variadic_bytes(...values: u8) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i]; }
    return total;
}

func variadic_pointers(...values: *u64) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + *values[i]; }
    return total;
}

func variadic_slices(...values: []u64) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) {
        for (var j: u64 = 0; j < values[i].len; j++) { total = total + values[i][j]; }
    }
    return total;
}

struct VariadicRecord {
    public a: u64;
    public b: u64;
    public c: u64;
}

func variadic_record(a: u64) -> VariadicRecord { return VariadicRecord{a, a + 1, a + 2}; }

func variadic_record_forward(factory: func (u64) -> VariadicRecord, a: u64) -> VariadicRecord {
    return factory(a);
}

struct VariadicNested { public small: VariadicTiny; public large: VariadicRecord; }
func variadic_nested(small: VariadicTiny, large: VariadicRecord) -> VariadicNested {
    return VariadicNested{small, large};
}

func variadic_records(...values: VariadicRecord) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i].a + values[i].b + values[i].c; }
    return total;
}

struct VariadicTiny { public a: u8; public b: u8; public c: u8; }
struct VariadicOdd { public wide: u64; public small: VariadicTiny; }
struct CallOrderMixed { public small: u8; public wide: u64; }
func call_order_mixed(value: CallOrderMixed) -> u64 { return value.small + value.wide; }
func variadic_odd(value: VariadicOdd) -> VariadicOdd { return value; }
func variadic_odds(...values: VariadicOdd) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) {
        total = total + values[i].wide + values[i].small.a + values[i].small.b + values[i].small.c;
    }
    return total;
}
func variadic_tiny(v: u8) -> VariadicTiny { return VariadicTiny{v, v, v}; }
func variadic_tinies(...values: VariadicTiny) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i].a + values[i].b + values[i].c; }
    return total;
}

func variadic_floats(...values: f64) -> f64 {
    var total: f64 = 0.0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i]; }
    return total;
}

func variadic_arrays(...values: [2]u64) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i][0] + values[i][1]; }
    return total;
}

func variadic_functions(...values: func (u64) -> u64) -> u64 {
    var total: u64 = 0;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i](10); }
    return total;
}

func variadic_spill(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, ...values: u64) -> u64 {
    var total: u64 = a + b + c + d + e + f;
    for (var i: u64 = 0; i < values.len; i++) { total = total + values[i]; }
    return total;
}

func variadic_plus_one(x: u64) -> u64 { return x + 1; }

func variadic_wide(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64, j: u64, k: u64, l: u64, m: u64, n: u64, ...tail: u64) -> u64 {
    var sum: u64 = a + b + c + d + e + f + g + h + i + j + k + l + m + n;
    for (var index: u64 = 0; index < tail.len; index++) { sum = sum + tail[index]; }
    return sum;
}

func variadic_last<T>(fallback: T, ...values: T) -> T {
    if (values.len == 0) { return fallback; }
    return values[values.len - 1];
}

func variadic_default<T>(fallback: T = (T)6, ...values: T) -> T {
    if (values.len == 0) { return fallback; }
    return values[values.len - 1];
}

struct VariadicBox { public total: u64; }
impl VariadicBox {
    public constructor(...values: u64) {
        self.total = 0;
        for (var i: u64 = 0; i < values.len; i++) { self.total = self.total + values[i]; }
    }
    public func add(self: *VariadicBox, ...values: u64) -> u64 {
        for (var i: u64 = 0; i < values.len; i++) { self.total = self.total + values[i]; }
        return self.total;
    }
}

func variadic_scalar_bundle() -> u64 {
    if (variadic_bytes() != 0 || variadic_bytes(1, 2, 250) != 253) { return 60; }
    var byte_fn: func (...u8) -> u64 = variadic_bytes;
    if (byte_fn(7, 8, 9) != 24 || byte_fn() != 0) { return 61; }
    if (variadic_floats(1.25, 2.5, 3.75) != 7.5) { return 75; }
    var float_fn: func (...f64) -> f64 = variadic_floats;
    if (float_fn(1.25, 2.5) != 3.75) { return 76; }
    return 0;
}

func variadic_pointer_bundle() -> u64 {
    var a: u64 = 3;
    var b: u64 = 5;
    if (variadic_pointers(&a, &b) != 8) { return 62; }
    var ptr_fn: func (...*u64) -> u64 = variadic_pointers;
    if (ptr_fn(&b, &a, &b) != 13) { return 63; }
    var first: []u64 = slice(&a, 1);
    var second: []u64 = slice(&b, 1);
    if (variadic_slices(first, second) != 8) { return 64; }
    var slice_fn: func (...[]u64) -> u64 = variadic_slices;
    if (slice_fn(second, first, second) != 13) { return 65; }
    return 0;
}

func variadic_record_bundle() -> u64 {
    var record: VariadicRecord = VariadicRecord{1, 2, 3};
    if (variadic_records(record, VariadicRecord{4, 5, 6}, variadic_record(7)) != 45) { return 66; }
    var record_fn: func (...VariadicRecord) -> u64 = variadic_records;
    if (record_fn(record, record) != 12) { return 67; }
    var tiny: VariadicTiny = VariadicTiny{1, 2, 3};
    if (variadic_tinies(tiny, variadic_tiny(4), VariadicTiny{5, 6, 7}) != 36) { return 77; }
    var make_record: func (u64) -> VariadicRecord = variadic_record;
    var made: VariadicRecord = make_record(7);
    if (made.a != 7 || made.b != 8 || made.c != 9) { return 84; }
    if (variadic_records(make_record(7), variadic_record_forward(make_record, 1)) != 30) { return 85; }
    var nested: VariadicNested = variadic_nested(tiny, record);
    if (nested.small.a != 1 || nested.small.b != 2 || nested.small.c != 3) { return 86; }
    if (nested.large.a != 1 || nested.large.b != 2 || nested.large.c != 3) { return 87; }
    var odd: VariadicOdd = VariadicOdd{10, tiny};
    var odd_fn: func (VariadicOdd) -> VariadicOdd = variadic_odd;
    if (variadic_odds(odd, variadic_odd(odd), odd_fn(odd)) != 48) { return 99; }
    return 0;
}

func variadic_generic_bundle() -> u64 {
    var a: u64 = 3;
    var b: u64 = 5;
    if (variadic_last<u64>(a) != 3 || variadic_last<u64>(a, b, a, b) != 5) { return 68; }
    if (variadic_last(a, b, a) != 3) { return 69; }
    if (variadic_default<u64>() != 6 || variadic_default<u64>(8, 9) != 9) { return 88; }
    return 0;
}

func variadic_method_bundle() -> u64 {
    var box: VariadicBox = VariadicBox(1, 2, 3);
    if (box.total != 6 || box.add(4, 5, 6) != 21 || box.add() != 21) { return 70; }
    var heap_box: *VariadicBox = new VariadicBox(1, 2, 3, 4, 5, 6);
    if (heap_box.total != 21 || heap_box.add(7, 8) != 36) { return 89; }
    delete heap_box;
    return 0;
}

func variadic_order_bundle() -> u64 {
    variadic_trace = 0;
    if (variadic_head_sum(variadic_mark(1), variadic_mark(2), variadic_mark(3), variadic_mark(4)) != 10) { return 71; }
    if (variadic_trace != 1234) { return 72; }
