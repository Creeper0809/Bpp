// Covers: a module separator and a literal underscore cannot produce the same linker prefix.
// Mode: ssa|nossa
// Opt: O0|O1
// Expect exit code: 0

import collision_value as nested_value from modules.mangle.a;
import collision_value as underscore_value from modules.mangle_a;

func main() -> u64 {
    if (nested_value() != 11) { return 1; }
    if (underscore_value() != 31) { return 2; }
    return 0;
}
