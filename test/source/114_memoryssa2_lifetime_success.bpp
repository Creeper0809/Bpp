// MemorySSA work graphs and process-global bindings must be pass-local.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.datastruct;
import ssa.memoryssa2;
import std.mem;

func main() -> u64 {
    var empty_block: *SSABlock = new SSABlock{};
    ssa_memoryssa2_rewrite_block(empty_block);
    var block_before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        ssa_memoryssa2_rewrite_block(empty_block);
    }
    var block_after: u64 = heap_profile_live_payload_byte_count();
    if (block_after > block_before + 64) { return 1; }

    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice((u64)"memoryssa2_probe", 16));
    create_block(ctx, fn);
    ssa_memoryssa2_rewrite_context(ctx);
    var ctx_before: u64 = heap_profile_live_payload_byte_count();
    for (var j: u64 = 0; j < 32; j++) {
        ssa_memoryssa2_rewrite_context(ctx);
    }
    var ctx_after: u64 = heap_profile_live_payload_byte_count();
    if (ctx_after > ctx_before + 64) { return 2; }
    ssa_context_release_aux(ctx);
    return 0;
}
