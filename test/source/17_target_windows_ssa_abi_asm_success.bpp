// Compiler args: --target windows-x86_64
// Compile only: true
// LLVM Build: true
// Mode: ssa
// Expect asm contains: abi_probe_ssa:
// Expect asm contains: mov [rbp-40], rcx
// Expect asm contains: mov [rbp-48], rdx
// Expect asm contains: mov [rbp-56], r8
// Expect asm contains: mov [rbp-64], r9
// Expect asm contains: mov rax, [rsp+8]
// Expect asm contains: mov [rsp], rax
// Expect asm contains: sub rsp, 32
// Expect asm contains: [rbp+48]
// Expect asm contains: add rsp, 48

func abi_probe_ssa(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var x: u64 = a + b;
    var y: u64 = c + d + e;
    return x + y;
}

func main() -> u64 {
    return abi_probe_ssa(1, 2, 3, 4, 5);
}
