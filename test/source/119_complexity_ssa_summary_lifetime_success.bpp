// SSA complexity summaries must release their per-run loop-header flags.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler.annotations;
import ssa.core;
import ssa.datastruct;
import std.mem;
import std.str;
import ast;

func main() -> u64 {
    var declaration: *AstFunc = new AstFunc{};
    if (str_eq(slice(annotation_complexity_status_name(declaration, ANN_COMPLEXITY_CONF_PROVEN), 16), slice("declaration-only", 16)) == 0) { return 2; }
    declaration.body = (*AstNode)ast_return(ast_literal(1));
    if (str_eq(slice(annotation_complexity_status_name(declaration, ANN_COMPLEXITY_CONF_PROVEN), 7), slice("checked", 7)) == 0) { return 3; }
    if (str_eq(slice(annotation_complexity_status_name(declaration, ANN_COMPLEXITY_CONF_HEURISTIC), 8), slice("unproven", 8)) == 0) { return 4; }
    if (str_eq(slice(annotation_complexity_status_name(declaration, ANN_COMPLEXITY_CONF_UNKNOWN), 8), slice("unproven", 8)) == 0) { return 5; }
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice((u64)"complexity_probe", 16));
    var empty_summary: *AnnComplexitySSASummary = annotation_complexity_ssa_build_summary(fn);
    if (empty_summary.conf != ANN_COMPLEXITY_CONF_UNKNOWN || empty_summary.space_conf != ANN_COMPLEXITY_CONF_UNKNOWN) { return 6; }
    free((u64)empty_summary);
    // Exercise the non-empty summary path too: the empty-function status check
    // above must not bypass the loop-header allocation lifetime regression.
    var body: *SSABlock = create_block(ctx, fn);
    append_inst(body, create_inst(ctx, SSA_OP_RET, 0, 0, 0));

    var warm: *AnnComplexitySSASummary = annotation_complexity_ssa_build_summary(fn);
    free((u64)warm);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        var summary: *AnnComplexitySSASummary = annotation_complexity_ssa_build_summary(fn);
        free((u64)summary);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    ssa_context_release_aux(ctx);
    if (after > before + 64) { return 1; }
    return 0;
}
