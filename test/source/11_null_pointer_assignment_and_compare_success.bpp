// LLVM Build: true
import std.option;

struct NullPtrBox {
    public value: u64;
}

func null_guard_ptr(p: *NullPtrBox) -> u64 {
    if (p == null) { return 42; }
    return p.value;
}

struct SafeLarge { public a: u64; public b: u64; public c: u64; }
struct SafeContainer {
    public value: u64;
    public next: *SafeContainer;
    public large: SafeLarge;
    public values: []u64;
    public callback: func (u64) -> u64;
    private secret: u64;
}
impl SafeContainer {
    public func add(self: *SafeContainer, delta: u64) -> u64 { return self.value + delta; }
    public func record(self: *SafeContainer) -> SafeLarge { return self.large; }
    public func sequence(self: *SafeContainer) -> []u64 { return self.values; }
    public func touch(self: *SafeContainer, delta: u64) { self.value = self.value + delta; }
    public func private_read(self: *SafeContainer) -> Option<u64> {
        self.$secret = 42;
        return self.?secret;
    }
}
var safe_receiver_count: u64 = 0;
func safe_receiver(value: *SafeContainer) -> *SafeContainer {
    safe_receiver_count = safe_receiver_count + 1;
    return value;
}
func safe_increment(value: *u64) -> u64 { *value = *value + 1; return *value; }
func safe_identity(value: u64) -> u64 { return value; }
func safe_keep<T>(value: T) -> T { return value; }
func safe_generic_index<T>(value: *T) -> Option<T> { return value?[0]; }

func safe_option_bundle() -> u64 {
    var numbers: [2]u64;
    numbers[0] = 0;
    numbers[1] = 42;
    var box: SafeContainer = SafeContainer{0, null, SafeLarge{10, 20, 30}, slice(&numbers[0], 2), safe_identity};
    var live: *SafeContainer = &box;
    var absent: *SafeContainer = null;
    var zero: Option<u64> = safe_receiver(live).?value;
    var missing: Option<u64> = safe_receiver(absent).?value;
    if (safe_receiver_count != 2 || zero.is_some == 0 || zero.value != 0 || missing.is_some != 0) { return 30; }
    var null_payload: Option<*SafeContainer> = live.?next;
    if (null_payload.is_some == 0 || null_payload.value != null) { return 31; }
    var chained: Option<u64> = live.?next.?value;
    if (chained.is_some != 0) { return 32; }
    var inferred = live.?value;
    if (inferred.is_some == 0 || inferred.value != 0) { return 45; }
    var delta: u64 = 4;
    var skipped: Option<u64> = absent.?add(safe_increment(&delta));
    if (delta != 4 || skipped.is_some != 0) { return 33; }
    var evaluated: Option<u64> = live.?add(safe_increment(&delta));
    if (delta != 5 || evaluated.is_some == 0 || evaluated.value != 5) { return 34; }
    var local_callback: func (u64) -> u64 = safe_identity;
    var callback_argument: Option<u64> = live.?add(local_callback(delta));
    if (callback_argument.is_some == 0 || callback_argument.value != 5) { return 35; }
    var big_field: Option<SafeLarge> = live.?large;
    var big_call: Option<SafeLarge> = live.?record();
    if (big_field.is_some == 0 || big_field.value.c != 30 || big_call.is_some == 0 || big_call.value.b != 20) { return 36; }
    var seq_field: Option<[]u64> = live.?values;
    var seq_call: Option<[]u64> = live.?sequence();
    if (seq_field.is_some == 0 || seq_field.value.len != 2 || seq_call.is_some == 0 || seq_call.value[1] != 42) { return 37; }
    var callable: Option<func (u64) -> u64> = live.?callback;
    if (callable.is_some == 0 || callable.value(42) != 42) { return 38; }
    absent.?touch(safe_increment(&delta));
    if (delta != 5 || box.value != 0) { return 39; }
    live.?touch(safe_increment(&delta));
    if (delta != 6 || box.value != 6) { return 40; }
    var pointer: *u64 = &numbers[0];
    var no_pointer: *u64 = null;
    var index: u64 = 0;
    var no_index: Option<u64> = no_pointer?[safe_increment(&index)];
    if (no_index.is_some != 0 || index != 0) { return 41; }
    var at_index: Option<u64> = pointer?[safe_increment(&index)];
    if (at_index.is_some == 0 || at_index.value != 42 || index != 1) { return 42; }
    var generic_value: Option<u64> = safe_keep(safe_generic_index(pointer));
    if (generic_value.is_some == 0 || generic_value.value != 0) { return 43; }
    var private_value: Option<u64> = live.private_read();
    if (private_value.is_some == 0 || private_value.value != 42) { return 44; }
    return 0;
}

func main() -> u64 {
    var src: [3]u64;
    src[0] = 10;
    src[1] = 20;
    src[2] = 30;
    var dst: [3]u64 = src;
    if (dst[0] != 10 || dst[1] != 20 || dst[2] != 30) { return 1; }
    src[1] = 99;
    if (dst[1] != 20) { return 2; }

    var p: *NullPtrBox = null;
    if (p != null) { return 10; }
    if (null_guard_ptr(p) != 42) { return 11; }

    var q: *NullPtrBox = new NullPtrBox { 42 };
    if (q == null) { return 12; }
    if (null_guard_ptr(q) != 42) { return 13; }

    var arr: [3]u64;
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    var live_ptr: *u64 = &arr[0];
    var null_ptr: *u64 = null;
    var live_value: Option<u64> = live_ptr?[1];
    var null_value: Option<u64> = null_ptr?[2];
    if (live_value.is_some == 0 || live_value.value != 20) { return 20; }
    if (null_value.is_some != 0) { return 21; }
    return safe_option_bundle();
}
