// Loop analysis must release its temporary graph storage after each run.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.loop3;
import std.mem;

func main() -> u64 {
    var ctx: *SSAContext = create_context();
    var fn: *SSAFunction = create_function(ctx, slice((u64)"loop3_probe", 11));
    var header: *SSABlock = create_block(ctx, fn);
    var latch: *SSABlock = create_block(ctx, fn);
    connect_blocks(fn.entry, header);
    connect_blocks(header, latch);
    connect_blocks(latch, header);

    var warm: *SSALoop3Summary = ssa_loop3_analyze_function(fn);
    free((u64)warm);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 32; i++) {
        var summary: *SSALoop3Summary = ssa_loop3_analyze_function(fn);
        free((u64)summary);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    ssa_context_release_aux(ctx);
    if (after > before + 64) { return 1; }
    return 0;
}
