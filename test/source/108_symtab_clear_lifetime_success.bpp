// Clearing a symbol table must release its table-owned entry objects.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import emitter.symtab;
import std.io;
import types;

func fill_and_clear(table: *Symtab) -> u64 {
    for (var i: u64 = 0; i < 32; i++) {
        symtab_add(table, slice("entry", 5), TYPE_U64, 0, 8);
    }
    symtab_clear(table);
    return 0;
}

func main() -> u64 {
    compiler_ctx_current();
    var table: *Symtab = symtab_new();
    fill_and_clear(table);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var round: u64 = 0; round < 32; round++) {
        fill_and_clear(table);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
