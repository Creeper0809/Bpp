// Covers: backend selection is independent of the earlier `-dump-ssa` mode
// flag inserted by the test runner.
// Mode: ssa|nossa
// Opt: O0|O1
// Compiler args: --backend legacy
// Expect exit code: 0
// Expect asm contains: .Lbpp_frame_size equ 0
// Expect asm contains: .Lbpp_frame_size equ 2048

@[hot]
func legacy_only_helper89() -> u64 {
    return 89;
}

func legacy_inline_scratch89() -> u64 {
    var value: u64 = 0;
    asm {
        mov qword [rbp-1024], 89
        mov rax, [rbp-1024]
        mov [rbp-8], rax
    }
    return value;
}

func main() -> u64 {
    if (legacy_only_helper89() != 89) { return 1; }
    if (legacy_inline_scratch89() != 89) { return 2; }
    return 0;
}
