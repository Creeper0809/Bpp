// Generated symbol-table names must be released on clear and final teardown.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import emitter.gen.expr;
import emitter.symtab;
import std.mem;

func main() -> u64 {
    compiler_ctx_current();
    var table: *Symtab = symtab_new();
    emit_alloc_tmp_struct(table, 16);
    symtab_clear(table);
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        emit_alloc_tmp_struct(table, 16);
        symtab_clear(table);
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    symtab_release(table);
    if (after > before + 64) { return 1; }
    return 0;
}
