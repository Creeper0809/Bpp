// SSA return-slice side metadata must be released, not merely forgotten.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import ssa.core;
import ssa.datastruct;
import std.io;
import llvm.lower_ssa;

func main() -> u64 {
    ret_slice_heap_clear();
    var first: *SSAInstruction = new SSAInstruction{};
    var second: *SSAInstruction = new SSAInstruction{};
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 64; i++) {
        ret_slice_heap_set((u64)first, 8);
        ret_slice_heap_set_ex((u64)first, 8, i + 2, i + 3, 1, 1);
    }
    var populated: u64 = heap_profile_live_payload_byte_count();
    if (populated > before + 64) { return 1; }
    if (ret_slice_heap_get((u64)first) != 8) { return 2; }
    var first_info: SSARetSliceHeapQueryEx = ret_slice_heap_get_ex((u64)first);
    if (first_info.found == 0 || first_info.ptr_val != 65 || first_info.len_val != 66) { return 3; }

    ret_slice_heap_set_ex((u64)second, 16, 91, 92, 1, 1);
    ret_slice_heap_clear();
    var second_info: SSARetSliceHeapQueryEx = ret_slice_heap_get_ex((u64)second);
    if (second_info.found == 0 || second_info.elem_size != 16) { return 4; }
    first_info = ret_slice_heap_get_ex((u64)first);
    if (first_info.found == 0 || first_info.elem_size != 8) { return 5; }
    var ctx: *SSAContext = create_context();
    var info: *SSACallInfo = new SSACallInfo{};
    var rewritten: *SSAInstruction = ssa_inst_set_aux(create_inst(ctx, SSA_OP_CALL, 1, 0, 0), SSA_AUX_CALL, (u64)info);
    set_op(rewritten, SSA_OP_CALL);
    if (ssa_inst_aux_ptr(rewritten) != (u64)info) { return 6; }
    set_op(rewritten, SSA_OP_CONST);
    rewritten.src1 = operand_const(7);
    if (rewritten.aux_kind != SSA_AUX_NONE || rewritten.aux_id != 0 || ssa_inst_aux_ptr(rewritten) != 0) { return 7; }
    var sketch: *LLVMSSAInstSketch = llvm_ssa_inst_to_sketch(rewritten);
    if (sketch.src1_is_const != 1 || sketch.src1_value != 7 || sketch.aux_kind != SSA_AUX_NONE) { return 8; }
    if (ctx.aux_table.values.len() != 1 || ctx.aux_table.values.get(0) != (u64)info) { return 9; }
    ssa_context_release_aux(ctx);
    return 0;
}
