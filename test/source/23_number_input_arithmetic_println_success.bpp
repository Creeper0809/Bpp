// LLVM Build: true
// Covers: println(number arithmetic expression) uses Number.to_str instead of raw tagged bits
// Stdin: 12\n
// Expect exit code: 0
// Expect stdout: 14\n17\n-12\n15\n16\n17\n12\n

func main() -> u64 {
    var i: number = input<number>();
    println(i + 2);
    println((i + 2) + 3);
    println(-i);
    // Reachability must retain the same overload chosen by the backend for
    // literal, explicitly typed, nested, and unary expression receivers.
    var signed_rhs: i64 = 3;
    var unsigned_rhs: u64 = 4;
    println(i + signed_rhs);
    println(i + unsigned_rhs);
    println((2 + i) + 3);
    println(-(-i));
    return 0;
}
