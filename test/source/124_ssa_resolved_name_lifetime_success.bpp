// SSA symbol-name resolution must return borrowed coordinates without heap scratch.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import ssa.builder;
import std.mem;

func resolve_once() -> u64 {
    var name: PtrLen = resolve_symbol_name(slice((u64)"unresolved_probe_name", 21));
    return name.len;
}

func main() -> u64 {
    compiler_ctx_current();
    if (resolve_once() != 21) { return 2; }
    var before: u64 = heap_profile_live_payload_byte_count();
    for (var i: u64 = 0; i < 128; i++) {
        if (resolve_once() != 21) { return 2; }
    }
    var after: u64 = heap_profile_live_payload_byte_count();
    if (after > before + 64) { return 1; }
    return 0;
}
