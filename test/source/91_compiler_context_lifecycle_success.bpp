// Covers: repeated in-process compiler sessions release owned state and advance
// a stable generation instead of retaining a misleading global snapshot.
// Mode: nossa
// Opt: O0
// Expect exit code: 0

import compiler;
import compiler.runtime_api;

func main() -> u64 {
    compiler_ctx_reset_state();
    var first: u64 = compiler_ctx_generation();
    if (first == 0) { return 1; }
    if (compiler_ctx_is_active(compiler_ctx_current()) == 0) { return 2; }

    compiler_ctx_reset_state();
    if (compiler_ctx_generation() != first + 1) { return 3; }

    compiler_ctx_release_state(compiler_ctx_current());
    if (compiler_ctx_is_active(compiler_ctx_current()) != 0) { return 4; }

    compiler_ctx_reset_state();
    if (compiler_ctx_generation() != first + 2) { return 5; }

    var default_ctx: *CompilerCtx = compiler_ctx_current();
    var session_a: *CompilerCtx = compiler_ctx_new();
    var session_b: *CompilerCtx = compiler_ctx_new();
    if (compiler_ctx_current() != default_ctx) { return 6; }

    compiler_ctx_activate(session_a);
    var session_a_generation: u64 = compiler_ctx_generation();
    compiler_ctx_reset_state();
    if (compiler_ctx_generation() != session_a_generation + 1) { return 7; }
    compiler_target_set_with_ctx(session_a, COMPILER_TARGET_WINDOWS_X86_64);

    compiler_ctx_activate(session_b);
    if (compiler_ctx_generation() != 1) { return 8; }
    if (compiler_target_with_ctx(session_b) == COMPILER_TARGET_WINDOWS_X86_64) { return 9; }

    compiler_ctx_activate(session_a);
    if (compiler_target_with_ctx(session_a) != COMPILER_TARGET_WINDOWS_X86_64) { return 10; }
    compiler_ctx_activate(default_ctx);
    if (compiler_ctx_destroy(session_a) == 0) { return 11; }
    if (compiler_ctx_destroy(session_b) == 0) { return 12; }
    return 0;
}
