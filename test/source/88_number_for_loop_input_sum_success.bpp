// Covers: typed input() inference with number for-loop compare/update and compound assignment
// Stdin: 10\n
// Expect exit code: 0
// Expect stdout: 55\n
// LLVM Build: true

import std.io;

func main() -> u64 {
    var a: number = input();
    var sum: number = 0;
    for (var i: number = 0; i <= a; i++) {
        sum += i;
    }
    println(sum);
    return 0;
}
