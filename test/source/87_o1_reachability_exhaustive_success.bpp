// Covers: calls nested in AST forms that O1 reachability used to skip.
// Mode: ssa|nossa
// Opt: O1

//=== CASE 208_call_only_in_ternary
func ternary_reachable208() -> u64 { return 41; }

func main() -> u64 {
    var result: u64 = (1 == 1) ? ternary_reachable208() : 0;
    if (result != 41) { return 1; }
    return 0;
}
//=== END

//=== CASE 209_calls_only_in_do_while
func body_reachable209() -> u64 { return 7; }
func cond_reachable209(value: u64) -> u64 { return 0; }

func main() -> u64 {
    var value: u64 = 0;
    do {
        value = body_reachable209();
    } while (cond_reachable209(value) != 0);
    if (value != 7) { return 1; }
    return 0;
}
//=== END

//=== CASE 210_calls_only_in_slice_operands
func ptr_reachable210() -> *u8 { return 0; }
func len_reachable210() -> u64 { return 0; }

func main() -> u64 {
    var empty: []u8 = slice(ptr_reachable210(), len_reachable210());
    if (empty.len != 0) { return 1; }
    return 0;
}
//=== END
