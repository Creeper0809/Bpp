// Compile only: true
// LLVM Build: true
// Mode: nossa
// Expect asm contains: __n15__utarget__uwindows__ucall__ushadow__uasm__usuccess__use_five:
// Expect asm contains: call __n15__utarget__uwindows__ucall__ushadow__uasm__usuccess__use_five
// Expect asm contains: mov r11, [rsp+8]
// Expect asm contains: mov [rsp], r11
// Expect asm contains: sub rsp, 32
// Expect asm contains: mov rax, [rbp+48]
// Expect asm contains: add rsp, 48

func use_five(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    return a + b + c + d + e;
}

func main() -> u64 {
    return use_five(1, 2, 3, 4, 5);
}
