//=== CASE struct_return_requires_struct_value
// Expect compile fail: 1
// Expect error contains: return type mismatch

struct ReturnTypeFail {
    public x: u64;
}

func bad_return() -> ReturnTypeFail {
    return 1;
}

func main() -> u64 {
    var v: ReturnTypeFail = bad_return();
    return v.x;
}
//=== END

//=== CASE zero_does_not_manufacture_struct
// Expect compile fail: 1
// Expect error contains: return type mismatch
struct Record { public value: u64; }
func invalid() -> Record { return 0; }
func main() -> u64 { var value: Record = invalid(); return value.value; }
//=== END

//=== CASE bare_return_requires_void
// Expect compile fail: 1
// Expect error contains: return type mismatch
func invalid() -> u64 { return; }
func main() -> u64 { return invalid(); }
//=== END

//=== CASE lambda_semicolon_discards_tail_value
// Expect compile fail: 1
// Expect error contains: lambda block must end with expression or return statement
func main() -> u64 {
    var invalid: func () -> u64 = func () -> u64 { 42; };
    return invalid();
}
//=== END

//=== CASE lambda_bare_return_has_no_value
// Expect compile fail: 1
// Expect error contains: value-returning lambda requires a return value
func main() -> u64 {
    var invalid: func () -> u64 = func () -> u64 { return; };
    return invalid();
}
//=== END

//=== CASE lambda_empty_block_has_no_value
// Expect compile fail: 1
// Expect error contains: lambda body expression is required
func main() -> u64 {
    var invalid: func () -> u64 = func () -> u64 {};
    return invalid();
}
//=== END
