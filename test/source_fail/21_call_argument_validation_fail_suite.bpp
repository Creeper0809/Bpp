// Covers: call argument validation and variadic parameter declaration diagnostics

//=== CASE inferred_callable_preserves_signature
// Expect compile fail: 1
// Expect error contains: initializer type mismatch
func keep<T>(callback: func (T) -> T) -> func (T) -> T { return callback; }
func boolean_identity(value: bool) -> bool { return value; }
func main() -> u64 {
    var invalid: func (u64) -> u64 = keep(boolean_identity);
    return invalid(1);
}
//=== END

//=== CASE generic_callback_result_preserves_type
// Expect compile fail: 1
// Expect error contains: initializer type mismatch
func keep<T>(value: T) -> T { return value; }
func boolean_identity(value: bool) -> bool { return value; }
func main() -> u64 {
    var callback: func (bool) -> bool = boolean_identity;
    var invalid: u64 = keep(callback(true));
    return invalid;
}
//=== END

//=== CASE variadic_direct_checks_every_element
// Expect compile fail: 1
// Expect error contains: variadic argument type mismatch
func checked_tail(...values: u64) -> u64 { return values.len; }
func main() -> u64 { return checked_tail(1, 2, true); }
//=== END

//=== CASE variadic_pointer_depth_is_preserved
// Expect compile fail: 1
// Expect error contains: variadic argument type mismatch
func pointer_tail(...values: *u64) -> u64 { return values.len; }
func main() -> u64 { var x: u64 = 7; return pointer_tail(&x, x); }
//=== END

//=== CASE variadic_function_stride_must_match
// Expect compile fail: 1
// Expect error contains: initializer type mismatch
func byte_tail(...values: u8) -> u64 { return values.len; }
func main() -> u64 { var f: func (...u64) -> u64 = byte_tail; return f(7); }
//=== END

//=== CASE indirect_slice_return_checks_arguments
// Expect compile fail: 1
// Expect error contains: function pointer call argument type mismatch
func get_slice(value: *u64) -> []u64 { return slice(value, 1); }
func main() -> u64 {
    var f: func (*u64) -> []u64 = get_slice;
    var result: []u64 = f(8);
    return result.len;
}
//=== END

//=== CASE indirect_large_return_checks_arguments
// Expect compile fail: 1
// Expect error contains: function pointer call argument type mismatch
struct CallLarge { public a: u64; public b: u64; public c: u64; }
func get_large(value: *u64) -> CallLarge { return CallLarge{*value, 2, 3}; }
func main() -> u64 {
    var f: func (*u64) -> CallLarge = get_large;
    var result: CallLarge = f(8);
    return result.a;
}
//=== END

//=== CASE variadic_void_element_rejected
// Expect compile fail: 1
// Expect error contains: unknown declared type
func invalid_tail(...values: void) -> u64 { return values.len; }
func main() -> u64 { return invalid_tail(); }
//=== END

//=== CASE callable_slice_return_stride_mismatch
// Expect compile fail: 1
// Expect error contains: type mismatch
func bytes() -> []u8 { var empty: []u8 = slice(0, 0); return empty; }
func main() -> u64 {
    var invalid: func () -> []u64 = bytes;
    return invalid().len;
}
//=== END

//=== CASE function_return_preserves_slice_element
// Expect compile fail: 1
// Expect error contains: return type mismatch
func wrong() -> []u64 { var empty: []u8 = slice(0, 0); return empty; }
func main() -> u64 { var result: []u64 = wrong(); return result.len; }
//=== END

//=== CASE function_return_preserves_nested_callback
// Expect compile fail: 1
// Expect error contains: return type mismatch
func boolean_callback(value: bool) -> u64 { if (value) { return 1; } return 0; }
func wrong() -> func (u64) -> u64 { return boolean_callback; }
func main() -> u64 { var result: func (u64) -> u64 = wrong(); return result(1); }
//=== END

//=== CASE variadic_void_signature_rejected
// Expect compile fail: 1
// Expect error contains: unknown declared type
func main() -> u64 { var invalid_fn: func (...void) -> u64; return 0; }
//=== END

//=== CASE decorator_next_requires_exact_callable
// Expect compile fail: 1
// Expect error contains: decorator first parameter must match the target function type
func invalid_decorator(next: func (bool) -> u64, value: u64) -> u64 { return 1; }
@[invalid_decorator]
func target(value: u64) -> u64 { return value; }
func main() -> u64 { return target(1); }
//=== END

//=== CASE decorator_raw_next_is_not_a_contract
// Expect compile fail: 1
// Expect error contains: decorator first parameter must match the target function type
func invalid_decorator(next: u64, value: u64) -> u64 { return next(value); }
@[invalid_decorator]
func target(value: u64) -> u64 { return value; }
func main() -> u64 { return target(1); }
//=== END

//=== CASE trait_slice_return_element_mismatch
// Expect compile fail: 1
// Expect error contains: Trait impl return type mismatch
trait Reader { func read(self: *Self) -> []u64; }
struct Buffer { public byte: u8; }
impl Reader for Buffer {
    public func read(self: *Buffer) -> []u8 { return slice(&self.byte, 1); }
}
func main() -> u64 { var buffer: Buffer = Buffer{1}; return buffer.read().len; }
//=== END

//=== CASE integer_handle_cannot_implicitly_gain_signature
// Expect compile fail: 1
// Expect error contains: type mismatch
func value(x: u64) -> u64 { return x; }
func main() -> u64 {
    var raw: u64 = (u64)value;
    var invalid: func (u64) -> u64 = raw;
    return invalid(1);
}
//=== END

//=== CASE captured_lambda_signature_mismatch
// Expect compile fail: 1
// Expect error contains: type mismatch
func main() -> u64 {
    var base: u64 = 5;
    var invalid: func (bool) -> u64 = func [base] (value: u64) -> u64 { value + base };
    return invalid(true);
}
//=== END

//=== CASE 116_unknown_named_argument_on_free_function_fail
// Expect compile fail: 1
// Expect error contains: unknown named argument

func addx_case116(a: u64, b: u64 = 1) -> u64 {
    return a + b;
}

func main() -> u64 {
    return addx_case116(a: 1, c: 2);
}
//=== END

//=== CASE 123_unknown_named_argument_on_instance_method_fail
// Expect compile fail: 1
// Expect error contains: unknown named argument

struct BoxFail123 {
    public v: u64;
}

impl BoxFail123 {
    public func set(self: *BoxFail123, a: u64, b: u64) -> u64 {
        self.v = a + b;
        return self.v;
    }
}

func main() -> u64 {
    var b: BoxFail123 = BoxFail123 { 0 };
    return b.set(c: 2, a: 1);
}
//=== END

//=== CASE 117_missing_required_argument_fail
// Expect compile fail: 1
// Expect error contains: missing required argument

func must_have_a_case117(a: u64, b: u64 = 9) -> u64 {
    return a + b;
}

func main() -> u64 {
    return must_have_a_case117(b: 1);
}
//=== END

//=== CASE 118_variadic_must_be_last_fail
// Expect compile fail: 1
// Expect error contains: variadic parameter must be the last parameter

func bad_case118(...rest: u64, tail: u64) -> u64 {
    return rest + tail;
}

func main() -> u64 {
    return bad_case118(1, 2);
}
//=== END

//=== CASE 119_variadic_cannot_have_default_fail
// Expect compile fail: 1
// Expect error contains: variadic parameter cannot have default value

func bad_case119(...rest: u64 = 1) -> u64 {
