// Covers: declared types remain invariant across initialization, assignment,
// argument passing, and return values.

//=== CASE safe_result_requires_option
// Expect compile fail: 1
// Expect error contains: initializer type mismatch
struct SafeValue { public value: u64; }
func main() -> u64 {
    var pointer: *SafeValue = null;
    var value: u64 = pointer.?value;
    return value;
}
//=== END

//=== CASE safe_receiver_requires_pointer
// Expect compile fail: 1
// Expect error contains: safe operation requires a pointer receiver
struct SafeValue { public value: u64; }
func main() -> u64 {
    var value: SafeValue = SafeValue{0};
    var invalid: Option<u64> = value.?value;
    return 0;
}
//=== END

//=== CASE safe_access_preserves_visibility
// Expect compile fail: 1
// Expect error contains: private field access denied
struct SafeValue { private secret: u64; }
func main() -> u64 {
    var pointer: *SafeValue = null;
    var invalid: Option<u64> = pointer.?secret;
    return 0;
}
//=== END

//=== CASE 201_same_width_scalar_initializer_fail
// Expect compile fail: 1
// Expect error contains: variable initializer type mismatch

func main() -> u64 {
    var floating: f64 = 1.5;
    var bits: u64 = floating;
    return bits;
}
//=== END

//=== CASE 202_unrelated_pointer_assignment_fail
// Expect compile fail: 1
// Expect error contains: assignment type mismatch

struct LeftType202 {
    public small: u8;
}

struct RightType202 {
    public wide: u64;
}

func main() -> u64 {
    var left: LeftType202;
    var right: RightType202;
    var left_ptr: *LeftType202 = &left;
    var right_ptr: *RightType202 = &right;
    left_ptr = right_ptr;
    return left_ptr.small;
}
//=== END

//=== CASE 203_nominal_struct_initializer_fail
// Expect compile fail: 1
// Expect error contains: variable initializer type mismatch

struct Small203 {
    public value: u64;
}

struct Large203 {
    public first: u64;
    public second: u64;
}

func main() -> u64 {
    var large: Large203 = Large203 { 1, 2 };
    var small: Small203 = large;
    return small.value;
}
//=== END

//=== CASE 204_same_width_call_argument_fail
// Expect compile fail: 1
// Expect error contains: argument type mismatch

func consume_bits204(bits: u64) -> u64 {
    return bits;
}

func main() -> u64 {
    var floating: f64 = 2.5;
    return consume_bits204(floating);
}
//=== END

//=== CASE 205_same_width_scalar_return_fail
// Expect compile fail: 1
// Expect error contains: return type mismatch

func wrong_return205() -> u64 {
    var floating: f64 = 3.5;
    return floating;
}

func main() -> u64 {
    return wrong_return205();
}
//=== END
