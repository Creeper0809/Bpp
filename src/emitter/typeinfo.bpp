// typeinfo.b - Type size/compatibility calculations and struct layout
//
// This module handles type-related calculations:
// - Type size computation (primitives, pointers, structs)
// - Type compatibility checking
// - Struct field offset calculation
// - Expression type inference

import std.io;
import std.vec;
import std.util;
import std.str;
import std.hashmap;
import types;
import ast;
import compiler;
import compiler.try_runtime;
import compiler.core_utils;
import compiler.generic.engine;
import compiler.symbol_runtime;
import emitter.emitter;
import emitter.symtab;

func typeinfo_make(base_type: u64, ptr_depth: u64) -> *TypeInfo {
    return typeinfo_new(base_type, ptr_depth);
}

func typeinfo_func_signature(ti: *TypeInfo) -> *TypeInfo {
    if (ti == 0) { return 0; }
    if (ti.type_kind != TYPE_FUNC) { return 0; }
    if (ti.elem_typeinfo != 0 && ti.elem_typeinfo.type_kind == TYPE_FUNC) {
        return ti.elem_typeinfo;
    }
    return ti;
}

func typeinfo_make_struct(ptr_depth: u64, struct_name: []u8, struct_def: *AstStructDef) -> *TypeInfo {
    var ti: *TypeInfo = typeinfo_make(TYPE_STRUCT, ptr_depth);
    ti.struct_name = struct_name;
    ti.struct_def = struct_def;
    return ti;
}

func typeinfo_make_array(ptr_depth: u64, elem_type_kind: u64, elem_ptr_depth: u64, elem_struct_name: []u8, elem_struct_def: *AstStructDef, array_len: u64) -> *TypeInfo {
    var ti: *TypeInfo = typeinfo_make(TYPE_ARRAY, ptr_depth);
    ti.struct_name = elem_struct_name;
    ti.struct_def = elem_struct_def;
    ti.elem_type_kind = elem_type_kind;
    ti.elem_ptr_depth = elem_ptr_depth;
    ti.array_len = array_len;
    return ti;
}

func typeinfo_make_slice(ptr_depth: u64, elem_type_kind: u64, elem_ptr_depth: u64, elem_struct_name: []u8, elem_struct_def: *AstStructDef) -> *TypeInfo {
    var ti: *TypeInfo = typeinfo_make(TYPE_SLICE, ptr_depth);
    ti.struct_name = elem_struct_name;
    ti.struct_def = elem_struct_def;
    ti.elem_type_kind = elem_type_kind;
    ti.elem_ptr_depth = elem_ptr_depth;
    return ti;
}

func typeinfo_from_var_decl(decl: *AstVarDecl) -> *TypeInfo {
    if (decl == 0) { return 0; }
    var ti: *TypeInfo = typeinfo_make(decl.type_kind, decl.ptr_depth);
    ti.is_tagged = decl.is_tagged;
    ti.struct_name = decl.struct_name;
    ti.tag_layout = decl.tag_layout;
    ti.elem_type_kind = decl.elem_type_kind;
    ti.elem_ptr_depth = decl.elem_ptr_depth;
    ti.array_len = decl.array_len;
    ti.array_len_is_param = decl.array_len_is_param;
    ti.array_len_param = decl.array_len_param;
    ti.elem_typeinfo = decl.elem_typeinfo;
    if (decl.type_kind == TYPE_STRUCT && u8_slice_ptr(decl.struct_name) != 0) {
        ti.struct_def = get_struct_def(decl.struct_name);
    }
    return ti;
}

func typeinfo_from_param(param: *Param) -> *TypeInfo {
    if (param == 0) { return 0; }
    var ti: *TypeInfo = typeinfo_make(param.type_kind, param.ptr_depth);
    ti.is_tagged = param.is_tagged;
    ti.struct_name = param.struct_name;
    ti.tag_layout = param.tag_layout;
    ti.elem_type_kind = param.elem_type_kind;
    ti.elem_ptr_depth = param.elem_ptr_depth;
    ti.array_len = param.array_len;
    ti.array_len_is_param = param.array_len_is_param;
    ti.array_len_param = param.array_len_param;
    ti.elem_typeinfo = param.elem_typeinfo;
    return ti;
}

// Variadic parameters are stored inside the callee as a pointer to their
// contiguous argument pack. Their public call-signature type is the element
// type that appeared after `...`, one pointer level shallower than that ABI
// storage view.
func typeinfo_from_call_param(param: *Param) -> *TypeInfo {
    var ti: *TypeInfo = typeinfo_from_param(param);
    if (ti != 0 && param != 0 && param.is_variadic != 0 && ti.ptr_depth > 0) {
        ti.ptr_depth = ti.ptr_depth - 1;
    }
    return ti;
}

func typeinfo_resolve_struct_defs_recursive(ti: *TypeInfo) -> u64 {
    if (ti == 0) { return 0; }
    if (ti.type_kind == TYPE_STRUCT && ti.struct_def == 0 && u8_slice_ptr(ti.struct_name) != 0) {
        ti.struct_def = get_struct_def(ti.struct_name);
    }
    if (ti.type_kind == TYPE_ARRAY || ti.type_kind == TYPE_SLICE) {
        if (ti.elem_type_kind == TYPE_STRUCT && ti.struct_def == 0 && u8_slice_ptr(ti.struct_name) != 0) {
            ti.struct_def = get_struct_def(ti.struct_name);
        }
        if (ti.elem_typeinfo != 0) {
            typeinfo_resolve_struct_defs_recursive(ti.elem_typeinfo);
        }
    }
    if (ti.type_kind == TYPE_FUNC) {
        var sig: *TypeInfo = typeinfo_func_signature(ti);
        if (sig != 0) {
            if (sig.fn_params_vec != 0) {
                var n: u64 = sig.fn_params_vec.len();
                for (var i: u64 = 0; i < n; i++) {
                    typeinfo_resolve_struct_defs_recursive(sig.fn_params_vec.get(i));
                }
            }
            if (sig.fn_ret_typeinfo != 0) {
                typeinfo_resolve_struct_defs_recursive(sig.fn_ret_typeinfo);
            }
        }
    }
    return 0;
}

func typeinfo_clone(src: *TypeInfo) -> *TypeInfo {
    if (src == 0) { return 0; }
    var ti: *TypeInfo = typeinfo_make(src.type_kind, src.ptr_depth);
    ti.copy_from(src);
    typeinfo_resolve_struct_defs_recursive(ti);
    return ti;
}

func typeinfo_elem_type_from_container(container: *TypeInfo) -> *TypeInfo {
    if (container == 0) { return 0; }
    if (container.elem_typeinfo != 0) {
        return typeinfo_clone(container.elem_typeinfo);
    }
    if (container.elem_type_kind == TYPE_STRUCT) {
        var sdef: *AstStructDef = container.struct_def;
        if (sdef == 0 && u8_slice_ptr(container.struct_name) != 0) {
            sdef = get_struct_def(container.struct_name);
        }
        return typeinfo_make_struct(container.elem_ptr_depth, container.struct_name, sdef);
    }
    var ti: *TypeInfo = typeinfo_make(container.elem_type_kind, container.elem_ptr_depth);
    ti.struct_name = container.struct_name;
    return ti;
}

func typeinfo_elem_size_from_container(container: *TypeInfo) -> u64 {
    var elem_ti: *TypeInfo = typeinfo_elem_type_from_container(container);
    if (elem_ti != 0) {
        return sizeof_type_ex(elem_ti);
    }
    return layout_type_sizeof(container.elem_type_kind, container.elem_ptr_depth, container.struct_name);
}

func typeinfo_make_trait(ptr_depth: u64, trait_slice: []u8) -> *TypeInfo {
    var ti: *TypeInfo = typeinfo_make(TYPE_TRAIT, ptr_depth);
    ti.struct_name = trait_slice;
    return ti;
}

// Global struct definitions (set by codegen before use)
var g_structs_vec: *Vec<*AstStructDef>;
// Global function definitions (set by codegen before use)
var g_funcs_vec: *Vec<*AstFunc>;
var g_funcs_map: *HashMap<u64, *AstFunc>;

struct TypeInfoCtx {
    public structs_vec: *Vec<*AstStructDef>;
    public funcs_vec: *Vec<*AstFunc>;
    public funcs_map: *HashMap<u64, *AstFunc>;
}

impl TypeInfoCtx {
    public constructor() {
        self.structs_vec = 0;
        self.funcs_vec = 0;
        self.funcs_map = 0;
    }
}

var g_typeinfo_ctx: *TypeInfoCtx;

func typeinfo_ctx_current() -> *TypeInfoCtx {
    if (g_typeinfo_ctx == 0) {
        g_typeinfo_ctx = new TypeInfoCtx{};
        g_typeinfo_ctx.structs_vec = g_structs_vec;
        g_typeinfo_ctx.funcs_vec = g_funcs_vec;
        g_typeinfo_ctx.funcs_map = g_funcs_map;
    }
    return g_typeinfo_ctx;
}

func typeinfo_ctx_sync_from_globals() -> u64 {
    var ctx: *TypeInfoCtx = typeinfo_ctx_current();
    ctx.structs_vec = g_structs_vec;
    ctx.funcs_vec = g_funcs_vec;
    ctx.funcs_map = g_funcs_map;
    return 0;
}

func typeinfo_set_structs(structs: *Vec<*AstStructDef>) -> u64 {
    return typeinfo_set_structs_with_ctx(typeinfo_ctx_current(), structs);
}

func typeinfo_set_structs_with_ctx(ctx: *TypeInfoCtx, structs: *Vec<*AstStructDef>) -> u64 {
    if (ctx == 0) { return 0; }
    g_structs_vec = structs;
    ctx.structs_vec = structs;
    return 0;
}

func typeinfo_get_structs() -> *Vec<*AstStructDef> {
    return typeinfo_get_structs_with_ctx(typeinfo_ctx_current());
}

func typeinfo_get_structs_with_ctx(ctx: *TypeInfoCtx) -> *Vec<*AstStructDef> {
    if (ctx == 0) { return g_structs_vec; }
    return ctx.structs_vec;
}

func typeinfo_set_funcs(funcs: *Vec<*AstFunc>) -> u64 {
    return typeinfo_set_funcs_with_ctx(typeinfo_ctx_current(), funcs);
}

func typeinfo_set_funcs_with_ctx(ctx: *TypeInfoCtx, funcs: *Vec<*AstFunc>) -> u64 {
    if (ctx == 0) { return 0; }
    g_funcs_vec = funcs;
    g_funcs_map = 0;
    ctx.funcs_vec = funcs;
    ctx.funcs_map = 0;
    if (funcs != 0) {
        var n: u64 = funcs.len();
        var cap: u64 = n * 2;
        if (cap < 16) { cap = 16; }
        g_funcs_map = new HashMap<u64, *AstFunc>{0, 0, 0};
        g_funcs_map.ensure_capacity(cap);
        for (var i: u64 = 0; i < n; i++) {
            var fn: *AstFunc = funcs.get(i);
            if (g_funcs_map.has(fn.name) == 0) {
                g_funcs_map.put(fn.name, fn);
            }
        }
    }
    ctx.funcs_map = g_funcs_map;
    return 0;
}

func typeinfo_find_func(name: []u8) -> *AstFunc {
    return typeinfo_find_func_with_ctx(typeinfo_ctx_current(), slice(name.ptr, name.len));
}

func typeinfo_find_func_with_ctx(ctx: *TypeInfoCtx, name: []u8) -> *AstFunc {
    if (ctx == 0) { return 0; }
    if (ctx.funcs_vec == 0) { return 0; }
    var resolved_ptr: u64 = name.ptr;
    var resolved_len: u64 = name.len;
    var resolved: *NameInfo = resolve_name(slice(name.ptr, name.len));
    if (resolved != 0) {
        resolved_ptr = resolved.ptr;
        resolved_len = resolved.len;
    }
    if (ctx.funcs_map != 0) {
        var mfn_resolved: *AstFunc = ctx.funcs_map.get(slice(resolved_ptr, resolved_len));
        if (mfn_resolved != 0) { return mfn_resolved; }
        var mfn_raw: *AstFunc = ctx.funcs_map.get(slice(name.ptr, name.len));
        if (mfn_raw != 0) { return mfn_raw; }
    }
    var num_funcs: u64 = ctx.funcs_vec.len();
    for (var i: u64 = 0; i < num_funcs; i++) {
        var fn: *AstFunc = ctx.funcs_vec.get(i);
        if (str_eq(fn.name, slice(resolved_ptr, resolved_len))) {
            return fn;
        }
        if (str_eq(fn.name, slice(name.ptr, name.len))) {
            return fn;
        }
    }
    // The signature view can omit imported bodies. The compiler-wide symbol
    // index is authoritative for calls in the merged program.
    var merged_fn: *AstFunc = sym_get_func(slice(name.ptr, name.len));
    if (merged_fn != 0) { return merged_fn; }
    return 0;
}

func typeinfo_from_func_ret(fn: *AstFunc, disallow_struct_value: u64) -> *TypeInfo {
    if (fn == 0) { return typeinfo_make(TYPE_I64, 0); }
    if (fn.ret_type == TYPE_STRUCT) {
        if (disallow_struct_value != 0 && fn.ret_ptr_depth == 0) {
            return typeinfo_make(TYPE_I64, 0);
        }
        var struct_def: *AstStructDef = get_struct_def(fn.ret_struct_name);
        var rs: *TypeInfo = typeinfo_make_struct(fn.ret_ptr_depth, fn.ret_struct_name, struct_def);
        rs.is_tagged = fn.ret_is_tagged;
        rs.tag_layout = fn.ret_tag_layout;
        return rs;
    }
    if (fn.ret_type == TYPE_SLICE) {
        var rsl: *TypeInfo = typeinfo_make(fn.ret_type, fn.ret_ptr_depth);
        rsl.is_tagged = fn.ret_is_tagged;
        return rsl;
    }
    var rb: *TypeInfo = typeinfo_make(fn.ret_type, fn.ret_ptr_depth);
    rb.is_tagged = fn.ret_is_tagged;
    rb.struct_name = fn.ret_struct_name;
    rb.tag_layout = fn.ret_tag_layout;
    return rb;
}

func typeinfo_from_func_decl(fn: *AstFunc) -> *TypeInfo {
    if (fn == 0) { return typeinfo_make(TYPE_FUNC, 0); }
    var params_sig: *Vec<*TypeInfo> = new Vec<*TypeInfo>{heap_alloc((4) * sizeof(*TypeInfo)), 0, (4)};
    var variadic: u64 = 0;
    if (fn.params_vec != 0) {
        var n: u64 = fn.params_vec.len();
        for (var i: u64 = 0; i < n; i++) {
            var p: *Param = fn.params_vec.get(i);
            var signature_depth: u64 = p.ptr_depth;
            if (p.is_variadic != 0 && signature_depth > 0) {
                signature_depth = signature_depth - 1;
            }
            var pti: *TypeInfo = typeinfo_make(p.type_kind, signature_depth);
            pti.is_tagged = p.is_tagged;
            pti.struct_name = p.struct_name;
            pti.tag_layout = p.tag_layout;
            pti.elem_type_kind = p.elem_type_kind;
            pti.elem_ptr_depth = p.elem_ptr_depth;
            pti.array_len = p.array_len;
            pti.array_len_is_param = p.array_len_is_param;
            pti.array_len_param = p.array_len_param;
            pti.elem_typeinfo = p.elem_typeinfo;
            params_sig.push(pti);
            if (p.is_variadic != 0) { variadic = 1; }
        }
    }

    var ret_sig: *TypeInfo = typeinfo_from_func_ret(fn, 0);
    var fn_ti: *TypeInfo = typeinfo_make(TYPE_FUNC, 0);
    fn_ti.fn_params_vec = params_sig;
    fn_ti.fn_ret_typeinfo = ret_sig;
    fn_ti.fn_is_variadic = variadic;
    var fn_sig: *TypeInfo = typeinfo_make(TYPE_FUNC, 0);
    fn_sig.fn_params_vec = params_sig;
    fn_sig.fn_ret_typeinfo = ret_sig;
    fn_sig.fn_is_variadic = variadic;
    fn_ti.elem_typeinfo = fn_sig;
    return fn_ti;
}

func typeinfo_from_field_desc(field: *FieldDesc, disallow_struct_value: u64) -> *TypeInfo {
    if (field == 0) { return 0; }
    if (field.type_kind == TYPE_FUNC) {
        if (field.elem_typeinfo != 0 && field.elem_typeinfo.type_kind == TYPE_FUNC) {
            var sig_ti: *TypeInfo = typeinfo_clone(field.elem_typeinfo);
            sig_ti.ptr_depth = field.ptr_depth;
            return sig_ti;
        }
        return typeinfo_make(TYPE_FUNC, field.ptr_depth);
    }
    if (field.type_kind == TYPE_STRUCT) {
        if (disallow_struct_value != 0 && field.ptr_depth == 0) { return 0; }
        var field_struct_def: *AstStructDef = 0;
        if (u8_slice_ptr(field.struct_name) != 0) {
            field_struct_def = get_struct_def(field.struct_name);
        }
        var rs: *TypeInfo = typeinfo_make_struct(field.ptr_depth, field.struct_name, field_struct_def);
        rs.is_tagged = field.is_tagged;
        rs.tag_layout = field.tag_layout;
        return rs;
    }
    if (field.type_kind == TYPE_ARRAY) {
        var elem_struct_def: *AstStructDef = 0;
        if (field.elem_type_kind == TYPE_STRUCT && u8_slice_ptr(field.struct_name) != 0) {
            elem_struct_def = get_struct_def(field.struct_name);
        }
        var ti_arr: *TypeInfo = typeinfo_make_array(field.ptr_depth, field.elem_type_kind, field.elem_ptr_depth, field.struct_name, elem_struct_def, field.array_len);
        ti_arr.elem_typeinfo = field.elem_typeinfo;
        return ti_arr;
    }
    if (field.type_kind == TYPE_SLICE) {
        var elem_struct_def2: *AstStructDef = 0;
        if (field.elem_type_kind == TYPE_STRUCT && u8_slice_ptr(field.struct_name) != 0) {
            elem_struct_def2 = get_struct_def(field.struct_name);
        }
        var ti_sl: *TypeInfo = typeinfo_make_slice(field.ptr_depth, field.elem_type_kind, field.elem_ptr_depth, field.struct_name, elem_struct_def2);
        ti_sl.elem_typeinfo = field.elem_typeinfo;
        return ti_sl;
    }
    var rf: *TypeInfo = typeinfo_make(field.type_kind, field.ptr_depth);
    rf.is_tagged = field.is_tagged;
    rf.struct_name = field.struct_name;
    rf.tag_layout = field.tag_layout;
    return rf;
}

// ============================================
// Type Size Helpers
// ============================================

func get_type_size(base_type: u64, ptr_depth: u64) -> u64 {
    if (ptr_depth > 0) { return 8; }
    if (base_type == TYPE_BOOL) { return 1; }
    if (base_type == TYPE_U8) { return 1; }
    if (base_type == TYPE_U16) { return 2; }
    if (base_type == TYPE_U32) { return 4; }
    if (base_type == TYPE_U64) { return 8; }
    if (base_type == TYPE_I8) { return 1; }
    if (base_type == TYPE_I16) { return 2; }
    if (base_type == TYPE_I32) { return 4; }
    if (base_type == TYPE_I64) { return 8; }
    if (base_type == TYPE_F64) { return 8; }
    if (base_type == TYPE_SLICE) { return 16; }
    if (base_type == TYPE_TRAIT) { return 8; }
    if (base_type == TYPE_FUNC) { return 8; }
    return 8;
}

func get_pointee_size(base_type: u64, ptr_depth: u64) -> u64 {
    if (ptr_depth > 1) { return 8; }
    if (ptr_depth == 1) {
        if (base_type == TYPE_BOOL) { return 1; }
        if (base_type == TYPE_U8) { return 1; }
        if (base_type == TYPE_U16) { return 2; }
        if (base_type == TYPE_U32) { return 4; }
        if (base_type == TYPE_U64) { return 8; }
        if (base_type == TYPE_I8) { return 1; }
        if (base_type == TYPE_I16) { return 2; }
        if (base_type == TYPE_I32) { return 4; }
        if (base_type == TYPE_I64) { return 8; }
        if (base_type == TYPE_F64) { return 8; }
        if (base_type == TYPE_SLICE) { return 16; }
        if (base_type == TYPE_TRAIT) { return 8; }
        if (base_type == TYPE_FUNC) { return 8; }
    }
    return 8;
}

func layout_field_sizeof(field: *FieldDesc) -> u64 {
    if (field.bit_width > 0) {
        return (field.bit_width + 7) / 8;
    }
    if (field.type_kind == TYPE_ARRAY) {
        var elem_size: u64 = 0;
        if (field.elem_typeinfo != 0) {
            elem_size = sizeof_type_ex(field.elem_typeinfo);
        } else {
            elem_size = layout_type_sizeof(field.elem_type_kind, field.elem_ptr_depth, field.struct_name);
        }
        return elem_size * field.array_len;
    }
    if (field.type_kind == TYPE_SLICE) { return 16; }
    return layout_type_sizeof(field.type_kind, field.ptr_depth, field.struct_name);
}

func get_field_desc(struct_def: *AstStructDef, field_name: []u8) -> *FieldDesc {
    var field_desc: *FieldDesc = typeinfo_find_field_desc_scoped(struct_def, slice(0, 0), slice(field_name.ptr, field_name.len));
    return field_desc;
}

func check_type_compat(from_base: u64, from_depth: u64, from_tagged: u64, from_layout: []u8, to_base: u64, to_depth: u64, to_tagged: u64, to_layout: []u8) -> u64 {
    if (from_base == TYPE_NULL && from_depth == 0) {
        if (to_base == TYPE_NULL && to_depth == 0) { return false; }
        if (to_depth > 0) { return false; }
        return true;
    }
    if (to_base == TYPE_NULL && to_depth == 0) {
        if (from_base == TYPE_NULL && from_depth == 0) { return false; }
        return true;
    }
    if (from_base == TYPE_FUNC || to_base == TYPE_FUNC) {
        if (from_base == to_base && from_depth == to_depth) { return false; }
        return true;
    }
    if (from_base == TYPE_ARRAY || to_base == TYPE_ARRAY || from_base == TYPE_SLICE || to_base == TYPE_SLICE) {
        if (from_base == to_base && from_depth == to_depth) { return false; }
        return true;
    }
    if (from_base == to_base) {
        if (from_depth == to_depth) {
            if (from_depth > 0 && from_tagged != to_tagged) { return true; }
            if (from_depth > 0 && from_tagged == 1) {
                if (!str_eq(slice(from_layout.ptr, from_layout.len), slice(to_layout.ptr, to_layout.len))) { return true; }
            }
            return false;
        }
    }
    if (from_depth > 0) {
        if (to_depth > 0) { return true; }
    }
    if (from_depth == 0) {
        if (to_depth == 0) {
            var from_size: u64 = get_type_size(from_base, 0);
            var to_size: u64 = get_type_size(to_base, 0);
            if (from_size == to_size) { return false; }
            return true;
        }
    }
    if (from_depth == 0) {
        if (to_depth > 0) { return true; }
    }
    if (from_depth > 0) {
        if (to_depth == 0) { return true; }
    }
    return true;
}

func typeinfo_kind_is_unsigned_integer(kind: u64) -> u64 {
    if (kind == TYPE_U8) { return 1; }
    if (kind == TYPE_U16) { return 1; }
    if (kind == TYPE_U32) { return 1; }
    if (kind == TYPE_U64) { return 1; }
    return 0;
}

func typeinfo_kind_is_signed_integer(kind: u64) -> u64 {
    if (kind == TYPE_I8) { return 1; }
    if (kind == TYPE_I16) { return 1; }
    if (kind == TYPE_I32) { return 1; }
    if (kind == TYPE_I64) { return 1; }
    return 0;
}

func typeinfo_is_number_struct(ti: *TypeInfo) -> u64 {
    if (ti == 0 || ti.ptr_depth != 0 || ti.type_kind != TYPE_STRUCT) { return 0; }
    if (u8_slice_ptr(ti.struct_name) == 0 || u8_slice_len(ti.struct_name) == 0) {
        if (ti.struct_def != 0) {
            ti.struct_name = ti.struct_def.name;
        }
    }
    if (u8_slice_ptr(ti.struct_name) != 0 && u8_slice_len(ti.struct_name) != 0) {
        if (str_eq(ti.struct_name, slice("Number", str_len("Number"))) != 0) { return 1; }
        if (str_eq(ti.struct_name, slice("std_number__Number", str_len("std_number__Number"))) != 0) { return 1; }
    }
    if (ti.struct_def != 0) {
        if (str_eq(ti.struct_def.name, slice("Number", str_len("Number"))) != 0) { return 1; }
        if (str_eq(ti.struct_def.name, slice("std_number__Number", str_len("std_number__Number"))) != 0) { return 1; }
    }
    return 0;
}

func typeinfo_number_storage_size(kind: u64) -> u64 {
    if (kind == TYPE_U8 || kind == TYPE_I8) { return 1; }
    if (kind == TYPE_U16 || kind == TYPE_I16) { return 2; }
    if (kind == TYPE_U32 || kind == TYPE_I32) { return 4; }
    if (kind == TYPE_U64 || kind == TYPE_I64) { return 8; }
    if (kind == TYPE_F64) { return 8; }
    return 0;
}

func typeinfo_number_storage_is_specialized(ti: *TypeInfo) -> u64 {
    if (ti == 0 || ti.number_storage_kind == 0) { return 0; }
    if (typeinfo_is_number_struct(ti) == 0) { return 0; }
    if (typeinfo_number_storage_size(ti.number_storage_kind) == 0) { return 0; }
    return 1;
}

func typeinfo_binary_number_value_op(op: u64) -> u64 {
    if (op == TOKEN_PLUS || op == TOKEN_MINUS || op == TOKEN_STAR || op == TOKEN_SLASH || op == TOKEN_PERCENT) { return 1; }
    if (op == TOKEN_LSHIFT || op == TOKEN_RSHIFT) { return 1; }
    if (op == TOKEN_AMPERSAND || op == TOKEN_PIPE || op == TOKEN_CARET) { return 1; }
    return 0;
}

func typeinfo_kind_integer_width(kind: u64) -> u64 {
    match (kind) {
        case TYPE_U8:
        case TYPE_I8:
            return 8;
        case TYPE_U16:
        case TYPE_I16:
            return 16;
        case TYPE_U32:
        case TYPE_I32:
            return 32;
        case TYPE_U64:
        case TYPE_I64:
            return 64;
    }
    return 0;
}

func typeinfo_can_implicit_integer_widen(src_ti: *TypeInfo, dst_ti: *TypeInfo) -> u64 {
    if (src_ti == 0 || dst_ti == 0) { return 0; }
    if (src_ti.ptr_depth != 0 || dst_ti.ptr_depth != 0) { return 0; }
    var src_width: u64 = typeinfo_kind_integer_width(src_ti.type_kind);
    var dst_width: u64 = typeinfo_kind_integer_width(dst_ti.type_kind);
    if (src_width == 0 || dst_width == 0 || src_width > dst_width) { return 0; }
    if (typeinfo_kind_is_unsigned_integer(src_ti.type_kind) != 0 && typeinfo_kind_is_unsigned_integer(dst_ti.type_kind) != 0) { return 1; }
    if (typeinfo_kind_is_signed_integer(src_ti.type_kind) != 0 && typeinfo_kind_is_signed_integer(dst_ti.type_kind) != 0) { return 1; }
    return 0;
}

func typeinfo_names_equal_resolved(lhs: []u8, rhs: []u8) -> u64 {
    if (str_eq(lhs, rhs) != 0) { return 1; }
    var lhs_resolved: *NameInfo = resolve_name(lhs);
    var rhs_resolved: *NameInfo = resolve_name(rhs);
    var lhs_name: []u8 = lhs;
    var rhs_name: []u8 = rhs;
    if (lhs_resolved != 0) { lhs_name = slice(lhs_resolved.ptr, lhs_resolved.len); }
    if (rhs_resolved != 0) { rhs_name = slice(rhs_resolved.ptr, rhs_resolved.len); }
    return str_eq(lhs_name, rhs_name);
}

func typeinfo_name_has_suffix(name: []u8, suffix: []u8) -> u64 {
    if (name.ptr == 0 || suffix.ptr == 0 || name.len < suffix.len) { return 0; }
    return str_eq(slice(name.ptr + name.len - suffix.len, suffix.len), suffix);
}

func typeinfo_ast_node_pointer_upcast(src_ti: *TypeInfo, dst_ti: *TypeInfo) -> u64 {
    if (src_ti == 0 || dst_ti == 0 || src_ti.ptr_depth == 0 || src_ti.ptr_depth != dst_ti.ptr_depth) { return 0; }
    if (src_ti.type_kind != TYPE_STRUCT || dst_ti.type_kind != TYPE_STRUCT) { return 0; }
    if (typeinfo_name_has_suffix(dst_ti.struct_name, slice("AstNode", 7)) == 0) { return 0; }
    if (typeinfo_name_has_suffix(src_ti.struct_name, slice("AstNode", 7)) != 0) { return 1; }
    var name: []u8 = src_ti.struct_name;
    for (var i: u64 = 0; i + 3 <= name.len; i++) {
        if (name[i] == 65 && name[i + 1] == 115 && name[i + 2] == 116) { return 1; }
    }
    return 0;
}

func typeinfo_equal(lhs: *TypeInfo, rhs: *TypeInfo) -> u64 {
    if (lhs == 0 || rhs == 0) { return 0; }
    if (lhs.type_kind != rhs.type_kind) { return 0; }
    if (lhs.ptr_depth != rhs.ptr_depth) { return 0; }
    if (lhs.is_tagged != rhs.is_tagged) { return 0; }
    if (lhs.is_tagged != 0) {
        if (typeinfo_names_equal_resolved(lhs.tag_layout, rhs.tag_layout) == 0) { return 0; }
    }
    if (lhs.type_kind == TYPE_STRUCT || lhs.type_kind == TYPE_TRAIT || lhs.type_kind == TYPE_GENERIC) {
        if (typeinfo_names_equal_resolved(lhs.struct_name, rhs.struct_name) == 0) { return 0; }
    }
    if (lhs.type_kind == TYPE_ARRAY || lhs.type_kind == TYPE_SLICE) {
        if (lhs.type_kind == TYPE_ARRAY && lhs.array_len != rhs.array_len) { return 0; }
        if (lhs.elem_typeinfo != 0 || rhs.elem_typeinfo != 0) {
            if (lhs.elem_typeinfo == 0 || rhs.elem_typeinfo == 0) { return 0; }
            if (typeinfo_equal(lhs.elem_typeinfo, rhs.elem_typeinfo) == 0) { return 0; }
        } else {
            if (lhs.elem_type_kind != rhs.elem_type_kind) { return 0; }
            if (lhs.elem_ptr_depth != rhs.elem_ptr_depth) { return 0; }
            if (lhs.elem_type_kind == TYPE_STRUCT || lhs.elem_type_kind == TYPE_TRAIT || lhs.elem_type_kind == TYPE_GENERIC) {
                if (typeinfo_names_equal_resolved(lhs.struct_name, rhs.struct_name) == 0) { return 0; }
            }
        }
    }
    if (lhs.type_kind == TYPE_FUNC) {
        var ls: *TypeInfo = typeinfo_func_signature(lhs);
        var rs: *TypeInfo = typeinfo_func_signature(rhs);
        if ((ls == 0) != (rs == 0)) { return 0; }
        if (ls == 0) { return 1; }
        if (ls.fn_is_variadic != rs.fn_is_variadic) { return 0; }
        var ln: u64 = 0;
        var rn: u64 = 0;
        if (ls.fn_params_vec != 0) { ln = ls.fn_params_vec.len(); }
        if (rs.fn_params_vec != 0) { rn = rs.fn_params_vec.len(); }
        if (ln != rn) { return 0; }
        for (var i: u64 = 0; i < ln; i++) {
            if (typeinfo_equal(ls.fn_params_vec.get(i), rs.fn_params_vec.get(i)) == 0) { return 0; }
        }
        if ((ls.fn_ret_typeinfo == 0) != (rs.fn_ret_typeinfo == 0)) { return 0; }
        if (ls.fn_ret_typeinfo != 0 && typeinfo_equal(ls.fn_ret_typeinfo, rs.fn_ret_typeinfo) == 0) { return 0; }
    }
    return 1;
}

func typeinfo_sequence_element_equal(lhs: *TypeInfo, rhs: *TypeInfo) -> u64 {
    if (lhs == 0 || rhs == 0) { return 0; }
    var lhs_kind: u64 = lhs.elem_type_kind;
    var lhs_depth: u64 = lhs.elem_ptr_depth;
    var lhs_name: []u8 = lhs.struct_name;
    if (lhs.elem_typeinfo != 0) {
        lhs_kind = lhs.elem_typeinfo.type_kind;
        lhs_depth = lhs.elem_typeinfo.ptr_depth;
        lhs_name = lhs.elem_typeinfo.struct_name;
    }
    var rhs_kind: u64 = rhs.elem_type_kind;
    var rhs_depth: u64 = rhs.elem_ptr_depth;
    var rhs_name: []u8 = rhs.struct_name;
    if (rhs.elem_typeinfo != 0) {
        rhs_kind = rhs.elem_typeinfo.type_kind;
        rhs_depth = rhs.elem_typeinfo.ptr_depth;
        rhs_name = rhs.elem_typeinfo.struct_name;
    }
    if (lhs_kind != rhs_kind || lhs_depth != rhs_depth) { return 0; }
    if (lhs_kind == TYPE_STRUCT || lhs_kind == TYPE_TRAIT || lhs_kind == TYPE_GENERIC) {
        return typeinfo_names_equal_resolved(lhs_name, rhs_name);
    }
    return 1;
}

// Assignment-style compatibility is nominal for aggregates and exact for
// pointer pointee types. Integer-to-integer conversions retain the language's
// existing machine-integer truncation/sign behavior; float and integer domains
// never become compatible merely because their storage widths match.
// Function types use explicit variance rules.
func typeinfo_is_assignable(src_ti: *TypeInfo, dst_ti: *TypeInfo) -> u64 {
    if (src_ti == 0 || dst_ti == 0) { return 0; }
    if (src_ti.type_kind == TYPE_NULL && src_ti.ptr_depth == 0) {
        if (dst_ti.type_kind == TYPE_NULL && dst_ti.ptr_depth == 0) { return 1; }
        if (dst_ti.ptr_depth > 0) { return 1; }
        return 0;
    }
    if (dst_ti.type_kind == TYPE_NULL && dst_ti.ptr_depth == 0) {
        if (src_ti.type_kind == TYPE_NULL && src_ti.ptr_depth == 0) { return 1; }
        return 0;
    }
    // A generic placeholder that survives into a generated specialization is
    // not a concrete nominal type. Its binding was already validated by the
    // monomorphizer, so only two explicitly named generic placeholders need a
    // name comparison here.
    if (src_ti.type_kind == TYPE_GENERIC || dst_ti.type_kind == TYPE_GENERIC) {
        if (src_ti.type_kind == TYPE_GENERIC && dst_ti.type_kind == TYPE_GENERIC &&
            src_ti.struct_name.ptr != 0 && dst_ti.struct_name.ptr != 0) {
            return typeinfo_names_equal_resolved(src_ti.struct_name, dst_ti.struct_name);
        }
        return 1;
    }
    // Function and closure values are represented as one-word handles by the
    // low-level language surface. Typed func-to-func assignments still take
    // the signature path below.
    if (src_ti.type_kind == TYPE_FUNC && dst_ti.ptr_depth == 0 &&
        (dst_ti.type_kind == TYPE_U64 || dst_ti.type_kind == TYPE_I64)) { return 1; }
    if (dst_ti.type_kind == TYPE_FUNC && src_ti.ptr_depth == 0 &&
        (src_ti.type_kind == TYPE_U64 || src_ti.type_kind == TYPE_I64)) { return 1; }
    if (src_ti.type_kind == TYPE_FUNC || dst_ti.type_kind == TYPE_FUNC) {
        return typeinfo_func_assignable(src_ti, dst_ti);
    }
    // Number is the language's dynamic numeric carrier used at generic
    // boundaries. This conversion is intentional and distinct from allowing
    // unrelated same-sized structs or float/integer bit reinterpretation.
    if (typeinfo_is_number_struct(src_ti) != 0 && dst_ti.ptr_depth == 0 &&
        (typeinfo_kind_integer_width(dst_ti.type_kind) != 0 || dst_ti.type_kind == TYPE_F64)) { return 1; }
    if (typeinfo_is_number_struct(dst_ti) != 0 && src_ti.ptr_depth == 0 &&
        (typeinfo_kind_integer_width(src_ti.type_kind) != 0 || src_ti.type_kind == TYPE_F64)) { return 1; }
    // Raw addresses are part of the current low-level ABI and may cross the
    // u64/i64 boundary. Pointer-to-pointer assignments remain nominal below.
    if (src_ti.ptr_depth > 0 && dst_ti.ptr_depth == 0 &&
        (dst_ti.type_kind == TYPE_U64 || dst_ti.type_kind == TYPE_I64)) { return 1; }
    if (dst_ti.ptr_depth > 0 && src_ti.ptr_depth == 0 &&
        (src_ti.type_kind == TYPE_U64 || src_ti.type_kind == TYPE_I64)) { return 1; }
    // The compiler's AST is an explicit tagged-node hierarchy represented by
    // concrete Ast* structs with AstNode as their common pointer view.
    if (typeinfo_ast_node_pointer_upcast(src_ti, dst_ti) != 0) { return 1; }
    if (src_ti.ptr_depth != dst_ti.ptr_depth) { return 0; }
    if (src_ti.ptr_depth == 0 &&
        (typeinfo_kind_is_unsigned_integer(src_ti.type_kind) != 0 || typeinfo_kind_is_signed_integer(src_ti.type_kind) != 0) &&
        (typeinfo_kind_is_unsigned_integer(dst_ti.type_kind) != 0 || typeinfo_kind_is_signed_integer(dst_ti.type_kind) != 0)) { return 1; }
    if (typeinfo_can_implicit_integer_widen(src_ti, dst_ti) != 0) { return 1; }
    if (src_ti.type_kind != dst_ti.type_kind) { return 0; }
    if (src_ti.is_tagged != dst_ti.is_tagged) { return 0; }
    if (src_ti.is_tagged != 0 && typeinfo_names_equal_resolved(src_ti.tag_layout, dst_ti.tag_layout) == 0) { return 0; }
    if (src_ti.type_kind == TYPE_STRUCT || src_ti.type_kind == TYPE_TRAIT || src_ti.type_kind == TYPE_GENERIC) {
        if (typeinfo_names_equal_resolved(src_ti.struct_name, dst_ti.struct_name) != 0) { return 1; }
        if (src_ti.type_kind == TYPE_STRUCT && src_ti.ptr_depth > 0) {
            var distance: u64 = sym_struct_distance_to_ancestor(src_ti.struct_name, dst_ti.struct_name);
            if (distance != COMPILER_INHERIT_DIST_NOT_FOUND) { return 1; }
        }
        return 0;
    }
    if (src_ti.type_kind == TYPE_ARRAY || src_ti.type_kind == TYPE_SLICE) {
        // AstFunc currently records only the outer sequence return kind. Treat
        // a missing element descriptor as unknown, not as a concrete mismatch.
        if ((src_ti.elem_typeinfo == 0 && src_ti.elem_type_kind == 0) ||
            (dst_ti.elem_typeinfo == 0 && dst_ti.elem_type_kind == 0)) { return 1; }
        if (src_ti.type_kind == TYPE_ARRAY && src_ti.array_len != dst_ti.array_len) { return 0; }
        return typeinfo_sequence_element_equal(src_ti, dst_ti);
    }
    return 1;
}

func typeinfo_expr_is_integer_constant(expr: *AstNode) -> u64 {
    if (expr == 0) { return 0; }
    var kind: u64 = ast_kind(expr);
    if (kind == AST_LITERAL) { return 1; }
    if (kind == AST_IDENT) {
        var ident: *AstIdent = (*AstIdent)expr;
        var found: *ConstResult = (*ConstResult)sym_find_const(ident.name);
        if (found != 0 && found.found != 0) { return 1; }
        var resolved: *NameInfo = resolve_name(ident.name);
        if (resolved != 0) {
            found = (*ConstResult)sym_find_const(slice(resolved.ptr, resolved.len));
            if (found != 0 && found.found != 0) { return 1; }
        }
        return 0;
    }
    if (kind == AST_MEMBER_ACCESS) {
        var member: *AstMemberAccess = (*AstMemberAccess)expr;
        if (ast_kind(member.object) != AST_IDENT) { return 0; }
        var scope: *AstIdent = (*AstIdent)member.object;
        var scoped: *ConstResult = (*ConstResult)sym_find_scoped_const(scope.name, member.member);
        if (scoped != 0 && scoped.found != 0) { return 1; }
        return 0;
    }
    if (kind == AST_CAST) {
        var cast: *AstCast = (*AstCast)expr;
        if (cast.target_ptr_depth != 0) { return 0; }
        if (typeinfo_kind_is_unsigned_integer(cast.target_type) == 0 &&
            typeinfo_kind_is_signed_integer(cast.target_type) == 0 && cast.target_type != TYPE_BOOL) { return 0; }
        return typeinfo_expr_is_integer_constant(cast.expr);
    }
    if (kind == AST_UNARY) {
        return typeinfo_expr_is_integer_constant(((*AstUnary)expr).operand);
    }
    if (kind == AST_BINARY) {
        var binary: *AstBinary = (*AstBinary)expr;
        if (typeinfo_expr_is_integer_constant(binary.left) == 0) { return 0; }
        return typeinfo_expr_is_integer_constant(binary.right);
    }
    if (kind == AST_TERNARY) {
        var ternary: *AstTernary = (*AstTernary)expr;
        if (typeinfo_expr_is_integer_constant(ternary.cond) == 0) { return 0; }
        if (typeinfo_expr_is_integer_constant(ternary.then_expr) == 0) { return 0; }
        return typeinfo_expr_is_integer_constant(ternary.else_expr);
    }
    return 0;
}

func typeinfo_expr_is_zero_literal(expr: *AstNode) -> u64 {
    if (expr == 0) { return 0; }
    var kind: u64 = ast_kind(expr);
    if (kind == AST_LITERAL) {
        return ((*AstLiteral)expr).value == 0;
    }
    if (kind == AST_CAST) {
        return typeinfo_expr_is_zero_literal(((*AstCast)expr).expr);
    }
    return 0;
}

func typeinfo_expr_is_assignable(expr: *AstNode, src_ti: *TypeInfo, dst_ti: *TypeInfo) -> u64 {
    if (typeinfo_is_assignable(src_ti, dst_ti) != 0) { return 1; }
    if (expr == 0 || dst_ti == 0) { return 0; }
    var kind: u64 = ast_kind(expr);
    // Fixed arrays decay to a pointer to their first element at call and
    // assignment boundaries. Compare the complete nested element descriptor
    // so `[N]T` cannot decay to an unrelated `*U` merely by size.
    if (src_ti != 0 && src_ti.ptr_depth == 0 && src_ti.type_kind == TYPE_ARRAY && dst_ti.ptr_depth > 0) {
        var array_elem: *TypeInfo = typeinfo_elem_type_from_container(src_ti);
        var pointer_elem: *TypeInfo = typeinfo_clone_with_depth(dst_ti, dst_ti.ptr_depth - 1);
        if (array_elem != 0 && pointer_elem != 0 && typeinfo_is_assignable(array_elem, pointer_elem) != 0) {
            return 1;
        }
    }
    if (dst_ti.ptr_depth == 0 && typeinfo_expr_is_integer_constant(expr) != 0) {
        if (dst_ti.type_kind == TYPE_BOOL || typeinfo_kind_is_unsigned_integer(dst_ti.type_kind) != 0 || typeinfo_kind_is_signed_integer(dst_ti.type_kind) != 0) {
            return 1;
        }
    }
    if (kind == AST_LITERAL && dst_ti.ptr_depth > 0) {
        var lit: *AstLiteral = (*AstLiteral)expr;
        if (lit.value == 0) { return 1; }
    }
    if (kind == AST_FLOAT && dst_ti.ptr_depth == 0 && dst_ti.type_kind == TYPE_F64) { return 1; }
    // `slice(0, 0)` is the language's context-typed empty slice literal. Its
    // fallback u8 element type must not defeat the declared destination type.
    if (kind == AST_SLICE && dst_ti.ptr_depth == 0 && dst_ti.type_kind == TYPE_SLICE) {
        var empty_slice: *AstSlice = (*AstSlice)expr;
        if (typeinfo_expr_is_zero_literal(empty_slice.ptr_expr) != 0 &&
            typeinfo_expr_is_zero_literal(empty_slice.len_expr) != 0) { return 1; }
    }
    return 0;
}

func typeinfo_func_pointer_variadic_arg_assignable(expr: *AstNode, actual: *TypeInfo, expected: *TypeInfo) -> u64 {
    if (actual == 0 || expected == 0) { return 0; }
    // Preserve the language's legacy bool/integer result convention generally,
    // but a typed variadic pack has a concrete element type and must not accept
    // a boolean constant as an integer element implicitly.
    if (actual.type_kind == TYPE_BOOL && expected.type_kind != TYPE_BOOL) { return 0; }
    return typeinfo_expr_is_assignable(expr, actual, expected);
}

func typeinfo_validate_call_arguments(args: *Vec<*AstNode>, fn: *AstFunc, symtab: *Symtab, phase: u64) -> u64 {
    if (fn == 0 || fn.params_vec == 0 || args == 0) { return 1; }
    var nargs: u64 = args.len();
    var nparams: u64 = fn.params_vec.len();
    var offset: u64 = 0;
    if (nparams > 0) {
        var first: *Param = fn.params_vec.get(0);
        if (first != 0 && str_eq(first.name, slice("self", 4)) != 0 && nargs + 1 <= nparams) { offset = 1; }
    }
    for (var i: u64 = 0; i < nargs; i++) {
        var param_index: u64 = i + offset;
        if (param_index >= nparams) {
            if (nparams == 0) { return 1; }
            var last: *Param = fn.params_vec.get(nparams - 1);
            if (last == 0 || last.is_variadic == 0) { return 1; }
            param_index = nparams - 1;
        }
        var param: *Param = fn.params_vec.get(param_index);
        if (param == 0) { continue; }
        var arg: *AstNode = args.get(i);
        var actual: *TypeInfo = get_expr_type_with_symtab(arg, symtab);
        var expected: *TypeInfo = typeinfo_from_call_param(param);
        if (actual != 0 && expected != 0 && typeinfo_expr_is_assignable(arg, actual, expected) == 0) {
            diag_emit_error_tag(phase, "call", "argument type mismatch");
            diag_emit_labelled_name("function: ", fn.name);
            diag_emit_labelled_u64("index: ", i);
            diag_emit_labelled_u64("expected type: ", expected.type_kind);
            diag_emit_labelled_u64("actual type: ", actual.type_kind);
            diag_emit_labelled_u64("expected pointer depth: ", expected.ptr_depth);
            diag_emit_labelled_u64("actual pointer depth: ", actual.ptr_depth);
            diag_emit_labelled_u64("expected element type: ", expected.elem_type_kind);
            diag_emit_labelled_u64("actual element type: ", actual.elem_type_kind);
            diag_force_stop_pass();
            return 0;
        }
    }
    return 1;
}

// Function type variance:
// - Return type: covariant (from_ret assignable to to_ret)
// - Parameters: contravariant (to_param assignable to from_param)
func typeinfo_func_assignable(src_ti: *TypeInfo, dst_ti: *TypeInfo) -> u64 {
    if (src_ti == 0 || dst_ti == 0) { return 0; }
    if (src_ti.type_kind != TYPE_FUNC || dst_ti.type_kind != TYPE_FUNC) { return 0; }
    if (src_ti.is_tagged != dst_ti.is_tagged) { return 0; }
    if (src_ti.is_tagged != 0) {
        if (typeinfo_names_equal_resolved(src_ti.tag_layout, dst_ti.tag_layout) == 0) { return 0; }
    }

    var fs: *TypeInfo = typeinfo_func_signature(src_ti);
    var ts: *TypeInfo = typeinfo_func_signature(dst_ti);
    if ((fs == 0) != (ts == 0)) { return 0; }
    if (fs == 0) { return 1; }
    if (fs.fn_is_variadic != ts.fn_is_variadic) { return 0; }

    var fn: u64 = 0;
    var tn: u64 = 0;
    if (fs.fn_params_vec != 0) { fn = fs.fn_params_vec.len(); }
    if (ts.fn_params_vec != 0) { tn = ts.fn_params_vec.len(); }
    if (fn != tn) { return 0; }

    for (var i: u64 = 0; i < fn; i++) {
        var from_param: *TypeInfo = fs.fn_params_vec.get(i);
        var to_param: *TypeInfo = ts.fn_params_vec.get(i);
        if (from_param == 0 || to_param == 0) { return 0; }
        if (from_param.ptr_depth != to_param.ptr_depth) { return 0; }
        if (typeinfo_is_assignable(to_param, from_param) == 0) { return 0; }
    }

    if ((fs.fn_ret_typeinfo == 0) != (ts.fn_ret_typeinfo == 0)) { return 0; }
    if (fs.fn_ret_typeinfo != 0) {
        if (fs.fn_ret_typeinfo.ptr_depth != ts.fn_ret_typeinfo.ptr_depth) { return 0; }
        if (typeinfo_is_assignable(fs.fn_ret_typeinfo, ts.fn_ret_typeinfo) == 0) { return 0; }
    }
    return 1;
}

// Calculate size of a type including structs
// Returns size in bytes for allocating on stack
func layout_type_sizeof(type_kind: u64, ptr_depth: u64, struct_name: []u8) -> u64 {
    // Pointers are always 8 bytes
    if (ptr_depth > 0) { return 8; }

    // Primitive types
    match (type_kind) {
        case TYPE_BOOL: return 1;
        case TYPE_U8: return 1;
        case TYPE_U16: return 2;
        case TYPE_U32: return 4;
        case TYPE_U64: return 8;
        case TYPE_I8: return 1;
        case TYPE_I16: return 2;
        case TYPE_I32: return 4;
        case TYPE_I64: return 8;
        case TYPE_F64: return 8;
        case TYPE_SLICE: return 16;
        case TYPE_TRAIT: return 8;
        case TYPE_FUNC: return 8;
        case TYPE_NULL: return 8;
        case TYPE_STRUCT:
            var struct_def: *AstStructDef = _typeinfo_find_struct_def(slice(struct_name.ptr, struct_name.len));
            if (struct_def == 0) { return 8; }
            return _typeinfo_struct_size(struct_def);
    }

    // Default: 8 bytes
    return 8;
}

func _typeinfo_find_struct_def(struct_name: []u8) -> *AstStructDef {
    if (g_structs_vec == 0) { return 0; }
    var si: u64 = g_structs_vec.len();
    while (si > 0) {
        si = si - 1;
        var candidate: *AstStructDef = g_structs_vec.get(si);
        if (str_eq(candidate.name, slice(struct_name.ptr, struct_name.len))) {
            return candidate;
        }
    }
    return 0;
}

func _typeinfo_packed_struct_size(struct_info: *AstStructDef) -> u64 {
    var fields_p: *Vec<*FieldDesc> = struct_info.fields_vec;
    var num_fields_p: u64 = fields_p.len();
    var total_bits: u64 = 0;
    for (var pi: u64 = 0; pi < num_fields_p; pi++) {
        var field_p: *FieldDesc = fields_p.get(pi);
        if (field_p.bit_width > 0) {
            total_bits = total_bits + field_p.bit_width;
        } else {
            var fsize: u64 = layout_field_sizeof(field_p);
            total_bits = total_bits + fsize * 8;
        }
    }
    return (total_bits + 7) / 8;
}

struct TypeInfoPackedFieldLookup {
    public found: u64;
    public offset: u64;
    public desc: *FieldDesc;
}

func _typeinfo_find_packed_field(struct_info: *AstStructDef, field: []u8) -> TypeInfoPackedFieldLookup {
    var lookup: TypeInfoPackedFieldLookup;
    lookup.found = 0;
    lookup.offset = 0;
    lookup.desc = 0;
    if (struct_info == 0 || struct_info.fields_vec == 0) { return lookup; }

    var fields: *Vec<*FieldDesc> = struct_info.fields_vec;
    var n: u64 = fields.len();
    var bit_cursor: u64 = 0;
    for (var i: u64 = 0; i < n; i++) {
        var f: *FieldDesc = fields.get(i);
        var width_bits: u64 = 0;
        if (f.bit_width > 0) {
            width_bits = f.bit_width;
        } else {
            width_bits = layout_field_sizeof(f) * 8;
        }

        if (str_eq(f.name, slice(field.ptr, field.len))) {
            if (f.bit_width > 0) {
                if ((bit_cursor % 8) != 0 || (f.bit_width % 8) != 0) {
                    diag_emit_error_tag("typecheck", "packed-layout", "packed bit-field address requires byte alignment");
                    diag_emit_labelled_member("field: ", struct_info.name, slice(field.ptr, field.len));
                    diag_error("TypeInfo error");
                }
            }
            lookup.found = 1;
            lookup.offset = bit_cursor / 8;
            lookup.desc = f;
            return lookup;
        }
        bit_cursor = bit_cursor + width_bits;
    }
    return lookup;
}

func _typeinfo_struct_size(struct_info: *AstStructDef) -> u64 {
    return _typeinfo_struct_size_internal(struct_info, 0);
}

// Sizeof helper for extended types (array/slice)
func sizeof_type_ex(info: *TypeInfo) -> u64 {
    if (info.ptr_depth > 0) { return 8; }
    if (info.type_kind == TYPE_STRUCT && info.ptr_depth == 0) {
        if (u8_slice_ptr(info.struct_name) == 0 && info.struct_def != 0) {
            var struct_def: *AstStructDef = info.struct_def;
            return _typeinfo_struct_size_internal(struct_def, 0);
        }
    }
    if (info.type_kind == TYPE_ARRAY) {
        var elem_size: u64 = typeinfo_elem_size_from_container(info);
        return elem_size * info.array_len;
    }
    if (info.type_kind == TYPE_SLICE) { return 16; }
    if (info.type_kind == TYPE_TRAIT) { return 8; }
    if (info.type_kind == TYPE_FUNC) { return 8; }
    return layout_type_sizeof(info.type_kind, info.ptr_depth, info.struct_name);
}

// ============================================
// Struct Helper Functions
// ============================================

func _typeinfo_resolve_parent_def(parent: *ParentDesc) -> *AstStructDef {
    if (parent.struct_def != 0) { return parent.struct_def; }
    var sd: *AstStructDef = get_struct_def(parent.name);
    if (sd == 0) {
        diag_emit_error_tag("typecheck", "inheritance", "Parent struct not found");
        diag_emit_labelled_name("parent: ", parent.name);
        diag_error("TypeInfo error");
    }
    parent.struct_def = sd;
    return sd;
}

func _typeinfo_struct_size_internal(struct_info: *AstStructDef, depth: u64) -> u64 {
    if (struct_info == 0) { return 0; }
    if (depth > 64) {
        diag_emit_error_tag("typecheck", "inheritance", "Inheritance depth exceeded");
        diag_emit_help("check for cyclic inheritance or an unexpectedly deep parent chain");
        diag_error("TypeInfo error");
        return 0;
    }
    if (struct_info.is_union == 1) {
        if ((struct_info.parents_vec != 0 && struct_info.parents_vec.len() > 0) ||
            (struct_info.traits_vec != 0 && struct_info.traits_vec.len() > 0)) {
            diag_emit_error_tag("typecheck", "layout", "union cannot use inheritance or traits");
            diag_error("TypeInfo error");
        }
        var max_size: u64 = 0;
        var fields_u: *Vec<*FieldDesc> = struct_info.fields_vec;
        var num_fields_u: u64 = fields_u.len();
        for (var ui: u64 = 0; ui < num_fields_u; ui++) {
            var field_u: *FieldDesc = fields_u.get(ui);
            var size_u: u64 = layout_field_sizeof(field_u);
            if (size_u > max_size) { max_size = size_u; }
        }
        return max_size;
    }
    if (struct_info.is_packed == 1) {
        if (struct_info.parents_vec != 0 && struct_info.parents_vec.len() > 0) {
            diag_emit_error_tag("typecheck", "layout", "packed struct cannot use inheritance");
            diag_error("TypeInfo error");
        }
        return _typeinfo_packed_struct_size(struct_info);
    }
    var total_size: u64 = 0;
    if (struct_info.parents_vec != 0) {
        var parents: *Vec<*ParentDesc> = struct_info.parents_vec;
        var pn: u64 = parents.len();
        for (var pi: u64 = 0; pi < pn; pi++) {
            var parent_desc: *ParentDesc = parents.get(pi);
            var parent_def: *AstStructDef = _typeinfo_resolve_parent_def(parent_desc);
            var parent_size: u64 = _typeinfo_struct_size_internal(parent_def, depth + 1);
            total_size = total_size + parent_size;
        }
    }
    var fields: *Vec<*FieldDesc> = struct_info.fields_vec;
    var num_fields: u64 = fields.len();
    for (var i: u64 = 0; i < num_fields; i++) {
        var field: *FieldDesc = fields.get(i);
        var field_size: u64 = layout_field_sizeof(field);
        total_size = total_size + field_size;
    }
    return total_size;
}

func _typeinfo_find_parent_offset(struct_info: *AstStructDef, target: []u8, base_offset: u64, depth: u64, out_offset: *u64, out_def: **AstStructDef) -> u64 {
    if (struct_info == 0) { return 0; }
    if (depth > 64) {
        diag_emit_error_tag("typecheck", "inheritance", "Inheritance depth exceeded");
        diag_emit_help("check for cyclic inheritance or an unexpectedly deep parent chain");
        diag_error("TypeInfo error");
        return 0;
    }
    if (str_eq(struct_info.name, slice(target.ptr, target.len))) {
        *out_offset = base_offset;
        *out_def = struct_info;
        return 1;
    }
    if (struct_info.parents_vec == 0) { return 0; }
    var parents: *Vec<*ParentDesc> = struct_info.parents_vec;
    var pn: u64 = parents.len();
    var cumulative: u64 = 0;
    for (var i: u64 = 0; i < pn; i++) {
        var parent_desc: *ParentDesc = parents.get(i);
        var parent_def: *AstStructDef = _typeinfo_resolve_parent_def(parent_desc);
        var found: u64 = _typeinfo_find_parent_offset(parent_def, slice(target.ptr, target.len), base_offset + cumulative, depth + 1, out_offset, out_def);
        if (found != 0) { return 1; }
        var parent_size: u64 = _typeinfo_struct_size_internal(parent_def, depth + 1);
        cumulative = cumulative + parent_size;
    }
    return 0;
}

func typeinfo_find_parent_offset(struct_info: *AstStructDef, target: []u8, out_offset: *u64, out_def: **AstStructDef) -> u64 {
    if (struct_info == 0) { return 0; }
    return _typeinfo_find_parent_offset(struct_info, slice(target.ptr, target.len), 0, 0, out_offset, out_def);
}

func _typeinfo_struct_parent_total_size(struct_info: *AstStructDef, depth: u64) -> u64 {
    if (struct_info != 0 && struct_info.is_union == 1) { return 0; }
    if (struct_info == 0 || struct_info.parents_vec == 0) { return 0; }
    var parents: *Vec<*ParentDesc> = struct_info.parents_vec;
    var pn: u64 = parents.len();
    var total: u64 = 0;
    for (var pi: u64 = 0; pi < pn; pi++) {
        var parent_desc: *ParentDesc = parents.get(pi);
        var parent_def: *AstStructDef = _typeinfo_resolve_parent_def(parent_desc);
        var parent_size: u64 = _typeinfo_struct_size_internal(parent_def, depth + 1);
        total = total + parent_size;
    }
    return total;
}

func _typeinfo_struct_find_field_local(struct_info: *AstStructDef, field: []u8, start_offset: u64, out_offset: *u64, out_desc: **FieldDesc) -> u64 {
    if (struct_info == 0 || struct_info.fields_vec == 0) { return 0; }
    if (struct_info.is_union == 1) {
        var fields_u: *Vec<*FieldDesc> = struct_info.fields_vec;
        var num_fields_u: u64 = fields_u.len();
        for (var ui: u64 = 0; ui < num_fields_u; ui++) {
            var field_u: *FieldDesc = fields_u.get(ui);
            if (str_eq(field_u.name, slice(field.ptr, field.len))) {
                *out_offset = 0;
                *out_desc = field_u;
                return 1;
            }
        }
        return 0;
    }
    var fields: *Vec<*FieldDesc> = struct_info.fields_vec;
    var num_fields: u64 = fields.len();
    var offset: u64 = start_offset;
    for (var i: u64 = 0; i < num_fields; i++) {
        var field_desc: *FieldDesc = fields.get(i);
        if (str_eq(field_desc.name, slice(field.ptr, field.len))) {
            *out_offset = offset;
            *out_desc = field_desc;
            return 1;
        }
        var field_size: u64 = layout_field_sizeof(field_desc);
        offset = offset + field_size;
    }
    return 0;
}

func _typeinfo_struct_find_field_in_parents(struct_info: *AstStructDef, field: []u8, depth: u64, out_offset: *u64, out_desc: **FieldDesc) -> u64 {
    if (struct_info == 0 || struct_info.parents_vec == 0) { return 0; }
    var parents: *Vec<*ParentDesc> = struct_info.parents_vec;
    var pn: u64 = parents.len();
    var match_count: u64 = 0;
    var match_offset: u64 = 0;
    var match_desc: *FieldDesc = 0;
    var cumulative: u64 = 0;

    for (var j: u64 = 0; j < pn; j++) {
        var parent_desc: *ParentDesc = parents.get(j);
        var parent_def: *AstStructDef = _typeinfo_resolve_parent_def(parent_desc);
        var child_offset: u64 = 0;
        var child_desc: *FieldDesc = 0;
        var found: u64 = _typeinfo_struct_find_field_internal(parent_def, slice(field.ptr, field.len), depth + 1, &child_offset, &child_desc);
        if (found != 0) {
            match_count = match_count + 1;
            if (match_count == 1) {
                match_offset = cumulative + child_offset;
                match_desc = child_desc;
            }
        }
        var parent_size: u64 = _typeinfo_struct_size_internal(parent_def, depth + 1);
        cumulative = cumulative + parent_size;
    }

    if (match_count > 1) {
        diag_emit_error_tag("typecheck", "field-access", "Ambiguous field access");
        diag_emit_labelled_member("field: ", struct_info.name, slice(field.ptr, field.len));
        diag_error("TypeInfo error");
    }
    if (match_count == 1) {
        *out_offset = match_offset;
        *out_desc = match_desc;
        return 1;
    }
    return 0;
}

func _typeinfo_struct_find_field_internal(struct_info: *AstStructDef, field: []u8, depth: u64, out_offset: *u64, out_desc: **FieldDesc) -> u64 {
    if (struct_info == 0) { return 0; }
    if (depth > 64) {
        diag_emit_error_tag("typecheck", "inheritance", "Inheritance depth exceeded");
        diag_emit_help("check for cyclic inheritance or an unexpectedly deep parent chain");
        diag_error("TypeInfo error");
        return 0;
    }
    if (struct_info.is_union == 1) {
        return _typeinfo_struct_find_field_local(struct_info, slice(field.ptr, field.len), 0, out_offset, out_desc);
    }
    if (struct_info.is_packed == 1) {
        var packed_lookup: TypeInfoPackedFieldLookup = _typeinfo_find_packed_field(struct_info, slice(field.ptr, field.len));
        if (packed_lookup.found == 0) { return 0; }
        *out_offset = packed_lookup.offset;
        *out_desc = packed_lookup.desc;
        return 1;
    }

    var parent_total: u64 = _typeinfo_struct_parent_total_size(struct_info, depth);
    if (_typeinfo_struct_find_field_local(struct_info, slice(field.ptr, field.len), parent_total, out_offset, out_desc) != 0) {
        return 1;
    }
    return _typeinfo_struct_find_field_in_parents(struct_info, slice(field.ptr, field.len), depth, out_offset, out_desc);
}

func struct_find_field_desc_scoped(struct_def: *AstStructDef, parent: []u8, field: []u8, out_offset: *u64, out_desc: **FieldDesc) -> u64 {
    if (struct_def == 0) { return 0; }
    if (struct_def.is_union == 1) {
        if (parent.ptr != 0) {
            diag_emit_error_tag("typecheck", "field-scope", "union cannot use parent scope");
            diag_emit_labelled_name("scope: ", slice(parent.ptr, parent.len));
            diag_error("TypeInfo error");
        }
        return _typeinfo_struct_find_field_local(struct_def, slice(field.ptr, field.len), 0, out_offset, out_desc);
    }
    if (parent.ptr != 0) {
        var parent_offset: u64 = 0;
        var parent_def: *AstStructDef = 0;
        var found_parent: u64 = _typeinfo_find_parent_offset(struct_def, slice(parent.ptr, parent.len), 0, 0, &parent_offset, &parent_def);
        if (found_parent == 0 || parent_def == 0) {
            diag_emit_error_tag("typecheck", "field-scope", "Parent scope not found");
            diag_emit_labelled_name("scope: ", slice(parent.ptr, parent.len));
            diag_error("TypeInfo error");
        }
        var field_offset: u64 = 0;
        var field_desc: *FieldDesc = 0;
        var found_field: u64 = _typeinfo_struct_find_field_internal(parent_def, slice(field.ptr, field.len), 0, &field_offset, &field_desc);
        if (found_field == 0 || field_desc == 0) {
            diag_emit_error_tag("typecheck", "field-scope", "Field not found in parent scope");
            diag_emit_labelled_member("field: ", slice(parent.ptr, parent.len), slice(field.ptr, field.len));
            diag_error("TypeInfo error");
        }
        *out_offset = parent_offset + field_offset;
        *out_desc = field_desc;
        return 1;
    }
    return _typeinfo_struct_find_field_internal(struct_def, slice(field.ptr, field.len), 0, out_offset, out_desc);
}

func typeinfo_find_field_desc_scoped(struct_def: *AstStructDef, parent: []u8, field: []u8) -> *FieldDesc {
    if (struct_def == 0) { return 0; }
    if (struct_def.is_union == 1) {
        var field_offset_u: u64 = 0;
        var field_desc_u: *FieldDesc = 0;
        var found_u: u64 = struct_find_field_desc_scoped(struct_def, slice(parent.ptr, parent.len), slice(field.ptr, field.len), &field_offset_u, &field_desc_u);
        if (found_u == 0) { return 0; }
        return field_desc_u;
    }
    if (struct_def.is_packed == 1) {
        if (parent.ptr != 0) {
            diag_emit_error_tag("typecheck", "field-scope", "Packed struct cannot use parent scope");
            diag_emit_labelled_name("scope: ", slice(parent.ptr, parent.len));
            diag_error("TypeInfo error");
        }
        var fields: *Vec<*FieldDesc> = struct_def.fields_vec;
        var num_fields: u64 = fields.len();
        for (var i: u64 = 0; i < num_fields; i++) {
            var field_desc: *FieldDesc = fields.get(i);
            if (str_eq(field_desc.name, slice(field.ptr, field.len))) {
                return field_desc;
            }
        }
        return 0;
    }
    var field_offset: u64 = 0;
    var field_desc: *FieldDesc = 0;
    var found: u64 = struct_find_field_desc_scoped(struct_def, slice(parent.ptr, parent.len), slice(field.ptr, field.len), &field_offset, &field_desc);
    if (found == 0) { return 0; }
    return field_desc;
}

// Get field offset in bytes from struct definition
// Returns 0 if field not found (caller must handle)
func get_field_offset(struct_def: *AstStructDef, field_name: []u8) -> u64 {
    var field_offset: u64 = 0;
    var field_desc: *FieldDesc = 0;
    var found: u64 = struct_find_field_desc_scoped(struct_def, slice(0, 0), slice(field_name.ptr, field_name.len), &field_offset, &field_desc);
    if (found == 0) { return 0; }
    return field_offset;
}

// ============================================
// Expression Type Inference
// ============================================

// Forward declarations for symtab functions (imported by codegen)
// We need g_symtab from emitter module

func typeinfo_collect_arg_types(args: *Vec<*AstNode>, symtab: *Symtab) -> *Vec<*TypeInfo> {
    if (args == 0) { return new Vec<*TypeInfo>{heap_alloc((0) * sizeof(*TypeInfo)), 0, (0)}; }
    var n: u64 = args.len();
    var out: *Vec<*TypeInfo> = new Vec<*TypeInfo>{heap_alloc((n) * sizeof(*TypeInfo)), 0, (n)};
    for (var i: u64 = 0; i < n; i++) {
        out.push(get_expr_type_with_symtab(args.get(i), symtab));
    }
    return out;
}

func typeinfo_method_call_ret(mc: *AstMethodCall, symtab: *Symtab, is_safe: u64) -> *TypeInfo {
    if (g_funcs_vec == 0) { return typeinfo_make(TYPE_I64, 0); }
    var recv_ti: *TypeInfo = get_expr_type_with_symtab(mc.receiver, symtab);
    if (recv_ti == 0) { return typeinfo_make(TYPE_I64, 0); }
    var arg_types: *Vec<*TypeInfo> = typeinfo_collect_arg_types(mc.args_vec, symtab);
    var arg_count_hint: u64 = 0;
    if (mc.args_vec != 0) { arg_count_hint = mc.args_vec.len(); }

    if (is_safe != 0) {
        var safe_mode: u64 = safe_receiver_mode(recv_ti);
        if (safe_mode == COMPILER_SAFE_RECV_INVALID) {
            if (recv_ti.ptr_depth == 0) {
                emit_stderr("[ERROR] Safe method call requires pointer receiver\n");
            }
            return typeinfo_make(TYPE_I64, 0);
        }
    }

    var is_trait_recv: u64 = 0;
    if (recv_ti.type_kind == TYPE_TRAIT || sym_is_trait_name(recv_ti.struct_name) != 0) {
        is_trait_recv = 1;
    }
    if (is_trait_recv != 0) {
        var trait_def: *TraitDef = sym_get_trait_def(recv_ti.struct_name);
        if (trait_def == 0) { return typeinfo_make(TYPE_I64, 0); }
        var mcount: u64 = trait_def.methods_vec.len();
        for (var mi: u64 = 0; mi < mcount; mi++) {
            var tm: *TraitMethod = trait_def.methods_vec.get(mi);
            if (str_eq(tm.name, mc.method)) {
                var sig: *AstFunc = tm.sig;
                if (is_safe != 0 && sig.ret_type == TYPE_STRUCT && sig.ret_ptr_depth == 0) {
                    emit_stderr("[ERROR] Safe method call cannot return struct by value\n");
                    return typeinfo_make(TYPE_I64, 0);
                }
                if (is_safe != 0) { return typeinfo_from_func_ret(sig, 1); }
                return typeinfo_from_func_ret(sig, 0);
            }
        }
        return typeinfo_make(TYPE_I64, 0);
    }

    if (recv_ti.type_kind != TYPE_STRUCT) { return typeinfo_make(TYPE_I64, 0); }
    var recv_owner_ptr: u64 = u8_slice_ptr(recv_ti.struct_name);
    var recv_owner_len: u64 = u8_slice_len(recv_ti.struct_name);
    if (recv_ti.struct_def != 0) {
        recv_owner_ptr = u8_slice_ptr(recv_ti.struct_def.name);
        recv_owner_len = u8_slice_len(recv_ti.struct_def.name);
    }

    if (check_method_access_overload(slice(recv_owner_ptr, recv_owner_len), mc.method, arg_types, arg_count_hint) == 0) {
        emit_stderr("[ERROR] private method access denied: ");
        emit_stderr_len(recv_owner_ptr, recv_owner_len);
        emit_stderr(".");
        emit_stderr_len(u8_slice_ptr(mc.method), u8_slice_len(mc.method));
        emit_stderr("\n");
        return typeinfo_make(TYPE_I64, 0);
    }

    var recv_struct_def: *AstStructDef = recv_ti.struct_def;
    if (recv_struct_def == 0) {
        recv_struct_def = get_struct_def(recv_ti.struct_name);
    }

    if (recv_ti.ptr_depth > 0) {
        var virt_trait: *NameInfo = vdispatch_find_trait(recv_ti.struct_name, mc.method);
        if (virt_trait != 0) {
            var vtd: *TraitDef = sym_get_trait_def(slice(virt_trait.ptr, virt_trait.len));
            if (vtd != 0) {
                var vmn: u64 = vtd.methods_vec.len();
                for (var vmi: u64 = 0; vmi < vmn; vmi++) {
                    var vtm: *TraitMethod = vtd.methods_vec.get(vmi);
                    if (str_eq(vtm.name, mc.method)) {
                        var vsig: *AstFunc = vtm.sig;
                        if (is_safe != 0 && vsig.ret_type == TYPE_STRUCT && vsig.ret_ptr_depth == 0) {
                            emit_stderr("[ERROR] Safe method call cannot return struct by value\n");
                            return typeinfo_make(TYPE_I64, 0);
                        }
                        if (is_safe != 0) { return typeinfo_from_func_ret(vsig, 1); }
                        return typeinfo_from_func_ret(vsig, 0);
                    }
                }
            }
        }
    }

    var resolved_method: CompilerMethodResolveResult = sym_resolve_method_overload_with_count_fallback(slice(recv_owner_ptr, recv_owner_len), mc.method, arg_types, arg_count_hint);
    var fn: *AstFunc = 0;
    if (resolved_method.found != 0) {
        fn = resolved_method.fn;
    }
    if (fn == 0 && recv_struct_def != 0) {
        fn = find_method_func_in_hierarchy_with_arg_count(recv_struct_def, mc.method, arg_count_hint);
    }
    if (fn == 0) {
        if (recv_struct_def != 0) {
            var field_desc: *FieldDesc = find_struct_field_desc_scoped(recv_struct_def, slice(0, 0), mc.method);
            if (field_desc != 0 && field_desc.type_kind == TYPE_FUNC) {
                var fn_ti: *TypeInfo = typeinfo_from_field_desc(field_desc, 0);
                if (fn_ti != 0 && fn_ti.type_kind == TYPE_FUNC) {
                    var sig_ti: *TypeInfo = fn_ti;
                    if (fn_ti.elem_typeinfo != 0 && fn_ti.elem_typeinfo.type_kind == TYPE_FUNC) {
                        sig_ti = fn_ti.elem_typeinfo;
                    }
                    if (sig_ti.fn_ret_typeinfo != 0) { return typeinfo_clone(sig_ti.fn_ret_typeinfo); }
                    return typeinfo_make(TYPE_I64, 0);
                }
            }
        }
        var name_info: *NameInfo = build_method_name(slice(recv_owner_ptr, recv_owner_len), mc.method);
        fn = typeinfo_find_func(slice(name_info.ptr, name_info.len));
        if (fn == 0) { fn = sym_get_func(slice(name_info.ptr, name_info.len)); }
        if (fn == 0) { fn = sym_get_impl_method_func(slice(name_info.ptr, name_info.len)); }
    }
    if (fn == 0) { return typeinfo_make(TYPE_I64, 0); }
    if (is_safe != 0 && fn.ret_type == TYPE_STRUCT && fn.ret_ptr_depth == 0) {
        emit_stderr("[ERROR] Safe method call cannot return struct by value\n");
        return typeinfo_make(TYPE_I64, 0);
    }
    if (is_safe != 0) { return typeinfo_from_func_ret(fn, 1); }
    return typeinfo_from_func_ret(fn, 0);
}

func typeinfo_try_value_type(tr: *AstTry, symtab: *Symtab) -> *TypeInfo {
    var opt_ti: *TypeInfo = get_expr_type_with_symtab(tr.operand, symtab);
    if (opt_ti == 0) { return 0; }
    var try_fields: CompilerTryFieldNames = try_field_names_from_typeinfo(opt_ti);
    if (try_fields.found == 0) {
        return 0;
    }
    var struct_def: *AstStructDef = try_resolve_struct_def(opt_ti);
    if (struct_def == 0) { return 0; }
    var field: *FieldDesc = get_field_desc(struct_def, try_fields.value);
    if (field == 0) { return 0; }
    return typeinfo_from_field_desc(field, 0);
}

func typeinfo_safe_field_decay_data_ptr(field: *FieldDesc) -> *TypeInfo {
    if (field == 0) { return 0; }
    if (field.type_kind == TYPE_STRUCT && field.ptr_depth == 0) {
        var field_struct_def: *AstStructDef = get_struct_def(field.struct_name);
        var out_struct_ptr: *TypeInfo = typeinfo_make_struct(1, field.struct_name, field_struct_def);
        out_struct_ptr.is_tagged = field.is_tagged;
        out_struct_ptr.tag_layout = field.tag_layout;
        return out_struct_ptr;
    }
    if ((field.type_kind == TYPE_ARRAY || field.type_kind == TYPE_SLICE) && field.ptr_depth == 0) {
        if (field.elem_type_kind == TYPE_STRUCT) {
            var elem_struct_def: *AstStructDef = 0;
            if (field.elem_typeinfo != 0 && field.elem_typeinfo.struct_def != 0) {
                elem_struct_def = field.elem_typeinfo.struct_def;
            }
            if (elem_struct_def == 0) {
                elem_struct_def = get_struct_def(field.struct_name);
            }
            return typeinfo_make_struct(field.elem_ptr_depth + 1, field.struct_name, elem_struct_def);
        }
        var out_ptr: *TypeInfo = typeinfo_make(field.elem_type_kind, field.elem_ptr_depth + 1);
        if (field.elem_typeinfo != 0) {
            out_ptr.struct_name = field.elem_typeinfo.struct_name;
            out_ptr.is_tagged = field.elem_typeinfo.is_tagged;
            out_ptr.tag_layout = field.elem_typeinfo.tag_layout;
        }
        return out_ptr;
    }
    return 0;
}

func typeinfo_safe_member_access_type(sm: *AstMemberAccess, symtab: *Symtab) -> *TypeInfo {
    var sobj_ti: *TypeInfo = get_expr_type_with_symtab(sm.object, symtab);
    if (sobj_ti == 0) { return 0; }
    var recv_mode: u64 = safe_receiver_mode(sobj_ti);
    if (recv_mode == COMPILER_SAFE_RECV_INVALID) {
        if (sobj_ti.ptr_depth == 0) {
            emit_stderr("[ERROR] Safe member access requires pointer receiver\n");
        }
        return 0;
    }
    if (recv_mode != COMPILER_SAFE_RECV_STRUCT_PTR) { return 0; }

    var sstruct_def: *AstStructDef = sobj_ti.struct_def;
    if (sstruct_def == 0) { return 0; }
    var sfield: *FieldDesc = typeinfo_find_field_desc_scoped(sstruct_def, sm.parent, sm.member);
    if (sfield == 0) { return 0; }
    if (check_field_access(sfield) == 0) {
        emit_stderr("[ERROR] private field access denied: ");
        emit_stderr_len(u8_slice_ptr(sstruct_def.name), u8_slice_len(sstruct_def.name));
        emit_stderr(".");
        emit_stderr_len(u8_slice_ptr(sm.member), u8_slice_len(sm.member));
        emit_stderr("\n");
        return 0;
    }
    var decayed_ptr: *TypeInfo = typeinfo_safe_field_decay_data_ptr(sfield);
    if (decayed_ptr != 0) { return decayed_ptr; }
    return typeinfo_from_field_desc(sfield, 0);
}

func typeinfo_safe_index_type(ix: *AstIndex, symtab: *Symtab) -> *TypeInfo {
    var base_ti: *TypeInfo = get_expr_type_with_symtab(ix.base, symtab);
    if (base_ti == 0 || base_ti.ptr_depth == 0) {
        emit_stderr("[ERROR] Safe index access requires pointer receiver\n");
        return 0;
    }
    return typeinfo_from_index_expr(ix, symtab);
}

func typeinfo_clone_with_depth(src: *TypeInfo, new_ptr_depth: u64) -> *TypeInfo {
    if (src == 0) { return 0; }
    var ti: *TypeInfo = typeinfo_make(src.type_kind, new_ptr_depth);
    ti.copy_from(src);
    ti.ptr_depth = new_ptr_depth;
    return ti;
}

func typeinfo_from_new_expr(nw: *AstNew) -> *TypeInfo {
    var out_ptr_depth: u64 = nw.ptr_depth + 1;
    if (nw.type_kind == TYPE_STRUCT) {
        var struct_def: *AstStructDef = get_struct_def(nw.struct_name);
        var ti_s: *TypeInfo = typeinfo_make_struct(out_ptr_depth, nw.struct_name, struct_def);
        ti_s.is_tagged = nw.is_tagged;
        ti_s.tag_layout = nw.tag_layout;
        return ti_s;
    }
    if (nw.type_kind == TYPE_ARRAY) {
        var elem_def: *AstStructDef = 0;
        if (nw.elem_type_kind == TYPE_STRUCT) {
            elem_def = get_struct_def(nw.struct_name);
        }
        var ti_arr: *TypeInfo = typeinfo_make_array(out_ptr_depth, nw.elem_type_kind, nw.elem_ptr_depth, nw.struct_name, elem_def, nw.array_len);
        ti_arr.elem_typeinfo = nw.elem_typeinfo;
        ti_arr.is_tagged = nw.is_tagged;
        ti_arr.tag_layout = nw.tag_layout;
        return ti_arr;
    }
    if (nw.type_kind == TYPE_SLICE) {
        var elem_def2: *AstStructDef = 0;
        if (nw.elem_type_kind == TYPE_STRUCT) {
            elem_def2 = get_struct_def(nw.struct_name);
        }
        var ti_sl: *TypeInfo = typeinfo_make_slice(out_ptr_depth, nw.elem_type_kind, nw.elem_ptr_depth, nw.struct_name, elem_def2);
        ti_sl.elem_typeinfo = nw.elem_typeinfo;
        ti_sl.is_tagged = nw.is_tagged;
        ti_sl.tag_layout = nw.tag_layout;
        return ti_sl;
    }
    var ti_p: *TypeInfo = typeinfo_make(nw.type_kind, out_ptr_depth);
    ti_p.is_tagged = nw.is_tagged;
    ti_p.struct_name = nw.struct_name;
    ti_p.tag_layout = nw.tag_layout;
    return ti_p;
}

func typeinfo_from_stack_ctor_expr(sc: *AstStackCtor) -> *TypeInfo {
    if (sc.type_kind == TYPE_STRUCT) {
        var struct_def_sc: *AstStructDef = get_struct_def(sc.struct_name);
        var ti_sc: *TypeInfo = typeinfo_make_struct(sc.ptr_depth, sc.struct_name, struct_def_sc);
        ti_sc.is_tagged = sc.is_tagged;
        return ti_sc;
    }
    var ti_sc2: *TypeInfo = typeinfo_make(sc.type_kind, sc.ptr_depth);
    ti_sc2.is_tagged = sc.is_tagged;
    ti_sc2.struct_name = sc.struct_name;
    ti_sc2.tag_layout = sc.tag_layout;
    ti_sc2.elem_type_kind = sc.elem_type_kind;
    ti_sc2.elem_ptr_depth = sc.elem_ptr_depth;
    ti_sc2.array_len = sc.array_len;
    ti_sc2.array_len_is_param = sc.array_len_is_param;
    ti_sc2.array_len_param = sc.array_len_param;
    ti_sc2.elem_typeinfo = sc.elem_typeinfo;
    return ti_sc2;
}

func typeinfo_is_lambda_closure_name(name: []u8) -> u64 {
    if (name.ptr == 0 || name.len < 18) { return 0; }
    if (str_eq(slice(name.ptr, 18), slice("__LambdaClosureObj", str_len("__LambdaClosureObj"))) == 0) { return 0; }
    if (name.len == 18) { return 1; }
    var s: []u8 = slice(name.ptr, name.len);
    if (s[18] == 95) { return 1; } // "__LambdaClosureObj_"
    return 0;
}

func typeinfo_try_lambda_closure_sig(callee_ti: *TypeInfo) -> *TypeInfo {
    if (callee_ti == 0) { return 0; }
    if (callee_ti.type_kind != TYPE_STRUCT || callee_ti.ptr_depth == 0) { return 0; }
    if (typeinfo_is_lambda_closure_name(callee_ti.struct_name) == 0) { return 0; }
    var sd: *AstStructDef = callee_ti.struct_def;
    if (sd == 0) {
        sd = get_struct_def(callee_ti.struct_name);
    }
    if (sd == 0) { return 0; }
    var fn_field: *FieldDesc = typeinfo_find_field_desc_scoped(sd, slice(0, 0), slice("fn", 2));
    var env_field: *FieldDesc = typeinfo_find_field_desc_scoped(sd, slice(0, 0), slice("env", 3));
    if (fn_field == 0 || env_field == 0) { return 0; }
    var fn_ti: *TypeInfo = typeinfo_from_field_desc(fn_field, 0);
    if (fn_ti == 0 || fn_ti.type_kind != TYPE_FUNC) { return 0; }
    return typeinfo_func_signature(fn_ti);
}

func typeinfo_from_call_ptr_expr(cp: *AstCallPtr, symtab: *Symtab) -> *TypeInfo {
    var callee_ti: *TypeInfo = get_expr_type_with_symtab(cp.callee, symtab);
    var sig_ti: *TypeInfo = typeinfo_func_signature(callee_ti);
    if (sig_ti == 0) {
        sig_ti = typeinfo_try_lambda_closure_sig(callee_ti);
    }
    if (sig_ti != 0 && sig_ti.fn_ret_typeinfo != 0) {
        return typeinfo_clone(sig_ti.fn_ret_typeinfo);
    }

    var callee: u64 = cp.callee;
    var name2: []u8 = slice(0, 0);
    var ck: u64 = ast_kind(callee);
    if (ck == AST_IDENT) {
        var idn: *AstIdent = (*AstIdent)callee;
        name2 = idn.name;
    } else if (ck == AST_ADDR_OF) {
        var a: *AstAddrOf = (*AstAddrOf)callee;
        if (ast_kind(a.operand) == AST_IDENT) {
            var idn2: *AstIdent = (*AstIdent)a.operand;
            name2 = idn2.name;
        }
    }
    if (u8_slice_ptr(name2) != 0) {
        var fn_ptr: *AstFunc = typeinfo_find_func(name2);
        if (fn_ptr != 0) { return typeinfo_from_func_ret(fn_ptr, 0); }
    }
    return typeinfo_make(TYPE_I64, 0);
}

func typeinfo_from_ident_expr(ident: *AstIdent, symtab: *Symtab) -> *TypeInfo {
    var name: []u8 = ident.name;
    var names: *Vec<*NameInfo> = symtab.names_vec;
    var types: *Vec<*TypeInfo> = symtab.types_vec;
    var count: u64 = symtab.count;

    if (count == 0) {
        var resolved_name0: []u8 = name;
        var resolved0: *NameInfo = resolve_name(name);
        if (resolved0 != 0) {
            resolved_name0 = slice(resolved0.ptr, resolved0.len);
        }
        var ginfo0: *GlobalInfo = sym_find_global_info(resolved_name0);
        if (ginfo0 == 0 && (u8_slice_ptr(resolved_name0) != u8_slice_ptr(name) || u8_slice_len(resolved_name0) != u8_slice_len(name))) {
            ginfo0 = sym_find_global_info(name);
        }
        if (ginfo0 != 0 && ginfo0.typeinfo_ptr != 0) { return ginfo0.typeinfo_ptr; }
        var fn0: *AstFunc = typeinfo_find_func(resolved_name0);
        if (fn0 == 0 && (u8_slice_ptr(resolved_name0) != u8_slice_ptr(name) || u8_slice_len(resolved_name0) != u8_slice_len(name))) {
            fn0 = typeinfo_find_func(name);
        }
        if (fn0 != 0) { return typeinfo_from_func_decl(fn0); }
        return typeinfo_make(TYPE_I64, 0);
    }

    for (var idx: i64 = (i64)count - 1; idx >= 0; idx = idx - 1) {
        var i: u64 = (u64)idx;
        var name_info: *NameInfo = names.get(i);
        if (str_eq(slice(name_info.ptr, name_info.len), name)) {
            return types.get(i);
        }
    }

    var resolved_name: []u8 = name;
    var resolved: *NameInfo = resolve_name(name);
    if (resolved != 0) {
        resolved_name = slice(resolved.ptr, resolved.len);
    }
    var ginfo: *GlobalInfo = sym_find_global_info(resolved_name);
    if (ginfo == 0 && (u8_slice_ptr(resolved_name) != u8_slice_ptr(name) || u8_slice_len(resolved_name) != u8_slice_len(name))) {
        ginfo = sym_find_global_info(name);
    }
    if (ginfo != 0 && ginfo.typeinfo_ptr != 0) { return ginfo.typeinfo_ptr; }

    var fn: *AstFunc = typeinfo_find_func(resolved_name);
    if (fn == 0 && (u8_slice_ptr(resolved_name) != u8_slice_ptr(name) || u8_slice_len(resolved_name) != u8_slice_len(name))) {
        fn = typeinfo_find_func(name);
    }
    if (fn != 0) { return typeinfo_from_func_decl(fn); }

    return typeinfo_make(TYPE_I64, 0);
}

func typeinfo_from_cast_expr(cast_node: *AstCast) -> *TypeInfo {
    if (cast_node.target_type == TYPE_TRAIT) {
        return typeinfo_make_trait(cast_node.target_ptr_depth, cast_node.struct_name);
    }
    if (cast_node.target_type == TYPE_STRUCT) {
        var struct_def: *AstStructDef = get_struct_def(cast_node.struct_name);
        var rs: *TypeInfo = typeinfo_make_struct(cast_node.target_ptr_depth, cast_node.struct_name, struct_def);
        rs.is_tagged = cast_node.target_is_tagged;
        rs.tag_layout = cast_node.tag_layout;
        return rs;
    }
    var rb: *TypeInfo = typeinfo_make(cast_node.target_type, cast_node.target_ptr_depth);
    rb.is_tagged = cast_node.target_is_tagged;
    rb.struct_name = cast_node.struct_name;
    rb.tag_layout = cast_node.tag_layout;
    return rb;
}

func typeinfo_from_addr_of_expr(addr_of: *AstAddrOf, symtab: *Symtab) -> *TypeInfo {
    var op_ti: *TypeInfo = get_expr_type_with_symtab(addr_of.operand, symtab);
    if (op_ti == 0) { return 0; }
    return typeinfo_clone_with_depth(op_ti, op_ti.ptr_depth + 1);
}

func typeinfo_from_deref_expr(deref: *AstDeref, symtab: *Symtab) -> *TypeInfo {
    var op_ti: *TypeInfo = get_expr_type_with_symtab(deref.operand, symtab);
    if (op_ti == 0 || op_ti.ptr_depth == 0) { return 0; }
    return typeinfo_clone_with_depth(op_ti, op_ti.ptr_depth - 1);
}

func typeinfo_from_index_expr(index: *AstIndex, symtab: *Symtab) -> *TypeInfo {
    var bt: *TypeInfo = get_expr_type_with_symtab(index.base, symtab);
    if (bt != 0) {
        if (bt.ptr_depth > 0) {
            if (bt.type_kind == TYPE_STRUCT) {
                return typeinfo_make_struct(bt.ptr_depth - 1, bt.struct_name, bt.struct_def);
            }
            return typeinfo_make(bt.type_kind, bt.ptr_depth - 1);
        }
        if (bt.type_kind == TYPE_ARRAY || bt.type_kind == TYPE_SLICE) {
            if (bt.elem_typeinfo != 0) {
                return typeinfo_clone(bt.elem_typeinfo);
            }
            if (bt.elem_type_kind == TYPE_STRUCT) {
                return typeinfo_make_struct(bt.elem_ptr_depth, bt.struct_name, bt.struct_def);
            }
            return typeinfo_make(bt.elem_type_kind, bt.elem_ptr_depth);
        }
    }
    return typeinfo_make(TYPE_I64, 0);
}

func typeinfo_from_slice_expr(slice: *AstSlice, symtab: *Symtab) -> *TypeInfo {
    var pt: *TypeInfo = get_expr_type_with_symtab(slice.ptr_expr, symtab);
    if (pt != 0 && pt.ptr_depth > 0) {
        var elem: *TypeInfo = typeinfo_clone_with_depth(pt, pt.ptr_depth - 1);
        var out: *TypeInfo = typeinfo_make_slice(0, elem.type_kind, elem.ptr_depth, elem.struct_name, elem.struct_def);
        out.elem_typeinfo = elem;
        return out;
    }
    return typeinfo_make_slice(0, TYPE_U8, 0, slice(0, 0), 0);
}

func typeinfo_from_member_access_expr(member_access: *AstMemberAccess, symtab: *Symtab) -> *TypeInfo {
    var obj_ti: *TypeInfo = get_expr_type_with_symtab(member_access.object, symtab);
    if (ast_kind(member_access.object) == AST_IDENT && u8_slice_ptr(member_access.parent) == 0) {
        var scope_id: *AstIdent = (*AstIdent)member_access.object;
        var scoped_const: *ConstResult = (*ConstResult)sym_find_scoped_const(scope_id.name, member_access.member);
        if (scoped_const != 0 && scoped_const.found != 0) {
            return typeinfo_make(TYPE_I64, 0);
        }
    }
    if (obj_ti == 0) { return 0; }
    if (obj_ti.ptr_depth > 0 && obj_ti.is_tagged == 1 && u8_slice_ptr(obj_ti.tag_layout) != 0) {
        return typeinfo_make(TYPE_U64, 0);
    }
    if (obj_ti.type_kind == TYPE_SLICE && obj_ti.ptr_depth == 0) {
        if (str_eq(member_access.member, slice("ptr", str_len("ptr"))) != 0) {
            return typeinfo_make(TYPE_U64, 0);
        }
        if (str_eq(member_access.member, slice("len", str_len("len"))) != 0) {
            return typeinfo_make(TYPE_U64, 0);
        }
        return 0;
    }
    if (obj_ti.type_kind != TYPE_STRUCT) { return 0; }
    var struct_def: *AstStructDef = obj_ti.struct_def;
    if (struct_def == 0 && u8_slice_ptr(obj_ti.struct_name) != 0 && u8_slice_len(obj_ti.struct_name) != 0) {
        struct_def = get_struct_def(obj_ti.struct_name);
        if (struct_def != 0) { obj_ti.struct_def = struct_def; }
    }
    if (struct_def == 0) { return 0; }
    var field: *FieldDesc = typeinfo_find_field_desc_scoped(struct_def, member_access.parent, member_access.member);
    if (field == 0) { return 0; }
    if (check_field_access(field) == 0) {
        emit_stderr("[ERROR] private field access denied: ");
        emit_stderr_len(u8_slice_ptr(struct_def.name), u8_slice_len(struct_def.name));
        emit_stderr(".");
        emit_stderr_len(u8_slice_ptr(member_access.member), u8_slice_len(member_access.member));
        emit_stderr("\n");
        return 0;
    }
    return typeinfo_from_field_desc(field, 0);
}

func typeinfo_from_unary_expr(unary: *AstUnary, symtab: *Symtab) -> *TypeInfo {
    if (unary == 0) { return typeinfo_make(TYPE_I64, 0); }
    var operand_ti_overload: *TypeInfo = get_expr_type_with_symtab(unary.operand, symtab);
    if (operand_ti_overload != 0 && operand_ti_overload.ptr_depth == 0 && operand_ti_overload.type_kind == TYPE_STRUCT) {
        var owner_ptr: u64 = u8_slice_ptr(operand_ti_overload.struct_name);
        var owner_len: u64 = u8_slice_len(operand_ti_overload.struct_name);
        if (operand_ti_overload.struct_def != 0) {
            owner_ptr = u8_slice_ptr(operand_ti_overload.struct_def.name);
            owner_len = u8_slice_len(operand_ti_overload.struct_def.name);
        }
        if (owner_ptr != 0 && owner_len != 0) {
            var method_name: *NameInfo = compiler_operator_unary_name(unary.op);
            if (method_name != 0) {
                var resolved_method: CompilerMethodResolveResult = sym_resolve_method_overload_with_count_fallback(slice(owner_ptr, owner_len), slice(method_name.ptr, method_name.len), 0, 0);
                if (resolved_method.found != 0 && resolved_method.fn != 0) {
                    return typeinfo_from_func_ret(resolved_method.fn, 0);
                }
            }
            if (unary.op == TOKEN_MINUS) {
                // Some older overload paths still lower unary `-x` through the
                // same method family used by binary subtraction. Keep typeinfo
                // aligned with SSA lowering so receiver-method chains like
                // `(-num).to_str()` retain the struct result type.
                var compat_name: *NameInfo = compiler_operator_binary_name(unary.op);
                if (compat_name != 0) {
                    var compat_resolved: CompilerMethodResolveResult = sym_resolve_method_overload_with_count_fallback(slice(owner_ptr, owner_len), slice(compat_name.ptr, compat_name.len), 0, 0);
                    if (compat_resolved.found != 0 && compat_resolved.fn != 0) {
                        return typeinfo_from_func_ret(compat_resolved.fn, 0);
                    }
                }
            }
        }
    }
    if (unary.op == TOKEN_MINUS || unary.op == TOKEN_PLUS) {
        var operand_ti: *TypeInfo = get_expr_type_with_symtab(unary.operand, symtab);
        if (operand_ti != 0 && operand_ti.ptr_depth == 0 && operand_ti.type_kind == TYPE_F64) {
            return typeinfo_make(TYPE_F64, 0);
        }
    }
    return typeinfo_make(TYPE_I64, 0);
}

func typeinfo_from_binary_expr(binary: *AstBinary, symtab: *Symtab) -> *TypeInfo {
    var op: u64 = binary.op;
    var left_ti_f: *TypeInfo = get_expr_type_with_symtab(binary.left, symtab);
    var right_ti_f: *TypeInfo = get_expr_type_with_symtab(binary.right, symtab);
    var left_is_f64: u64 = 0;
    var right_is_f64: u64 = 0;
    if (left_ti_f != 0) { left_is_f64 = (left_ti_f.ptr_depth == 0 && left_ti_f.type_kind == TYPE_F64); }
    if (right_ti_f != 0) { right_is_f64 = (right_ti_f.ptr_depth == 0 && right_ti_f.type_kind == TYPE_F64); }
    if (typeinfo_binary_number_value_op(op) != 0) {
        if (typeinfo_is_number_struct(left_ti_f) != 0) { return typeinfo_clone(left_ti_f); }
        if (typeinfo_is_number_struct(right_ti_f) != 0) { return typeinfo_clone(right_ti_f); }
    }
    if (left_is_f64 != 0 || right_is_f64 != 0) {
        if (op == TOKEN_PLUS || op == TOKEN_MINUS || op == TOKEN_STAR || op == TOKEN_SLASH) {
            return typeinfo_make(TYPE_F64, 0);
        }
    }

    if (op == TOKEN_ANDAND || op == TOKEN_OROR ||
        op == TOKEN_LT || op == TOKEN_GT ||
        op == TOKEN_LTEQ || op == TOKEN_GTEQ ||
        op == TOKEN_EQEQ || op == TOKEN_BANGEQ) {
        return typeinfo_make(TYPE_I64, 0);
    }

    if (op == TOKEN_PLUS || op == TOKEN_MINUS) {
        var left_ti: *TypeInfo = get_expr_type_with_symtab(binary.left, symtab);
        if (left_ti != 0 && left_ti.ptr_depth > 0) {
            return typeinfo_clone_with_depth(left_ti, left_ti.ptr_depth);
        }
        var right_ti: *TypeInfo = get_expr_type_with_symtab(binary.right, symtab);
        if (right_ti != 0 && right_ti.ptr_depth > 0) {
            return typeinfo_clone_with_depth(right_ti, right_ti.ptr_depth);
        }
    }
    if (op == TOKEN_PLUS || op == TOKEN_MINUS || op == TOKEN_STAR || op == TOKEN_SLASH ||
        op == TOKEN_PERCENT || op == TOKEN_AMPERSAND || op == TOKEN_PIPE || op == TOKEN_CARET ||
        op == TOKEN_LSHIFT || op == TOKEN_RSHIFT) {
        // Integer literals and constants are untyped until their surrounding
        // expression supplies a concrete scalar type. Preserve the typed side
        // instead of collapsing every integer expression to the I64 fallback.
        var left_constant: u64 = typeinfo_expr_is_integer_constant(binary.left);
        var right_constant: u64 = typeinfo_expr_is_integer_constant(binary.right);
        if (left_ti_f != 0 && left_ti_f.ptr_depth == 0 && left_constant == 0 &&
            (typeinfo_kind_is_unsigned_integer(left_ti_f.type_kind) != 0 || typeinfo_kind_is_signed_integer(left_ti_f.type_kind) != 0)) {
            return typeinfo_clone(left_ti_f);
        }
        if (right_ti_f != 0 && right_ti_f.ptr_depth == 0 && right_constant == 0 &&
            (typeinfo_kind_is_unsigned_integer(right_ti_f.type_kind) != 0 || typeinfo_kind_is_signed_integer(right_ti_f.type_kind) != 0)) {
            return typeinfo_clone(right_ti_f);
        }
        if (left_ti_f != 0 && left_ti_f.ptr_depth == 0 &&
            (typeinfo_kind_is_unsigned_integer(left_ti_f.type_kind) != 0 || typeinfo_kind_is_signed_integer(left_ti_f.type_kind) != 0)) {
            return typeinfo_clone(left_ti_f);
        }
        if (right_ti_f != 0 && right_ti_f.ptr_depth == 0 &&
            (typeinfo_kind_is_unsigned_integer(right_ti_f.type_kind) != 0 || typeinfo_kind_is_signed_integer(right_ti_f.type_kind) != 0)) {
            return typeinfo_clone(right_ti_f);
        }
    }
    return 0;
}

func typeinfo_from_ternary_expr(ternary: *AstTernary, symtab: *Symtab) -> *TypeInfo {
    if (ternary == 0) { return typeinfo_make(TYPE_I64, 0); }
    var then_ti: *TypeInfo = get_expr_type_with_symtab(ternary.then_expr, symtab);
    var else_ti: *TypeInfo = get_expr_type_with_symtab(ternary.else_expr, symtab);
    if (then_ti == 0) { return else_ti; }
    if (else_ti == 0) { return then_ti; }

    if (typeinfo_is_assignable(then_ti, else_ti) != 0) { return else_ti; }
    if (typeinfo_is_assignable(else_ti, then_ti) != 0) { return then_ti; }

    if (then_ti.ptr_depth == 0 && else_ti.ptr_depth == 0) {
        if (then_ti.type_kind == TYPE_F64 || else_ti.type_kind == TYPE_F64) {
            return typeinfo_make(TYPE_F64, 0);
        }
    }

    return then_ti;
}

func get_expr_type_with_symtab(node: *AstNode, symtab: *Symtab) -> *TypeInfo {
    if (node == 0) { return typeinfo_make(TYPE_I64, 0); }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;

    if (kind == AST_NEW) { return typeinfo_from_new_expr(nref.new_expr); }
    if (kind == AST_STACK_CTOR) { return typeinfo_from_stack_ctor_expr(nref.stack_ctor); }
    if (kind == AST_SIZEOF || kind == AST_SIZEOF_EXPR) { return typeinfo_make(TYPE_U64, 0); }

    if (kind == AST_CALL) {
        var call_name: []u8 = nref.call.name;
        var resolved_call_name: []u8 = call_name;
        var resolved_call: *NameInfo = resolve_name(call_name);
        if (resolved_call != 0) {
            resolved_call_name = slice(resolved_call.ptr, resolved_call.len);
        }

        var local_call_ti: *TypeInfo = 0;
        if (symtab != 0) {
            local_call_ti = symtab_get_type(symtab, call_name);
        }
        var call_closure: u64 = closure_handle_is(call_name);
        if (call_closure == 0 && (u8_slice_ptr(resolved_call_name) != u8_slice_ptr(call_name) || u8_slice_len(resolved_call_name) != u8_slice_len(call_name))) {
            call_closure = closure_handle_is(resolved_call_name);
        }
        if (call_closure != 0 || (local_call_ti != 0 && local_call_ti.type_kind == TYPE_FUNC)) {
            var callee_ident_cp: *AstNode = ast_ident(call_name);
            var call_ptr_cp: *AstCallPtr = ast_call_ptr(callee_ident_cp, nref.call.args_vec);
            return typeinfo_from_call_ptr_expr(call_ptr_cp, symtab);
        }

        var fn_call: *AstFunc = sym_get_func(resolved_call_name);
        if (fn_call == 0) { fn_call = typeinfo_find_func(resolved_call_name); }
        if (fn_call == 0 && (u8_slice_ptr(resolved_call_name) != u8_slice_ptr(call_name) || u8_slice_len(resolved_call_name) != u8_slice_len(call_name))) {
            fn_call = typeinfo_find_func(call_name);
        }
        if (fn_call == 0 && nref.call.origin == AST_CALL_ORIGIN_MEMBER_LOWERED) {
            fn_call = sym_get_impl_method_func(resolved_call_name);
            if (fn_call == 0 && (u8_slice_ptr(resolved_call_name) != u8_slice_ptr(call_name) || u8_slice_len(resolved_call_name) != u8_slice_len(call_name))) {
                fn_call = sym_get_impl_method_func(call_name);
            }
        }
        if (fn_call != 0) { return typeinfo_from_func_ret(fn_call, 0); }
        var call_global: *GlobalInfo = sym_find_global_info(resolved_call_name);
        if (call_global == 0 && (u8_slice_ptr(resolved_call_name) != u8_slice_ptr(call_name) || u8_slice_len(resolved_call_name) != u8_slice_len(call_name))) {
            call_global = sym_find_global_info(call_name);
        }
        if (call_global != 0) {
            var callee_ident_cp2: *AstNode = ast_ident(call_name);
            var call_ptr_cp2: *AstCallPtr = ast_call_ptr(callee_ident_cp2, nref.call.args_vec);
            return typeinfo_from_call_ptr_expr(call_ptr_cp2, symtab);
        }
        return typeinfo_make(TYPE_I64, 0);
    }
    if (kind == AST_CALL_PTR) { return typeinfo_from_call_ptr_expr(nref.call_ptr, symtab); }
    if (kind == AST_METHOD_CALL) { return typeinfo_method_call_ret(nref.method_call, symtab, 0); }
    if (kind == AST_SAFE_METHOD_CALL) { return typeinfo_method_call_ret(nref.method_call, symtab, 1); }
    if (kind == AST_IDENT) { return typeinfo_from_ident_expr(nref.ident, symtab); }
    if (kind == AST_STRING) { return typeinfo_make(TYPE_U8, 1); }
    if (kind == AST_CAST) { return typeinfo_from_cast_expr(nref.cast_expr); }
    if (kind == AST_TRY) { return typeinfo_try_value_type(nref.try_expr, symtab); }

    if (kind == AST_ADDR_OF) {
        var addr_res: *TypeInfo = typeinfo_from_addr_of_expr(nref.addr_of, symtab);
        if (addr_res != 0) { return addr_res; }
    }
    if (kind == AST_DEREF) {
        var deref_res: *TypeInfo = typeinfo_from_deref_expr(nref.deref, symtab);
        if (deref_res != 0) { return deref_res; }
    }
    if (kind == AST_DEREF8) { return typeinfo_make(TYPE_U8, 0); }
    if (kind == AST_INDEX) { return typeinfo_from_index_expr(nref.index_expr, symtab); }
    if (kind == AST_SAFE_INDEX) { return typeinfo_safe_index_type(nref.index_expr, symtab); }
    if (kind == AST_SLICE) { return typeinfo_from_slice_expr(nref.slice_expr, symtab); }

    if (kind == AST_MEMBER_ACCESS) {
        var mres: *TypeInfo = typeinfo_from_member_access_expr(nref.member_access, symtab);
        if (mres != 0) { return mres; }
        return 0;
    }
    if (kind == AST_TERNARY) { return typeinfo_from_ternary_expr(nref.ternary_expr, symtab); }
    if (kind == AST_SAFE_MEMBER_ACCESS) { return typeinfo_safe_member_access_type(nref.member_access, symtab); }
    if (kind == AST_STRUCT_LITERAL) {
        var literal_name: []u8 = slice(0, 0);
        if (nref.struct_lit.struct_def != 0) { literal_name = nref.struct_lit.struct_def.name; }
        return typeinfo_make_struct(0, literal_name, nref.struct_lit.struct_def);
    }

    if (kind == AST_BINARY) {
        var bres: *TypeInfo = typeinfo_from_binary_expr(nref.binary, symtab);
        if (bres != 0) { return bres; }
    }
    if (kind == AST_UNARY) { return typeinfo_from_unary_expr(nref.unary, symtab); }

    if (kind == AST_LITERAL) { return typeinfo_make(TYPE_I64, 0); }
    if (kind == AST_FLOAT) { return typeinfo_make(TYPE_F64, 0); }
    return typeinfo_make(TYPE_I64, 0);
}
