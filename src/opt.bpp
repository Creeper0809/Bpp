// opt.b - optimization flags (v3_17)

var g_opt_level: u64 = 0;
var g_ir_mode: u64 = 0;
var g_output_mode: u64 = 0;
var g_source_map_user_only: u64 = 0;
var g_source_map_file_ptr: u64 = 0;
var g_source_map_file_len: u64 = 0;

const IR_NONE = 0;
const IR_3ADDR = 1;
const IR_SSA = 2;
const IR_MACHINE = 3;

const OUT_EXEC = 0;
const OUT_IR = 1;
const OUT_ASM = 2;
const OUT_AST = 3;
const OUT_AST_GRAPH = 4;
const OUT_AST_JSON = 5;
const OUT_LLVM_CONTRACT = 6;
const OUT_LLVM_PROTO = 7;
const OUT_LLVM_LL = 8;
const OUT_LLVM_BUILD = 9;
const OUT_OPT_REPORT = 10;
const OUT_SOURCE_MAP = 11;
const OUT_IR_JSON = 12;
const OUT_UNIFIED_JSON = 13;

func opt_init_defaults() -> u64 {
    g_opt_level = 0;
    g_ir_mode = IR_NONE;
    g_output_mode = OUT_EXEC;
    g_source_map_user_only = 0;
    g_source_map_file_ptr = 0;
    g_source_map_file_len = 0;
    return 0;
}

func opt_set_level(level: u64) -> u64 {
    g_opt_level = level;
    return 0;
}

func opt_get_level() -> u64 {
    return g_opt_level;
}

func opt_set_ir_mode(mode: u64) -> u64 {
    g_ir_mode = mode;
    return 0;
}

func opt_get_ir_mode() -> u64 {
    return g_ir_mode;
}

func opt_set_output_mode(mode: u64) -> u64 {
    g_output_mode = mode;
    return 0;
}

func opt_get_output_mode() -> u64 {
    return g_output_mode;
}

func opt_source_map_set_user_only(enabled: u64) -> u64 {
    g_source_map_user_only = enabled;
    return 0;
}

func opt_source_map_user_only() -> u64 {
    return g_source_map_user_only;
}

func opt_source_map_set_file(file_ptr: u64, file_len: u64) -> u64 {
    g_source_map_file_ptr = file_ptr;
    g_source_map_file_len = file_len;
    return 0;
}

func opt_source_map_file_ptr() -> u64 {
    return g_source_map_file_ptr;
}

func opt_source_map_file_len() -> u64 {
    return g_source_map_file_len;
}
