// ssa_core.b - SSA core helpers and constructors
// 자료구조를 조립하기 위한 핵심 유틸/생성자/리스트 조작 함수 모음

import std.io;
import std.util;
import std.vec;
import std.mem;
import std.hashmap;
import ssa.datastruct;
import compiler;

func ssa_builder_diag_suppress_set(enabled: u64) -> u64 {
    compiler_ctx_current().ssa_builder_diag_suppressed = enabled;
    return 0;
}

func ssa_builder_diag_suppressed() -> u64 {
    return compiler_ctx_current().ssa_builder_diag_suppressed;
}

func ssa_source_span_set_current_full(file_ptr: u64, file_len: u64, start_line: u64, start_col: u64, end_line: u64, end_col: u64, range_id: u64, start_offset: u64, end_offset: u64) -> u64 {
    var ctx: *CompilerCtx = compiler_ctx_current();
    ctx.ssa_current_source_file_ptr = file_ptr;
    ctx.ssa_current_source_file_len = file_len;
    ctx.ssa_current_source_start_line = start_line;
    ctx.ssa_current_source_start_col = start_col;
    ctx.ssa_current_source_end_line = end_line;
    ctx.ssa_current_source_end_col = end_col;
    ctx.ssa_current_source_range_id = range_id;
    ctx.ssa_current_source_start_offset = start_offset;
    ctx.ssa_current_source_end_offset = end_offset;
    return 0;
}

func ssa_source_span_set_current(file_ptr: u64, file_len: u64, start_line: u64, start_col: u64, end_line: u64, end_col: u64) -> u64 {
    return ssa_source_span_set_current_full(file_ptr, file_len, start_line, start_col, end_line, end_col, 0, 0, 0);
}

func ssa_source_span_get_current_full(file_ptr: *u64, file_len: *u64, start_line: *u64, start_col: *u64, end_line: *u64, end_col: *u64, range_id: *u64, start_offset: *u64, end_offset: *u64) -> u64 {
    var ctx: *CompilerCtx = compiler_ctx_current();
    if (file_ptr != 0) { file_ptr[0] = ctx.ssa_current_source_file_ptr; }
    if (file_len != 0) { file_len[0] = ctx.ssa_current_source_file_len; }
    if (start_line != 0) { start_line[0] = ctx.ssa_current_source_start_line; }
    if (start_col != 0) { start_col[0] = ctx.ssa_current_source_start_col; }
    if (end_line != 0) { end_line[0] = ctx.ssa_current_source_end_line; }
    if (end_col != 0) { end_col[0] = ctx.ssa_current_source_end_col; }
    if (range_id != 0) { range_id[0] = ctx.ssa_current_source_range_id; }
    if (start_offset != 0) { start_offset[0] = ctx.ssa_current_source_start_offset; }
    if (end_offset != 0) { end_offset[0] = ctx.ssa_current_source_end_offset; }
    if (ctx.ssa_current_source_file_ptr == 0 || ctx.ssa_current_source_start_line == 0) { return 0; }
    return 1;
}

func ssa_source_span_get_current(file_ptr: *u64, file_len: *u64, start_line: *u64, start_col: *u64, end_line: *u64, end_col: *u64) -> u64 {
    return ssa_source_span_get_current_full(file_ptr, file_len, start_line, start_col, end_line, end_col, 0, 0, 0);
}

// ============================================
// Pointer List Helpers
// ============================================

// push_item - 슬라이스 필드와 cap 필드를 직접 참조로 받아 동적 확장/삽입합니다.
// 기존 오프셋 기반 구현(unsafe pointer arithmetic)을 제네릭 기반으로 대체했습니다.
func push_item<T>(slice_ref: *[]T, cap_ref: *u64, item: T, initial_cap: u64) -> u64 {
    push_trace("push_item<T>", "ssa_core.b", __LINE__);
    defer pop_trace();
    var slice_u64: *u64 = (*u64)slice_ref;

    var len: u64 = slice_u64[1];
    var cap: u64 = *cap_ref;
    var data: u64 = slice_u64[0];

    if (len >= cap) {
        var new_cap: u64 = cap * 2;
        if (new_cap == 0) { new_cap = initial_cap; }

        var elem_size: u64 = sizeof(T);
        var new_data: u64 = heap_alloc(new_cap * elem_size);
        if (len > 0) {
            var old_u64: *T = (*T)data;
            var new_u64: *T = (*T)new_data;
            for (var i: u64 = 0; i < len; i++) {
                new_u64[i] = old_u64[i];
            }
        }
        if (data != 0) {
            // Currently a no-op in bump allocator mode, but keep explicit release path.
            free(data);
        }
        data = new_data;
        cap = new_cap;
    }

    var data_u64: *T = (*T)data;
    data_u64[len] = item;
    len = len + 1;

    slice_u64[0] = data;
    slice_u64[1] = len;
    *cap_ref = cap;
    return 0;
}

func push_block(fn: *SSAFunction, block: *SSABlock) -> u64 {
    push_trace("push_block", "ssa_core.b", __LINE__);
    defer pop_trace();
    return push_item<*SSABlock>(&fn.blocks, &fn.blocks_cap, block, 8);
}

func push_function(ctx: *SSAContext, fn: *SSAFunction) -> u64 {
    push_trace("push_function", "ssa_core.b", __LINE__);
    defer pop_trace();
    return push_item<*SSAFunction>(&ctx.funcs, &ctx.funcs_cap, fn, 8);
}

func slice_len<T>(s: []T) -> u64 {
    var s_u64: *u64 = (*u64)&s;
    return s_u64[1];
}

// ============================================
// SSA Constructors
// ============================================

func create_context() -> *SSAContext {
    push_trace("create_context", "ssa_core.b", __LINE__);
    defer pop_trace();
    var ctx: *SSAContext = new SSAContext{};
    ctx.funcs_by_name = new HashMap<u64, *SSAFunction>{0, 0, 0};
    ctx.funcs_by_name.ensure_capacity(64);
    ctx.aux_table = new SSAAuxTable{};
    ctx.aux_table.values = new Vec<u64>{heap_alloc((32) * sizeof(u64)), 0, (32)};
    ctx.aux_table.kinds = new Vec<u64>{heap_alloc((32) * sizeof(u64)), 0, (32)};
    return ctx;
}

// Auxiliary payloads have context lifetime. Each table record owns its nested
// argument/text vector; rewrites which replace a payload transfer that nested
// ownership to the replacement record.
func ssa_aux_payload_release(kind: u64, payload: u64) -> u64 {
    if (payload == 0) { return 0; }
    if (kind == SSA_AUX_CALL) {
        var call_info: *SSACallInfo = (*SSACallInfo)payload;
        if (call_info.args_vec != 0) {
            call_info.args_vec.release_buffer();
            free((u64)call_info.args_vec);
        }
        free(payload);
        return 0;
    }
    if (kind == SSA_AUX_CALL_PTR) {
        var call_ptr_info: *SSACallPtrInfo = (*SSACallPtrInfo)payload;
        if (call_ptr_info.args_vec != 0) {
            call_ptr_info.args_vec.release_buffer();
            free((u64)call_ptr_info.args_vec);
        }
        free(payload);
        return 0;
    }
    if (kind == SSA_AUX_CALL_SLICE_STORE) {
        var slice_info: *SSACallSliceStoreInfo = (*SSACallSliceStoreInfo)payload;
        if (slice_info.is_ptr > 1) {
            var legacy_call_info: *SSACallInfo = (*SSACallInfo)payload;
            if (legacy_call_info.args_vec != 0) {
                legacy_call_info.args_vec.release_buffer();
                free((u64)legacy_call_info.args_vec);
            }
            free(payload);
            return 0;
        }
        if (slice_info.args_vec != 0) {
            slice_info.args_vec.release_buffer();
            free((u64)slice_info.args_vec);
        }
        free(payload);
        return 0;
    }
    if (kind == SSA_AUX_ASM) {
        var text: *Vec<u64> = (*Vec<u64>)payload;
        text.release_buffer();
        free(payload);
        return 0;
    }
    free(payload);
    return 0;
}

func ssa_context_release_aux(ctx: *SSAContext) -> u64 {
    if (ctx == 0) { return 0; }
    if (ctx.aux_table != 0) {
        var table: *SSAAuxTable = ctx.aux_table;
        if (table.values != 0 && table.kinds != 0) {
            var count: u64 = table.values.len();
            if (table.kinds.len() < count) { count = table.kinds.len(); }
            for (var i: u64 = 0; i < count; i++) {
                ssa_aux_payload_release(table.kinds.get(i), table.values.get(i));
            }
        }
        if (table.values != 0) {
            table.values.release_buffer();
            free((u64)table.values);
        }
        if (table.kinds != 0) {
            table.kinds.release_buffer();
            free((u64)table.kinds);
        }
        free((u64)table);
        ctx.aux_table = 0;
    }
    ret_slice_heap_clear();
    return 0;
}

func create_block(ctx: *SSAContext, fn: *SSAFunction) -> *SSABlock {
    push_trace("create_block", "ssa_core.b", __LINE__);
    defer pop_trace();
    var b: *SSABlock = new SSABlock{};
    b.id = fn.next_local_block_id;
    fn.next_local_block_id = fn.next_local_block_id + 1;
    push_block(fn, b);
    return b;
}

func create_inst(ctx: *SSAContext, op: u64, dest: u64, src1: u64, src2: u64) -> *SSAInstruction {
    push_trace("create_inst", "ssa_core.b", __LINE__);
    defer pop_trace();
    var inst: *SSAInstruction = new SSAInstruction{};
    var p: *tagged(InstMeta) u8 = (*tagged(InstMeta) u8)0;
    p.op = (u16)op;
    inst.prev = p;
    inst.id = ctx.next_inst_id;
    ctx.next_inst_id = ctx.next_inst_id + 1;
    inst.dest = dest;
    inst.src1 = src1;
    inst.src2 = src2;
    inst.aux_table = ctx.aux_table;
    var compiler_ctx: *CompilerCtx = compiler_ctx_current();
    inst.source_file_ptr = compiler_ctx.ssa_current_source_file_ptr;
    inst.source_file_len = compiler_ctx.ssa_current_source_file_len;
    inst.source_start_line = compiler_ctx.ssa_current_source_start_line;
    inst.source_start_col = compiler_ctx.ssa_current_source_start_col;
    inst.source_end_line = compiler_ctx.ssa_current_source_end_line;
    inst.source_end_col = compiler_ctx.ssa_current_source_end_col;
    inst.source_range_id = compiler_ctx.ssa_current_source_range_id;
    inst.source_start_offset = compiler_ctx.ssa_current_source_start_offset;
    inst.source_end_offset = compiler_ctx.ssa_current_source_end_offset;
    return inst;
}

func append_inst(block: *SSABlock, inst: *SSAInstruction) -> u64 {
    push_trace("append_inst", "ssa_core.b", __LINE__);
    defer pop_trace();
    var p: *tagged(InstMeta) u8 = inst.prev;
    var current_op: u16 = p.op;
    p = (*tagged(InstMeta) u8)block.inst_tail;
    p.op = current_op;
    inst.prev = p;
    inst.next = 0;
    if (block.inst_head == 0) {
        block.inst_head = inst;
        block.inst_tail = inst;
        return 0;
    }
    block.inst_tail.next = inst;
    block.inst_tail = inst;
    return 0;
}

func insert_before_terminator(block: *SSABlock, inst: *SSAInstruction) -> u64 {
    push_trace("insert_before_terminator", "ssa_core.b", __LINE__);
    defer pop_trace();
    if (block == 0 || inst == 0) { return 0; }

    var tail: *SSAInstruction = block.inst_tail;
    if (tail == 0) { return append_inst(block, inst); }

    var op: u64 = op_of(tail);
    if (op != SSA_OP_JMP && op != SSA_OP_BR && op != SSA_OP_RET && op != SSA_OP_RET_SLICE_HEAP) {
        return append_inst(block, inst);
    }

    var prev: *SSAInstruction = 0;
    var cur: *SSAInstruction = block.inst_head;
    while (cur != 0 && cur != tail) {
        prev = cur;
        cur = cur.next;
    }
    if (cur == 0) { return append_inst(block, inst); }

    inst.next = tail;
    set_prev(inst, prev);
    if (prev != 0) {
        prev.next = inst;
    } else {
        block.inst_head = inst;
    }
    set_prev(tail, inst);
    return 0;
}

func append_phi(block: *SSABlock, phi: *SSAInstruction) -> u64 {
    push_trace("append_phi", "ssa_core.b", __LINE__);
    defer pop_trace();
    var next_phi: *SSAInstruction = block.phi_head;
    phi.next = next_phi;

    if (next_phi != 0) {
        var next_p: *tagged(InstMeta) u8 = next_phi.prev;
        var next_op: u16 = next_p.op;
        next_p = (*tagged(InstMeta) u8)phi;
        next_p.op = next_op;
        next_phi.prev = next_p;
    }

    var p: *tagged(InstMeta) u8 = phi.prev;
    var op: u16 = p.op;
    p = (*tagged(InstMeta) u8)0;
    p.op = op;
    phi.prev = p;

    block.phi_head = phi;
    return 0;
}

func op_of(inst: *SSAInstruction) -> u64 {
    push_trace("op_of", "ssa_core.b", __LINE__);
    defer pop_trace();
    var p: *tagged(InstMeta) u8 = inst.prev;
    return (u64)p.op;
}

func set_op(inst: *SSAInstruction, op: u64) -> u64 {
    push_trace("set_op", "ssa_core.b", __LINE__);
    defer pop_trace();
    var p: *tagged(InstMeta) u8 = inst.prev;
    p.op = (u16)op;
    inst.prev = p;
    return 0;
}

func set_prev(inst: *SSAInstruction, prev: *SSAInstruction) -> u64 {
    push_trace("set_prev", "ssa_core.b", __LINE__);
    defer pop_trace();
    var p: *tagged(InstMeta) u8 = inst.prev;
    var op: u16 = p.op;
    p = (*tagged(InstMeta) u8)prev;
    p.op = op;
    inst.prev = p;
    return 0;
}

func prev_of(inst: *SSAInstruction) -> *SSAInstruction {
    if (inst == 0) { return 0; }
    var raw: u64 = ((u64)inst.prev) & SSA_TAGGED_PTR_MASK;
    return (*SSAInstruction)raw;
}

func create_phi_arg(val: u64, block_id: u64) -> *SSAPhiArg {
    push_trace("create_phi_arg", "ssa_core.b", __LINE__);
    defer pop_trace();
    var a: *SSAPhiArg = new SSAPhiArg{};
    a.val = val;
    a.block_id = block_id;
    return a;
}

func append_phi_arg(head: *SSAPhiArg, val: u64, block_id: u64) -> *SSAPhiArg {
    push_trace("append_phi_arg", "ssa_core.b", __LINE__);
    defer pop_trace();
    var node_ptr: *SSAPhiArg = create_phi_arg(val, block_id);
    if (head == 0) { return node_ptr; }

    var cur: *SSAPhiArg = head;
    while (cur.next != 0) {
        cur = cur.next;
    }
    cur.next = node_ptr;
    return head;
}

func create_phi(ctx: *SSAContext, dest: u64, args_head: *SSAPhiArg) -> *SSAInstruction {
    push_trace("create_phi", "ssa_core.b", __LINE__);
    defer pop_trace();
    var inst_ptr: *SSAInstruction = create_inst(ctx, SSA_OP_PHI, dest, (u64)args_head, 0);
    return inst_ptr;
}

func add_phi_arg(inst: *SSAInstruction, val: u64, block_id: u64) -> u64 {
    push_trace("add_phi_arg", "ssa_core.b", __LINE__);
    defer pop_trace();
    if (op_of(inst) != SSA_OP_PHI) { return 0; }
    var head: *SSAPhiArg = (*SSAPhiArg)inst.src1;
    var new_head_ptr: *SSAPhiArg = append_phi_arg(head, val, block_id);
    inst.src1 = (u64)new_head_ptr;
    return 0;
}

func operand_const(val: u64) -> u64 {
    push_trace("operand_const", "ssa_core.b", __LINE__);
    defer pop_trace();
    if (val <= SSA_OPR_INLINE_VALUE_MASK) {
        return SSA_OPR_CONST_MASK | SSA_OPR_INLINE_CONST_MASK | val;
    }
    var boxed: *u64 = (*u64)heap_alloc(sizeof(u64));
    boxed[0] = val;
    return ((u64)boxed) | SSA_OPR_CONST_MASK;
}

func operand_reg(id: u64) -> u64 {
    push_trace("operand_reg", "ssa_core.b", __LINE__);
    defer pop_trace();
    return id & SSA_OPR_VALUE_MASK;
}

func operand_is_const(opr: u64) -> u64 {
    push_trace("operand_is_const", "ssa_core.b", __LINE__);
    defer pop_trace();
    return (opr & SSA_OPR_CONST_MASK) != 0;
}

func operand_value(opr: u64) -> u64 {
    push_trace("operand_value", "ssa_core.b", __LINE__);
    defer pop_trace();
    if (operand_is_const(opr) != 0) {
        if ((opr & SSA_OPR_INLINE_CONST_MASK) != 0) {
            return opr & SSA_OPR_INLINE_VALUE_MASK;
        }
        var raw: u64 = opr & SSA_OPR_VALUE_MASK;
        if (raw == 0) { return 0; }
        return ((*u64)raw)[0];
    }
    return opr & SSA_OPR_VALUE_MASK;
}

struct SSARetSliceHeapQueryEx {
    public found: u64;
    public elem_size: u64;
    public ptr_val: u64;
    public len_val: u64;
    public ptr_is_reg: u64;
    public len_is_reg: u64;
}

func ret_slice_heap_clear() -> u64 {
    // Metadata is stored directly on each instruction. New instructions start
    // cleared, so there is no process-global side table to reset.
    return 0;
}

func ret_slice_heap_set(inst_ptr: u64, elem_size: u64) -> u64 {
    if (inst_ptr == 0) { return 0; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    inst.ret_slice_heap_valid = 1;
    inst.ret_slice_heap_elem_size = elem_size;
    return 0;
}

func ret_slice_heap_set_ex(inst_ptr: u64, elem_size: u64, ptr_val: u64, len_val: u64, ptr_is_reg: u64, len_is_reg: u64) -> u64 {
    if (inst_ptr == 0) { return 0; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    inst.ret_slice_heap_valid = 1;
    inst.ret_slice_heap_elem_size = elem_size;
    inst.ret_slice_heap_ptr_val = ptr_val;
    inst.ret_slice_heap_len_val = len_val;
    inst.ret_slice_heap_ptr_is_reg = ptr_is_reg;
    inst.ret_slice_heap_len_is_reg = len_is_reg;
    return 0;
}

func ret_slice_heap_get(inst_ptr: u64) -> u64 {
    if (inst_ptr == 0) { return 0; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    if (inst.ret_slice_heap_valid == 0) { return 0; }
    return inst.ret_slice_heap_elem_size;
}

func ret_slice_heap_get_ex(inst_ptr: u64) -> SSARetSliceHeapQueryEx {
    var result: SSARetSliceHeapQueryEx;
    result.found = 0;
    result.elem_size = 0;
    result.ptr_val = 0;
    result.len_val = 0;
    result.ptr_is_reg = 0;
    result.len_is_reg = 0;

    if (inst_ptr == 0) { return result; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    if (inst.ret_slice_heap_valid == 0) { return result; }
    result.found = 1;
    result.elem_size = inst.ret_slice_heap_elem_size;
    result.ptr_val = inst.ret_slice_heap_ptr_val;
    result.len_val = inst.ret_slice_heap_len_val;
    result.ptr_is_reg = inst.ret_slice_heap_ptr_is_reg;
    result.len_is_reg = inst.ret_slice_heap_len_is_reg;
    return result;
}

func ret_slice_heap_remap_ex(inst_ptr: u64, map: u64, map_len: u64) -> u64 {
    if (inst_ptr == 0) { return false; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    if (inst.ret_slice_heap_valid == 0) { return false; }
    var map_u64: *u64 = (*u64)map;
    if (inst.ret_slice_heap_ptr_is_reg != 0 && inst.ret_slice_heap_ptr_val < map_len) {
        var pptr: u64 = map_u64[inst.ret_slice_heap_ptr_val];
        if (pptr != 0) { inst.ret_slice_heap_ptr_val = pptr; }
    }
    if (inst.ret_slice_heap_len_is_reg != 0 && inst.ret_slice_heap_len_val < map_len) {
        var plen: u64 = map_u64[inst.ret_slice_heap_len_val];
        if (plen != 0) { inst.ret_slice_heap_len_val = plen; }
    }
    return true;
}

func ret_slice_heap_uses_reg(inst_ptr: u64, reg: u64) -> u64 {
    if (inst_ptr == 0 || reg == 0) { return false; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    if (inst.ret_slice_heap_valid == 0) { return false; }
    if (inst.ret_slice_heap_ptr_is_reg != 0 && inst.ret_slice_heap_ptr_val == reg) { return true; }
    if (inst.ret_slice_heap_len_is_reg != 0 && inst.ret_slice_heap_len_val == reg) { return true; }
    return false;
}

func ret_slice_heap_remap_single(inst_ptr: u64, old_reg: u64, new_reg: u64) -> u64 {
    if (inst_ptr == 0 || old_reg == 0 || new_reg == 0) { return false; }
    var inst: *SSAInstruction = (*SSAInstruction)inst_ptr;
    if (inst.ret_slice_heap_valid == 0) { return false; }
    var changed: u64 = 0;
    if (inst.ret_slice_heap_ptr_is_reg != 0 && inst.ret_slice_heap_ptr_val == old_reg) {
        inst.ret_slice_heap_ptr_val = new_reg;
        changed = 1;
    }
    if (inst.ret_slice_heap_len_is_reg != 0 && inst.ret_slice_heap_len_val == old_reg) {
        inst.ret_slice_heap_len_val = new_reg;
        changed = 1;
    }
    return changed;
}

func add_pred(block: *SSABlock, pred: *SSABlock) -> u64 {
    push_trace("add_pred", "ssa_core.b", __LINE__);
    defer pop_trace();
    return push_item<*SSABlock>(&block.preds, &block.preds_cap, pred, 4);
}

func add_succ(block: *SSABlock, succ: *SSABlock) -> u64 {
    push_trace("add_succ", "ssa_core.b", __LINE__);
    defer pop_trace();
    return push_item<*SSABlock>(&block.succs, &block.succs_cap, succ, 4);
}

func add_df(block: *SSABlock, target: *SSABlock) -> u64 {
    push_trace("add_df", "ssa_core.b", __LINE__);
    defer pop_trace();
    var data: []*SSABlock = block.df;
    var len: u64 = slice_len(data);
    for (var i: u64 = 0; i < len; i++) {
        var cur: *SSABlock = data[i];
        if (cur == target) { return 0; }
    }

    return push_item<*SSABlock>(&block.df, &block.df_cap, target, 4);
}

func replace_succ(block: *SSABlock, old_succ: *SSABlock, new_succ: *SSABlock) -> u64 {
    push_trace("replace_succ", "ssa_core.b", __LINE__);
    defer pop_trace();
    var data: []*SSABlock = block.succs;
    var len: u64 = slice_len(data);
    for (var i: u64 = 0; i < len; i++) {
        var cur: *SSABlock = data[i];
        if (cur == old_succ) {
            data[i] = new_succ;
            return true;
        }
    }
    return false;
}

func replace_pred(block: *SSABlock, old_pred: *SSABlock, new_pred: *SSABlock) -> u64 {
    push_trace("replace_pred", "ssa_core.b", __LINE__);
    defer pop_trace();
    var data: []*SSABlock = block.preds;
    var len: u64 = slice_len(data);
    for (var i: u64 = 0; i < len; i++) {
        var cur: *SSABlock = data[i];
        if (cur == old_pred) {
            data[i] = new_pred;
            return true;
        }
    }
    return false;
}

func connect_blocks(src: *SSABlock, dst: *SSABlock) -> u64 {
    push_trace("connect_blocks", "ssa_core.b", __LINE__);
    defer pop_trace();
    add_succ(src, dst);
    add_pred(dst, src);
    return 0;
}

func create_function(ctx: *SSAContext, name: []u8) -> *SSAFunction {
    push_trace("create_function", "ssa_core.b", __LINE__);
    defer pop_trace();
    var f: *SSAFunction = new SSAFunction{};
    f.id = slice_len(ctx.funcs);
    f.name = slice(name.ptr, name.len);
    f.blocks = slice(0, 0);
    f.blocks_cap = 0;
    f.next_local_block_id = 0;
    f.entry = create_block(ctx, f);
    f.reg_map_data = 0;
    f.reg_map_len = 0;
    f.regalloc_failed = 0;
    f.regalloc_done = 0;
    push_function(ctx, f);
    if (ctx.funcs_by_name == 0) {
        ctx.funcs_by_name = new HashMap<u64, *SSAFunction>{0, 0, 0};
        ctx.funcs_by_name.ensure_capacity(64);
    }
    ctx.funcs_by_name.put(slice(name.ptr, name.len), f);
    return f;
}
