// Optional compiler phase timing. Disabled unless --timings-json is present.

import std.os;
import std.str;

var g_timings_enabled: u64 = 0;
var g_timings_path: []u8;
var g_timings_path_ptr: u64 = 0;
var g_timings_started_ms: u64 = 0;
var g_timings_preprocess_ms: u64 = 0;
var g_timings_parse_ms: u64 = 0;
var g_timings_lowering_ms: u64 = 0;
var g_timings_ssa_ms: u64 = 0;
var g_timings_opt_ms: u64 = 0;
var g_timings_regalloc_ms: u64 = 0;
var g_timings_validation_ms: u64 = 0;
var g_timings_codegen_ms: u64 = 0;
var g_timings_lex_ms: u64 = 0;
var g_timings_signature_parse_ms: u64 = 0;
var g_timings_body_parse_ms: u64 = 0;
var g_timings_module_merge_ms: u64 = 0;

func timings_enable(path: []u8) -> u64 {
    if (path.ptr == 0 || path.len == 0) { return 0; }
    g_timings_enabled = 1;
    g_timings_path = slice(path.ptr, path.len);
    g_timings_path_ptr = path.ptr;
    g_timings_started_ms = os_monotonic_ms();
    return 1;
}

func timings_now_ms() -> u64 { return os_monotonic_ms(); }
func timings_is_enabled() -> u64 { return g_timings_enabled; }

func timings_elapsed_ms(start_ms: u64) -> u64 {
    var now: u64 = os_monotonic_ms();
    if (now < start_ms) { return 0; }
    return now - start_ms;
}

func timings_add_preprocess(ms: u64) -> u64 { g_timings_preprocess_ms = g_timings_preprocess_ms + ms; return 0; }
func timings_add_parse(ms: u64) -> u64 { g_timings_parse_ms = g_timings_parse_ms + ms; return 0; }
func timings_add_lowering(ms: u64) -> u64 { g_timings_lowering_ms = g_timings_lowering_ms + ms; return 0; }
func timings_add_ssa(ms: u64) -> u64 { g_timings_ssa_ms = g_timings_ssa_ms + ms; return 0; }
func timings_add_opt(ms: u64) -> u64 { g_timings_opt_ms = g_timings_opt_ms + ms; return 0; }
func timings_add_regalloc(ms: u64) -> u64 { g_timings_regalloc_ms = g_timings_regalloc_ms + ms; return 0; }
func timings_add_validation(ms: u64) -> u64 { g_timings_validation_ms = g_timings_validation_ms + ms; return 0; }
func timings_add_codegen(ms: u64) -> u64 { g_timings_codegen_ms = g_timings_codegen_ms + ms; return 0; }
func timings_add_lex(ms: u64) -> u64 { g_timings_lex_ms = g_timings_lex_ms + ms; return 0; }
func timings_add_signature_parse(ms: u64) -> u64 { g_timings_signature_parse_ms = g_timings_signature_parse_ms + ms; return 0; }
func timings_add_body_parse(ms: u64) -> u64 { g_timings_body_parse_ms = g_timings_body_parse_ms + ms; return 0; }
func timings_add_module_merge(ms: u64) -> u64 { g_timings_module_merge_ms = g_timings_module_merge_ms + ms; return 0; }

func timings_write_text(fd: u64, text: []u8) -> u64 {
    if (text.ptr == 0 || text.len == 0) { return 0; }
    os_sys_write(fd, text.ptr, text.len);
    return 0;
}

func timings_write_u64(fd: u64, value: u64) -> u64 {
    var buf: [32]u8;
    var end: u64 = 32;
    var pos: u64 = end;
    if (value == 0) {
        pos = pos - 1;
        buf[pos] = (u8)48;
    } else {
        var current: u64 = value;
        while (current != 0 && pos != 0) {
            pos = pos - 1;
            buf[pos] = (u8)(48 + current % 10);
            current = current / 10;
        }
    }
    os_sys_write(fd, (u64)&buf + pos, end - pos);
    return 0;
}

func timings_write_field(fd: u64, name: []u8, value: u64, trailing: u64) -> u64 {
    timings_write_text(fd, slice("\"", 1));
    timings_write_text(fd, name);
    timings_write_text(fd, slice("\":", 2));
    timings_write_u64(fd, value);
    if (trailing != 0) { timings_write_text(fd, slice(",", 1)); }
    return 0;
}

func timings_write_json() -> u64 {
    if (g_timings_enabled == 0 || g_timings_path_ptr == 0) { return 0; }
    var fd: u64 = os_sys_open(g_timings_path_ptr, OS_O_WRONLY + OS_O_CREAT + OS_O_TRUNC, 420);
    if ((i64)fd < 0) { return 0; }

    timings_write_text(fd, slice("{\"schemaVersion\":1,\"phases\":{", str_len("{\"schemaVersion\":1,\"phases\":{")));
    timings_write_field(fd, slice("preprocessMs", 12), g_timings_preprocess_ms, 1);
    timings_write_field(fd, slice("parseMs", 7), g_timings_parse_ms, 1);
    timings_write_field(fd, slice("loweringMs", 10), g_timings_lowering_ms, 1);
    timings_write_field(fd, slice("ssaGenerationMs", 15), g_timings_ssa_ms, 1);
    timings_write_field(fd, slice("optimizationMs", 14), g_timings_opt_ms, 1);
    timings_write_field(fd, slice("regallocMs", 10), g_timings_regalloc_ms, 1);
    timings_write_field(fd, slice("validationMs", 12), g_timings_validation_ms, 1);
    timings_write_field(fd, slice("codegenMs", 9), g_timings_codegen_ms, 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"moduleLoad\":{", str_len("\"moduleLoad\":{")));
    timings_write_field(fd, slice("lexMs", 5), g_timings_lex_ms, 1);
    timings_write_field(fd, slice("signatureParseMs", 16), g_timings_signature_parse_ms, 1);
    timings_write_field(fd, slice("bodyParseMs", 11), g_timings_body_parse_ms, 1);
    timings_write_field(fd, slice("mergeMs", 7), g_timings_module_merge_ms, 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_field(fd, slice("totalMs", 7), timings_elapsed_ms(g_timings_started_ms), 0);
    timings_write_text(fd, slice("}\n", 2));
    os_sys_close(fd);
    return 0;
}
