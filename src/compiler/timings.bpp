// Optional compiler phase timing. Disabled unless --timings-json is present.

import std.os;
import std.str;

var g_timings_enabled: u64 = 0;
var g_timings_path: []u8;
var g_timings_path_ptr: u64 = 0;
var g_timings_started_ms: u64 = 0;
var g_timings_preprocess_ms: u64 = 0;
var g_timings_parse_ms: u64 = 0;
var g_timings_lowering_ms: u64 = 0;
var g_timings_ssa_ms: u64 = 0;
var g_timings_opt_ms: u64 = 0;
var g_timings_regalloc_ms: u64 = 0;
var g_timings_validation_ms: u64 = 0;
var g_timings_codegen_ms: u64 = 0;
var g_timings_lex_ms: u64 = 0;
var g_timings_signature_parse_ms: u64 = 0;
var g_timings_body_parse_ms: u64 = 0;
var g_timings_module_merge_ms: u64 = 0;
var g_timings_pass_ms: [16]u64;
var g_timings_o1_ms: [19]u64;
var g_timings_regalloc_detail_ms: [8]u64;
var g_timings_ssa_detail_ms: [7]u64;
var g_timings_builder_detail_ms: [7]u64;

func timings_enable(path: []u8) -> u64 {
    if (path.ptr == 0 || path.len == 0) { return 0; }
    g_timings_enabled = 1;
    g_timings_path = slice(path.ptr, path.len);
    g_timings_path_ptr = path.ptr;
    g_timings_started_ms = os_monotonic_ms();
    return 1;
}

func timings_now_ms() -> u64 { return os_monotonic_ms(); }
func timings_is_enabled() -> u64 { return g_timings_enabled; }

func timings_elapsed_ms(start_ms: u64) -> u64 {
    var now: u64 = os_monotonic_ms();
    if (now < start_ms) { return 0; }
    return now - start_ms;
}

func timings_add_preprocess(ms: u64) -> u64 { g_timings_preprocess_ms = g_timings_preprocess_ms + ms; return 0; }
func timings_add_parse(ms: u64) -> u64 { g_timings_parse_ms = g_timings_parse_ms + ms; return 0; }
func timings_add_lowering(ms: u64) -> u64 { g_timings_lowering_ms = g_timings_lowering_ms + ms; return 0; }
func timings_add_ssa(ms: u64) -> u64 { g_timings_ssa_ms = g_timings_ssa_ms + ms; return 0; }
func timings_add_opt(ms: u64) -> u64 { g_timings_opt_ms = g_timings_opt_ms + ms; return 0; }
func timings_add_regalloc(ms: u64) -> u64 { g_timings_regalloc_ms = g_timings_regalloc_ms + ms; return 0; }
func timings_add_validation(ms: u64) -> u64 { g_timings_validation_ms = g_timings_validation_ms + ms; return 0; }
func timings_add_codegen(ms: u64) -> u64 { g_timings_codegen_ms = g_timings_codegen_ms + ms; return 0; }
func timings_add_lex(ms: u64) -> u64 { g_timings_lex_ms = g_timings_lex_ms + ms; return 0; }
func timings_add_signature_parse(ms: u64) -> u64 { g_timings_signature_parse_ms = g_timings_signature_parse_ms + ms; return 0; }
func timings_add_body_parse(ms: u64) -> u64 { g_timings_body_parse_ms = g_timings_body_parse_ms + ms; return 0; }
func timings_add_module_merge(ms: u64) -> u64 { g_timings_module_merge_ms = g_timings_module_merge_ms + ms; return 0; }

func timings_add_pass(pass_id: u64, ms: u64) -> u64 {
    if (pass_id == 0 || pass_id >= 16) { return 0; }
    g_timings_pass_ms[pass_id] = g_timings_pass_ms[pass_id] + ms;
    return 0;
}

func timings_profile_start() -> u64 {
    if (g_timings_enabled == 0) { return 0; }
    return os_monotonic_ms();
}

func timings_add_o1_span(span_id: u64, started_ms: u64) -> u64 {
    if (started_ms == 0 || span_id == 0 || span_id >= 19) { return 0; }
    g_timings_o1_ms[span_id] = g_timings_o1_ms[span_id] + timings_elapsed_ms(started_ms);
    return 0;
}

func timings_add_builder_span(span_id: u64, started_ms: u64) -> u64 {
    if (started_ms == 0 || span_id == 0 || span_id >= 7) { return 0; }
    g_timings_builder_detail_ms[span_id] = g_timings_builder_detail_ms[span_id] + timings_elapsed_ms(started_ms);
    return 0;
}

func timings_add_regalloc_span(span_id: u64, started_ms: u64) -> u64 {
    if (started_ms == 0 || span_id == 0 || span_id >= 8) { return 0; }
    g_timings_regalloc_detail_ms[span_id] = g_timings_regalloc_detail_ms[span_id] + timings_elapsed_ms(started_ms);
    return 0;
}

func timings_add_ssa_span(span_id: u64, started_ms: u64) -> u64 {
    if (started_ms == 0 || span_id == 0 || span_id >= 7) { return 0; }
    g_timings_ssa_detail_ms[span_id] = g_timings_ssa_detail_ms[span_id] + timings_elapsed_ms(started_ms);
    return 0;
}

func timings_write_text(fd: u64, text: []u8) -> u64 {
    if (text.ptr == 0 || text.len == 0) { return 0; }
    os_sys_write(fd, text.ptr, text.len);
    return 0;
}

func timings_write_u64(fd: u64, value: u64) -> u64 {
    var buf: [32]u8;
    var end: u64 = 32;
    var pos: u64 = end;
    if (value == 0) {
        pos = pos - 1;
        buf[pos] = (u8)48;
    } else {
        var current: u64 = value;
        while (current != 0 && pos != 0) {
            pos = pos - 1;
            buf[pos] = (u8)(48 + current % 10);
            current = current / 10;
        }
    }
    os_sys_write(fd, (u64)&buf + pos, end - pos);
    return 0;
}

func timings_write_field(fd: u64, name: []u8, value: u64, trailing: u64) -> u64 {
    timings_write_text(fd, slice("\"", 1));
    timings_write_text(fd, name);
    timings_write_text(fd, slice("\":", 2));
    timings_write_u64(fd, value);
    if (trailing != 0) { timings_write_text(fd, slice(",", 1)); }
    return 0;
}

func timings_write_json() -> u64 {
    if (g_timings_enabled == 0 || g_timings_path_ptr == 0) { return 0; }
    var fd: u64 = os_sys_open(g_timings_path_ptr, OS_O_WRONLY + OS_O_CREAT + OS_O_TRUNC, 420);
    if ((i64)fd < 0) { return 0; }

    timings_write_text(fd, slice("{\"schemaVersion\":1,\"phases\":{", str_len("{\"schemaVersion\":1,\"phases\":{")));
    timings_write_field(fd, slice("preprocessMs", 12), g_timings_preprocess_ms, 1);
    timings_write_field(fd, slice("parseMs", 7), g_timings_parse_ms, 1);
    timings_write_field(fd, slice("loweringMs", 10), g_timings_lowering_ms, 1);
    timings_write_field(fd, slice("ssaGenerationMs", 15), g_timings_ssa_ms, 1);
    timings_write_field(fd, slice("optimizationMs", 14), g_timings_opt_ms, 1);
    timings_write_field(fd, slice("regallocMs", 10), g_timings_regalloc_ms, 1);
    timings_write_field(fd, slice("validationMs", 12), g_timings_validation_ms, 1);
    timings_write_field(fd, slice("codegenMs", 9), g_timings_codegen_ms, 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"moduleLoad\":{", str_len("\"moduleLoad\":{")));
    timings_write_field(fd, slice("lexMs", 5), g_timings_lex_ms, 1);
    timings_write_field(fd, slice("signatureParseMs", 16), g_timings_signature_parse_ms, 1);
    timings_write_field(fd, slice("bodyParseMs", 11), g_timings_body_parse_ms, 1);
    timings_write_field(fd, slice("mergeMs", 7), g_timings_module_merge_ms, 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"pipelinePasses\":{", str_len("\"pipelinePasses\":{")));
    timings_write_field(fd, slice("finalizeImportAliasesMs", 23), g_timings_pass_ms[1], 1);
    timings_write_field(fd, slice("lowerExceptionsMs", 17), g_timings_pass_ms[2], 1);
    timings_write_field(fd, slice("lowerParseSugarMs", 17), g_timings_pass_ms[3], 1);
    timings_write_field(fd, slice("finalizeGlobalInitKindsMs", 25), g_timings_pass_ms[4], 1);
    timings_write_field(fd, slice("validateDirectImplCallsMs", 25), g_timings_pass_ms[5], 1);
    timings_write_field(fd, slice("insertDefaultConstructorsMs", 27), g_timings_pass_ms[6], 1);
    timings_write_field(fd, slice("insertAutoSuperChainsMs", 23), g_timings_pass_ms[7], 1);
    timings_write_field(fd, slice("insertGlobalInitFuncMs", 22), g_timings_pass_ms[8], 1);
    timings_write_field(fd, slice("resolveSuperReferencesMs", 24), g_timings_pass_ms[9], 1);
    timings_write_field(fd, slice("validateImplOverridesMs", 23), g_timings_pass_ms[10], 1);
    timings_write_field(fd, slice("monomorphizeGenericsMs", 22), g_timings_pass_ms[11], 1);
    timings_write_field(fd, slice("finalizeAbstMethodsMs", 21), g_timings_pass_ms[12], 1);
    timings_write_field(fd, slice("finalizeTraitsMs", 16), g_timings_pass_ms[13], 1);
    timings_write_field(fd, slice("applyAnnotationsMs", 18), g_timings_pass_ms[14], 1);
    timings_write_field(fd, slice("validateContractPreservationMs", 30), g_timings_pass_ms[15], 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"o1Passes\":{", str_len("\"o1Passes\":{")));
    timings_write_field(fd, slice("analysisMs", 10), g_timings_o1_ms[1], 1);
    timings_write_field(fd, slice("verifyMs", 8), g_timings_o1_ms[2], 1);
    timings_write_field(fd, slice("localProofMs", 12), g_timings_o1_ms[3], 1);
    timings_write_field(fd, slice("sccpMs", 6), g_timings_o1_ms[4], 1);
    timings_write_field(fd, slice("cfgMs", 5), g_timings_o1_ms[5], 1);
    timings_write_field(fd, slice("gvnMs", 5), g_timings_o1_ms[6], 1);
    timings_write_field(fd, slice("memorySsaMs", 11), g_timings_o1_ms[7], 1);
    timings_write_field(fd, slice("loopMs", 6), g_timings_o1_ms[8], 1);
    timings_write_field(fd, slice("numberMs", 8), g_timings_o1_ms[9], 1);
    timings_write_field(fd, slice("inlineMs", 8), g_timings_o1_ms[10], 1);
    timings_write_field(fd, slice("tagMs", 5), g_timings_o1_ms[11], 1);
    timings_write_field(fd, slice("roadmapMs", 9), g_timings_o1_ms[12], 1);
    timings_write_field(fd, slice("copyMs", 6), g_timings_o1_ms[13], 1);
    timings_write_field(fd, slice("dceMs", 5), g_timings_o1_ms[14], 1);
    timings_write_field(fd, slice("finalizeMs", 10), g_timings_o1_ms[15], 1);
    timings_write_field(fd, slice("interprocMs", 11), g_timings_o1_ms[16], 1);
    timings_write_field(fd, slice("loopMetadataMs", 14), g_timings_o1_ms[17], 1);
    timings_write_field(fd, slice("loopRewriteMs", 13), g_timings_o1_ms[18], 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"regallocPasses\":{", str_len("\"regallocPasses\":{")));
    timings_write_field(fd, slice("colorAnalysisMs", 15), g_timings_regalloc_detail_ms[1], 1);
    timings_write_field(fd, slice("livenessMs", 10), g_timings_regalloc_detail_ms[2], 1);
    timings_write_field(fd, slice("interferenceMs", 14), g_timings_regalloc_detail_ms[3], 1);
    timings_write_field(fd, slice("selectionMs", 11), g_timings_regalloc_detail_ms[4], 1);
    timings_write_field(fd, slice("mapTotalMs", 10), g_timings_regalloc_detail_ms[5], 1);
    timings_write_field(fd, slice("spillRewriteMs", 14), g_timings_regalloc_detail_ms[6], 1);
    timings_write_field(fd, slice("applyMs", 7), g_timings_regalloc_detail_ms[7], 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"ssaPasses\":{", str_len("\"ssaPasses\":{")));
    timings_write_field(fd, slice("builderMs", 9), g_timings_ssa_detail_ms[1], 1);
    timings_write_field(fd, slice("mem2regMs", 9), g_timings_ssa_detail_ms[2], 1);
    timings_write_field(fd, slice("idomMs", 6), g_timings_ssa_detail_ms[3], 1);
    timings_write_field(fd, slice("frontierMs", 10), g_timings_ssa_detail_ms[4], 1);
    timings_write_field(fd, slice("phiMs", 5), g_timings_ssa_detail_ms[5], 1);
    timings_write_field(fd, slice("renameMs", 8), g_timings_ssa_detail_ms[6], 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_text(fd, slice("\"builderPasses\":{", str_len("\"builderPasses\":{")));
    timings_write_field(fd, slice("addrTakenMs", 11), g_timings_builder_detail_ms[1], 1);
    timings_write_field(fd, slice("stackCandidatesMs", 17), g_timings_builder_detail_ms[2], 1);
    timings_write_field(fd, slice("stackEscapesMs", 14), g_timings_builder_detail_ms[3], 1);
    timings_write_field(fd, slice("inlineAsmMs", 11), g_timings_builder_detail_ms[4], 1);
    timings_write_field(fd, slice("paramsMs", 8), g_timings_builder_detail_ms[5], 1);
    timings_write_field(fd, slice("bodyMs", 6), g_timings_builder_detail_ms[6], 0);
    timings_write_text(fd, slice("},", 2));
    timings_write_field(fd, slice("totalMs", 7), timings_elapsed_ms(g_timings_started_ms), 0);
    timings_write_text(fd, slice("}\n", 2));
    os_sys_close(fd);
    return 0;
}
