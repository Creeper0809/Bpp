// Explicit argv layouts for execve-style argument arrays.
// Each field is a single u64 pointer slot, matching the exact contiguous memory
// layout expected by execve without any manual byte offset calculations.
struct Argv6 { public a0: u64; public a1: u64; public a2: u64; public a3: u64; public a4: u64; public a5: u64; }
struct Argv7 { public a0: u64; public a1: u64; public a2: u64; public a3: u64; public a4: u64; public a5: u64; public a6: u64; }
struct Argv8 { public a0: u64; public a1: u64; public a2: u64; public a3: u64; public a4: u64; public a5: u64; public a6: u64; public a7: u64; }
struct Argv10 { public a0: u64; public a1: u64; public a2: u64; public a3: u64; public a4: u64; public a5: u64; public a6: u64; public a7: u64; public a8: u64; public a9: u64; }
struct Argv5 { public a0: u64; public a1: u64; public a2: u64; public a3: u64; public a4: u64; }
struct Argv2 { public a0: u64; public a1: u64; }
struct MainCliParseResult {
    public ok: u64;
    public filename: u64;
    public target_override: u64;
    public ast_filter_func_name: []u8;
    public ast_filter_module_name: []u8;
    public ast_filter_no_std: u64;
    public timings_json_path: []u8;
    public cache_dir: []u8;
    public cache_report: u64;
    public cache_disabled: u64;
}
struct MainOutputPaths { public asm_path: u64; public obj_path: u64; public exe_path: u64; }
struct MainLLVMPaths { public ll_path: u64; public obj_path: u64; public exe_path: u64; }

func number_from_i8(v: i8) -> Number { var out: Number = Number { 1 }; out.set_i64((i64)v); return out; }
func number_from_i16(v: i16) -> Number { var out: Number = Number { 1 }; out.set_i64((i64)v); return out; }
func number_from_i32(v: i32) -> Number { var out: Number = Number { 1 }; out.set_i64((i64)v); return out; }
func number_from_i64(v: i64) -> Number { var out: Number = Number { 1 }; out.set_i64(v); return out; }
func number_from_u8(v: u8) -> Number { var out: Number = Number { 1 }; out.set_u64((u64)v); return out; }
func number_from_u16(v: u16) -> Number { var out: Number = Number { 1 }; out.set_u64((u64)v); return out; }
func number_from_u32(v: u32) -> Number { var out: Number = Number { 1 }; out.set_u64((u64)v); return out; }
func number_from_u64(v: u64) -> Number { var out: Number = Number { 1 }; out.set_u64(v); return out; }
func number_from_f64(v: f64) -> Number { return number_make_real(v); }
func number_from_rational(num: Number, den: Number) -> Number { return number_make_rational(num, den); }
func number_from_decimal(coeff: Number, scale: u64) -> Number { return number_make_decimal(coeff, scale); }
func number_from_bigfloat(mant: Number, exp: i64, precision: u64) -> Number { return number_make_bigfloat(mant, exp, precision); }
func number_cmp_ptr(lhs: *Number, rhs: *Number) -> i64 { return lhs.cmp_ptr(rhs); }
func number_eq_cmp_ptr(lhs: *Number, rhs: *Number) -> i64 { return lhs.eq_cmp_ptr(rhs); }

impl Argv6 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
        self.a2 = 0;
        self.a3 = 0;
        self.a4 = 0;
        self.a5 = 0;
    }
}

impl Argv7 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
        self.a2 = 0;
        self.a3 = 0;
        self.a4 = 0;
        self.a5 = 0;
        self.a6 = 0;
    }
}

impl Argv8 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
        self.a2 = 0;
        self.a3 = 0;
        self.a4 = 0;
        self.a5 = 0;
        self.a6 = 0;
        self.a7 = 0;
    }
}

impl Argv10 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
        self.a2 = 0;
        self.a3 = 0;
        self.a4 = 0;
        self.a5 = 0;
        self.a6 = 0;
        self.a7 = 0;
        self.a8 = 0;
        self.a9 = 0;
    }
}

impl Argv5 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
        self.a2 = 0;
        self.a3 = 0;
        self.a4 = 0;
    }
}

impl Argv2 {
    public constructor() {
        self.a0 = 0;
        self.a1 = 0;
    }
}

impl MainLLVMPaths {
    public constructor() {
        self.ll_path = 0;
        self.obj_path = 0;
        self.exe_path = 0;
    }
}

func main_print_usage() -> u64 {
    emit("Build cache: --cache-dir <directory> [--cache-report], or --no-cache. Native ASM/exec outputs only.\n");
    emit("Usage: bppc [-O0|-O1|-O2|-O3|-Os] [-dump-ast|-dump-ast-graph|-dump-ast-json|-dump-ir|-dump-ir-json|-dump-ssa|-dump-ssa-json|-dump-machine-ir|-dump-machine-ir-json|-dump-llvm-contract|-dump-llvm-proto|-dump-llvm-ll|-llvm-build|-asm|--emit-source-map|--emit-json|--opt-report] [--backend <auto|legacy|ssa>] [--backend-report] [--views <ast,ir,ssa,asm>] [--ast-func <name>] [--ast-module <module>] [--ast-no-std] [--target <linux-x86_64|windows-x86_64>] [--timings-json <path>] [--symbolic-report] [--strict-std-complexity-summary] <source.bpp>\n");
    return 0;
}

func main_has_prefix(arg: u64, arg_len: u64, prefix: u64, prefix_len: u64) -> u64 {
    if (arg_len < prefix_len) { return 0; }
    return str_eq(slice(arg, prefix_len), slice(prefix, prefix_len));
}

func main_emit_supported_targets() -> u64 {
    emit_stderr("[ERROR] supported targets: linux-x86_64, windows-x86_64\n");
    return 0;
}

func main_parse_target_or_report(value: u64, value_len: u64) -> u64 {
    var parsed: u64 = compiler_target_parse(value, value_len);
    if (parsed != 0) { return parsed; }
    emit_stderr("[ERROR] unsupported target: ");
    emit_stderr_len(value, value_len);
    emit_stderr("\n");
    main_emit_supported_targets();
    return 0;
}

func main_parse_backend_or_report(value: u64, value_len: u64) -> u64 {
    if (str_eq(slice(value, value_len), slice("auto", 4)) != 0) { return BACKEND_AUTO + 1; }
    if (str_eq(slice(value, value_len), slice("legacy", 6)) != 0) { return BACKEND_LEGACY + 1; }
    if (str_eq(slice(value, value_len), slice("ssa", 3)) != 0) { return BACKEND_SSA + 1; }
    emit_stderr("[ERROR] unsupported backend: ");
    emit_stderr_len(value, value_len);
    emit_stderr("\n[ERROR] supported backends: auto, legacy, ssa\n");
    return 0;
}

func main_parse_views_or_report(value: u64, value_len: u64) -> u64 {
    if (value_len == 0) {
        emit_stderr("[ERROR] empty --views value\n");
        emit_stderr("[ERROR] supported views: ast, ir, ssa, asm\n");
        return 0;
    }
    if (str_eq(slice(value, value_len), slice("all", 3)) != 0) {
        return UNIFIED_VIEW_ALL;
    }

    var mask: u64 = 0;
    var start: u64 = 0;
    var bytes: *u8 = (*u8)value;
    for (var i: u64 = 0; i <= value_len; i++) {
        if (i != value_len && bytes[i] != 44) { continue; }
        if (i == start) {
            emit_stderr("[ERROR] empty name in --views\n");
            emit_stderr("[ERROR] supported views: ast, ir, ssa, asm\n");
            return 0;
        }
        var part: []u8 = slice(value + start, i - start);
        if (str_eq(part, slice("ast", 3)) != 0) {
            mask = mask | UNIFIED_VIEW_AST;
        } else if (str_eq(part, slice("ir", 2)) != 0) {
            mask = mask | UNIFIED_VIEW_IR;
        } else if (str_eq(part, slice("ssa", 3)) != 0) {
            mask = mask | UNIFIED_VIEW_SSA;
        } else if (str_eq(part, slice("asm", 3)) != 0) {
            mask = mask | UNIFIED_VIEW_ASM;
        } else {
            emit_stderr("[ERROR] unsupported view: ");
            emit_stderr_len(part.ptr, part.len);
            emit_stderr("\n[ERROR] supported views: ast, ir, ssa, asm\n");
            return 0;
        }
        start = i + 1;
    }
    return mask;
}

func main_parse_cli(argc: u64, argv_ptr: *u64) -> MainCliParseResult {
    var result: MainCliParseResult;
    result.ok = 0;
    result.filename = 0;
    result.target_override = 0;
    result.ast_filter_func_name = slice(0, 0);
    result.ast_filter_module_name = slice(0, 0);
    result.ast_filter_no_std = 0;
    result.timings_json_path = slice(0, 0);
    result.cache_dir = slice(0, 0);
    result.cache_report = 0;
    result.cache_disabled = 0;

    // Default flags (avoid uninitialized globals affecting codegen)
    opt_init_defaults();
    annotation_set_symbolic_report_enabled(0);
    annotation_set_complexity_require_std_summaries(0);

    if (argc < 2) { return result; }

    var filename: u64 = 0;
    for (var i: u64 = 1; i < argc; i++) {
        var arg: u64 = argv_ptr[i];
        var arg_len: u64 = str_len(arg);

        if (str_eq(slice(arg, arg_len), slice("--cache-dir", 11))) {
            if (i + 1 >= argc) { emit_stderr("[ERROR] missing value for --cache-dir\n"); return result; }
            i = i + 1;
            var cache_arg: u64 = argv_ptr[i];
            var cache_len: u64 = str_len(cache_arg);
            if (cache_len == 0) { emit_stderr("[ERROR] empty --cache-dir\n"); return result; }
            result.cache_dir = slice(cache_arg, cache_len);
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--cache-dir=", 12) != 0) {
            if (arg_len == 12) { emit_stderr("[ERROR] empty --cache-dir\n"); return result; }
            result.cache_dir = slice(arg + 12, arg_len - 12);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--cache-report", 14))) { result.cache_report = 1; continue; }
        if (str_eq(slice(arg, arg_len), slice("--no-cache", 10))) { result.cache_disabled = 1; continue; }

        if (str_eq(slice(arg, arg_len), slice("--backend", str_len("--backend")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for --backend\n");
                return result;
            }
            i = i + 1;
            var backend_arg: u64 = argv_ptr[i];
            var backend_len: u64 = str_len(backend_arg);
            var parsed_backend: u64 = main_parse_backend_or_report(backend_arg, backend_len);
            if (parsed_backend == 0) { return result; }
            opt_set_backend_mode(parsed_backend - 1);
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--backend=", 10) != 0) {
            var parsed_backend2: u64 = main_parse_backend_or_report(arg + 10, arg_len - 10);
            if (parsed_backend2 == 0) { return result; }
            opt_set_backend_mode(parsed_backend2 - 1);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--backend-report", str_len("--backend-report")))) {
            opt_set_backend_report(1);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-O1", str_len("-O1")))) {
            opt_set_level(1);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-O0", str_len("-O0")))) {
            opt_set_level(0);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-O2", str_len("-O2")))) {
            opt_set_level(2);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-O3", str_len("-O3")))) {
            opt_set_level(3);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-Os", str_len("-Os")))) {
            opt_set_level(2);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ir", str_len("-dump-ir")))) {
            opt_set_ir_mode(IR_3ADDR);
            opt_set_output_mode(OUT_IR);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ir-json", str_len("-dump-ir-json")))) {
            opt_set_ir_mode(IR_3ADDR);
            opt_set_output_mode(OUT_IR_JSON);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ssa", str_len("-dump-ssa")))) {
            opt_set_ir_mode(IR_SSA);
            opt_set_output_mode(OUT_IR);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ssa-json", str_len("-dump-ssa-json")))) {
            opt_set_ir_mode(IR_SSA);
            opt_set_output_mode(OUT_IR_JSON);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-machine-ir", str_len("-dump-machine-ir")))) {
            opt_set_ir_mode(IR_MACHINE);
            opt_set_output_mode(OUT_IR);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-machine-ir-json", str_len("-dump-machine-ir-json")))) {
            opt_set_ir_mode(IR_MACHINE);
            opt_set_output_mode(OUT_IR_JSON);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ast", str_len("-dump-ast")))) {
            opt_set_output_mode(OUT_AST);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ast-graph", str_len("-dump-ast-graph")))) {
            opt_set_output_mode(OUT_AST_GRAPH);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-ast-json", str_len("-dump-ast-json")))) {
            opt_set_output_mode(OUT_AST_JSON);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-llvm-contract", str_len("-dump-llvm-contract")))) {
            opt_set_output_mode(OUT_LLVM_CONTRACT);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-llvm-proto", str_len("-dump-llvm-proto")))) {
            opt_set_output_mode(OUT_LLVM_PROTO);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-dump-llvm-ll", str_len("-dump-llvm-ll")))) {
            opt_set_output_mode(OUT_LLVM_LL);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-llvm-build", str_len("-llvm-build")))) {
            opt_set_output_mode(OUT_LLVM_BUILD);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--opt-report", str_len("--opt-report")))) {
            opt_set_output_mode(OUT_OPT_REPORT);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--ast-func", str_len("--ast-func"))) || str_eq(slice(arg, arg_len), slice("--graph-func", str_len("--graph-func")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for ");
                emit_stderr_len(arg, arg_len);
                emit_stderr("\n");
                return result;
            }
            i = i + 1;
            var filter_func_arg: u64 = argv_ptr[i];
            var filter_func_arg_len: u64 = str_len(filter_func_arg);
            var filter_func_name: []u8 = slice(filter_func_arg, filter_func_arg_len);
            result.ast_filter_func_name = filter_func_name;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--ast-func=", 11) != 0) {
            var ast_func_name: []u8 = slice(arg + 11, arg_len - 11);
            result.ast_filter_func_name = ast_func_name;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--graph-func=", 13) != 0) {
            var graph_func_name: []u8 = slice(arg + 13, arg_len - 13);
            result.ast_filter_func_name = graph_func_name;
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--ast-module", str_len("--ast-module"))) || str_eq(slice(arg, arg_len), slice("--graph-module", str_len("--graph-module")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for ");
                emit_stderr_len(arg, arg_len);
                emit_stderr("\n");
                return result;
            }
            i = i + 1;
            var filter_module_arg: u64 = argv_ptr[i];
            var filter_module_arg_len: u64 = str_len(filter_module_arg);
            var filter_module_name: []u8 = slice(filter_module_arg, filter_module_arg_len);
            result.ast_filter_module_name = filter_module_name;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--ast-module=", 13) != 0) {
            var ast_module_name: []u8 = slice(arg + 13, arg_len - 13);
            result.ast_filter_module_name = ast_module_name;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--graph-module=", 15) != 0) {
            var graph_module_name: []u8 = slice(arg + 15, arg_len - 15);
            result.ast_filter_module_name = graph_module_name;
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--ast-no-std", str_len("--ast-no-std"))) || str_eq(slice(arg, arg_len), slice("--graph-no-std", str_len("--graph-no-std")))) {
            result.ast_filter_no_std = 1;
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("-asm", str_len("-asm")))) {
            opt_set_output_mode(OUT_ASM);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--emit-source-map", str_len("--emit-source-map")))) {
            opt_set_output_mode(OUT_SOURCE_MAP);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--emit-json", str_len("--emit-json")))) {
            opt_set_output_mode(OUT_UNIFIED_JSON);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--views", str_len("--views")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for --views\n");
                return result;
            }
            i = i + 1;
            var views_arg: u64 = argv_ptr[i];
            var views_mask: u64 = main_parse_views_or_report(views_arg, str_len(views_arg));
            if (views_mask == 0) { return result; }
            opt_set_unified_views(views_mask);
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--views=", 8) != 0) {
            var views_mask2: u64 = main_parse_views_or_report(arg + 8, arg_len - 8);
            if (views_mask2 == 0) { return result; }
            opt_set_unified_views(views_mask2);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--source-map-user-only", str_len("--source-map-user-only")))) {
            opt_source_map_set_user_only(1);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--source-map-include-std", str_len("--source-map-include-std")))) {
            opt_source_map_set_user_only(0);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--source-map-file", str_len("--source-map-file")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for --source-map-file\n");
                return result;
            }
            i = i + 1;
            opt_source_map_set_file(argv_ptr[i], str_len(argv_ptr[i]));
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--source-map-file=", 18) != 0) {
            opt_source_map_set_file(arg + 18, arg_len - 18);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--target", str_len("--target")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for --target\n");
                main_emit_supported_targets();
                return result;
            }
            i = i + 1;
            var next_arg: u64 = argv_ptr[i];
            var next_len: u64 = str_len(next_arg);
            var parsed_target: u64 = main_parse_target_or_report(next_arg, next_len);
            if (parsed_target == 0) { return result; }
            result.target_override = parsed_target;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--target=", 9) != 0) {
            var target_arg: u64 = arg + 9;
            var target_len: u64 = arg_len - 9;
            var parsed_target2: u64 = main_parse_target_or_report(target_arg, target_len);
            if (parsed_target2 == 0) { return result; }
            result.target_override = parsed_target2;
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--timings-json", str_len("--timings-json")))) {
            if (i + 1 >= argc) {
                emit_stderr("[ERROR] missing value for --timings-json\n");
                return result;
            }
            i = i + 1;
            var timings_path_ptr: u64 = argv_ptr[i];
            var timings_path_len: u64 = str_len(timings_path_ptr);
            var timings_path: []u8 = slice(timings_path_ptr, timings_path_len);
            result.timings_json_path = timings_path;
            continue;
        }
        if (main_has_prefix(arg, arg_len, "--timings-json=", 15) != 0) {
            var timings_eq_path: []u8 = slice(arg + 15, arg_len - 15);
            result.timings_json_path = timings_eq_path;
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--symbolic-report", str_len("--symbolic-report")))) {
            annotation_set_symbolic_report_enabled(1);
            continue;
        }
        if (str_eq(slice(arg, arg_len), slice("--strict-std-complexity-summary", str_len("--strict-std-complexity-summary")))) {
            annotation_set_complexity_require_std_summaries(1);
            continue;
        }

        if (arg_len > 0) {
            var arg_u8: []u8 = slice(arg, arg_len);
            if (arg_u8[0] == 45) { // '-'
                emit_stderr("[ERROR] unknown option: ");
                emit_stderr_len(arg, arg_len);
                emit_stderr("\n");
                return result;
            }
        }

        filename = arg;
    }

    if (filename == 0) { return result; }
    if (opt_unified_views_explicit() != 0 && opt_get_output_mode() != OUT_UNIFIED_JSON) {
        emit_stderr("[ERROR] --views requires --emit-json\n");
        return result;
    }
    result.ok = 1;
    result.filename = filename;
    return result;
}

func main_run_compile_pipeline(filename: u64, filename_len: u64) -> *AstProgram {
    var cctx: *CompilerCtx = compiler_ctx_current();
    var bootstrap_errors: u64 = 0;
    var phase_started: u64 = timings_now_ms();
    if (!load_std_prelude_with_ctx(cctx)) {
        emit_stderr("[ERROR] failed to load std prelude\n");
        bootstrap_errors = bootstrap_errors + 1;
    }
    timings_add_preprocess(timings_elapsed_ms(phase_started));

    phase_started = timings_now_ms();
    if (!load_module_with_ctx(cctx, filename, filename_len)) {
        emit_stderr("[ERROR] failed to load module: ");
        emit_stderr_len(filename, filename_len);
        emit_stderr("\n");
        bootstrap_errors = bootstrap_errors + 1;
    }
    timings_add_parse(timings_elapsed_ms(phase_started));

    // Dependencies are freshly resolved and read. Only a prior successful
    // artifact with an exact full identity can bypass lowering/typechecking.
    if (bootstrap_errors == 0 && artifact_cache_probe(cctx) != 0) { return 0; }

    if (bootstrap_errors == 0) {
        diag_reset();
        // Structural validation performs module-scoped nominal lookup, so the
        // complete import alias graph (including deferred cycle edges) must be
        // available before validation begins.
        run_pass_with_ctx(cctx, COMPILER_PASS_FINALIZE_IMPORT_ALIASES);
        if (diag_has_errors() != 0 || validate_program_structure_with_ctx(cctx) != 0 || diag_has_errors() != 0) {
            emit_stderr("[ERROR] invalid program structure\n");
            return 0;
        }
    }

    var passes: *Vec<u64> = default_passes_with_ctx(cctx);

    var pass_count: u64 = passes.len();
    var total_pipeline_errors: u64 = 0;
    for (var i: u64 = 0; i < pass_count; i++) {
        var pass_id: u64 = passes.get(i);
        phase_started = timings_now_ms();
        diag_reset();
        if (run_pass_with_ctx(cctx, pass_id) != 0) {
            emit_stderr("[ERROR] compiler pipeline failed at pass: ");
            emit_stderr(pass_name(pass_id));
            emit_stderr("\n");
            total_pipeline_errors = total_pipeline_errors + 1;
            break;
        }
        var pass_ms: u64 = timings_elapsed_ms(phase_started);
        timings_add_pass(pass_id, pass_ms);
        if (pass_id == COMPILER_PASS_VALIDATE_DIRECT_IMPL_CALLS ||
            pass_id == COMPILER_PASS_VALIDATE_IMPL_OVERRIDES ||
            pass_id == COMPILER_PASS_FINALIZE_ABST_METHODS ||
            pass_id == COMPILER_PASS_FINALIZE_TRAITS ||
            pass_id == COMPILER_PASS_APPLY_ANNOTATIONS ||
            pass_id == COMPILER_PASS_VALIDATE_CONTRACT_PRESERVATION) {
            timings_add_validation(pass_ms);
        } else {
            timings_add_lowering(pass_ms);
        }
        if (diag_has_errors() != 0) {
            emit_stderr("[ERROR] compiler pipeline diagnostics in pass: ");
            emit_stderr(pass_name(pass_id));
            emit_stderr(" (");
            emit_u64_stderr(diag_count());
            emit_stderr(" error(s))\n");
            total_pipeline_errors = total_pipeline_errors + diag_count();
            break;
        }
    }

    if (bootstrap_errors != 0 || total_pipeline_errors != 0) {
        emit_stderr("[ERROR] compiler pipeline completed with diagnostics (total ");
        emit_u64_stderr(bootstrap_errors + total_pipeline_errors);
        emit_stderr(" error(s))\n");
        return 0;
    }

    return build_merged_program();
}

func main_build_output_paths(base_name: u64, base_len: u64) -> MainOutputPaths {
    var paths: MainOutputPaths;
    var target: u64 = compiler_target();
    if (target == COMPILER_TARGET_WINDOWS_X86_64) {
        paths.asm_path = str_concat(base_name, base_len, ".asm", 4);
        paths.obj_path = str_concat(base_name, base_len, ".obj", 4);
        paths.exe_path = str_concat(base_name, base_len, ".exe", 4);
        return paths;
    }
    paths.asm_path = str_concat(base_name, base_len, ".s", 2);
    paths.obj_path = str_concat(base_name, base_len, ".o", 2);
    paths.exe_path = str_concat(base_name, base_len, ".out", 4);
    return paths;
}

func main_build_llvm_paths(base_name: u64, base_len: u64) -> MainLLVMPaths {
    var paths: MainLLVMPaths;
    paths.ll_path = str_concat(base_name, base_len, ".ll", 3);
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64) {
        paths.obj_path = str_concat(base_name, base_len, ".llvm.obj", 9);
        paths.exe_path = str_concat(base_name, base_len, ".llvm.exe", 9);
        return paths;
    }
    paths.obj_path = str_concat(base_name, base_len, ".llvm.o", 7);
    paths.exe_path = str_concat(base_name, base_len, ".llvm.out", 9);
    return paths;
}

func main_restore_stdout(saved_fd: u64) -> u64 {
    os_sys_dup2(saved_fd, 1);
    sys_close(saved_fd);
    return 0;
}

func main_host_allows_target(target: u64) -> u64 {
    if (os_host_is_windows() != 0) {
        if (target == COMPILER_TARGET_WINDOWS_X86_64) { return 1; }
        return 0;
    }
    if (target == COMPILER_TARGET_LINUX_X86_64) { return 1; }
    return 0;
}

func main_emit_asm_file(asm_path: u64, merged_prog: *AstProgram) -> u64 {
    var flags: u64 = OS_O_WRONLY + OS_O_CREAT + OS_O_TRUNC;
    var fd_i: i64 = (i64)sys_open(asm_path, flags, 420);
    if (fd_i < 0) {
        emit_stderr("[ERROR] failed to open asm output: ");
        emit_stderr(asm_path);
        emit_stderr("\n");
        return 1;
    }
    var fd: u64 = (u64)fd_i;
    io_set_output_fd(fd);
    io_set_emit_buffering(1);

    diag_reset();
    if (artifact_cache_hit() != 0) {
        if (artifact_cache_emit_hit() == 0) { io_set_output_fd(0); sys_close(fd); return 1; }
    } else {
        artifact_cache_begin_output();
        program_with_sigs(merged_prog, get_func_sigs());
        artifact_cache_end_output(diag_has_errors() == 0);
    }
    io_set_emit_buffering(0);
    if (diag_has_errors() != 0) {
        io_set_output_fd(0);
        sys_close(fd);
        emit_stderr("[ERROR] code generation failed while emitting asm (");
        emit_u64_stderr(diag_count());
        emit_stderr(" error(s))\n");
        return 1;
    }
    io_set_output_fd(0);
    sys_close(fd);
    return 0;
}

const MAIN_EXEC_NOT_FOUND_STATUS = 32512; // 127 << 8

func main_status_exec_not_found(status: i64) -> u64 {
    if (status == MAIN_EXEC_NOT_FOUND_STATUS) { return 1; }
    if (os_host_is_windows() != 0 && status == -1) { return 1; }
    return 0;
}

func main_run_nasm(asm_path: u64, obj_path: u64) -> u64 {
    var nasm_argv: *Argv7 = new Argv7{};
    var nasm_format: u64 = (u64)"-felf64";
    var target: u64 = compiler_target();
    if (target == COMPILER_TARGET_WINDOWS_X86_64) {
        nasm_format = (u64)"-fwin64";
    }
    nasm_argv.a0 = (u64)"nasm";
    nasm_argv.a1 = nasm_format;
    nasm_argv.a2 = (u64)"-O1";
    nasm_argv.a3 = asm_path;
    nasm_argv.a4 = (u64)"-o";
    nasm_argv.a5 = obj_path;
    nasm_argv.a6 = 0;
    var nasm_status: i64 = 0;

    var nasm_override: u64 = nasm_path_with_ctx(compiler_ctx_current());
    if (nasm_override != 0) {
        nasm_argv.a0 = nasm_override;
        nasm_status = os_execute(nasm_override, (u64)nasm_argv);
        if (main_status_exec_not_found(nasm_status) != 0) {
            emit_stderr("[ERROR] assembler not found at nasm_path from bpp.toml: ");
            emit_stderr(nasm_override);
            emit_stderr("\n");
            return 1;
        }
        if (nasm_status != 0) {
            emit_stderr("[ERROR] nasm failed with status ");
            emit_i64_stderr(nasm_status);
            emit_stderr("\n");
            return 1;
        }
        return 0;
    }

    if (os_host_is_windows() != 0) {
        nasm_status = os_execute((u64)"nasm", (u64)nasm_argv);
        if (main_status_exec_not_found(nasm_status) != 0) {
            nasm_status = os_execute((u64)"nasm.exe", (u64)nasm_argv);
        }
        if (main_status_exec_not_found(nasm_status) != 0) {
            emit_stderr("[ERROR] nasm not found. Set nasm_path in bpp.toml or install nasm in PATH.\n");
            return 1;
        }
        if (nasm_status != 0) {
            emit_stderr("[ERROR] nasm failed with status ");
            emit_i64_stderr(nasm_status);
            emit_stderr("\n");
            return 1;
        }
        return 0;
    }

    nasm_status = os_execute((u64)"/usr/bin/nasm", (u64)nasm_argv);
    if (main_status_exec_not_found(nasm_status) != 0) {
        nasm_status = os_execute((u64)"/usr/local/bin/nasm", (u64)nasm_argv);
    }
    if (main_status_exec_not_found(nasm_status) != 0) {
        nasm_status = os_execute((u64)"/bin/nasm", (u64)nasm_argv);
    }
    if (main_status_exec_not_found(nasm_status) != 0) {
        var env_argv: *Argv8 = new Argv8{};
        env_argv.a0 = (u64)"env";
        env_argv.a1 = (u64)"nasm";
        env_argv.a2 = nasm_format;
        env_argv.a3 = (u64)"-O1";
        env_argv.a4 = asm_path;
        env_argv.a5 = (u64)"-o";
        env_argv.a6 = obj_path;
        env_argv.a7 = 0;
        nasm_status = os_execute((u64)"/usr/bin/env", (u64)env_argv);
        if (main_status_exec_not_found(nasm_status) != 0) {
            nasm_status = os_execute((u64)"/bin/env", (u64)env_argv);
        }
    }

    if (main_status_exec_not_found(nasm_status) != 0) {
        emit_stderr("[ERROR] nasm not found. Set nasm_path in bpp.toml or install nasm in PATH.\n");
        return 1;
    }
    if (nasm_status != 0) {
        emit_stderr("[ERROR] nasm failed with status ");
        emit_i64_stderr(nasm_status);
        emit_stderr("\n");
        return 1;
    }
    return 0;
}

func main_run_ld(obj_path: u64, exe_path: u64) -> u64 {
    if (os_host_is_windows() != 0) {
        var out_arg: u64 = str_concat("/out:", 5, exe_path, str_len(exe_path));
        var link_argv: *Argv10 = new Argv10{};
        link_argv.a0 = (u64)"link.exe";
        link_argv.a1 = (u64)"/nologo";
        link_argv.a2 = (u64)"/Brepro";
        link_argv.a3 = (u64)"/subsystem:console";
        link_argv.a4 = (u64)"/entry:mainCRTStartup";
        link_argv.a5 = out_arg;
        link_argv.a6 = obj_path;
        link_argv.a7 = (u64)"kernel32.lib";
        link_argv.a8 = 0;
        var link_status: i64 = 0;

        var ld_override2: u64 = ld_path_with_ctx(compiler_ctx_current());
        if (ld_override2 != 0) {
            link_argv.a0 = ld_override2;
            link_status = os_execute(ld_override2, (u64)link_argv);
            if (main_status_exec_not_found(link_status) != 0) {
                emit_stderr("[ERROR] linker not found at ld_path from bpp.toml: ");
                emit_stderr(ld_override2);
                emit_stderr("\n");
                return 1;
            }
            if (link_status != 0) {
                emit_stderr("[ERROR] linker failed with status ");
                emit_i64_stderr(link_status);
                emit_stderr("\n");
                return 1;
            }
            return 0;
        }

        link_status = os_execute((u64)"link.exe", (u64)link_argv);
        if (main_status_exec_not_found(link_status) != 0) {
            link_argv.a0 = (u64)"lld-link.exe";
            link_status = os_execute((u64)"lld-link.exe", (u64)link_argv);
        }
        if (main_status_exec_not_found(link_status) != 0) {
            link_argv.a0 = (u64)"lld-link";
            link_status = os_execute((u64)"lld-link", (u64)link_argv);
        }
        if (main_status_exec_not_found(link_status) != 0) {
            emit_stderr("[ERROR] no Windows linker found. Set ld_path in bpp.toml or install link.exe/lld-link.\n");
            return 1;
        }
        if (link_status != 0) {
            emit_stderr("[ERROR] linker failed with status ");
            emit_i64_stderr(link_status);
            emit_stderr("\n");
            return 1;
        }
        return 0;
    }

    var ld_argv: *Argv5 = new Argv5{};
    ld_argv.a0 = (u64)"ld";
    ld_argv.a1 = obj_path;
    ld_argv.a2 = (u64)"-o";
    ld_argv.a3 = exe_path;
    ld_argv.a4 = 0;
    var ld_status: i64 = 0;

    var ld_override: u64 = ld_path_with_ctx(compiler_ctx_current());
    if (ld_override != 0) {
        ld_argv.a0 = ld_override;
        ld_status = os_execute(ld_override, (u64)ld_argv);
        if (main_status_exec_not_found(ld_status) != 0) {
            emit_stderr("[ERROR] linker not found at ld_path from bpp.toml: ");
            emit_stderr(ld_override);
            emit_stderr("\n");
            return 1;
        }
        if (ld_status != 0) {
            emit_stderr("[ERROR] ld failed with status ");
            emit_i64_stderr(ld_status);
            emit_stderr("\n");
            return 1;
        }
        return 0;
    }

    ld_status = os_execute((u64)"/usr/bin/ld", (u64)ld_argv);
    if (main_status_exec_not_found(ld_status) != 0) {
        ld_status = os_execute((u64)"/usr/local/bin/ld", (u64)ld_argv);
    }
    if (main_status_exec_not_found(ld_status) != 0) {
        ld_status = os_execute((u64)"/bin/ld", (u64)ld_argv);
    }
    if (main_status_exec_not_found(ld_status) != 0) {
        var env_ld_argv: *Argv6 = new Argv6{};
        env_ld_argv.a0 = (u64)"env";
        env_ld_argv.a1 = (u64)"ld";
        env_ld_argv.a2 = obj_path;
        env_ld_argv.a3 = (u64)"-o";
        env_ld_argv.a4 = exe_path;
        env_ld_argv.a5 = 0;
        ld_status = os_execute((u64)"/usr/bin/env", (u64)env_ld_argv);
        if (main_status_exec_not_found(ld_status) != 0) {
            ld_status = os_execute((u64)"/bin/env", (u64)env_ld_argv);
        }
    }

    if (main_status_exec_not_found(ld_status) != 0) {
        emit_stderr("[ERROR] ld not found. Set ld_path in bpp.toml or install ld in PATH.\n");
        return 1;
    }
    if (ld_status != 0) {
        emit_stderr("[ERROR] ld failed with status ");
        emit_i64_stderr(ld_status);
        emit_stderr("\n");
        return 1;
    }
    return 0;
}

func main_run_output(exe_path: u64) -> u64 {
    var exe_argv: *Argv2 = new Argv2{};
    exe_argv.a0 = exe_path;
    exe_argv.a1 = 0;
    var status: i64 = os_execute(exe_path, (u64)exe_argv);
    emit("[RUN] exit=");
    print_i64(status);
    emit("\n");
    return 0;
}

func main_emit_llvm_file(ll_path: u64, merged_prog: *AstProgram) -> u64 {
    if (annotation_dump_llvm_ll_skeleton_to_path(merged_prog, slice(ll_path, str_len(ll_path))) == 0) {
        emit_stderr("[ERROR] failed to write LLVM ll output: ");
        emit_stderr(ll_path);
        emit_stderr("\n");
        return 1;
    }
    return 0;
}

func main_run_clang_ir(ll_path: u64, exe_path: u64) -> u64 {
    if (os_host_is_windows() != 0) {
        emit_stderr("[ERROR] -llvm-build is not wired for Windows host execution yet\n");
        return 1;
    }
    var clang_argv: *Argv10 = new Argv10{};
    clang_argv.a0 = (u64)"clang";
    clang_argv.a1 = (u64)"-x";
    clang_argv.a2 = (u64)"ir";
    clang_argv.a3 = (u64)"-B";
    clang_argv.a4 = (u64)"/usr/bin";
    clang_argv.a5 = ll_path;
    clang_argv.a6 = (u64)"-o";
    clang_argv.a7 = exe_path;
    clang_argv.a8 = 0;

    var clang_status: i64 = os_execute((u64)"/usr/bin/clang", (u64)clang_argv);
    if (main_status_exec_not_found(clang_status) != 0) {
        clang_status = os_execute((u64)"/usr/local/bin/clang", (u64)clang_argv);
    }
    if (main_status_exec_not_found(clang_status) != 0) {
        clang_status = os_execute((u64)"/bin/clang", (u64)clang_argv);
    }
    if (main_status_exec_not_found(clang_status) != 0) {
        emit_stderr("[ERROR] clang not found. Install clang or add it to PATH.\n");
        return 1;
    }
    if (clang_status != 0) {
        emit_stderr("[ERROR] clang failed with status ");
        emit_i64_stderr(clang_status);
        emit_stderr("\n");
        return 1;
    }
    return 0;
}

func main_run_clang_windows_obj(ll_path: u64, obj_path: u64) -> u64 {
    var clang_argv: *Argv10 = new Argv10{};
    clang_argv.a0 = (u64)"clang";
    clang_argv.a1 = (u64)"-target";
    clang_argv.a2 = (u64)"x86_64-pc-windows-msvc";
    clang_argv.a3 = (u64)"-x";
    clang_argv.a4 = (u64)"ir";
    clang_argv.a5 = (u64)"-c";
    clang_argv.a6 = ll_path;
    clang_argv.a7 = (u64)"-o";
    clang_argv.a8 = obj_path;
    clang_argv.a9 = 0;

    var clang_status: i64 = os_execute((u64)"/usr/bin/clang", (u64)clang_argv);
    if (main_status_exec_not_found(clang_status) != 0) {
        clang_status = os_execute((u64)"/usr/local/bin/clang", (u64)clang_argv);
    }
    if (main_status_exec_not_found(clang_status) != 0) {
        clang_status = os_execute((u64)"/bin/clang", (u64)clang_argv);
    }
    if (main_status_exec_not_found(clang_status) != 0) {
        emit_stderr("[ERROR] clang not found. Install clang or add it to PATH.\n");
        return 1;
    }
    if (clang_status != 0) {
        emit_stderr("[ERROR] clang windows object build failed with status ");
        emit_i64_stderr(clang_status);
        emit_stderr("\n");
        return 1;
    }
    return 0;
}

func main_emit_llvm_and_run(base_name: u64, base_len: u64, merged_prog: *AstProgram) -> u64 {
    var paths: MainLLVMPaths = main_build_llvm_paths(base_name, base_len);
    if (main_emit_llvm_file(paths.ll_path, merged_prog) != 0) { return 1; }
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64) {
        if (main_run_clang_windows_obj(paths.ll_path, paths.obj_path) != 0) { return 1; }
        emit("[OK] llvm ll: ");
        emit(paths.ll_path);
        emit("\n");
        emit("[OK] llvm obj: ");
        emit(paths.obj_path);
        emit("\n");
        emit("[SKIP] llvm run: windows-x86_64 target emits COFF object; link/run requires Windows runtime policy\n");
        return 0;
    }
    if (compiler_target() != COMPILER_TARGET_LINUX_X86_64) {
        emit_stderr("[ERROR] -llvm-build target is not supported\n");
        return 1;
    }
    if (main_run_clang_ir(paths.ll_path, paths.exe_path) != 0) { return 1; }
    emit("[OK] llvm ll: ");
    emit(paths.ll_path);
    emit("\n");
    emit("[OK] llvm exe: ");
    emit(paths.exe_path);
    emit("\n");
    if (main_run_output(paths.exe_path) != 0) { return 1; }
    return 0;
}

func main_emit_and_run(base_name: u64, base_len: u64, merged_prog: *AstProgram) -> u64 {
    var paths: MainOutputPaths = main_build_output_paths(base_name, base_len);
    var asm_path: u64 = paths.asm_path;
    var obj_path: u64 = paths.obj_path;
    var exe_path: u64 = paths.exe_path;

    if (main_emit_asm_file(asm_path, merged_prog) != 0) { return 1; }
    if (main_run_nasm(asm_path, obj_path) != 0) { return 1; }
    if (main_run_ld(obj_path, exe_path) != 0) { return 1; }

    emit("[OK] output: ");
    emit(exe_path);
    emit("\n");
    if (main_run_output(exe_path) != 0) { return 1; }
    return 0;
}

func main_emit_source_map_stdout(merged_prog: *AstProgram) -> u64 {
    diag_reset();
    if (opt_source_map_user_only() != 0 && opt_source_map_file_ptr() != 0) {
        asm_source_capture_set_filter_file(opt_source_map_file_ptr(), opt_source_map_file_len());
    }
    asm_source_capture_start(1);
    program_with_sigs(merged_prog, get_func_sigs());
    asm_source_capture_stop();
    asm_source_capture_clear_filter();
    if (diag_has_errors() != 0) {
        emit_stderr("[ERROR] ASM source map generation failed (");
        emit_u64_stderr(diag_count());
        emit_stderr(" error(s))\n");
        return 1;
    }
    asm_source_capture_dump_json();
    return 0;
}

func main_emit_unified_json_stdout(merged_prog: *AstProgram, ast_filter: *AstDumpFilter, source_file: u64, source_file_len: u64) -> u64 {
    emit("{\"schemaVersion\":1,\"sourceRangeSemantics\":{\"endColumn\":\"exclusive\",\"columnEncoding\":\"byte\",\"offsetEncoding\":\"byte\"},\"views\":{");
    var views: u64 = opt_get_unified_views();
    var wrote_view: u64 = 0;

    if ((views & UNIFIED_VIEW_AST) != 0) {
        emit("\"ast\":");
        ast_dump_program_json_filtered(merged_prog, ast_filter);
        wrote_view = 1;
    }

    var old_ir_mode: u64 = opt_get_ir_mode();
    if ((views & UNIFIED_VIEW_IR) != 0) {
        if (wrote_view != 0) { emit(","); }
        emit("\"ir\":");
        opt_set_ir_mode(IR_3ADDR);
        diag_reset();
        program_with_sigs_ir_json(merged_prog, get_func_sigs());
        opt_set_ir_mode(old_ir_mode);
        if (diag_has_errors() != 0) {
            emit_stderr("[ERROR] unified JSON IR generation failed (");
            emit_u64_stderr(diag_count());
            emit_stderr(" error(s))\n");
            return 1;
        }
        wrote_view = 1;
    }

    if ((views & UNIFIED_VIEW_SSA) != 0) {
        if (wrote_view != 0) { emit(","); }
        emit("\"ssa\":");
        opt_set_ir_mode(IR_SSA);
        diag_reset();
        program_with_sigs_ir_json(merged_prog, get_func_sigs());
        opt_set_ir_mode(old_ir_mode);
        if (diag_has_errors() != 0) {
            emit_stderr("[ERROR] unified JSON SSA generation failed (");
            emit_u64_stderr(diag_count());
            emit_stderr(" error(s))\n");
            return 1;
        }
        wrote_view = 1;
    }

    if ((views & UNIFIED_VIEW_ASM) != 0) {
        if (wrote_view != 0) { emit(","); }
        emit("\"asm\":");
        diag_reset();
        if (opt_source_map_user_only() != 0) {
            if (opt_source_map_file_ptr() != 0) {
                asm_source_capture_set_filter_file(opt_source_map_file_ptr(), opt_source_map_file_len());
            } else {
                asm_source_capture_set_filter_file(source_file, source_file_len);
            }
        }
        asm_source_capture_start(1);
        program_with_sigs(merged_prog, get_func_sigs());
        asm_source_capture_stop();
        asm_source_capture_clear_filter();
        if (diag_has_errors() != 0) {
            emit_stderr("[ERROR] unified JSON ASM generation failed (");
            emit_u64_stderr(diag_count());
            emit_stderr(" error(s))\n");
            return 1;
        }
        asm_source_capture_dump_json();
    }
    emit("}}\n");
    return 0;
}

func main_output_requires_semantic_gate(out_mode: u64) -> u64 {
    if (out_mode == OUT_LLVM_CONTRACT || out_mode == OUT_LLVM_PROTO) { return 1; }
    if (out_mode == OUT_UNIFIED_JSON) {
        var non_ast_views: u64 = opt_get_unified_views() & (UNIFIED_VIEW_IR | UNIFIED_VIEW_SSA | UNIFIED_VIEW_ASM);
        if (non_ast_views != 0) { return 1; }
    }
    return 0;
}

func main_bytes_contains(haystack: u64, haystack_len: u64, needle: u64, needle_len: u64) -> u64 {
    if (needle_len == 0 || needle_len > haystack_len) { return 0; }
    var h: *u8 = (*u8)haystack;
    var n: *u8 = (*u8)needle;
    for (var i: u64 = 0; i + needle_len <= haystack_len; i++) {
        var same: u64 = 1;
        for (var j: u64 = 0; j < needle_len; j++) {
            if (h[i + j] != n[j]) { same = 0; break; }
        }
        if (same != 0) { return 1; }
    }
    return 0;
}

func main_compile_expected_failure(filename: u64, filename_len: u64, opt_level: u64, use_ssa: u64) -> u64 {
    opt_init_defaults();
    opt_set_level(opt_level);
    opt_set_output_mode(OUT_ASM);
    if (use_ssa != 0) { opt_set_ir_mode(IR_SSA); }
    begin_batch_error_capture();
    // 0: compiled successfully, 1: failed before backend emission,
    // 2: failed during backend emission. The batch driver uses this structural
    // boundary instead of guessing the phase from diagnostic wording.
    var failure_kind: u64 = 0;
    if (setup_paths_with_compiler(filename, filename_len) == 0) {
        failure_kind = 1;
    } else {
        compiler_target_set_with_ctx(compiler_ctx_current(), COMPILER_TARGET_WINDOWS_X86_64);
        var merged_prog: *AstProgram = main_run_compile_pipeline(filename, filename_len);
        if (merged_prog == 0 || diag_has_errors() != 0) {
            failure_kind = 1;
        } else {
            io_set_emit_buffering(1);
            var emit_failure_kind: u64 = program_with_sigs(merged_prog, get_func_sigs());
            io_set_emit_buffering(0);
            if (diag_has_errors() != 0) {
                if (emit_failure_kind == 1) { failure_kind = 1; }
                else { failure_kind = 2; }
            }
        }
    }
    end_batch_error_capture();
    return failure_kind;
}

// Compile expected-failure groups inside one hosted process. Each manifest line
// is `<mode-mask>\t<opt-mask>\t<absolute-source-path>`; bit 0 is legacy/O0 and
// bit 1 is SSA/O1. A front-end-tagged diagnostic needs one request, an untagged
// backend diagnostic keeps one request per backend, and explicitly tagged
// backend/codegen failures retain the complete requested matrix.
func main_run_failure_batch(manifest_path: u64) -> u64 {
    var manifest_ptr: u64 = 0;
    var manifest_len: u64 = 0;
    var recording: u64 = heap_owned_alloc_recording_suspend();
    var manifest: u64 = source_read_entire_file(manifest_path, &manifest_ptr, &manifest_len);
    heap_owned_alloc_recording_restore(recording);
    if (manifest == 0) {
        emit_stderr("[ERROR] cannot read failure batch manifest\n");
        return 1;
    }
    var manifest_bytes: *u8 = (*u8)manifest;
    var null_fd_i: i64 = (i64)sys_open("NUL", OS_O_WRONLY, 0);
    if (null_fd_i < 0) {
        heap_free(manifest_ptr);
        emit_stderr("[ERROR] cannot open batch output sink\n");
        return 1;
    }
    var null_fd: u64 = (u64)null_fd_i;

    var pos: u64 = 0;
    var request_index: u64 = 0;
    for (; pos < manifest_len; ) {
        var line_start: u64 = pos;
        for (; pos < manifest_len && manifest_bytes[pos] != (u8)10; ) { pos = pos + 1; }
        var line_end: u64 = pos;
        if (pos < manifest_len) { pos = pos + 1; }
        if (line_end > line_start && manifest_bytes[line_end - 1] == (u8)13) { line_end = line_end - 1; }
        if (line_end <= line_start) { continue; }

        var first_tab: u64 = line_start;
        for (; first_tab < line_end && manifest_bytes[first_tab] != (u8)9; ) { first_tab = first_tab + 1; }
        var second_tab: u64 = first_tab + 1;
        for (; second_tab < line_end && manifest_bytes[second_tab] != (u8)9; ) { second_tab = second_tab + 1; }
        if (first_tab >= line_end || second_tab >= line_end || second_tab + 1 >= line_end) {
            heap_free(manifest_ptr);
            emit_stderr("[ERROR] invalid failure batch manifest line\n");
            return 1;
        }

        var mode_mask: u64 = (u64)manifest_bytes[line_start] - (u64)((u8)'0');
        var opt_mask: u64 = (u64)manifest_bytes[first_tab + 1] - (u64)((u8)'0');
        var filename: u64 = manifest + second_tab + 1;
        var filename_len: u64 = line_end - second_tab - 1;
        manifest_bytes[line_end] = 0;

        io_set_output_fd(null_fd);
        var canonical_mode: u64 = 0;
        if ((mode_mask & 1) == 0) { canonical_mode = 1; }
        var canonical_opt: u64 = 0;
        if ((opt_mask & 1) == 0) { canonical_opt = 1; }
        var canonical_failure_kind: u64 = main_compile_expected_failure(filename, filename_len, canonical_opt, canonical_mode);
        var all_failed: u64 = canonical_failure_kind != 0;
        var canonical_diag_len: u64 = error_capture_len();
        var canonical_diag: u64 = heap_alloc(canonical_diag_len + 1);
        if (canonical_diag_len != 0) { memcopy(canonical_diag, error_capture_ptr(), canonical_diag_len); }
        var canonical_diag_bytes: *u8 = (*u8)canonical_diag;
        canonical_diag_bytes[canonical_diag_len] = 0;

        // Untagged diagnostics are language-semantic failures and share one
        // canonical request. Explicit backend/SSA diagnostics retain the full
        // requested backend and optimization matrix.
        var backend_tagged: u64 = 0;
        if (main_bytes_contains(canonical_diag, canonical_diag_len, "[ERROR][backend]", 16) != 0 ||
            main_bytes_contains(canonical_diag, canonical_diag_len, "[ERROR][codegen]", 16) != 0 ||
            main_bytes_contains(canonical_diag, canonical_diag_len, "[ERROR][ssa]", 12) != 0 ||
            main_bytes_contains(canonical_diag, canonical_diag_len, "[ERROR][ssa-preservation]", 25) != 0) {
            backend_tagged = 1;
        }

        if (all_failed != 0 && canonical_failure_kind == 2 && backend_tagged != 0) {
            for (var mode: u64 = 0; mode < 2; mode++) {
                if ((mode_mask & (1 << mode)) == 0) { continue; }
                for (var level: u64 = 0; level < 2; level++) {
                    if ((opt_mask & (1 << level)) == 0) { continue; }
                    if (mode == canonical_mode && level == canonical_opt) { continue; }
                    if (main_compile_expected_failure(filename, filename_len, level, mode) == 0) { all_failed = 0; }
                }
            }
        }
        io_set_output_fd(1);

        emit("BPPB ");
        emit_u64(request_index);
        emit(" ");
        emit_u64(all_failed);
        emit(" ");
        emit_u64(canonical_diag_len);
        emit_nl();
        if (canonical_diag_len != 0) { emit_len(canonical_diag, canonical_diag_len); }
        emit_nl();
        heap_free(canonical_diag);
        request_index = request_index + 1;
    }
    sys_close(null_fd);
    heap_free(manifest_ptr);
    return 0;
}


func main(argc: u64, argv: u64) -> u64 {
    init_stack_trace();
    bpp_gc_set_auto(0, 0);
    bpp_gc_set_edge_tracking(0);
    bpp_gc_set_root_slot_tracking(0);

    var argv_ptr: *u64 = (*u64)argv;

    if (argc == 3 && str_eq(slice(argv_ptr[1], str_len(argv_ptr[1])), slice("--batch-fail-manifest", 21))) {
        return main_run_failure_batch(argv_ptr[2]);
    }

    var cli: MainCliParseResult = main_parse_cli(argc, argv_ptr);
    if (cli.ok == 0) {
        main_print_usage();
        return 1;
    }
    if (cli.timings_json_path.ptr != 0) {
        timings_enable(cli.timings_json_path);
    }
    defer timings_write_json();
    var filename: u64 = cli.filename;

    var filename_len: u64 = str_len(filename);
    if (opt_source_map_user_only() != 0 && opt_source_map_file_ptr() == 0) {
        opt_source_map_set_file(filename, filename_len);
    }

    if (setup_paths_with_compiler(filename, filename_len) == 0) {
        return 1;
    }
    if (cli.target_override != 0) {
        if (compiler_target_set_with_ctx(compiler_ctx_current(), cli.target_override) == 0) {
            return 1;
        }
    }

    push_trace("main", "main.bpp", __LINE__);
    defer pop_trace();

    if (cli.cache_disabled == 0) { artifact_cache_configure(cli.cache_dir, cli.cache_report, argc, argv_ptr); }
    defer artifact_cache_release();

    var merged_prog: *AstProgram = 0;
    if (artifact_cache_preparse_probe() == 0) {
        merged_prog = main_run_compile_pipeline(filename, filename_len);
    }
    if (merged_prog == 0 && artifact_cache_hit() == 0) {
        return 1;
    }

    var out_mode: u64 = opt_get_output_mode();
    var target: u64 = compiler_target();
    var base_name: u64 = path_basename_noext(filename, filename_len);
    var base_len: u64 = str_len(base_name);
    var ast_filter: AstDumpFilter;
    var ast_filter_func_name: []u8 = cli.ast_filter_func_name;
    var ast_filter_module_name: []u8 = cli.ast_filter_module_name;
    ast_filter.func_name = ast_filter_func_name;
    ast_filter.module_name = ast_filter_module_name;
    ast_filter.no_std = cli.ast_filter_no_std;

    if (out_mode == OUT_EXEC && main_host_allows_target(target) == 0) {
        emit_stderr("[ERROR] target ");
        emit_stderr(compiler_target_name(target));
        emit_stderr(" cannot be executed on this host.\n");
        emit_stderr("[ERROR] Use -asm for cross-target assembly output, or run a matching hosted compiler.\n");
        return 1;
    }

    if (main_output_requires_semantic_gate(out_mode) != 0) {
        diag_reset();
        if (validate_program_semantics(merged_prog) == 0 || diag_has_errors() != 0) {
            emit_stderr("[ERROR] semantic validation failed (");
            emit_u64_stderr(diag_count());
            emit_stderr(" error(s))\n");
            return 1;
        }
    }

    match (out_mode) {
        case OUT_AST:
            ast_dump_program_filtered(merged_prog, &ast_filter);
            break;
        case OUT_AST_GRAPH:
            ast_dump_program_dot_filtered(merged_prog, &ast_filter);
            break;
        case OUT_AST_JSON:
            ast_dump_program_json_filtered(merged_prog, &ast_filter);
            break;
        case OUT_IR:
            diag_reset();
            program_with_sigs_ir(merged_prog, get_func_sigs());
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] IR generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_IR_JSON:
            diag_reset();
            program_with_sigs_ir_json(merged_prog, get_func_sigs());
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] IR JSON generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_LLVM_CONTRACT:
            diag_reset();
            if (annotation_dump_llvm_contract_adapter_stdout(merged_prog) == 0) {
                emit_stderr("[ERROR] LLVM contract adapter generation failed\n");
                return 1;
            }
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] LLVM contract adapter generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_LLVM_PROTO:
            diag_reset();
            if (annotation_dump_llvm_contract_proto_stdout(merged_prog) == 0) {
                emit_stderr("[ERROR] LLVM contract prototype generation failed\n");
                return 1;
            }
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] LLVM contract prototype generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_LLVM_LL:
            diag_reset();
            if (annotation_dump_llvm_ll_skeleton_stdout(merged_prog) == 0) {
                emit_stderr("[ERROR] LLVM ll skeleton generation failed\n");
                return 1;
            }
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] LLVM ll skeleton generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_OPT_REPORT:
            diag_reset();
            if (annotation_dump_llvm_ll_skeleton_stdout(merged_prog) == 0) {
                emit_stderr("[ERROR] optimization report generation failed\n");
                return 1;
            }
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] optimization report generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_LLVM_BUILD:
            diag_reset();
            if (main_emit_llvm_and_run(base_name, base_len, merged_prog) != 0) {
                return 1;
            }
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] LLVM build failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_ASM:
            diag_reset();
            io_set_emit_buffering(1);
            if (artifact_cache_hit() != 0) {
                if (artifact_cache_emit_hit() == 0) { io_set_emit_buffering(0); return 1; }
            } else {
                artifact_cache_begin_output();
                program_with_sigs(merged_prog, get_func_sigs());
                artifact_cache_end_output(diag_has_errors() == 0);
            }
            io_set_emit_buffering(0);
            if (diag_has_errors() != 0) {
                emit_stderr("[ERROR] ASM generation failed (");
                emit_u64_stderr(diag_count());
                emit_stderr(" error(s))\n");
                return 1;
            }
            break;
        case OUT_SOURCE_MAP:
            if (main_emit_source_map_stdout(merged_prog) != 0) {
                return 1;
            }
            break;
        case OUT_UNIFIED_JSON:
            if (main_emit_unified_json_stdout(merged_prog, &ast_filter, filename, filename_len) != 0) {
                return 1;
            }
            break;
        default:
            if (main_emit_and_run(base_name, base_len, merged_prog) != 0) {
                return 1;
            }
            break;
    }
    
    return 0;
}
