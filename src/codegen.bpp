// codegen.b - Code generator wrapper for v3.13
//
// This is a thin wrapper that re-exports functionality from:
// - symtab.b: Symbol table management
// - typeinfo.b: Type size/compatibility calculations
// - emitter.b: ASM output helpers and global state
// - gen_expr.b: Expression code generation
// - gen_stmt.b: Statement code generation

import std.io;
import std.util;
import std.str;
import types;
import std.vec;
import std.hashmap;
import ast;
import compiler;
import compiler.core_utils;
import compiler.generic.engine;
import compiler.symbol_runtime;
import compiler.annotations;
import compiler.runtime_api;
import compiler.ast_lowering;
import compiler.timings;
import compiler.incremental_cache;
import llvm.contract_adapter;
import ssa.datastruct;
import ssa;
import ssa_context_release_aux from ssa.core;
import run as to_ssa from ssa.mem2reg;
import run as optimize_ssa from ssa.opt_pipeline;
import run as lower_phi from ssa.destroy;
import run as allocate_regs from ssa.regalloc;
import run as lower_phys from ssa.lower_phys;
import emit_func as emit_ssa_func from ssa.codegen;
import is_supported_func from ssa.codegen;
import dump as dump_ssa from ssa.dump;
import dump_machine as dump_machine_ir from ssa.dump;
import dump_json as dump_ssa_json from ssa.dump;
import opt;
import emitter.symtab;
import emitter.typeinfo;
import emitter.emitter;
import emitter.gen.expr;
import emitter.gen.stmt;

const CODEGEN_DEBUG = 0;

const CG_USED_HAS_CALL_PTR = 1;
const CG_USED_HAS_METHOD_CALL = 2;
const CG_USED_HAS_FUNC_ADDR = 4;
const CG_USED_HAS_BINARY = 8;
var g_codegen_trace_runtime_touches: u64;
var g_codegen_used_name_budget: u64;
var g_codegen_used_name_budget_exceeded: u64;
var g_codegen_gc_runtime_needed: u64;
var g_codegen_gc_runtime_reason: u64;
func used_mark_flag(flags_ptr: u64, mask: u64) -> u64 {
    *(flags_ptr) = *(flags_ptr) | mask;
    return 0;
}

func used_has_name(used: *Vec<*NameInfo>, name: []u8) -> u64 {
    if (used == 0) { return false; }
    if (g_compiler_ctx.codegen_used_name_membership != 0) {
        return g_compiler_ctx.codegen_used_name_membership.get(slice(name.ptr, name.len)) != 0;
    }
    var n: u64 = used.len();
    for (var i: u64 = 0; i < n; i++) {
        var info: *NameInfo = used.get(i);
        var ptr: u64 = info.ptr;
        var len: u64 = info.len;
        if (len == name.len && str_eq(slice(ptr, len), name) != 0) { return true; }
    }
    return false;
}

func used_has_name_prefix(used: *Vec<*NameInfo>, prefix: []u8) -> u64 {
    if (used == 0 || prefix.ptr == 0 || prefix.len == 0) { return false; }
    var n: u64 = used.len();
    for (var i: u64 = 0; i < n; i++) {
        var info: *NameInfo = used.get(i);
        if (info == 0 || info.len < prefix.len) { continue; }
        if (str_eq(slice(info.ptr, prefix.len), prefix) != 0) { return true; }
    }
    return false;
}

func codegen_name_has_prefix(name: []u8, prefix: []u8) -> u64 {
    if (name.ptr == 0 || prefix.ptr == 0 || name.len < prefix.len) { return 0; }
    return str_eq(slice(name.ptr, prefix.len), prefix) != 0;
}

func codegen_name_has_suffix(name: []u8, suffix: []u8) -> u64 {
    if (name.ptr == 0 || suffix.ptr == 0 || name.len < suffix.len) { return 0; }
    return str_eq(slice(name.ptr + name.len - suffix.len, suffix.len), suffix) != 0;
}

func codegen_name_contains(name: []u8, needle: []u8) -> u64 {
    if (name.ptr == 0 || needle.ptr == 0 || needle.len == 0 || name.len < needle.len) { return 0; }
    var limit: u64 = name.len - needle.len;
    for (var i: u64 = 0; i <= limit; i++) {
        if (str_eq(slice(name.ptr + i, needle.len), needle) != 0) { return 1; }
    }
    return 0;
}

func used_add_name(used: *Vec<*NameInfo>, name: []u8) -> u64 {
    if (used_has_name(used, name) != 0) { return false; }
    if (g_codegen_used_name_budget != 0 && used.len() >= g_codegen_used_name_budget) {
        g_codegen_used_name_budget_exceeded = 1;
        return false;
    }
    var info: *NameInfo = new NameInfo{name.ptr, name.len};
    used.push(info);
    if (g_compiler_ctx.codegen_used_name_membership != 0) {
        g_compiler_ctx.codegen_used_name_membership.put(slice(name.ptr, name.len), 1);
    }
    return true;
}

func used_add_resolved_name(used: *Vec<*NameInfo>, name: []u8) -> u64 {
    var resolved: *NameInfo = resolve_name(slice(name.ptr, name.len));
    if (resolved != 0) {
        name = slice(resolved.ptr, resolved.len);
    }
    return used_add_name(used, name);
}

func used_has_resolved_name(used: *Vec<*NameInfo>, name: []u8) -> u64 {
    var resolved: *NameInfo = resolve_name(slice(name.ptr, name.len));
    if (resolved != 0) {
        name = slice(resolved.ptr, resolved.len);
    }
    return used_has_name(used, name);
}

func collect_calls_in_args_vec(args: *Vec<*AstNode>, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    var n: u64 = 0;
    if (args != 0) { n = args.len(); }
    for (var i: u64 = 0; i < n; i++) {
        collect_calls_in_expr(args.get(i), used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_call(call: *AstCall, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    used_add_resolved_name(used, call.name);
    return collect_calls_in_args_vec(call.args_vec, used, flags_ptr);
}

func collect_calls_in_call_ptr(cp: *AstCallPtr, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    used_mark_flag(flags_ptr, CG_USED_HAS_CALL_PTR);
    collect_calls_in_expr(cp.callee, used, flags_ptr);
    return collect_calls_in_args_vec(cp.args_vec, used, flags_ptr);
}

func collect_calls_in_method_call(mc: *AstMethodCall, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(mc.receiver, used, flags_ptr);
    collect_calls_in_args_vec(mc.args_vec, used, flags_ptr);
    var resolved: u64 = 0;
    if (g_compiler_ctx.codegen_collect_used_symtab != 0) {
        var recv_ti: *TypeInfo = generic_infer_expr_type(mc.receiver, g_compiler_ctx.codegen_collect_used_symtab);
        if (recv_ti != 0 && recv_ti.type_kind == TYPE_STRUCT && u8_slice_ptr(recv_ti.struct_name) != 0 && u8_slice_len(recv_ti.struct_name) != 0) {
            var arg_count_hint: u64 = 0;
            if (mc.args_vec != 0) { arg_count_hint = mc.args_vec.len(); }
            var arg_types: *Vec<*TypeInfo> = generic_collect_call_arg_types(mc.args_vec, g_compiler_ctx.codegen_collect_used_symtab);
            var method_target: *AstFunc = lower_resolve_method_call_edge(recv_ti, mc.method, arg_types, arg_count_hint);
            if (method_target != 0) {
                used_add_resolved_name(used, method_target.name);
                resolved = 1;
            } else {
                var fallback_name: *NameInfo = build_method_name(recv_ti.struct_name, mc.method);
                if (fallback_name != 0) {
                    var resolved_fallback: *NameInfo = resolve_name(slice(fallback_name.ptr, fallback_name.len));
                    var fb_name: []u8 = slice(fallback_name.ptr, fallback_name.len);
                    if (resolved_fallback != 0) { fb_name = slice(resolved_fallback.ptr, resolved_fallback.len); }
                    if (sym_func_exists(fb_name) != 0) {
                        used_add_name(used, fb_name);
                        resolved = 1;
                    }
                }
            }
        }
    }
    if (resolved == 0) {
        used_mark_flag(flags_ptr, CG_USED_HAS_METHOD_CALL);
    }
    return 0;
}

func codegen_binary_preserves_struct_value(op: u64) -> u64 {
    if (op == TOKEN_PLUS) { return 1; }
    if (op == TOKEN_MINUS) { return 1; }
    if (op == TOKEN_STAR) { return 1; }
    if (op == TOKEN_SLASH) { return 1; }
    if (op == TOKEN_PERCENT) { return 1; }
    if (op == TOKEN_LSHIFT) { return 1; }
    if (op == TOKEN_RSHIFT) { return 1; }
    if (op == TOKEN_AMPERSAND) { return 1; }
    if (op == TOKEN_PIPE) { return 1; }
    if (op == TOKEN_CARET) { return 1; }
    return 0;
}

// SSA may synthesize an overloaded method call from a binary expression after
// reachability has run. Recover the receiver type for nested value operations
// using the same rule as the backend so those implicit callees are retained.
func codegen_infer_overloaded_receiver_type(expr: *AstNode, symtab: *HashMap<u64, *TypeInfo>) -> *TypeInfo {
    if (expr == 0 || symtab == 0) { return 0; }
    // Raw integer constants are scalar at this backend boundary. Generic
    // inference treats them as contextual Number values before lowering.
    if (generic_expr_is_integer_literal(expr) != 0) { return 0; }
    var ti: *TypeInfo = generic_infer_expr_type(expr, symtab);
    if (ti != 0 && ti.ptr_depth == 0 && ti.type_kind == TYPE_STRUCT) { return ti; }
    if (ast_kind(expr) != AST_BINARY) { return 0; }
    var bin: *AstBinary = (*AstBinary)expr;
    if (codegen_binary_preserves_struct_value(bin.op) == 0) { return 0; }
    return codegen_infer_overloaded_receiver_type(bin.left, symtab);
}

func collect_calls_in_binary(bin: *AstBinary, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(bin.left, used, flags_ptr);
    collect_calls_in_expr(bin.right, used, flags_ptr);
    var symtab: *HashMap<u64, *TypeInfo> = g_compiler_ctx.codegen_collect_used_symtab;
    if (symtab == 0) { return 0; }
    // Comparisons and logical operations do not preserve the receiver value;
    // Number lowers them through dedicated runtime paths, while user-defined
    // overloads have already become method-call nodes during parse lowering.
    if (codegen_binary_preserves_struct_value(bin.op) == 0) { return 0; }
    var method_name: NameInfo = compiler_operator_binary_name(bin.op);
    if (method_name.ptr == 0) { return 0; }
    var recv_ti: *TypeInfo = codegen_infer_overloaded_receiver_type(bin.left, symtab);
    if (recv_ti == 0) { return 0; }

    var arg_types: *Vec<*TypeInfo> = new Vec<*TypeInfo>{heap_alloc(sizeof(*TypeInfo)), 0, 1};
    // Match the SSA caller's overload type exactly. Integer literals are i64
    // at this late backend boundary; generic inference may contextualize them
    // as Number and retain a different overload.
    var arg_ti: *TypeInfo = 0;
    if (generic_expr_is_integer_literal(bin.right) != 0) {
        arg_ti = typeinfo_make(TYPE_I64, 0);
    } else {
        arg_ti = generic_infer_expr_type(bin.right, symtab);
    }
    if (arg_ti == 0) { arg_ti = codegen_infer_overloaded_receiver_type(bin.right, symtab); }
    arg_types.push(arg_ti);
    var target: *AstFunc = lower_resolve_method_call_edge(recv_ti, slice(method_name.ptr, method_name.len), arg_types, 1);
    arg_types.release_buffer();
    free((u64)arg_types);
    if (target != 0) {
        used_add_resolved_name(used, target.name);
    } else {
        // Preserve the conservative fallback for an overload that cannot be
        // resolved precisely, rather than silently dropping a generated edge.
        used_mark_flag(flags_ptr, CG_USED_HAS_BINARY);
    }
    return 0;
}

func collect_calls_in_unary(un: *AstUnary, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(un.operand, used, flags_ptr);
    var symtab: *HashMap<u64, *TypeInfo> = g_compiler_ctx.codegen_collect_used_symtab;
    if (symtab == 0) { return 0; }
    var recv_ti: *TypeInfo = codegen_infer_overloaded_receiver_type(un.operand, symtab);
    if (recv_ti == 0) { return 0; }

    // Operator declarations use the subtraction family for both binary and
    // unary '-', distinguished by overload arity. Other unary operators have
    // dedicated method families.
    var method_name: NameInfo;
    if (un.op == TOKEN_MINUS) {
        method_name = compiler_operator_binary_name(un.op);
    } else {
        method_name = compiler_operator_unary_name(un.op);
    }
    if (method_name.ptr == 0) { return 0; }
    var target: *AstFunc = lower_resolve_method_call_edge(recv_ti, slice(method_name.ptr, method_name.len), 0, 0);
    if (target != 0) {
        used_add_resolved_name(used, target.name);
    } else {
        used_mark_flag(flags_ptr, CG_USED_HAS_BINARY);
    }
    return 0;
}

func collect_calls_in_addr_of(ao: *AstAddrOf, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    var op_kind: u64 = ast_kind(ao.operand);
    if (op_kind == AST_IDENT) {
        var idn: *AstIdent = (*AstIdent)ao.operand;
        if (sym_func_exists(idn.name) != 0) {
            used_mark_flag(flags_ptr, CG_USED_HAS_FUNC_ADDR);
            used_add_resolved_name(used, idn.name);
        }
    }
    collect_calls_in_expr(ao.operand, used, flags_ptr);
    return 0;
}

func collect_calls_in_index(ix: *AstIndex, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(ix.base, used, flags_ptr);
    collect_calls_in_expr(ix.index, used, flags_ptr);
    return 0;
}

func collect_calls_in_new(nw: *AstNew, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    used_add_resolved_name(used, slice((u64)"malloc", 6));
    used_add_resolved_name(used, slice((u64)"memset", 6));

    if (nw.literal_expr != 0) {
        collect_calls_in_expr(nw.literal_expr, used, flags_ptr);
    }

    if (nw.ctor_args_vec != 0 && nw.type_kind == TYPE_STRUCT) {
        var method_ptr: u64 = (u64)"constructor";
        var method_len: u64 = 11;
        var name_info: *NameInfo = build_method_name(nw.struct_name, slice(method_ptr, method_len));
        used_add_resolved_name(used, slice(name_info.ptr, name_info.len));
        collect_calls_in_args_vec(nw.ctor_args_vec, used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_stack_ctor(sc: *AstStackCtor, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    used_add_resolved_name(used, slice((u64)"memset", 6));
    if (sc.ctor_args_vec != 0 && sc.type_kind == TYPE_STRUCT) {
        var method_ptr: u64 = (u64)"constructor";
        var method_len: u64 = 11;
        var name_info: *NameInfo = build_method_name(sc.struct_name, slice(method_ptr, method_len));
        used_add_resolved_name(used, slice(name_info.ptr, name_info.len));
        collect_calls_in_args_vec(sc.ctor_args_vec, used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_property_member(member: *AstMemberAccess, used: *Vec<*NameInfo>, is_write: u64) -> u64 {
    if (member == 0 || g_compiler_ctx.codegen_collect_used_symtab == 0) { return 0; }
    var recv_ti: *TypeInfo = generic_infer_expr_type(member.object, g_compiler_ctx.codegen_collect_used_symtab);
    if (recv_ti == 0 || recv_ti.type_kind != TYPE_STRUCT || u8_slice_ptr(recv_ti.struct_name) == 0) { return 0; }
    var struct_def: *AstStructDef = get_struct_def(recv_ti.struct_name);
    if (struct_def == 0) { return 0; }
    var field_offset: u64 = 0;
    var field: *FieldDesc = 0;
    if (struct_find_field_desc_scoped(struct_def, member.parent, member.member, &field_offset, &field) == 0 || field == 0) { return 0; }
    if (is_write != 0) {
        if (u8_slice_ptr(field.setter_hook) != 0 && u8_slice_len(field.setter_hook) != 0) {
            used_add_resolved_name(used, field.setter_hook);
        }
    } else {
        if (u8_slice_ptr(field.getter_hook) != 0 && u8_slice_len(field.getter_hook) != 0) {
            used_add_resolved_name(used, field.getter_hook);
        }
    }
    return 0;
}

func collect_calls_in_assign(assign: *AstAssign, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (assign == 0) { return 0; }
    var target_kind: u64 = ast_kind(assign.target);
    if (target_kind == AST_MEMBER_ACCESS || target_kind == AST_SAFE_MEMBER_ACCESS) {
        var target_member: *AstMemberAccess = (*AstMemberAccess)assign.target;
        collect_calls_in_property_member(target_member, used, 1);
        collect_calls_in_expr(target_member.object, used, flags_ptr);
    } else {
        collect_calls_in_expr(assign.target, used, flags_ptr);
    }
    collect_calls_in_expr(assign.value, used, flags_ptr);
    return 0;
}

func collect_calls_in_expr(node: *AstNode, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (node == 0) { return 0; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;
    match (kind) {
        case AST_IDENT:
            var ident: *AstIdent = nref.ident;
            if (ident != 0 && sym_func_exists(ident.name) != 0) {
                used_mark_flag(flags_ptr, CG_USED_HAS_FUNC_ADDR);
                used_add_resolved_name(used, ident.name);
            }
            return 0;
        case AST_CALL: return collect_calls_in_call(nref.call, used, flags_ptr);
        case AST_GENERIC_CALL:
            used_add_resolved_name(used, nref.generic_call.name);
            return collect_calls_in_args_vec(nref.generic_call.args_vec, used, flags_ptr);
        case AST_STATIC_GENERIC_CALL:
            return collect_calls_in_args_vec(nref.static_generic_call.args_vec, used, flags_ptr);
        case AST_CALL_PTR: return collect_calls_in_call_ptr(nref.call_ptr, used, flags_ptr);
        case AST_METHOD_CALL: return collect_calls_in_method_call(nref.method_call, used, flags_ptr);
        case AST_SAFE_METHOD_CALL: return collect_calls_in_method_call(nref.method_call, used, flags_ptr);
        case AST_BINARY: return collect_calls_in_binary(nref.binary, used, flags_ptr);
        case AST_UNARY: return collect_calls_in_unary(nref.unary, used, flags_ptr);
        case AST_ADDR_OF: return collect_calls_in_addr_of(nref.addr_of, used, flags_ptr);
        case AST_DEREF: return collect_calls_in_expr(nref.deref.operand, used, flags_ptr);
        case AST_DEREF8: return collect_calls_in_expr(nref.deref8.operand, used, flags_ptr);
        case AST_INDEX:
        case AST_SAFE_INDEX:
            return collect_calls_in_index(nref.index_expr, used, flags_ptr);
        case AST_CAST: return collect_calls_in_expr(nref.cast_expr.expr, used, flags_ptr);
        case AST_SIZEOF_EXPR: return collect_calls_in_expr(nref.sizeof_expr.expr, used, flags_ptr);
        case AST_MEMBER_ACCESS:
        case AST_SAFE_MEMBER_ACCESS:
            collect_calls_in_property_member(nref.member_access, used, 0);
            return collect_calls_in_expr(nref.member_access.object, used, flags_ptr);
        case AST_ASSIGN:
            return collect_calls_in_assign(nref.assign_stmt, used, flags_ptr);
        case AST_NEW: return collect_calls_in_new(nref.new_expr, used, flags_ptr);
        case AST_STACK_CTOR: return collect_calls_in_stack_ctor(nref.stack_ctor, used, flags_ptr);
        case AST_SLICE:
            used_add_resolved_name(used, slice("std_mem__bpp_return_slice_copy", str_len("std_mem__bpp_return_slice_copy")));
            collect_calls_in_expr(nref.slice_expr.ptr_expr, used, flags_ptr);
            return collect_calls_in_expr(nref.slice_expr.len_expr, used, flags_ptr);
        case AST_VARIADIC_PACK:
            return collect_calls_in_args_vec(((*AstVariadicPack)node).values_vec, used, flags_ptr);
        case AST_TERNARY:
            collect_calls_in_expr(nref.ternary_expr.cond, used, flags_ptr);
            collect_calls_in_expr(nref.ternary_expr.then_expr, used, flags_ptr);
            return collect_calls_in_expr(nref.ternary_expr.else_expr, used, flags_ptr);
        case AST_TRY:
            return collect_calls_in_expr(nref.try_expr.operand, used, flags_ptr);
        case AST_STRUCT_LITERAL:
            used_add_resolved_name(used, slice("memset", 6));
            return collect_calls_in_args_vec(nref.struct_lit.values_vec, used, flags_ptr);
        case AST_GENERIC_STRUCT_LITERAL:
            return collect_calls_in_args_vec(nref.generic_struct_lit.values_vec, used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_delete(dl: *AstDelete, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    used_mark_flag(flags_ptr, CG_USED_HAS_METHOD_CALL);
    used_add_resolved_name(used, slice((u64)"free", 4));
    if (dl.expr != 0) {
        collect_calls_in_expr(dl.expr, used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_if(ifs: *AstIf, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(ifs.cond, used, flags_ptr);
    collect_calls_in_stmt(ifs.then_block, used, flags_ptr);
    collect_calls_in_stmt(ifs.else_block, used, flags_ptr);
    return 0;
}

func collect_calls_in_while(wl: *AstWhile, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(wl.cond, used, flags_ptr);
    collect_calls_in_stmt(wl.body, used, flags_ptr);
    return 0;
}

func collect_calls_in_for(fr: *AstFor, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_stmt(fr.init, used, flags_ptr);
    collect_calls_in_expr(fr.cond, used, flags_ptr);
    collect_calls_in_stmt(fr.update, used, flags_ptr);
    collect_calls_in_stmt(fr.body, used, flags_ptr);
    return 0;
}

func collect_calls_in_match_stmt(sw: *AstSwitch, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    collect_calls_in_expr(sw.expr, used, flags_ptr);
    var cases: *Vec<*AstNode> = sw.cases_vec;
    var has_string_case: u64 = 0;
    if (cases != 0) {
        var n5: u64 = cases.len();
        for (var c: u64 = 0; c < n5; c++) {
            var cs: *AstCase = (*AstCase)cases.get(c);
            if (cs.is_default == 0) {
                if (ast_kind(cs.value) == AST_STRING) {
                    has_string_case = 1;
                }
                collect_calls_in_expr(cs.value, used, flags_ptr);
            }
            collect_calls_in_stmt(cs.body, used, flags_ptr);
        }
    }
    if (has_string_case == 1) {
        used_add_resolved_name(used, slice((u64)"str_len", 7));
        used_add_resolved_name(used, slice((u64)"str_eq", 6));
    }
    return 0;
}

func collect_calls_in_block(blk: *AstBlock, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    var stmts: *Vec<*AstNode> = blk.stmts_vec;
    if (stmts != 0) {
        var n6: u64 = stmts.len();
        for (var s: u64 = 0; s < n6; s++) {
            collect_calls_in_stmt(stmts.get(s), used, flags_ptr);
        }
    }
    return 0;
}

func collect_calls_in_stmt(node: *AstNode, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (node == 0) { return 0; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;
    match (kind) {
        case AST_RETURN:
            return collect_calls_in_expr(nref.ret_stmt.expr, used, flags_ptr);
        case AST_VAR_DECL:
            return collect_calls_in_expr(nref.var_decl.init_expr, used, flags_ptr);
        case AST_CONST_DECL:
            return collect_calls_in_expr(nref.const_decl.value, used, flags_ptr);
        case AST_ASSIGN:
            return collect_calls_in_assign(nref.assign_stmt, used, flags_ptr);
        case AST_DELETE: return collect_calls_in_delete(nref.delete_stmt, used, flags_ptr);
        case AST_EXPR_STMT:
            return collect_calls_in_expr(nref.expr_stmt.expr, used, flags_ptr);
        case AST_DEFER:
            return collect_calls_in_stmt(nref.defer_stmt.stmt, used, flags_ptr);
        case AST_IF: return collect_calls_in_if(nref.if_stmt, used, flags_ptr);
        case AST_WHILE: return collect_calls_in_while(nref.while_stmt, used, flags_ptr);
        case AST_DO_WHILE:
            collect_calls_in_stmt(nref.do_while_stmt.body, used, flags_ptr);
            return collect_calls_in_expr(nref.do_while_stmt.cond, used, flags_ptr);
        case AST_FOR: return collect_calls_in_for(nref.for_stmt, used, flags_ptr);
        case AST_SWITCH:
        case AST_MATCH:
            return collect_calls_in_match_stmt(nref.switch_stmt, used, flags_ptr);
        case AST_BLOCK: return collect_calls_in_block(nref.block_stmt, used, flags_ptr);
        case AST_THROW_STMT:
            return collect_calls_in_expr(((*AstThrowStmt)node).expr, used, flags_ptr);
        case AST_TRY_STMT:
            var tr: *AstTryStmt = (*AstTryStmt)node;
            collect_calls_in_stmt(tr.try_block, used, flags_ptr);
            collect_calls_in_stmt(tr.catch_block, used, flags_ptr);
            return collect_calls_in_stmt(tr.finally_block, used, flags_ptr);
        case AST_CASE:
            var cs: *AstCase = nref.case_stmt;
            if (cs.is_default == 0) { collect_calls_in_expr(cs.value, used, flags_ptr); }
            return collect_calls_in_stmt(cs.body, used, flags_ptr);
    }
    return 0;
}

func collect_calls_in_func(fn: *AstFunc, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (fn == 0) { return 0; }
    g_compiler_ctx.codegen_collect_used_symtab = generic_build_symtab_for_func(fn);
    collect_calls_in_stmt(fn.body, used, flags_ptr);
    g_compiler_ctx.codegen_collect_used_symtab = 0;
    return 0;
}

func collect_property_hook_func_names(program: *AstProgram, used: *Vec<*NameInfo>) -> u64 {
    if (program == 0 || used == 0) { return 0; }
    var structs: *Vec<*AstStructDef> = program.structs_vec;
    if (structs == 0) { return 0; }

    var ns: u64 = structs.len();
    for (var si: u64 = 0; si < ns; si++) {
        var sd: *AstStructDef = structs.get(si);
        if (sd == 0 || sd.fields_vec == 0) { continue; }
        var nf: u64 = sd.fields_vec.len();
        for (var fi: u64 = 0; fi < nf; fi++) {
            var field: *FieldDesc = sd.fields_vec.get(fi);
            if (field == 0) { continue; }
            if (u8_slice_ptr(field.setter_hook) != 0 && u8_slice_len(field.setter_hook) != 0) {
                used_add_resolved_name(used, field.setter_hook);
            }
            if (u8_slice_ptr(field.getter_hook) != 0 && u8_slice_len(field.getter_hook) != 0) {
                used_add_resolved_name(used, field.getter_hook);
            }
        }
    }
    return 0;
}

