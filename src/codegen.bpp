func codegen_expr_vec_has_gc_runtime_need(args: *Vec<*AstNode>) -> u64 {
    if (args == 0) { return 0; }
    var n: u64 = args.len();
    for (var i: u64 = 0; i < n; i++) {
        if (codegen_expr_has_gc_runtime_need(args.get(i)) != 0) { return 1; }
    }
    return 0;
}

func codegen_expr_has_gc_runtime_need(node: *AstNode) -> u64 {
    if (node == 0) { return 0; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;
    match (kind) {
        case AST_VARIADIC_PACK:
            // Even pointer-only packs register temporary roots without a local
            // pointer declaration or an allocation at this call site.
            g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 1;
            return 1;
        case AST_NEW:
            g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 2;
            return 1;
        case AST_CALL:
            if (nref.call.name.len == 10 && str_eq(nref.call.name, slice("heap_alloc", 10)) != 0) {
                g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 4;
                return 1;
            }
            if (nref.call.name.len >= 12 && codegen_name_has_prefix(nref.call.name, slice("bpp_gc_alloc", 12)) != 0) {
                g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 4;
                return 1;
            }
            return codegen_expr_vec_has_gc_runtime_need(nref.call.args_vec);
        case AST_CALL_PTR:
            if (codegen_expr_has_gc_runtime_need(nref.call_ptr.callee) != 0) { return 1; }
            return codegen_expr_vec_has_gc_runtime_need(nref.call_ptr.args_vec);
        case AST_METHOD_CALL:
        case AST_SAFE_METHOD_CALL:
            if (codegen_expr_has_gc_runtime_need(nref.method_call.receiver) != 0) { return 1; }
            return codegen_expr_vec_has_gc_runtime_need(nref.method_call.args_vec);
        case AST_BINARY:
            if (codegen_expr_has_gc_runtime_need(nref.binary.left) != 0) { return 1; }
            return codegen_expr_has_gc_runtime_need(nref.binary.right);
        case AST_UNARY: return codegen_expr_has_gc_runtime_need(nref.unary.operand);
        case AST_ADDR_OF: return codegen_expr_has_gc_runtime_need(nref.addr_of.operand);
        case AST_DEREF: return codegen_expr_has_gc_runtime_need(nref.deref.operand);
        case AST_DEREF8: return codegen_expr_has_gc_runtime_need(nref.deref8.operand);
        case AST_INDEX:
        case AST_SAFE_INDEX:
            if (codegen_expr_has_gc_runtime_need(nref.index_expr.base) != 0) { return 1; }
            return codegen_expr_has_gc_runtime_need(nref.index_expr.index);
        case AST_CAST: return codegen_expr_has_gc_runtime_need(nref.cast_expr.expr);
        case AST_MEMBER_ACCESS:
        case AST_SAFE_MEMBER_ACCESS:
            return codegen_expr_has_gc_runtime_need(nref.member_access.object);
        case AST_ASSIGN:
            if (codegen_expr_has_gc_runtime_need(nref.assign_stmt.target) != 0) { return 1; }
            return codegen_expr_has_gc_runtime_need(nref.assign_stmt.value);
        case AST_STACK_CTOR:
            if (nref.stack_ctor.is_tagged != 0) {
                g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 16;
                return 1;
            }
            return codegen_expr_vec_has_gc_runtime_need(nref.stack_ctor.ctor_args_vec);
        case AST_STRUCT_LITERAL:
            return codegen_expr_vec_has_gc_runtime_need(nref.struct_lit.values_vec);
    }
    return 0;
}

func codegen_stmt_has_gc_runtime_need(node: *AstNode) -> u64 {
    if (node == 0) { return 0; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;
    match (kind) {
        case AST_RETURN:
            return codegen_expr_has_gc_runtime_need(nref.ret_stmt.expr);
        case AST_VAR_DECL:
            return codegen_expr_has_gc_runtime_need(nref.var_decl.init_expr);
        case AST_CONST_DECL:
            return codegen_expr_has_gc_runtime_need(nref.const_decl.value);
        case AST_ASSIGN:
            if (codegen_expr_has_gc_runtime_need(nref.assign_stmt.target) != 0) { return 1; }
            return codegen_expr_has_gc_runtime_need(nref.assign_stmt.value);
        case AST_DELETE:
            g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 8;
            return 1;
        case AST_EXPR_STMT:
            return codegen_expr_has_gc_runtime_need(nref.expr_stmt.expr);
        case AST_DEFER:
            return codegen_stmt_has_gc_runtime_need(nref.defer_stmt.stmt);
        case AST_IF:
            if (codegen_expr_has_gc_runtime_need(nref.if_stmt.cond) != 0) { return 1; }
            if (codegen_stmt_has_gc_runtime_need(nref.if_stmt.then_block) != 0) { return 1; }
            return codegen_stmt_has_gc_runtime_need(nref.if_stmt.else_block);
        case AST_WHILE:
            if (codegen_expr_has_gc_runtime_need(nref.while_stmt.cond) != 0) { return 1; }
            return codegen_stmt_has_gc_runtime_need(nref.while_stmt.body);
        case AST_FOR:
            if (codegen_stmt_has_gc_runtime_need(nref.for_stmt.init) != 0) { return 1; }
            if (codegen_expr_has_gc_runtime_need(nref.for_stmt.cond) != 0) { return 1; }
            if (codegen_stmt_has_gc_runtime_need(nref.for_stmt.update) != 0) { return 1; }
            return codegen_stmt_has_gc_runtime_need(nref.for_stmt.body);
        case AST_SWITCH:
        case AST_MATCH:
            if (codegen_expr_has_gc_runtime_need(nref.switch_stmt.expr) != 0) { return 1; }
            var cases: *Vec<*AstNode> = nref.switch_stmt.cases_vec;
            if (cases == 0) { return 0; }
            var cn: u64 = cases.len();
            for (var ci: u64 = 0; ci < cn; ci++) {
                var cs: *AstCase = (*AstCase)cases.get(ci);
                if (cs == 0) { continue; }
                if (cs.is_default == 0 && codegen_expr_has_gc_runtime_need(cs.value) != 0) { return 1; }
                if (codegen_stmt_has_gc_runtime_need(cs.body) != 0) { return 1; }
            }
            return 0;
        case AST_BLOCK:
            var stmts: *Vec<*AstNode> = nref.block_stmt.stmts_vec;
            if (stmts == 0) { return 0; }
            var sn: u64 = stmts.len();
            for (var si: u64 = 0; si < sn; si++) {
                if (codegen_stmt_has_gc_runtime_need(stmts.get(si)) != 0) { return 1; }
            }
            return 0;
    }
    return 0;
}

func codegen_gc_codegen_disabled_for_name(name: []u8) -> u64 {
    if (codegen_name_has_prefix(name, slice("std_", str_len("std_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("std.", str_len("std."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("bpp_gc_", str_len("bpp_gc_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("bpp_tag_", str_len("bpp_tag_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("__bpp_", str_len("__bpp_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("emitter_", str_len("emitter_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("emitter.", str_len("emitter."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("ssa_", str_len("ssa_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("ssa.", str_len("ssa."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("compiler_", str_len("compiler_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("compiler.", str_len("compiler."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("llvm_", str_len("llvm_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("llvm.", str_len("llvm."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("parser_", str_len("parser_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("parser.", str_len("parser."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("lexer_", str_len("lexer_"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("lexer.", str_len("lexer."))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("codegen__", str_len("codegen__"))) != 0) { return 1; }
    if (codegen_name_has_prefix(name, slice("codegen.", str_len("codegen."))) != 0) { return 1; }
    return 0;
}

func codegen_func_params_have_gc_runtime_need(fn: *AstFunc) -> u64 {
    if (fn == 0 || fn.params_vec == 0) { return 0; }
    var params: *Vec<*Param> = fn.params_vec;
    var n: u64 = params.len();
    for (var i: u64 = 0; i < n; i++) {
        var param: *Param = params.get(i);
        if (param != 0 && (param.ptr_depth > 0 || param.type_kind == TYPE_FUNC)) { return 1; }
    }
    return 0;
}

func codegen_program_has_gc_runtime_need(program: *AstProgram, used: *Vec<*NameInfo>) -> u64 {
    if (program == 0 || program.funcs_vec == 0) { return 0; }
    var funcs: *Vec<*AstFunc> = program.funcs_vec;
    var n: u64 = funcs.len();
    for (var i: u64 = 0; i < n; i++) {
        var fn: *AstFunc = funcs.get(i);
        if (fn == 0 || fn.body == 0) { continue; }
        if (used != 0 && used_has_resolved_name(used, fn.name) == 0) { continue; }
        if (codegen_gc_codegen_disabled_for_name(fn.name) != 0) { continue; }
        if (codegen_stmt_has_gc_runtime_need(fn.body) != 0) { return 1; }
    }
    return 0;
}

func collect_trait_vtable_impl_func_names(used: *Vec<*NameInfo>) -> u64 {
    if (used == 0) { return 0; }
    var impls: *Vec<*TraitImpl> = sym_get_trait_impls();
    if (impls == 0) { return 0; }

    var inum: u64 = impls.len();
    for (var ii: u64 = 0; ii < inum; ii++) {
        var impl_info: *TraitImpl = impls.get(ii);
        if (impl_info == 0 || impl_info.methods_vec == 0) { continue; }
        var mn: u64 = impl_info.methods_vec.len();
        for (var mi: u64 = 0; mi < mn; mi++) {
            var method: *TraitImplMethod = impl_info.methods_vec.get(mi);
            if (method == 0 || method.func_def == 0) { continue; }
            used_add_resolved_name(used, method.func_def.name);
        }
    }
    return 0;
}

func collect_used_func_closure(funcs: *Vec<*AstFunc>, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (funcs == 0 || used == 0 || g_compiler_ctx.codegen_used_func_index == 0) { return 0; }
    // used is insertion ordered. Processing it with a cursor turns the old
    // whole-program fixed-point scan into a deterministic work queue.
    while (g_compiler_ctx.codegen_used_closure_cursor < used.len()) {
        var info: *NameInfo = used.get(g_compiler_ctx.codegen_used_closure_cursor);
        g_compiler_ctx.codegen_used_closure_cursor = g_compiler_ctx.codegen_used_closure_cursor + 1;
        if (info == 0) { continue; }
        var fn: *AstFunc = g_compiler_ctx.codegen_used_func_index.get(slice(info.ptr, info.len));
        if (fn == 0) { continue; }
        set_current_module_for_func(fn.name);
        collect_calls_in_func(fn, used, flags_ptr);
    }
    return 0;
}

func collect_build_func_index(funcs: *Vec<*AstFunc>) -> u64 {
    if (g_compiler_ctx.codegen_used_func_index == 0) {
        g_compiler_ctx.codegen_used_func_index = new HashMap<u64, *AstFunc>{0, 0, 0};
        g_compiler_ctx.codegen_used_func_index.ensure_capacity(256);
    } else {
        g_compiler_ctx.codegen_used_func_index.clear();
    }
    g_compiler_ctx.codegen_used_closure_cursor = 0;
    if (funcs == 0) { return 0; }
    var n: u64 = funcs.len();
    for (var i: u64 = 0; i < n; i++) {
        var fn: *AstFunc = funcs.get(i);
        if (fn == 0) { continue; }
        g_compiler_ctx.codegen_used_func_index.put(slice(fn.name.ptr, fn.name.len), fn);
        var resolved: *NameInfo = resolve_name(slice(fn.name.ptr, fn.name.len));
        if (resolved != 0) {
            g_compiler_ctx.codegen_used_func_index.put(slice(resolved.ptr, resolved.len), fn);
        }
    }
    return 0;
}

func collect_used_functions_need_gc_frame(used: *Vec<*NameInfo>) -> u64 {
    if (used == 0 || g_compiler_ctx.codegen_used_func_index == 0) { return 0; }
    var n: u64 = used.len();
    for (var i: u64 = 0; i < n; i++) {
        var info: *NameInfo = used.get(i);
        if (info == 0) { continue; }
        var fn: *AstFunc = g_compiler_ctx.codegen_used_func_index.get(slice(info.ptr, info.len));
        if (fn == 0) { continue; }
        if (codegen_gc_codegen_disabled_for_name(fn.name) != 0) { continue; }
        if (compiler_function_needs_gc_frame(fn.name) != 0) { return 1; }
    }
    return 0;
}

func codegen_ssa_requested() -> u64 {
    var backend_mode: u64 = opt_get_backend_mode();
    if (backend_mode == BACKEND_SSA) { return 1; }
    if (backend_mode == BACKEND_AUTO && opt_get_ir_mode() == IR_SSA) { return 1; }
    return 0;
}

func collect_used_func_names(program: *AstProgram, used: *Vec<*NameInfo>, flags_ptr: u64) -> u64 {
    if (program == 0) { return 0; }
    var funcs: *Vec<*AstFunc> = program.funcs_vec;
    if (funcs == 0) { return 0; }
    collect_build_func_index(funcs);

    var entry_ptr: u64 = entry_func_ptr();
    var entry_len: u64 = entry_func_len();
    used_add_name(used, slice(entry_ptr, entry_len));
    used_add_name(used, slice((u64)"std_io__sys_exit", 16));
    var entry_fn: *AstFunc = sym_get_func(slice(entry_ptr, entry_len));
    var entry_param_n: u64 = 0;
    if (entry_fn != 0 && entry_fn.params_vec != 0) {
        entry_param_n = entry_fn.params_vec.len();
    }
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64 && entry_param_n != 0) {
        // The PE entry stub calls this helper directly, so it is not visible
        // to the AST call-graph walk used by optimized dead-code elimination.
        used_add_name(used, slice("std_os__os_main_args", str_len("std_os__os_main_args")));
    }

    // Legacy optimized codegen has a few implicit call sites which are not
    // represented in the source AST. Strict SSA instead uses the exact
    // reachable closure; dynamic dispatch makes that closure unknowable and
    // is handled conservatively by collect_used_names below.
    var seed_implicit_codegen: u64 = codegen_ssa_requested() == 0;
    var seed_n: u64 = funcs.len();
    for (var si: u64 = 0; si < seed_n; si++) {
        var seed_fn: *AstFunc = funcs.get(si);
        if (seed_fn == 0) { continue; }
        if (seed_implicit_codegen != 0 && codegen_name_has_suffix(seed_fn.name, slice("_destructor", str_len("_destructor"))) != 0) {
            used_add_name(used, seed_fn.name);
        }
        // Trait and virtual-dispatch tables reference thunks from emitted data,
        // not from an AST call node. They are roots in every backend mode.
        if (codegen_name_has_prefix(seed_fn.name, slice("__thunk_", str_len("__thunk_"))) != 0) {
            used_add_resolved_name(used, seed_fn.name);
        }
        if (seed_fn.annotations_vec == 0) { continue; }
        if (annotation_count_name(seed_fn.annotations_vec, slice("used", str_len("used"))) != 0) {
            used_add_name(used, seed_fn.name);
        }
        if (annotation_has_complexity_contract_annotation(seed_fn) != 0) {
            used_add_name(used, seed_fn.name);
        }
    }

    if (seed_implicit_codegen != 0) {
        collect_property_hook_func_names(program, used);
        collect_trait_vtable_impl_func_names(used);
    }

    collect_used_func_closure(funcs, used, flags_ptr);
    var collected_flags: u64 = *(flags_ptr);
    if (seed_implicit_codegen != 0 && (collected_flags & CG_USED_HAS_BINARY) != 0) {
        // Direct operator calls created by lowering are already part of the
        // closure. Only unresolved struct-valued binary nodes need the legacy
        // fallback that retains every overload target.
        for (var oi: u64 = 0; oi < seed_n; oi++) {
            var operator_target: *AstFunc = funcs.get(oi);
            if (operator_target != 0 && codegen_name_contains(operator_target.name, slice("__op_", str_len("__op_"))) != 0) {
                used_add_resolved_name(used, operator_target.name);
            }
        }
        collect_used_func_closure(funcs, used, flags_ptr);
    }
    if (seed_implicit_codegen == 0 && (collected_flags & (CG_USED_HAS_METHOD_CALL | CG_USED_HAS_BINARY)) != 0) {
        // An unresolved method edge may dispatch through a trait vtable or an
        // implicit destructor. Add exactly those generated targets, then
        // close over calls made by their bodies.
        if ((collected_flags & CG_USED_HAS_METHOD_CALL) != 0) {
            collect_trait_vtable_impl_func_names(used);
        }
        for (var di: u64 = 0; di < seed_n; di++) {
            var generated_target: *AstFunc = funcs.get(di);
            if (generated_target == 0) { continue; }
            var needs_method_target: u64 = (collected_flags & CG_USED_HAS_METHOD_CALL) != 0 &&
                (codegen_name_has_suffix(generated_target.name, slice("_destructor", str_len("_destructor"))) != 0 ||
                 codegen_name_has_prefix(generated_target.name, slice("__thunk_", str_len("__thunk_"))) != 0);
            var needs_operator_target: u64 = (collected_flags & CG_USED_HAS_BINARY) != 0 &&
                codegen_name_contains(generated_target.name, slice("__op_", str_len("__op_"))) != 0;
            if (needs_method_target != 0 || needs_operator_target != 0) {
                used_add_resolved_name(used, generated_target.name);
            }
        }
        collect_used_func_closure(funcs, used, flags_ptr);
    }
    // Code generation emits the frame cleanup edge only for functions whose
    // signature or body can contain GC root slots. Keep reachability aligned
    // with that exact predicate instead of pulling the entire GC/heap runtime
    // into programs whose reachable functions cannot register a root slot.
    g_codegen_gc_runtime_reason = 0;
    var gc_runtime_needed: u64 = codegen_program_has_gc_runtime_need(program, used);
    var used_functions_need_gc_frame: u64 = collect_used_functions_need_gc_frame(used);
    if (used_functions_need_gc_frame != 0) {
        g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 128;
        gc_runtime_needed = 1;
    }
    if (used_has_name_prefix(used, slice("std_mem__bpp_gc_", str_len("std_mem__bpp_gc_"))) != 0) {
        g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 32;
        gc_runtime_needed = 1;
    }
    if (used_has_name_prefix(used, slice("std_number__", str_len("std_number__"))) != 0) {
        g_codegen_gc_runtime_reason = g_codegen_gc_runtime_reason | 64;
        gc_runtime_needed = 1;
    }
    timings_set_codegen_gc_runtime_reason(g_codegen_gc_runtime_reason);
    g_codegen_gc_runtime_needed = gc_runtime_needed;
    if (gc_runtime_needed != 0 && used_functions_need_gc_frame != 0) {
        used_add_resolved_name(used, slice("std_mem__bpp_gc_root_slots_remove_frame", str_len("std_mem__bpp_gc_root_slots_remove_frame")));
        collect_used_func_closure(funcs, used, flags_ptr);
    }
    if (gc_runtime_needed != 0) {
        var before_gc: u64 = used.len();
        collect_add_gc_runtime_helper_names(used);
        if (used.len() != before_gc) {
            collect_used_func_closure(funcs, used, flags_ptr);
        }
    }
    if (used_has_name_prefix(used, slice("std_number__", str_len("std_number__"))) != 0) {
        var before_number: u64 = used.len();
        collect_add_number_runtime_helper_names(used);
        if (used.len() != before_number) {
            collect_used_func_closure(funcs, used, flags_ptr);
        }
    }
    return 0;
}

func generic_template_fn(fn: *AstFunc) -> u64 {
    if (fn == 0) { return false; }
    if (sym_is_generic_func_ptr(fn) != 0) { return true; }
    if (fn.ret_type == TYPE_GENERIC) { return true; }

    var params: *Vec<*Param> = fn.params_vec;
    if (params != 0) {
        var n: u64 = params.len();
        for (var i: u64 = 0; i < n; i++) {
            var p: *Param = params.get(i);
            if (p.type_kind == TYPE_GENERIC) { return true; }
            if (p.elem_type_kind == TYPE_GENERIC) { return true; }
            if (p.array_len_is_param != 0) { return true; }
        }
    }
    return false;
}

// ============================================
// Function Codegen
// ============================================

// Function parameter layout (48 bytes)
struct FuncParam {
    public name: []u8;
    public type_kind: u64;
    public ptr_depth: u64;
    public is_tagged: u64;
    public struct_name: []u8;
    public tag_layout: []u8;
    public elem_type_kind: u64;
    public elem_ptr_depth: u64;
    public array_len: u64;
}

func align_up_8(value: u64) -> u64 {
    var rem: u64 = value % 8;
    if (rem == 0) { return value; }
    return value + (8 - rem);
}

func align_up_16(value: u64) -> u64 {
    var rem: u64 = value % 16;
    if (rem == 0) { return value; }
    return value + (16 - rem);
}

const CG_STACK_RESERVE_DEFAULT = 2048;
const CG_STACK_RESERVE_MIN = 256;
const CG_STACK_RESERVE_MAX = 1048576;

const CG_FUNC_SECTION_DEFAULT = 0;
const CG_FUNC_SECTION_HOT = 1;
const CG_FUNC_SECTION_COLD = 2;

func fn_find_annotation(fn: *AstFunc, ann_name: []u8) -> *CompilerAnnotationParsed {
    if (fn == 0 || fn.annotations_vec == 0) { return 0; }
    var n: u64 = fn.annotations_vec.len();
    for (var i: u64 = 0; i < n; i++) {
        var info: *NameInfo = fn.annotations_vec.get(i);
        if (info == 0) { continue; }
        var parsed: *CompilerAnnotationParsed = annotation_parse(info);
        if (parsed == 0 || parsed.parse_ok == 0) { continue; }
        if (u8_slice_len(parsed.name) != ann_name.len) { continue; }
        if (str_eq(parsed.name, slice(ann_name.ptr, ann_name.len)) != 0) {
            return parsed;
        }
    }
    return 0;
}

func ann_arg_key_eq(arg: *CompilerAnnotationArg, key: []u8) -> u64 {
    if (arg == 0 || u8_slice_ptr(arg.key) == 0 || u8_slice_len(arg.key) != key.len) { return 0; }
    if (str_eq(arg.key, slice(key.ptr, key.len)) != 0) { return 1; }
    return 0;
}

func parse_ascii_u64(src: []u8, out_value: *u64) -> u64 {
    if (out_value == 0 || src.ptr == 0 || src.len == 0) { return 0; }
    var s: []u8 = slice(src.ptr, src.len);
    var v: u64 = 0;
    for (var i: u64 = 0; i < src.len; i++) {
        var ch: u64 = s[i];
        if (ch < 48 || ch > 57) { return 0; }
        v = v * 10 + (ch - 48);
    }
    *out_value = v;
    return 1;
}

func parse_ascii_bool(src: []u8, out_value: *u64) -> u64 {
    if (out_value == 0 || src.ptr == 0 || src.len == 0) { return 0; }
    if (src.len == 4 && str_eq(slice(src.ptr, src.len), slice("true", str_len("true"))) != 0) {
        *out_value = 1;
        return 1;
    }
    if (src.len == 5 && str_eq(slice(src.ptr, src.len), slice("false", str_len("false"))) != 0) {
        *out_value = 0;
        return 1;
    }
    return 0;
}

func config_read_stack_override(cfg_ann: *CompilerAnnotationParsed, out_stack: *u64) -> u64 {
    if (cfg_ann == 0 || cfg_ann.args_vec == 0 || out_stack == 0) { return 0; }
    var found: u64 = 0;
    var n: u64 = cfg_ann.args_vec.len();
    for (var i: u64 = 0; i < n; i++) {
        var arg: *CompilerAnnotationArg = cfg_ann.args_vec.get(i);
        if (arg == 0 || u8_slice_ptr(arg.key) == 0 || u8_slice_len(arg.key) == 0) { continue; }

        var is_stack_bytes: u64 = 0;
        var stack_scale: u64 = 1;
        if (ann_arg_key_eq(arg, slice("stack", 5)) != 0 || ann_arg_key_eq(arg, slice("stack_bytes", 11)) != 0) {
            is_stack_bytes = 1;
        } else if (ann_arg_key_eq(arg, slice("stack_kb", 8)) != 0) {
            is_stack_bytes = 1;
            stack_scale = 1024;
        }
        if (is_stack_bytes == 0) { continue; }

        var value: u64 = 0;
        var ok: u64 = 0;
        if (arg.kind == COMPILER_ANN_ARG_INT) {
            value = arg.int_value;
            ok = 1;
        } else if (arg.kind == COMPILER_ANN_ARG_STRING) {
            ok = parse_ascii_u64(arg.string_value, &value);
        }
        if (ok == 0) { continue; }

        if (stack_scale > 1) { value = value * stack_scale; }
        *out_stack = value;
        found = 1;
    }
    return found;
}

func parse_section_override_value(arg: *CompilerAnnotationArg, out_section_kind: *u64) -> u64 {
    if (arg == 0 || out_section_kind == 0) { return 0; }
    var value_ptr: u64 = 0;
    var value_len: u64 = 0;
    if (arg.kind == COMPILER_ANN_ARG_STRING) {
        value_ptr = u8_slice_ptr(arg.string_value);
        value_len = u8_slice_len(arg.string_value);
    } else if (arg.kind == COMPILER_ANN_ARG_IDENT) {
        value_ptr = u8_slice_ptr(arg.ident);
        value_len = u8_slice_len(arg.ident);
    } else {
        return 0;
    }
    if (value_ptr == 0 || value_len == 0) { return 0; }

    if ((value_len == 3 && str_eq(slice(value_ptr, value_len), slice("hot", str_len("hot"))) != 0) ||
        (value_len == 9 && str_eq(slice(value_ptr, value_len), slice(".text.hot", str_len(".text.hot"))) != 0)) {
        *out_section_kind = CG_FUNC_SECTION_HOT;
        return 1;
    }
    if ((value_len == 4 && str_eq(slice(value_ptr, value_len), slice("cold", str_len("cold"))) != 0) ||
        (value_len == 14 && str_eq(slice(value_ptr, value_len), slice(".text.unlikely", str_len(".text.unlikely"))) != 0)) {
        *out_section_kind = CG_FUNC_SECTION_COLD;
        return 1;
    }
    if ((value_len == 7 && str_eq(slice(value_ptr, value_len), slice("default", str_len("default"))) != 0) ||
        (value_len == 5 && str_eq(slice(value_ptr, value_len), slice(".text", str_len(".text"))) != 0)) {
        *out_section_kind = CG_FUNC_SECTION_DEFAULT;
        return 1;
    }
    return 0;
}

func config_read_section_override(cfg_ann: *CompilerAnnotationParsed, out_section_kind: *u64) -> u64 {
    if (cfg_ann == 0 || cfg_ann.args_vec == 0 || out_section_kind == 0) { return 0; }
    var found: u64 = 0;
    var n: u64 = cfg_ann.args_vec.len();
    for (var i: u64 = 0; i < n; i++) {
        var arg: *CompilerAnnotationArg = cfg_ann.args_vec.get(i);
        if (arg == 0 || u8_slice_ptr(arg.key) == 0 || u8_slice_len(arg.key) == 0) { continue; }
        if (ann_arg_key_eq(arg, slice("section", 7)) == 0) { continue; }
        if (parse_section_override_value(arg, out_section_kind) != 0) {
            found = 1;
        }
    }
    return found;
}

func config_read_trace_overrides(cfg_ann: *CompilerAnnotationParsed, out_enabled: *u64, out_level: *u64) -> u64 {
    if (cfg_ann == 0 || cfg_ann.args_vec == 0) { return 0; }
    var n: u64 = cfg_ann.args_vec.len();
    for (var i: u64 = 0; i < n; i++) {
        var arg: *CompilerAnnotationArg = cfg_ann.args_vec.get(i);
        if (arg == 0 || u8_slice_ptr(arg.key) == 0 || u8_slice_len(arg.key) == 0) { continue; }

        if (ann_arg_key_eq(arg, slice("trace", 5)) != 0 || ann_arg_key_eq(arg, slice("trace_enabled", 13)) != 0) {
            var enabled_val: u64 = 0;
            if (arg.kind == COMPILER_ANN_ARG_BOOL) {
                enabled_val = arg.bool_value;
            } else if (arg.kind == COMPILER_ANN_ARG_INT) {
                if (arg.int_value != 0) { enabled_val = 1; }
            } else if (arg.kind == COMPILER_ANN_ARG_STRING) {
                if (parse_ascii_bool(arg.string_value, &enabled_val) == 0) {
                    continue;
                }
            } else {
                continue;
            }
            if (out_enabled != 0) { *out_enabled = enabled_val; }
            continue;
        }

        if (ann_arg_key_eq(arg, slice("trace_level", 11)) != 0) {
            var level_val: u64 = 0;
            if (arg.kind == COMPILER_ANN_ARG_INT) {
                level_val = arg.int_value;
            } else if (arg.kind == COMPILER_ANN_ARG_BOOL) {
                level_val = arg.bool_value;
            } else if (arg.kind == COMPILER_ANN_ARG_STRING) {
                if (parse_ascii_u64(arg.string_value, &level_val) == 0) {
                    continue;
                }
            } else {
                continue;
            }
            if (out_level != 0) { *out_level = level_val; }
        }
    }
    return 0;
}

func func_stack_reserve(fn: *AstFunc) -> u64 {
    var reserve: u64 = CG_STACK_RESERVE_DEFAULT;
    var cfg_ann: *CompilerAnnotationParsed = fn_find_annotation(fn, slice("config", 6));
    var explicit_reserve: u64 = config_read_stack_override(cfg_ann, &reserve);
    // The final frame equate already accounts for every local, parameter and
    // compiler temporary. Do not impose an unrelated 2KiB floor on each call.
    // Raw inline assembly may rely on the historic scratch area; keep its
    // default and preserve the existing explicit config clamping rules.
    if (explicit_reserve == 0 && fn != 0 && lower_number_storage_stmt_contains_inline_asm(fn.body) == 0) {
        return 0;
    }
    if (reserve < CG_STACK_RESERVE_MIN) { reserve = CG_STACK_RESERVE_MIN; }
    if (reserve > CG_STACK_RESERVE_MAX) { reserve = CG_STACK_RESERVE_MAX; }
    return align_up_16(reserve);
}

func func_section_kind(fn: *AstFunc) -> u64 {
    var section_kind: u64 = CG_FUNC_SECTION_DEFAULT;
    if (fn != 0 && fn.annotations_vec != 0) {
        if (annotation_count_name(fn.annotations_vec, slice("cold", str_len("cold"))) != 0) {
            section_kind = CG_FUNC_SECTION_COLD;
        } else if (annotation_count_name(fn.annotations_vec, slice("hot", str_len("hot"))) != 0) {
            section_kind = CG_FUNC_SECTION_HOT;
        }
    }

    var cfg_ann: *CompilerAnnotationParsed = fn_find_annotation(fn, slice("config", 6));
    config_read_section_override(cfg_ann, &section_kind);
    return section_kind;
}

func func_trace_info(fn: *AstFunc, out_enabled: *u64, out_level: *u64) -> u64 {
    if (out_enabled != 0) { *out_enabled = 0; }
    if (out_level != 0) { *out_level = 0; }
    if (fn == 0) { return 0; }

    var trace_ann: *CompilerAnnotationParsed = fn_find_annotation(fn, slice("trace", 5));
    if (trace_ann != 0) {
        if (out_enabled != 0) { *out_enabled = 1; }
        if (trace_ann.args_vec != 0) {
            var n: u64 = trace_ann.args_vec.len();
            for (var i: u64 = 0; i < n; i++) {
                var arg: *CompilerAnnotationArg = trace_ann.args_vec.get(i);
                if (arg == 0) { continue; }

                if (u8_slice_ptr(arg.key) != 0) {
                    if (ann_arg_key_eq(arg, slice("enabled", 7)) != 0) {
                        if (arg.kind == COMPILER_ANN_ARG_BOOL) {
                            if (out_enabled != 0) { *out_enabled = arg.bool_value; }
                        } else if (arg.kind == COMPILER_ANN_ARG_INT) {
                            if (out_enabled != 0) {
                                if (arg.int_value != 0) { *out_enabled = 1; } else { *out_enabled = 0; }
                            }
                        }
                        continue;
                    }
                    if (ann_arg_key_eq(arg, slice("level", 5)) != 0) {
                        if (arg.kind == COMPILER_ANN_ARG_INT) {
                            if (out_level != 0) { *out_level = arg.int_value; }
                        } else if (arg.kind == COMPILER_ANN_ARG_BOOL) {
                            if (out_level != 0) { *out_level = arg.bool_value; }
                        }
                        continue;
                    }
                }

                if (arg.kind == COMPILER_ANN_ARG_BOOL) {
                    if (out_enabled != 0) { *out_enabled = arg.bool_value; }
                } else if (arg.kind == COMPILER_ANN_ARG_INT) {
                    if (out_level != 0) { *out_level = arg.int_value; }
                }
            }
        }
    }

    var cfg_ann: *CompilerAnnotationParsed = fn_find_annotation(fn, slice("config", 6));
    config_read_trace_overrides(cfg_ann, out_enabled, out_level);
    return 0;
}

func emit_func_section(section_kind: u64) -> u64 {
    if (section_kind == CG_FUNC_SECTION_HOT) {
        emitln("section .text.hot");
    } else if (section_kind == CG_FUNC_SECTION_COLD) {
        emitln("section .text.unlikely");
    } else {
        emitln("section .text");
    }
    return 0;
}

func emit_func_trace_enter(level: u64) -> u64 {
    g_codegen_trace_runtime_touches = g_codegen_trace_runtime_touches + 1;
    g_compiler_ctx.codegen_trace_runtime_needed = 1;
    emit("    mov edi, ");
    emit_u64(level);
    emit_nl();
    emitln("    call __bpp_trace_enter");
    return 0;
}

func func_has_codegen_annotation(fn: *AstFunc) -> u64 {
    if (fn == 0 || fn.annotations_vec == 0) { return 0; }
    // hot/cold are placement hints and do not change function semantics. The
    // SSA backend may safely ignore them; trace/config still require legacy
    // prologue and instrumentation support.
    if (annotation_count_name(fn.annotations_vec, slice("trace", str_len("trace"))) != 0) { return 1; }
    if (annotation_count_name(fn.annotations_vec, slice("config", str_len("config"))) != 0) { return 1; }
    return 0;
}

func param_size(p: *Param) -> u64 {
    if (p.type_kind == TYPE_SLICE && p.ptr_depth == 0) {
        return 16;
    }
    if (p.type_kind == TYPE_STRUCT && p.ptr_depth == 0) {
        var size: u64 = layout_type_sizeof(TYPE_STRUCT, 0, p.struct_name);
        return align_up_8(size);
    }
    return 8;
}

func resolve_struct_def_for_param(ti: *TypeInfo, p: *Param, g_structs_vec: *Vec<*AstStructDef>) -> u64 {
    if (u8_slice_ptr(p.struct_name) == 0) { return 0; }

    if (p.type_kind == TYPE_STRUCT) {
        ti.struct_def = get_struct_def(p.struct_name);
    }

    if (p.elem_type_kind == TYPE_STRUCT) {
        var elem_name: []u8 = p.struct_name;
        if (p.elem_typeinfo != 0 && u8_slice_ptr(p.elem_typeinfo.struct_name) != 0) {
            elem_name = p.elem_typeinfo.struct_name;
        }
        var elem_def: *AstStructDef = get_struct_def(elem_name);
        ti.struct_def = elem_def;
        if (ti.elem_typeinfo != 0) {
            ti.elem_typeinfo.struct_def = elem_def;
        }
    }
    return 0;
}

func symtab_add_param(p: *Param, g_symtab: *Symtab, g_structs_vec: *Vec<*AstStructDef>) -> u64 {
    var param_size: u64 = param_size(p);
    var offset: u64 = symtab_add(g_symtab, p.name, p.type_kind, p.ptr_depth, param_size);
    var ti: *TypeInfo = symtab_get_type(g_symtab, p.name);
    p.apply_to_typeinfo(ti);
    resolve_struct_def_for_param(ti, p, g_structs_vec);
    return offset;
}

func param_struct_size(p: *Param) -> u64 {
    if (p.type_kind != TYPE_STRUCT || p.ptr_depth != 0) { return 0; }
    return layout_type_sizeof(TYPE_STRUCT, 0, p.struct_name);
}

func load_arg_ptr_to_rax(arg_word_index: u64) -> u64 {
    var reg_limit: u64 = compiler_target_raw_arg_reg_limit();
    if (arg_word_index < reg_limit) {
        emit("    mov rax, ");
        emit_target_arg_reg_name(arg_word_index);
        emit_nl();
        return 0;
    }
    var src_offset: u64 = compiler_target_stack_arg_base_offset() + (arg_word_index - reg_limit) * 8;
    emit("    mov rax, [rbp+");
    emit_u64(src_offset);
    emit("]\n");
    return 0;
}

func emit_struct_copy_to_stack(offset: u64, struct_size: u64) -> u64 {
    emit("    lea rbx, [rbp");
    emit_signed_disp(offset);
    emit("]\n");

    var off_copy: u64 = 0;
    while (off_copy + 8 <= struct_size) {
        emit("    mov rcx, [rax");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("]\n");
        emit("    mov [rbx");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("], rcx\n");
        off_copy = off_copy + 8;
    }
    var rem_copy: u64 = struct_size - off_copy;
    if (rem_copy >= 4) {
        emit("    mov ecx, [rax");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("]\n");
        emit("    mov [rbx");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("], ecx\n");
        off_copy = off_copy + 4;
        rem_copy = rem_copy - 4;
    }
    if (rem_copy >= 2) {
        emit("    mov cx, [rax");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("]\n");
        emit("    mov [rbx");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("], cx\n");
        off_copy = off_copy + 2;
        rem_copy = rem_copy - 2;
    }
    if (rem_copy >= 1) {
        emit("    mov cl, [rax");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("]\n");
        emit("    mov [rbx");
        if (off_copy != 0) { emit("+"); emit_u64(off_copy); }
        emit("], cl\n");
    }
    return 0;
}

func store_large_struct_arg(arg_word_index: u64, offset: u64, struct_size: u64) -> u64 {
    load_arg_ptr_to_rax(arg_word_index);
    emit_struct_copy_to_stack(offset, struct_size);
    return arg_word_index + 1;
}

func store_param_words(p: *Param, offset: u64, arg_word_index: u64) -> u64 {
    if (p.type_kind == TYPE_SLICE && p.ptr_depth == 0) {
        store_target_arg_word(arg_word_index, offset);
        store_target_arg_word(arg_word_index + 1, offset + 8);
        return arg_word_index + 2;
    }

    if (p.type_kind == TYPE_STRUCT && p.ptr_depth == 0) {
        var struct_size: u64 = layout_type_sizeof(TYPE_STRUCT, 0, p.struct_name);
        if (struct_size <= 8) {
            store_target_arg_word(arg_word_index, offset);
            return arg_word_index + 1;
        }
        if (struct_size <= 16) {
            store_target_arg_word(arg_word_index, offset);
            store_target_arg_word(arg_word_index + 1, offset + 8);
            return arg_word_index + 2;
        }
        store_target_arg_word(arg_word_index, offset);
        return arg_word_index + 1;
    }

    store_target_arg_word(arg_word_index, offset);
    return arg_word_index + 1;
}

func emit_func_prologue(fn: *AstFunc, g_symtab: *Symtab, section_kind: u64, stack_reserve: u64) -> u64 {
    sym_reg_alias_reset();
    set_current_module_for_func(fn.name);
    sym_set_current_access_struct_from_func(fn.name);
    closure_handles_reset();

    ret_type_set(fn.ret_type);
    ret_ptr_depth_set(fn.ret_ptr_depth);
    ret_struct_name_set(fn.ret_struct_name);
    current_func_name_set(fn.name);

    symtab_clear(g_symtab);

    emit_func_section(section_kind);
    emitln("align 16");
    emit_len(u8_slice_ptr(fn.name), u8_slice_len(fn.name));
    emit(":\n");

    emitln("    push rbp");
    emitln("    mov rbp, rsp");
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64) {
        emitln("    mov rax, strict qword (.Lbpp_frame_size + 32)");
        emit_windows_stack_probe_rax();
    } else {
        emitln("    sub rsp, strict qword (.Lbpp_frame_size + 32)");
    }
    emit_legacy_nonvolatile_save(stack_reserve);

    if (fn.ret_type == TYPE_STRUCT && fn.ret_ptr_depth == 0) {
        var ret_struct_size: u64 = layout_type_sizeof(TYPE_STRUCT, 0, fn.ret_struct_name);
        if (ret_struct_size > 16) {
            var sret_ptr: u64 = (u64)"__sret_ptr";
            var sret_len: u64 = 10;
            var sret_offset: u64 = symtab_add(g_symtab, slice(sret_ptr, sret_len), TYPE_U64, 1, 8);
            emit("    mov [rbp");
            emit_signed_disp(sret_offset);
            emit("], ");
            emit_target_arg_reg_name(0);
            emit_nl();
        }
    }
    return 0;
}

func emit_func_epilogue() -> u64 {
    emit_gc_cleanup_root_slots();
    emitln("   xor eax, eax");
    emit_legacy_nonvolatile_restore();
    emitln("    mov rsp, rbp");
    emitln("    pop rbp");
    emitln("   ret");
    return 0;
}

func emit_func_frame_size_equ(symtab: *Symtab, configured_reserve: u64) -> u64 {
    var required: u64 = 0;
    if (symtab != 0) {
        required = 0 - symtab.stack_offset;
    }
    required = align_up_16(required);
    if (required < configured_reserve) { required = configured_reserve; }
    emit(".Lbpp_frame_size equ ");
    emit_u64(required);
    emit_nl();
    return required;
}

func emit_target_arg_reg_name(idx: u64) -> u64 {
    var reg_name: u64 = compiler_target_raw_arg_reg_name(idx);
    var reg_len: u64 = compiler_target_raw_arg_reg_name_len(idx);
    if (reg_name == 0 || reg_len == 0) { return 0; }
    emit_len(reg_name, reg_len);
    return 0;
}

func store_target_arg_word(arg_idx: u64, dst_offset: u64) -> u64 {
    var reg_limit: u64 = compiler_target_raw_arg_reg_limit();
    if (arg_idx < reg_limit) {
        emit("    mov [rbp");
        emit_signed_disp(dst_offset);
        emit("], ");
        emit_target_arg_reg_name(arg_idx);
        emit_nl();
        return 0;
    }
    var src_offset: u64 = compiler_target_stack_arg_base_offset() + (arg_idx - reg_limit) * 8;
    emit("    mov rax, [rbp+");
    emit_u64(src_offset);
    emit("]\n");
    emit("    mov [rbp");
    emit_signed_disp(dst_offset);
    emit("], rax\n");
    return 0;
}

func emit_func_prepared(fn: *AstFunc) -> u64 {
    if (fn == 0) { return 0; }
    typeinfo_expr_cache_next_function();
    var legacy_started: u64 = timings_profile_start();
    var g_symtab: *Symtab = symtab_current();
    var section_kind: u64 = func_section_kind(fn);
    var stack_reserve: u64 = func_stack_reserve(fn);
    emit_func_prologue(fn, g_symtab, section_kind, stack_reserve);
    
    var g_structs_vec: *Vec<*AstStructDef> = typeinfo_get_structs();
    
    var nparams: u64 = fn.params_vec.len();
    var arg_word_index: u64 = 0;
    if (fn.ret_type == TYPE_STRUCT && fn.ret_ptr_depth == 0) {
        var ret_struct_size: u64 = layout_type_sizeof(TYPE_STRUCT, 0, fn.ret_struct_name);
        if (ret_struct_size > 16) { arg_word_index = 1; }
    }
    for(var i: u64 = 0 ; i < nparams ; i++){
        var p: *Param = fn.params_vec.get(i);
        var offset: u64 = symtab_add_param(p, g_symtab, g_structs_vec);
        var struct_size_copy: u64 = param_struct_size(p);
        if (struct_size_copy > 16) {
            arg_word_index = store_large_struct_arg(arg_word_index, offset, struct_size_copy);
            continue;
        }
        arg_word_index = store_param_words(p, offset, arg_word_index);
    }

    // Register parameter roots only after every incoming ABI word is saved.
    for (var ri: u64 = 0; ri < nparams; ri++) {
        var root_param: *Param = fn.params_vec.get(ri);
        emit_gc_typed_root_slots(symtab_get_type(g_symtab, root_param.name), symtab_find(g_symtab, root_param.name));
    }

    var trace_enabled: u64 = 0;
    var trace_level: u64 = 0;
    func_trace_info(fn, &trace_enabled, &trace_level);
    if (trace_enabled != 0) {
        emit_func_trace_enter(trace_level);
    }
    timings_add_codegen_legacy_span(2, legacy_started);

    legacy_started = timings_profile_start();
    emit_block(fn.body);
    timings_add_codegen_legacy_span(3, legacy_started);

    legacy_started = timings_profile_start();
    emit_func_epilogue();
    emit_func_frame_size_equ(g_symtab, stack_reserve);
    timings_add_codegen_legacy_span(4, legacy_started);
}

func emit_func(fn: *AstFunc) -> u64 {
    if (fn == 0) { return 0; }
    var legacy_started: u64 = timings_profile_start();
    lower_number_storage_prepare_function(fn);
    timings_add_codegen_legacy_span(1, legacy_started);

    var key_len: u64 = 0;
    var key: u64 = incremental_cache_make_function_key(fn, &key_len);
    if (key == 0) { emit_func_prepared(fn); return 0; }
    var cached: u64 = 0;
    var cached_len: u64 = 0;
    var cached_label_delta: u64 = 0;
    if (incremental_cache_lookup(key, key_len, emitter_label_counter(), &cached, &cached_len, &cached_label_delta) != 0) {
        emit_len(cached, cached_len);
        emitter_advance_label_counter(cached_label_delta);
        heap_free(key);
        return 0;
    }

    var label_before: u64 = emitter_label_counter();
    var strings_before: u64 = emitter_string_label_lookup_count();
    var floats_before: u64 = emitter_float_label_lookup_count();
    var globals_before: u64 = emitter_backend_global_touch_count();
    var trace_before: u64 = g_codegen_trace_runtime_touches;
    io_raw_capture_start();
    emit_func_prepared(fn);
    var fragment: u64 = 0;
    var fragment_len: u64 = 0;
    var capture_ok: u64 = io_raw_capture_stop(&fragment, &fragment_len);
    var state_neutral: u64 =
        emitter_string_label_lookup_count() == strings_before
        && emitter_float_label_lookup_count() == floats_before
        && emitter_backend_global_touch_count() == globals_before
        && g_codegen_trace_runtime_touches == trace_before;
    if (capture_ok != 0 && state_neutral != 0 && diag_should_stop_pass() == 0 && fragment_len != 0) {
        if (incremental_cache_store(key, key_len, fragment, fragment_len, label_before, emitter_label_counter() - label_before) != 0) { return 0; }
    }
    timings_note_incremental_ineligible();
    heap_free(key);
    if (fragment != 0) { heap_free(fragment); }
    return 0;
}

// ============================================
// Program Codegen
// ============================================

func program_has_runtime_global_init(program: *AstProgram) -> u64 {
    if (program == 0) { return false; }
    if (program.globals_vec == 0) { return false; }
    var n: u64 = program.globals_vec.len();
    for (var i: u64 = 0; i < n; i++) {
        var ginfo: *GlobalInfo = program.globals_vec.get(i);
        if (ginfo.init_kind == GLOBAL_INIT_RUNTIME) { return true; }
    }
    return false;
}

func collect_used_names(program: *AstProgram, has_runtime_init: u64) -> *Vec<*NameInfo> {
    // Reachability controls which already-validated functions are emitted; it
    // is not an optimization-level semantic. Keep the conservative legacy
    // implicit roots below, but do not make O0 generate every unused prelude
    // and compiler function merely because instruction optimization is off.
    var used_names: *Vec<*NameInfo> = new Vec<*NameInfo>{heap_alloc((64) * sizeof(*NameInfo)), 0, (64)};
    if (g_compiler_ctx.codegen_used_name_membership == 0) {
        g_compiler_ctx.codegen_used_name_membership = new HashMap<u64, u64>{0, 0, 0};
        g_compiler_ctx.codegen_used_name_membership.ensure_capacity(256);
    } else {
        g_compiler_ctx.codegen_used_name_membership.clear();
    }
    var used_flags: u64 = 0;
    collect_used_func_names(program, used_names, &used_flags);
    // Address-taken functions are added to the closure at the address
    // expression. Fall back to the whole program only when an indirect call
    // has no statically visible target anywhere in the reachable source.
    if ((used_flags & CG_USED_HAS_CALL_PTR) != 0 && (used_flags & CG_USED_HAS_FUNC_ADDR) == 0) {
        return 0;
    }
    if (has_runtime_init != 0) {
        if (used_add_resolved_name(used_names, slice((u64)"__global_init", 13)) != 0) {
            collect_used_func_closure(program.funcs_vec, used_names, &used_flags);
        }
    }
    return used_names;
}

func collect_used_names_bounded(program: *AstProgram, has_runtime_init: u64, max_names: u64) -> *Vec<*NameInfo> {
    g_codegen_used_name_budget = max_names;
    g_codegen_used_name_budget_exceeded = 0;
    var used_names: *Vec<*NameInfo> = collect_used_names(program, has_runtime_init);
    var exceeded: u64 = g_codegen_used_name_budget_exceeded;
    g_codegen_used_name_budget = 0;
    g_codegen_used_name_budget_exceeded = 0;
    if (exceeded != 0) { return 0; }
    return used_names;
}

func collect_auto_ssa_used_names(used_names: *Vec<*NameInfo>) -> *Vec<*NameInfo> {
    if (used_names == 0 || opt_get_backend_mode() != BACKEND_AUTO) { return used_names; }
    var n: u64 = used_names.len();
    var ssa_names: *Vec<*NameInfo> = new Vec<*NameInfo>{heap_alloc((n) * sizeof(*NameInfo)), 0, n};
    for (var i: u64 = 0; i < n; i++) {
        var info: *NameInfo = used_names.get(i);
        if (info == 0) { continue; }
        var fn: *AstFunc = 0;
        if (g_compiler_ctx.codegen_used_func_index != 0) {
            fn = g_compiler_ctx.codegen_used_func_index.get(slice(info.ptr, info.len));
        }
        // Auto SSA is intentionally a mixed backend. Compiler/prelude runtime
        // functions are already validated and have a mature legacy emitter;
        // rebuilding their large implementation graphs in SSA for every user
        // program dominates compile time without increasing user-code coverage.
        if (fn != 0 && codegen_gc_codegen_disabled_for_name(fn.name) != 0) { continue; }
        ssa_names.push(info);
    }
    return ssa_names;
}

const CG_EXPR_FEATURE_SAFE_NAV = 1;
const CG_EXPR_FEATURE_FLOAT = 2;

func expr_vec_has_feature(exprs: *Vec<*AstNode>, feature: u64) -> u64 {
    if (exprs == 0) { return false; }
    var n: u64 = exprs.len();
    for (var i: u64 = 0; i < n; i++) {
        if (expr_has_feature(exprs.get(i), feature) != 0) { return true; }
    }
    return false;
}

func expr_has_feature(node: *AstNode, feature: u64) -> u64 {
    if (node == 0) { return false; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;

    if (feature == CG_EXPR_FEATURE_SAFE_NAV) {
        if (kind == AST_SAFE_MEMBER_ACCESS || kind == AST_SAFE_METHOD_CALL || kind == AST_SAFE_INDEX) { return true; }
    } else if (feature == CG_EXPR_FEATURE_FLOAT) {
        if (kind == AST_FLOAT) { return true; }
    }

    match (kind) {
        case AST_BINARY:
            if (expr_has_feature(nref.binary.left, feature) != 0) { return true; }
            return expr_has_feature(nref.binary.right, feature);
        case AST_UNARY:
            return expr_has_feature(nref.unary.operand, feature);
        case AST_ADDR_OF:
            return expr_has_feature(nref.addr_of.operand, feature);
        case AST_DEREF:
            return expr_has_feature(nref.deref.operand, feature);
        case AST_DEREF8:
            return expr_has_feature(nref.deref8.operand, feature);
        case AST_CAST:
            if (feature == CG_EXPR_FEATURE_FLOAT && nref.cast_expr.target_type == TYPE_F64) { return true; }
            return expr_has_feature(nref.cast_expr.expr, feature);
        case AST_MEMBER_ACCESS:
        case AST_SAFE_MEMBER_ACCESS:
            return expr_has_feature(nref.member_access.object, feature);
        case AST_METHOD_CALL:
        case AST_SAFE_METHOD_CALL:
            if (expr_has_feature(nref.method_call.receiver, feature) != 0) { return true; }
            return expr_vec_has_feature(nref.method_call.args_vec, feature);
        case AST_CALL:
            return expr_vec_has_feature(nref.call.args_vec, feature);
        case AST_GENERIC_CALL:
            return expr_vec_has_feature(nref.generic_call.args_vec, feature);
        case AST_INDEX:
        case AST_SAFE_INDEX:
            if (expr_has_feature(nref.index_expr.base, feature) != 0) { return true; }
            return expr_has_feature(nref.index_expr.index, feature);
        case AST_SLICE:
            if (expr_has_feature(nref.slice_expr.ptr_expr, feature) != 0) { return true; }
            return expr_has_feature(nref.slice_expr.len_expr, feature);
        case AST_VARIADIC_PACK:
            return expr_vec_has_feature(((*AstVariadicPack)node).values_vec, feature);
        case AST_CALL_PTR:
            if (feature == CG_EXPR_FEATURE_FLOAT) { return false; }
            if (expr_has_feature(nref.call_ptr.callee, feature) != 0) { return true; }
            return expr_vec_has_feature(nref.call_ptr.args_vec, feature);
        case AST_NEW:
            if (feature == CG_EXPR_FEATURE_FLOAT) { return false; }
            if (expr_has_feature(nref.new_expr.literal_expr, feature) != 0) { return true; }
            return expr_vec_has_feature(nref.new_expr.ctor_args_vec, feature);
        case AST_STRUCT_LITERAL:
            if (feature == CG_EXPR_FEATURE_FLOAT) { return false; }
            return expr_vec_has_feature(nref.struct_lit.values_vec, feature);
        case AST_SIZEOF_EXPR:
            if (feature == CG_EXPR_FEATURE_FLOAT) { return false; }
            return expr_has_feature(nref.sizeof_expr.expr, feature);
        case AST_TRY:
            if (feature == CG_EXPR_FEATURE_SAFE_NAV) { return false; }
            return expr_has_feature(nref.try_expr.operand, feature);
    }
    return false;
}

func stmt_has_feature(node: *AstNode, feature: u64) -> u64 {
    if (node == 0) { return false; }
    var kind: u64 = ast_kind(node);
    var nref: AstNodeTagRef;
    nref.node = node;
    match (kind) {
        case AST_RETURN:
            return expr_has_feature(nref.ret_stmt.expr, feature);
        case AST_VAR_DECL:
            if (feature == CG_EXPR_FEATURE_FLOAT && nref.var_decl.type_kind == TYPE_F64 && nref.var_decl.ptr_depth == 0) { return true; }
            return expr_has_feature(nref.var_decl.init_expr, feature);
        case AST_CONST_DECL:
            if (feature == CG_EXPR_FEATURE_SAFE_NAV) { return expr_has_feature(nref.const_decl.value, feature); }
            return false;
        case AST_ASSIGN:
            if (expr_has_feature(nref.assign_stmt.target, feature) != 0) { return true; }
            return expr_has_feature(nref.assign_stmt.value, feature);
        case AST_EXPR_STMT:
            return expr_has_feature(nref.expr_stmt.expr, feature);
        case AST_IF:
            if (expr_has_feature(nref.if_stmt.cond, feature) != 0) { return true; }
            if (stmt_has_feature(nref.if_stmt.then_block, feature) != 0) { return true; }
            return stmt_has_feature(nref.if_stmt.else_block, feature);
        case AST_WHILE:
            if (expr_has_feature(nref.while_stmt.cond, feature) != 0) { return true; }
            return stmt_has_feature(nref.while_stmt.body, feature);
        case AST_FOR:
            if (stmt_has_feature(nref.for_stmt.init, feature) != 0) { return true; }
            if (expr_has_feature(nref.for_stmt.cond, feature) != 0) { return true; }
            if (expr_has_feature(nref.for_stmt.update, feature) != 0) { return true; }
            return stmt_has_feature(nref.for_stmt.body, feature);
        case AST_SWITCH:
        case AST_MATCH:
            if (expr_has_feature(nref.switch_stmt.expr, feature) != 0) { return true; }
            var cases: *Vec<*AstNode> = nref.switch_stmt.cases_vec;
            var cn: u64 = 0;
            if (cases != 0) { cn = cases.len(); }
            for (var i: u64 = 0; i < cn; i++) {
                if (stmt_has_feature((*AstNode)cases.get(i), feature) != 0) { return true; }
            }
            return false;
        case AST_CASE:
            if (expr_has_feature(nref.case_stmt.value, feature) != 0) { return true; }
            return stmt_has_feature(nref.case_stmt.body, feature);
        case AST_BLOCK:
            var stmts: *Vec<*AstNode> = nref.block_stmt.stmts_vec;
            if (stmts == 0) { return false; }
            var n: u64 = stmts.len();
            for (var j: u64 = 0; j < n; j++) {
                if (stmt_has_feature(stmts.get(j), feature) != 0) { return true; }
            }
            return false;
    }
    return false;
}

func program_has_safe_nav(program: *AstProgram) -> u64 {
    if (program == 0) { return false; }
    var funcs: *Vec<*AstFunc> = program.funcs_vec;
    if (funcs != 0) {
        var n: u64 = funcs.len();
        for (var i: u64 = 0; i < n; i++) {
            var fn: *AstFunc = funcs.get(i);
            if (fn != 0 && stmt_has_feature(fn.body, CG_EXPR_FEATURE_SAFE_NAV) != 0) { return true; }
        }
    }
    if (program.globals_vec != 0) {
        var gn: u64 = program.globals_vec.len();
        for (var j: u64 = 0; j < gn; j++) {
            var ginfo: *GlobalInfo = program.globals_vec.get(j);
            if (ginfo != 0 && ginfo.init_expr != 0) {
                if (expr_has_feature((*AstNode)ginfo.init_expr, CG_EXPR_FEATURE_SAFE_NAV) != 0) { return true; }
            }
        }
    }
    return false;
}

// ============================================
// Float Detection (SSA Disable)
// ============================================

func program_has_float(program: *AstProgram) -> u64 {
    if (program == 0) { return false; }
    var funcs: *Vec<*AstFunc> = program.funcs_vec;
    if (funcs != 0) {
        var n: u64 = funcs.len();
        for (var i: u64 = 0; i < n; i++) {
            var fn: *AstFunc = funcs.get(i);
            if (fn != 0) {
                if (fn.ret_type == TYPE_F64 && fn.ret_ptr_depth == 0) { return true; }
                var params: *Vec<*Param> = fn.params_vec;
                if (params != 0) {
                    var pn: u64 = params.len();
                    for (var pi: u64 = 0; pi < pn; pi++) {
                        var p: *Param = params.get(pi);
                        if (p.type_kind == TYPE_F64 && p.ptr_depth == 0) { return true; }
                    }
                }
                if (stmt_has_feature(fn.body, CG_EXPR_FEATURE_FLOAT) != 0) { return true; }
            }
        }
    }
    if (program.globals_vec != 0) {
        var gn: u64 = program.globals_vec.len();
        for (var j: u64 = 0; j < gn; j++) {
            var ginfo: *GlobalInfo = program.globals_vec.get(j);
            if (ginfo != 0) {
                if (ginfo.typeinfo_ptr != 0 && ginfo.typeinfo_ptr.type_kind == TYPE_F64 && ginfo.typeinfo_ptr.ptr_depth == 0) { return true; }
                if (ginfo.init_expr != 0 && expr_has_feature((*AstNode)ginfo.init_expr, CG_EXPR_FEATURE_FLOAT) != 0) { return true; }
            }
        }
    }
    return false;
}

func build_ssa_pipeline(program: *AstProgram, use_ssa: u64, used_names: *Vec<*NameInfo>) -> *SSAContext {
    if (use_ssa == 0) { return 0; }
    var phase_started: u64 = timings_now_ms();
    var ssa_detail_started: u64 = timings_profile_start();
    var ssa_ctx_ptr: *SSAContext = build_program_used(program, used_names);
    if (ssa_ctx_ptr == 0) { return 0; }
    timings_add_ssa_span(1, ssa_detail_started);
    // Type/build diagnostics make every later SSA phase invalid. Stop before
    // optimization, lowering, and register allocation so failing source files
    // do not spend most of their time compiling unrelated runtime helpers.
    if (diag_has_errors() != 0) { return ssa_ctx_ptr; }
    ssa_detail_started = timings_profile_start();
    to_ssa(ssa_ctx_ptr);
    timings_add_ssa_span(2, ssa_detail_started);
    timings_add_ssa(timings_elapsed_ms(phase_started));
    if (CODEGEN_DEBUG != 0) {
        println("[DEBUG] codegen: mem2reg", 25);
    }
    if (opt_get_level() >= 1) {
        phase_started = timings_now_ms();
        optimize_ssa(ssa_ctx_ptr);
        timings_add_opt(timings_elapsed_ms(phase_started));
        if (CODEGEN_DEBUG != 0) {
            println("[DEBUG] codegen: opt_o1", 25);
        }
    }
    phase_started = timings_now_ms();
    lower_phi(ssa_ctx_ptr);
    if (CODEGEN_DEBUG != 0) {
        println("[DEBUG] codegen: destroy", 25);
    }
    lower_phys(ssa_ctx_ptr);
    timings_add_lowering(timings_elapsed_ms(phase_started));
    if (CODEGEN_DEBUG != 0) {
        println("[DEBUG] codegen: lower_phys", 27);
    }
    var regalloc_gpr_count: u64 = 8;
    if (opt_get_level() >= 1) { regalloc_gpr_count = 12; }
    phase_started = timings_now_ms();
    allocate_regs(ssa_ctx_ptr, regalloc_gpr_count);
    timings_add_regalloc(timings_elapsed_ms(phase_started));
    if (CODEGEN_DEBUG != 0) {
        println("[DEBUG] codegen: regalloc", 26);
    }
    phase_started = timings_now_ms();
    if (validate_contract_preservation_ssa(ssa_ctx_ptr) != 0) {
        timings_add_validation(timings_elapsed_ms(phase_started));
        return 0;
    }
    if (annotation_validate_complexity_preservation_ssa(ssa_ctx_ptr) == 0) {
        timings_add_validation(timings_elapsed_ms(phase_started));
        return 0;
    }
    if (annotation_validate_lowered_contract_boundary(program, ssa_ctx_ptr) != 0) {
        timings_add_validation(timings_elapsed_ms(phase_started));
        return 0;
    }
    if (annotation_validate_post_llvm_contract_metadata_scaffold(program) == 0) {
        timings_add_validation(timings_elapsed_ms(phase_started));
        return 0;
    }
    if (annotation_validate_llvm_contract_adapter_scaffold(program) == 0) {
        timings_add_validation(timings_elapsed_ms(phase_started));
        return 0;
    }
    timings_add_validation(timings_elapsed_ms(phase_started));
    if (CODEGEN_DEBUG != 0) {
        annotation_dump_backend_contract_envelope_stderr(program);
        annotation_dump_llvm_contract_adapter_stderr(program);
    }
    return ssa_ctx_ptr;
}

func find_ssa_func_by_name(ssa_ctx: *SSAContext, name: []u8) -> *SSAFunction {
    if (ssa_ctx == 0) { return 0; }
    if (ssa_ctx.funcs_by_name != 0) {
        return ssa_ctx.funcs_by_name.get(slice(name.ptr, name.len));
    }
    var funcs: []*SSAFunction = ssa_ctx.funcs;
    var n: u64 = slice_len(funcs);
    for (var i: u64 = 0; i < n; i++) {
        var fn: *SSAFunction = funcs[i];
        if (fn == 0) { continue; }
        if (fn.name.len == name.len && str_eq(slice(fn.name.ptr, fn.name.len), name) != 0) {
            return fn;
        }
    }
    return 0;
}

func init_globals(program: *AstProgram) -> u64 {
    globals_set_from_prog(program.globals_vec);
    sym_set_all_globals(globals_current());
    return 0;
}

func emit_windows_runtime_externs() -> u64 {
    if (compiler_target() != COMPILER_TARGET_WINDOWS_X86_64) { return 0; }
    emitln("default rel");
    emitln("extern GetStdHandle");
    emitln("extern GetTickCount64");
    emitln("extern ReadFile");
    emitln("extern WriteFile");
    emitln("extern CreateFileA");
    emitln("extern CloseHandle");
    emitln("extern GetFileSizeEx");
    emitln("extern VirtualAlloc");
    emitln("extern VirtualFree");
    emitln("extern CreateProcessA");
    emitln("extern WaitForSingleObject");
    emitln("extern GetExitCodeProcess");
    emitln("extern ExitProcess");
    emitln("extern GetCommandLineA");
    emit_nl();
    return 0;
}

func emit_windows_entry(has_runtime_init: u64, entry: []u8, pass_process_args: u64) -> u64 {
    emitln("default rel");
    emitln("section .text");
    emitln("global _start");
    emitln("global mainCRTStartup");
    emitln("_start:");
    emitln("mainCRTStartup:");
    // Windows transfers control to the PE entry point with a 16-byte aligned
    // stack. Reserve the 32-byte home area plus two output slots while keeping
    // rsp aligned at every call site.
    emitln("    sub rsp, 48");
    if (has_runtime_init != 0) {
        emitln("    call __global_init");
    }
    if (pass_process_args != 0) {
        emitln("    lea rcx, [rsp+32]");
        emitln("    lea rdx, [rsp+40]");
        emitln("    call std_os__os_main_args");
        emitln("    mov rcx, [rsp+32]");
        emitln("    mov rdx, [rsp+40]");
    }
    emit("    call ");
    emit_len(entry.ptr, entry.len);
    emit_nl();
    emitln("    mov ecx, eax");
    emitln("    call std_io__sys_exit");
    return 0;
}

func emit_entry(program: *AstProgram, has_runtime_init: u64) -> u64 {
    var entry_ptr: u64 = entry_func_ptr();
    var entry_len: u64 = entry_func_len();
    var entry_fn: *AstFunc = sym_get_func(slice(entry_ptr, entry_len));
    var pass_process_args: u64 = 0;
    if (entry_fn != 0 && entry_fn.params_vec != 0 && entry_fn.params_vec.len() != 0) {
        pass_process_args = 1;
    }
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64) {
        return emit_windows_entry(has_runtime_init, slice(entry_ptr, entry_len), pass_process_args);
    }
    emitln("default rel");
    emitln("section .text");
    emitln("global _start");
    emitln("_start:");
    if (has_runtime_init != 0) {
        emitln("    call __global_init");
    }
    if (pass_process_args != 0) {
        emitln("    pop rdi          ; argc");
        emitln("    mov rsi, rsp     ; argv");
        emitln("    push rsi");
        emitln("    push rdi");
    }
    emit("    call ");
    emit_len(entry_ptr, entry_len);
    emit_nl();
    emitln("    mov rdi, rax");
    emitln("    call std_io__sys_exit");
    return 0;
}

func emit_trace_runtime() -> u64 {
    if (g_compiler_ctx.codegen_trace_runtime_needed == 0) { return 0; }
    if (compiler_target() == COMPILER_TARGET_WINDOWS_X86_64) {
        emitln("\nsection .text");
        emitln("align 16");
        emitln("__bpp_trace_enter:");
        emitln("    ret");
        return 0;
    }
    emitln("\nsection .data");
    emitln("__bpp_trace_msg: db 91,116,114,97,99,101,93,10");
    emitln("\nsection .text");
    emitln("align 16");
    emitln("__bpp_trace_enter:");
    emitln("    mov rax, 1");
    emitln("    mov rdi, 2");
    emitln("    lea rsi, [rel __bpp_trace_msg]");
    emitln("    mov rdx, 8");
    emitln("    syscall");
    emitln("    ret");
    return 0;
}

func emit_backend_fallback_report(fn: *AstFunc, reason: u64) -> u64 {
    if (opt_get_backend_report() == 0 || fn == 0) { return 0; }
    emit_stderr("[BACKEND] legacy fallback: ");
    emit_stderr_len(u8_slice_ptr(fn.name), u8_slice_len(fn.name));
    emit_stderr(" (");
    emit_stderr(reason);
    emit_stderr(")\n");
    return 0;
}

// Reject an explicit strict-SSA/legacy-only conflict before constructing the
// whole-program SSA graph. The old check in emit_functions remains as a
// defensive invariant, but waiting until emission made a known-invalid request
// pay the full prelude SSA and register-allocation cost first.
func strict_ssa_preflight_legacy_only(program: *AstProgram, used_names: *Vec<*NameInfo>) -> u64 {
    if (opt_get_backend_mode() != BACKEND_SSA || program == 0 || program.funcs_vec == 0) { return 1; }
    for (var i: u64 = 0; i < program.funcs_vec.len(); i++) {
        var fn: *AstFunc = program.funcs_vec.get(i);
        if (generic_template_fn(fn) != 0) { continue; }
        if (used_names != 0 && used_has_resolved_name(used_names, fn.name) == 0) { continue; }
        if (func_has_codegen_annotation(fn) != 0) {
            diag_emit_error_tag("backend", "ssa", "strict SSA backend rejected a legacy-only annotated function");
            diag_emit_labelled_name("function: ", fn.name);
            diag_force_stop_pass();
            return 0;
        }
    }
    return 1;
}

func emit_functions(program: *AstProgram, used_names: *Vec<*NameInfo>, use_ssa: u64, ssa_ctx: *SSAContext) -> u64 {
    var strict_ssa: u64 = opt_get_backend_mode() == BACKEND_SSA;
    for (var i: u64 = 0; i < program.funcs_vec.len(); i++) {
        if (diag_should_stop_pass() != 0) { break; }
        var fn: *AstFunc = program.funcs_vec.get(i);
        if (generic_template_fn(fn) != 0) {
            continue;
        }
        if (used_names != 0 && used_has_resolved_name(used_names, fn.name) == 0) {
            continue;
        }
        var annotation_forces_legacy: u64 = func_has_codegen_annotation(fn);
        var auto_runtime_legacy: u64 = strict_ssa == 0 && use_ssa != 0 &&
            codegen_gc_codegen_disabled_for_name(fn.name) != 0;
        var force_non_ssa_codegen: u64 = annotation_forces_legacy != 0 || auto_runtime_legacy != 0;
        if (strict_ssa != 0 && force_non_ssa_codegen != 0) {
            diag_emit_error_tag("backend", "ssa", "strict SSA backend rejected a legacy-only annotated function");
            diag_emit_labelled_name("function: ", fn.name);
            diag_force_stop_pass();
            break;
        }
        if (use_ssa != 0 && force_non_ssa_codegen == 0) {
            var ssa_fn_ptr: *SSAFunction = find_ssa_func_by_name(ssa_ctx, fn.name);
            var ssa_ready: u64 = 0;
            if (ssa_fn_ptr != 0 && ssa_fn_ptr.regalloc_failed == 0 && ssa_fn_ptr.regalloc_done != 0) {
                ssa_ready = 1;
            }
            if (is_supported_func(fn, program.globals_vec) != 0 &&
                is_build_ok(fn.name) != 0 &&
                ssa_ready != 0) {
                emit_ssa_func(fn, (u64)ssa_fn_ptr);
            } else {
                if (strict_ssa != 0) {
                    diag_emit_error_tag("backend", "ssa", "strict SSA backend could not compile function without fallback");
                    diag_emit_labelled_name("function: ", fn.name);
                    if (is_supported_func(fn, program.globals_vec) == 0) {
                        diag_emit_note("function contains an SSA-unsupported construct");
                    } else if (is_build_ok(fn.name) == 0) {
                        diag_emit_note("SSA construction failed for this function");
                    } else {
                        diag_emit_note("SSA register allocation did not complete");
                    }
                    diag_force_stop_pass();
                    break;
                } else {
                    if (is_supported_func(fn, program.globals_vec) == 0) {
                        emit_backend_fallback_report(fn, "unsupported SSA construct");
                    } else if (is_build_ok(fn.name) == 0) {
                        emit_backend_fallback_report(fn, "SSA construction failed");
                    } else {
                        emit_backend_fallback_report(fn, "register allocation failed");
                    }
                    emit_func(fn);
                }
            }
        } else {
            if (use_ssa != 0 && annotation_forces_legacy != 0) {
                emit_backend_fallback_report(fn, "legacy-only annotation");
            }
            emit_func(fn);
        }
        if (diag_should_stop_pass() != 0) { break; }
    }
    return 0;
}

func program_with_sigs(prog: *AstProgram, sigs: *Vec<*AstFunc>) -> u64 {
    push_trace("program_with_sigs", "codegen.b", __LINE__);
    defer pop_trace();

    var program: *AstProgram = prog;
    g_compiler_ctx.codegen_trace_runtime_needed = 0;
    g_codegen_trace_runtime_touches = 0;

    var has_runtime_init: u64 = program_has_runtime_global_init(program);
    var used_names: *Vec<*NameInfo> = collect_used_names(program, has_runtime_init);

    // SSA CFG scaffold (no codegen impact unless SSA/opt enabled)
    typeinfo_set_structs(program.structs_vec);
    typeinfo_set_funcs(program.funcs_vec);
    var ir_mode: u64 = opt_get_ir_mode();
    var out_mode: u64 = opt_get_output_mode();
    var use_ir: u64 = 0;
    if (ir_mode != IR_NONE) { use_ir = 1; }
    var use_ssa: u64 = 0;
    var backend_mode: u64 = opt_get_backend_mode();
    if (backend_mode == BACKEND_SSA) {
        use_ssa = 1;
    } else if (backend_mode == BACKEND_AUTO && ir_mode == IR_SSA) {
        use_ssa = 1;
    }

    if (strict_ssa_preflight_legacy_only(program, used_names) == 0) { return 1; }

    var ssa_used_names: *Vec<*NameInfo> = collect_auto_ssa_used_names(used_names);
    var ssa_ctx: *SSAContext = build_ssa_pipeline(program, use_ssa, ssa_used_names);
    if (ssa_used_names != used_names && ssa_used_names != 0) {
        ssa_used_names.release_buffer();
        free((u64)ssa_used_names);
    }
    defer ssa_context_release_aux(ssa_ctx);
    if (diag_has_errors() != 0) { return 1; }
    if (ssa_ctx == 0) {
        if (backend_mode == BACKEND_SSA) {
            diag_emit_error_tag("backend", "ssa", "strict SSA backend pipeline failed");
            diag_force_stop_pass();
            return 2;
        }
        use_ssa = 0;
    }

    var codegen_started: u64 = timings_now_ms();
    var codegen_expr_queries_before: u64 = typeinfo_expr_query_count();
    var codegen_expr_cache_hits_before: u64 = typeinfo_expr_cache_hits();
    var codegen_allocs_before: u64 = heap_profile_alloc_count();
    var codegen_alloc_bytes_before: u64 = heap_profile_requested_byte_count();
    var codegen_output_fragments_before: u64 = io_buffered_write_call_count();
    var codegen_output_bytes_before: u64 = io_buffered_write_byte_count();
    var codegen_output_flushes_before: u64 = io_buffer_flush_count();
    var codegen_detail_started: u64 = timings_profile_start();
    init_state();
    emit_gc_program_enabled_set(g_codegen_gc_runtime_needed);
    timings_add_codegen_span(1, codegen_detail_started);

    // Set structs and functions for typeinfo module
    typeinfo_set_structs(program.structs_vec);
    typeinfo_set_funcs(program.funcs_vec);
    typeinfo_layout_cache_begin();
    defer typeinfo_layout_cache_end();
    typeinfo_expr_cache_begin();
    defer typeinfo_expr_cache_end();
    

    codegen_detail_started = timings_profile_start();
    init_globals(program);
    timings_add_codegen_span(2, codegen_detail_started);
    codegen_detail_started = timings_profile_start();
    load_consts(program.consts_vec);
    emit_windows_runtime_externs();
    timings_add_codegen_span(3, codegen_detail_started);
    incremental_cache_begin(program, use_ssa);
    codegen_detail_started = timings_profile_start();
    emit_functions(program, used_names, use_ssa, ssa_ctx);
    timings_add_codegen_span(4, codegen_detail_started);
    if (diag_has_errors() != 0) { incremental_cache_end(0); return 2; }
    codegen_detail_started = timings_profile_start();
    emit_entry(program, has_runtime_init);
    emit_trace_runtime();
    timings_add_codegen_span(5, codegen_detail_started);

    codegen_detail_started = timings_profile_start();
    globals_emit_data();
    timings_add_codegen_span(6, codegen_detail_started);
    codegen_detail_started = timings_profile_start();
    string_emit_data();
    float_emit_data();
    timings_add_codegen_span(7, codegen_detail_started);
    codegen_detail_started = timings_profile_start();
    globals_emit_bss();
    timings_add_codegen_span(8, codegen_detail_started);
    incremental_cache_end(diag_has_errors() == 0);
    timings_set_codegen_metrics(
        typeinfo_expr_query_count() - codegen_expr_queries_before,
        typeinfo_expr_cache_hits() - codegen_expr_cache_hits_before,
        heap_profile_alloc_count() - codegen_allocs_before,
        heap_profile_requested_byte_count() - codegen_alloc_bytes_before,
        io_buffered_write_call_count() - codegen_output_fragments_before,
        io_buffered_write_byte_count() - codegen_output_bytes_before,
        io_buffer_flush_count() - codegen_output_flushes_before);
    timings_add_codegen(timings_elapsed_ms(codegen_started));
    return 0;
}

// Run the backend-independent semantic gate used by contract-style outputs.
// AST-only views intentionally stop after parsing/lowering; every output that
// claims a compilable contract must build and type-check all SSA-supported
// functions before it writes its payload.
func validate_program_semantics(prog: *AstProgram) -> u64 {
    if (prog == 0) { return 0; }
    typeinfo_set_structs(prog.structs_vec);
    typeinfo_set_funcs(prog.funcs_vec);
    var semantic_ctx: *SSAContext = build_program(prog);
    ssa_context_release_aux(semantic_ctx);
    if (diag_has_errors() != 0) { return 0; }
    return 1;
}

func program_with_sigs_ir(prog: *AstProgram, sigs: *Vec<*AstFunc>) -> u64 {
    push_trace("program_with_sigs_ir", "codegen.b", __LINE__);
    defer pop_trace();

    var program: *AstProgram = prog;

    typeinfo_set_structs(program.structs_vec);
    typeinfo_set_funcs(program.funcs_vec);

    var ir_mode: u64 = opt_get_ir_mode();
    var opt_level: u64 = opt_get_level();
    if (ir_mode == IR_3ADDR) {
        var ssa_ctx_ptr3: *SSAContext = build_program(prog);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_ptr3);
        }
        lower_phi(ssa_ctx_ptr3);
        dump_ssa(ssa_ctx_ptr3, 0);
        ssa_context_release_aux(ssa_ctx_ptr3);
    } else if (ir_mode == IR_MACHINE) {
        var ssa_ctx_machine: *SSAContext = build_program(prog);
        to_ssa(ssa_ctx_machine);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_machine);
        }
        lower_phi(ssa_ctx_machine);
        lower_phys(ssa_ctx_machine);
        dump_machine_ir(ssa_ctx_machine);
        ssa_context_release_aux(ssa_ctx_machine);
    } else {
        var ssa_ctx_ptr: *SSAContext = build_program(prog);
        to_ssa(ssa_ctx_ptr);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_ptr);
        }
        dump_ssa(ssa_ctx_ptr, 1);
        ssa_context_release_aux(ssa_ctx_ptr);
    }

    return 0;
}

func program_with_sigs_ir_json(prog: *AstProgram, sigs: *Vec<*AstFunc>) -> u64 {
    push_trace("program_with_sigs_ir_json", "codegen.b", __LINE__);
    defer pop_trace();

    var program: *AstProgram = prog;

    typeinfo_set_structs(program.structs_vec);
    typeinfo_set_funcs(program.funcs_vec);

    var ir_mode: u64 = opt_get_ir_mode();
    var opt_level: u64 = opt_get_level();
    if (ir_mode == IR_3ADDR) {
        var ssa_ctx_ptr3: *SSAContext = build_program(prog);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_ptr3);
        }
        lower_phi(ssa_ctx_ptr3);
        dump_ssa_json(ssa_ctx_ptr3, 0, "ir");
        ssa_context_release_aux(ssa_ctx_ptr3);
    } else if (ir_mode == IR_MACHINE) {
        var ssa_ctx_machine: *SSAContext = build_program(prog);
        to_ssa(ssa_ctx_machine);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_machine);
        }
        lower_phi(ssa_ctx_machine);
        lower_phys(ssa_ctx_machine);
        dump_ssa_json(ssa_ctx_machine, 0, "machine-ir");
        ssa_context_release_aux(ssa_ctx_machine);
    } else {
        var ssa_ctx_ptr: *SSAContext = build_program(prog);
        to_ssa(ssa_ctx_ptr);
        if (opt_level >= 1) {
            optimize_ssa(ssa_ctx_ptr);
        }
        dump_ssa_json(ssa_ctx_ptr, 1, "ssa");
        ssa_context_release_aux(ssa_ctx_ptr);
    }

    return 0;
}

func emit_program(prog: u64) -> u64 {
    push_trace("emit_program", "codegen.b", __LINE__);
    defer pop_trace();
    
    var program: *AstProgram = (*AstProgram)prog;
    
    // Reuse full function list as signature list
    program_with_sigs(program, program.funcs_vec);
    return 0;
}
